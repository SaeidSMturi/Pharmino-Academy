@model Domain.Entities.Course.CoursePdf

@{
    var cultureName = System.Globalization.CultureInfo.CurrentUICulture.Name;
    var isFarsi = cultureName.StartsWith("fa", StringComparison.OrdinalIgnoreCase);
    var isArabic = cultureName.StartsWith("ar", StringComparison.OrdinalIgnoreCase);
    var isRtl = System.Globalization.CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    ViewData["Title"] = Localizer["AddPdf"].Value;
    var courseId = ViewBag.CourseId;
    var courseTitle = (ViewBag.CourseTitle as string) ?? string.Empty;
}

<div class="animate-[fadeIn_0.4s_ease_forwards] w-full max-w-4xl mx-auto text-start" dir="@(isRtl ? "rtl" : "ltr")">
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="mb-6 p-4 rounded-2xl bg-brand-orange/10 border border-brand-orange/20 text-brand-orange flex items-center @(isRtl ? "space-x-reverse" : "space-x-3") shadow-[0_0_20px_rgba(255,126,66,0.1)]">
            <i class="fas fa-exclamation-triangle text-lg"></i>
            <span class="font-medium text-sm">@TempData["ErrorMessage"]</span>
        </div>
    }

    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6 mb-10">
        <div>
            <h1 class="text-3xl font-extrabold bg-gradient-to-r from-brand-cyan to-brand-blue bg-clip-text text-transparent mb-2 tracking-wide">
                @Localizer["AddCoursePdf"]
            </h1>
            <p class="text-slate-400 text-sm font-medium">@string.Format(Localizer["UploadPdfForCourse"].Value, courseTitle)</p>
        </div>
        <a asp-controller="CoursePdfs" asp-action="Index" asp-route-courseId="@courseId" class="w-full sm:w-auto text-center px-5 py-2.5 bg-white/5 border border-white/5 text-slate-300 rounded-xl hover:bg-white/10 hover:text-white transition-all text-sm font-bold flex items-center justify-center shadow-lg whitespace-nowrap">
            <i class="fas @(isRtl ? "fa-arrow-right ml-2" : "fa-arrow-left mr-2") text-xs"></i> @Localizer["AllPdfs"]
        </a>
    </div>

    <div class="w-full">
        <form asp-action="Create" method="post" enctype="multipart/form-data" class="space-y-10">
            @Html.AntiForgeryToken()
            <input type="hidden" name="CourseId" value="@courseId" />

            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="All" class="bg-rose-500/10 border border-rose-500/20 rounded-2xl p-4 text-rose-400 text-sm font-semibold flex items-center @(isRtl ? "space-x-reverse" : "space-x-3") shadow-[0_0_15px_rgba(244,63,94,0.1)] mb-6">
                    <i class="fas fa-triangle-exclamation text-lg"></i>
                    <span>@Localizer["PleaseFixErrors"]</span>
                </div>
            }

            <div class="space-y-6">
                <h3 class="text-sm font-bold text-brand-cyan uppercase tracking-widest mb-6 flex items-center">
                    <i class="fas fa-file-pdf @(isRtl ? "ml-2.5" : "mr-2.5") text-base"></i> @Localizer["CoursePdfFiles"]
                </h3>

                <div class="space-y-2">
                    <label class="block text-xs font-bold text-slate-400 uppercase tracking-wide">
                        @Localizer["SelectPdfFile"] <span class="text-brand-orange">*</span>
                    </label>
                    <input type="file" name="PdfFile" accept="application/pdf" required
                           class="w-full bg-white/[0.01] border border-white/5 rounded-xl px-4 py-3 text-white text-xs font-medium file:mr-4 file:py-1.5 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-bold file:bg-brand-blue/20 file:text-brand-blue hover:file:bg-brand-blue/30 file:transition-colors" />
                    <p class="text-[10px] text-slate-500 font-semibold leading-relaxed mt-2 flex items-center">
                        <i class="fas fa-info-circle @(isRtl ? "ml-1.5" : "mr-1.5") text-brand-cyan"></i> @Localizer["PdfSupportNotice"]
                    </p>
                </div>
            </div>

            <div class="pt-6">
                <h3 class="text-sm font-bold text-brand-blue uppercase tracking-widest mb-6 flex items-center">
                    <i class="fas fa-tag @(isRtl ? "ml-2.5" : "mr-2.5") text-base"></i> @Localizer["PricingAndStatus"]
                </h3>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-start">
                    <div class="space-y-2">
                        <label asp-for="Price" class="block text-xs font-bold text-slate-400 uppercase tracking-wide">
                            @Localizer["PdfPriceUSD"] <span class="text-brand-orange">*</span>
                        </label>
                        <div class="relative group border-b border-white/10 focus-within:border-brand-cyan/80 transition-colors">
                            <input asp-for="Price" id="pdfPriceInput" type="number" step="0.01" min="0" oninput="updatePdfPriceConversion()" class="w-full bg-transparent px-4 py-3.5 @(isRtl ? "pr-11 pl-4" : "pl-11 pr-4") text-white placeholder-slate-600 focus:outline-none text-base font-bold font-mono" placeholder="0" />
                            <i class="fas fa-tag absolute @(isRtl ? "right-2" : "left-2") top-1/2 transform -translate-y-1/2 text-slate-600 group-focus-within:text-brand-cyan transition-colors text-sm"></i>
                        </div>
                        <span asp-validation-for="Price" class="text-rose-400 text-xs font-semibold mt-1 block"></span>

                        <!-- Smart IP & Regional Currency Converter -->
                        <div id="priceConverterBar" class="mt-3 p-3 rounded-xl bg-white/[0.02] border border-white/5 space-y-2">
                            <div class="flex items-center justify-between gap-2 flex-wrap text-xs">
                                <span class="text-slate-400 font-medium flex items-center gap-1.5">
                                    <i class="fas fa-globe text-brand-cyan text-xs"></i>
                                    <span id="detectedRegionText">@(isFarsi ? "در حال شناسایی ارز محلی..." : (isArabic ? "جاري كشف العملة المحلية..." : "Detecting local currency..."))</span>
                                </span>
                                <div class="flex items-center gap-1.5">
                                    <label for="currencySelect" class="text-[10px] uppercase font-bold text-slate-500">@(isFarsi ? "ارز:" : (isArabic ? "العملة:" : "Currency:"))</label>
                                    <select id="currencySelect" onchange="onCurrencySelectChange(this.value)" class="bg-dark-bg/90 border border-white/10 rounded-lg px-2 py-1 text-xs font-bold text-brand-cyan focus:outline-none focus:border-brand-cyan max-w-[170px]">
                                        <optgroup label="GCC & Arab Currencies">
                                            <option value="OMR">OMR (ر.ع.) - Oman (Base)</option>
                                            <option value="AED">AED (د.إ) - UAE</option>
                                            <option value="SAR">SAR (ر.س) - Saudi Arabia</option>
                                            <option value="QAR">QAR (ر.ق) - Qatar</option>
                                            <option value="KWD">KWD (د.ك) - Kuwait</option>
                                            <option value="BHD">BHD (د.ب) - Bahrain</option>
                                            <option value="IQD">IQD (د.ع) - Iraq</option>
                                            <option value="JOD">JOD (د.أ) - Jordan</option>
                                            <option value="EGP">EGP (ج.م) - Egypt</option>
                                            <option value="LBP">LBP (ل.ل) - Lebanon</option>
                                            <option value="MAD">MAD (د.م.) - Morocco</option>
                                            <option value="DZD">DZD (د.ج) - Algeria</option>
                                            <option value="TND">TND (د.ت) - Tunisia</option>
                                            <option value="LYD">LYD (د.ل) - Libya</option>
                                            <option value="YER">YER (ر.ي) - Yemen</option>
                                        </optgroup>
                                        <optgroup label="Major Global Currencies">
                                            <option value="USD">USD ($) - US Dollar</option>
                                            <option value="EUR">EUR (€) - Euro</option>
                                            <option value="GBP">GBP (£) - British Pound</option>
                                            <option value="CHF">CHF (CHF) - Swiss Franc</option>
                                            <option value="CAD">CAD (CA$) - Canada</option>
                                            <option value="AUD">AUD (AU$) - Australia</option>
                                            <option value="JPY">JPY (¥) - Japan</option>
                                            <option value="CNY">CNY (¥) - China</option>
                                            <option value="INR">INR (₹) - India</option>
                                            <option value="TRY">TRY (₺) - Turkey</option>
                                            <option value="SGD">SGD (S$) - Singapore</option>
                                            <option value="NZD">NZD (NZ$) - New Zealand</option>
                                            <option value="HKD">HKD (HK$) - Hong Kong</option>
                                            <option value="KRW">KRW (₩) - South Korea</option>
                                            <option value="MYR">MYR (RM) - Malaysia</option>
                                            <option value="IDR">IDR (Rp) - Indonesia</option>
                                            <option value="THB">THB (฿) - Thailand</option>
                                            <option value="PKR">PKR (₨) - Pakistan</option>
                                            <option value="BDT">BDT (৳) - Bangladesh</option>
                                            <option value="PHP">PHP (₱) - Philippines</option>
                                            <option value="SEK">SEK (kr) - Sweden</option>
                                            <option value="NOK">NOK (kr) - Norway</option>
                                            <option value="DKK">DKK (kr) - Denmark</option>
                                            <option value="PLN">PLN (zł) - Poland</option>
                                            <option value="CZK">CZK (Kč) - Czech Republic</option>
                                            <option value="HUF">HUF (Ft) - Hungary</option>
                                            <option value="RON">RON (lei) - Romania</option>
                                            <option value="BGN">BGN (лв) - Bulgaria</option>
                                            <option value="ZAR">ZAR (R) - South Africa</option>
                                            <option value="BRL">BRL (R$) - Brazil</option>
                                            <option value="MXN">MXN (Mex$) - Mexico</option>
                                            <option value="CLP">CLP (CLP$) - Chile</option>
                                            <option value="COP">COP (COL$) - Colombia</option>
                                            <option value="PEN">PEN (S/) - Peru</option>
                                            <option value="ARS">ARS (ARS$) - Argentina</option>
                                            <option value="NGN">NGN (₦) - Nigeria</option>
                                            <option value="KES">KES (KSh) - Kenya</option>
                                            <option value="GHS">GHS (GH₵) - Ghana</option>
                                            <option value="AZN">AZN (₼) - Azerbaijan</option>
                                            <option value="KZT">KZT (₸) - Kazakhstan</option>
                                            <option value="UZS">UZS (soʻm) - Uzbekistan</option>
                                            <option value="GEL">GEL (₾) - Georgia</option>
                                        </optgroup>
                                        <optgroup id="otherCurrenciesGroup" label="Other World Currencies">
                                        </optgroup>
                                    </select>
                                </div>
                            </div>
                            <div class="flex items-center justify-between text-xs pt-1 border-t border-white/5">
                                <span class="text-slate-400">@(isFarsi ? "معادل با ارز انتخابی:" : (isArabic ? "المعادل بالعملة المحددة:" : "Regional estimate:"))</span>
                                <span id="convertedPriceText" class="font-bold font-mono text-brand-cyan">0.000 OMR</span>
                            </div>
                        </div>

                        <p class="text-[10px] text-slate-500 font-medium mt-2">@Localizer["SetPriceZeroFreePdf"]</p>
                    </div>

                    <div class="space-y-2 md:mt-6">
                        <label class="flex items-center @(isRtl ? "space-x-reverse" : "space-x-3") bg-white/[0.01] border border-white/5 p-4 rounded-xl cursor-pointer hover:bg-white/[0.03] transition-colors group">
                            <input asp-for="IsActive" type="checkbox" checked class="w-4 h-4 rounded border-white/10 bg-dark-bg text-brand-cyan focus:ring-brand-cyan/20 focus:ring-offset-0" />
                            <span class="text-xs font-bold text-slate-400 group-hover:text-slate-200 transition-colors flex items-center">
                                <i class="fas fa-circle-check @(isRtl ? "ml-2" : "mr-2") text-slate-500 text-sm group-hover:text-brand-cyan transition-colors"></i>
                                @Localizer["PublishImmediatelyActive"]
                            </span>
                        </label>
                    </div>
                </div>
            </div>

            <div class="bg-brand-cyan/5 border border-brand-cyan/10 rounded-2xl p-4 flex items-start @(isRtl ? "space-x-reverse" : "space-x-3") shadow-sm">
                <i class="fas fa-info-circle text-brand-cyan text-sm mt-0.5"></i>
                <div class="text-xs text-slate-400 font-medium leading-relaxed">
                    @Localizer["RequiredFieldsNote"]
                </div>
            </div>

            <div class="flex flex-col-reverse sm:flex-row sm:items-center sm:justify-end gap-4 pt-6 border-t border-white/5">
                <a asp-controller="CoursePdfs" asp-action="Index" asp-route-courseId="@courseId" class="w-full sm:w-auto text-center px-5 py-2.5 bg-white/5 border border-white/5 text-slate-300 rounded-xl hover:bg-white/10 hover:text-white transition-all text-xs font-bold flex items-center justify-center">
                    @Localizer["Cancel"]
                </a>
                <button type="submit" class="w-full sm:w-auto text-center px-6 py-2.5 bg-gradient-to-r from-brand-cyan to-brand-blue text-dark-bg font-black text-xs rounded-xl hover:shadow-[0_0_20px_rgba(66,234,255,0.3)] hover:scale-[1.01] transition-all flex items-center justify-center">
                    <i class="fas fa-plus @(isRtl ? "ml-1.5" : "mr-1.5") text-sm"></i> @Localizer["AddPdf"]
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // --- Smart Currency Converter & Geo-IP Engine (Base: OMR, Excluding FATF Blacklist) ---
        const FATF_BLACKLIST_CURRENCIES = ['IRR', 'KPW', 'MMK', 'RUB', 'SYP', 'CUP'];
        const FATF_BLACKLIST_CODES = ['IR', 'KP', 'MM', 'RU', 'SY', 'CU', 'IRN', 'PRK', 'MMR', 'RUS', 'SYR', 'CUB'];

        function isFatfBlacklisted(val) {
            if (!val) return false;
            const str = String(val).trim().toUpperCase();
            if (FATF_BLACKLIST_CURRENCIES.includes(str) || FATF_BLACKLIST_CODES.includes(str)) return true;
            const lower = str.toLowerCase();
            return lower.includes('iran') || lower.includes('north korea') || lower.includes('dprk') ||
                   lower.includes('myanmar') || lower.includes('burma') || lower.includes('syria') ||
                   lower.includes('russia') || lower.includes('cuba');
        }

        // Base currency is OMR (Omani Rial). Rates relative to 1 OMR:
        const exchangeRates = {
            // GCC & Arab
            OMR: { rate: 1.0, symbol: 'ر.ع.', name: 'Omani Rial', decimals: 3 },
            AED: { rate: 9.5514, symbol: 'د.إ', name: 'UAE Dirham', decimals: 2 },
            SAR: { rate: 9.7530, symbol: 'ر.س', name: 'Saudi Riyal', decimals: 2 },
            QAR: { rate: 9.4670, symbol: 'ر.ق', name: 'Qatari Riyal', decimals: 2 },
            KWD: { rate: 0.8010, symbol: 'د.ك', name: 'Kuwaiti Dinar', decimals: 3 },
            BHD: { rate: 0.9800, symbol: 'د.ب', name: 'Bahraini Dinar', decimals: 3 },
            IQD: { rate: 3946.5, symbol: 'د.ع', name: 'Iraqi Dinar', decimals: 0 },
            JOD: { rate: 1.8440, symbol: 'د.أ', name: 'Jordanian Dinar', decimals: 3 },
            EGP: { rate: 126.15, symbol: 'ج.م', name: 'Egyptian Pound', decimals: 2 },
            LBP: { rate: 232800, symbol: 'ل.ل', name: 'Lebanese Pound', decimals: 0 },
            MAD: { rate: 25.80, symbol: 'د.م.', name: 'Moroccan Dirham', decimals: 2 },
            DZD: { rate: 348.50, symbol: 'د.ج', name: 'Algerian Dinar', decimals: 2 },
            TND: { rate: 8.050, symbol: 'د.ت', name: 'Tunisian Dinar', decimals: 3 },
            LYD: { rate: 12.60, symbol: 'د.ل', name: 'Libyan Dinar', decimals: 3 },
            YER: { rate: 651.0, symbol: 'ر.ي', name: 'Yemeni Rial', decimals: 0 },

            // Global Major
            USD: { rate: 2.6008, symbol: '$', name: 'US Dollar', decimals: 2 },
            EUR: { rate: 2.3188, symbol: '€', name: 'Euro', decimals: 2 },
            GBP: { rate: 1.9420, symbol: '£', name: 'British Pound', decimals: 2 },
            CHF: { rate: 2.3140, symbol: 'CHF', name: 'Swiss Franc', decimals: 2 },
            CAD: { rate: 3.5890, symbol: 'CA$', name: 'Canadian Dollar', decimals: 2 },
            AUD: { rate: 3.9520, symbol: 'AU$', name: 'Australian Dollar', decimals: 2 },
            JPY: { rate: 390.50, symbol: '¥', name: 'Japanese Yen', decimals: 0 },
            CNY: { rate: 18.72, symbol: '¥', name: 'Chinese Yuan', decimals: 2 },
            INR: { rate: 218.40, symbol: '₹', name: 'Indian Rupee', decimals: 2 },
            TRY: { rate: 89.20, symbol: '₺', name: 'Turkish Lira', decimals: 2 },
            SGD: { rate: 3.480, symbol: 'S$', name: 'Singapore Dollar', decimals: 2 },
            NZD: { rate: 4.350, symbol: 'NZ$', name: 'New Zealand Dollar', decimals: 2 },
            HKD: { rate: 20.25, symbol: 'HK$', name: 'Hong Kong Dollar', decimals: 2 },
            KRW: { rate: 3580.0, symbol: '₩', name: 'South Korean Won', decimals: 0 },
            MYR: { rate: 11.55, symbol: 'RM', name: 'Malaysian Ringgit', decimals: 2 },
            IDR: { rate: 42100, symbol: 'Rp', name: 'Indonesian Rupiah', decimals: 0 },
            THB: { rate: 88.50, symbol: '฿', name: 'Thai Baht', decimals: 2 },
            PKR: { rate: 724.0, symbol: '₨', name: 'Pakistani Rupee', decimals: 2 },
            BDT: { rate: 312.0, symbol: '৳', name: 'Bangladeshi Taka', decimals: 2 },
            PHP: { rate: 151.2, symbol: '₱', name: 'Philippine Peso', decimals: 2 },
            SEK: { rate: 27.20, symbol: 'kr', name: 'Swedish Krona', decimals: 2 },
            NOK: { rate: 28.10, symbol: 'kr', name: 'Norwegian Krone', decimals: 2 },
            DKK: { rate: 17.30, symbol: 'kr', name: 'Danish Krone', decimals: 2 },
            PLN: { rate: 10.15, symbol: 'zł', name: 'Polish Zloty', decimals: 2 },
            CZK: { rate: 58.60, symbol: 'Kč', name: 'Czech Koruna', decimals: 2 },
            HUF: { rate: 955.0, symbol: 'Ft', name: 'Hungarian Forint', decimals: 0 },
            RON: { rate: 11.55, symbol: 'lei', name: 'Romanian Leu', decimals: 2 },
            BGN: { rate: 4.54, symbol: 'лв', name: 'Bulgarian Lev', decimals: 2 },
            ZAR: { rate: 46.50, symbol: 'R', name: 'South African Rand', decimals: 2 },
            BRL: { rate: 14.80, symbol: 'R$', name: 'Brazilian Real', decimals: 2 },
            MXN: { rate: 52.10, symbol: 'Mex$', name: 'Mexican Peso', decimals: 2 },
            CLP: { rate: 2470.0, symbol: 'CLP$', name: 'Chilean Peso', decimals: 0 },
            COP: { rate: 11100.0, symbol: 'COL$', name: 'Colombian Peso', decimals: 0 },
            PEN: { rate: 9.85, symbol: 'S/', name: 'Peruvian Sol', decimals: 2 },
            ARS: { rate: 2650.0, symbol: 'ARS$', name: 'Argentine Peso', decimals: 2 },
            NGN: { rate: 4180.0, symbol: '₦', name: 'Nigerian Naira', decimals: 2 },
            KES: { rate: 336.0, symbol: 'KSh', name: 'Kenyan Shilling', decimals: 2 },
            GHS: { rate: 41.50, symbol: 'GH₵', name: 'Ghanaian Cedi', decimals: 2 },
            AZN: { rate: 4.42, symbol: '₼', name: 'Azerbaijani Manat', decimals: 2 },
            KZT: { rate: 1270.0, symbol: '₸', name: 'Kazakhstani Tenge', decimals: 2 },
            UZS: { rate: 33500, symbol: 'soʻm', name: 'Uzbekistani Som', decimals: 0 },
            GEL: { rate: 7.15, symbol: '₾', name: 'Georgian Lari', decimals: 2 }
        };

        let selectedCurrency = 'OMR';

        function countryToCurrencyCode(code) {
            if (isFatfBlacklisted(code)) return 'OMR';
            const map = {
                'OM': 'OMR', 'AE': 'AED', 'SA': 'SAR', 'KW': 'KWD', 'QA': 'QAR', 
                'BH': 'BHD', 'IQ': 'IQD', 'JO': 'JOD', 'EG': 'EGP', 'LB': 'LBP',
                'TR': 'TRY', 'GB': 'GBP', 'CA': 'CAD', 'AU': 'AUD', 'NZ': 'NZD',
                'DE': 'EUR', 'FR': 'EUR', 'IT': 'EUR', 'ES': 'EUR', 'NL': 'EUR',
                'CH': 'CHF', 'JP': 'JPY', 'CN': 'CNY', 'IN': 'INR', 'SG': 'SGD',
                'US': 'USD'
            };
            return map[code] || 'USD';
        }

        async function initSmartPriceConverter() {
            let detectedCurrency = null;
            let detectedCountry = null;

            try {
                const resp = await fetch('https://ipapi.co/json/', { signal: AbortSignal.timeout(2500) });
                if (resp.ok) {
                    const data = await resp.json();
                    if (data.country_code && isFatfBlacklisted(data.country_code)) {
                        detectedCurrency = 'OMR';
                        detectedCountry = 'Oman';
                    } else if (data.currency && isFatfBlacklisted(data.currency)) {
                        detectedCurrency = 'OMR';
                        detectedCountry = 'Oman';
                    } else if (data.currency && exchangeRates[data.currency]) {
                        detectedCurrency = data.currency;
                        detectedCountry = data.country_name || data.country_code;
                    } else if (data.country_code) {
                        detectedCurrency = countryToCurrencyCode(data.country_code);
                        detectedCountry = data.country_name || data.country_code;
                    }
                }
            } catch (e) {}

            if (!detectedCurrency || isFatfBlacklisted(detectedCurrency)) {
                const tz = (Intl.DateTimeFormat().resolvedOptions().timeZone || '').toLowerCase();
                if (tz.includes('muscat')) { detectedCurrency = 'OMR'; detectedCountry = 'Oman'; }
                else if (tz.includes('dubai')) { detectedCurrency = 'AED'; detectedCountry = 'United Arab Emirates'; }
                else if (tz.includes('riyadh')) { detectedCurrency = 'SAR'; detectedCountry = 'Saudi Arabia'; }
                else if (tz.includes('kuwait')) { detectedCurrency = 'KWD'; detectedCountry = 'Kuwait'; }
                else if (tz.includes('qatar')) { detectedCurrency = 'QAR'; detectedCountry = 'Qatar'; }
                else if (tz.includes('bahrain')) { detectedCurrency = 'BHD'; detectedCountry = 'Bahrain'; }
                else if (tz.includes('baghdad')) { detectedCurrency = 'IQD'; detectedCountry = 'Iraq'; }
                else if (tz.includes('amman')) { detectedCurrency = 'JOD'; detectedCountry = 'Jordan'; }
                else if (tz.includes('cairo')) { detectedCurrency = 'EGP'; detectedCountry = 'Egypt'; }
                else if (tz.includes('istanbul')) { detectedCurrency = 'TRY'; detectedCountry = 'Turkey'; }
                else if (tz.includes('london')) { detectedCurrency = 'GBP'; detectedCountry = 'United Kingdom'; }
                else if (tz.includes('paris') || tz.includes('berlin') || tz.includes('rome') || tz.includes('madrid')) { detectedCurrency = 'EUR'; detectedCountry = 'Europe'; }
                else if (tz.includes('toronto') || tz.includes('vancouver')) { detectedCurrency = 'CAD'; detectedCountry = 'Canada'; }
                else if (tz.includes('tehran') || tz.includes('pyongyang') || tz.includes('yangon')) { detectedCurrency = 'OMR'; detectedCountry = 'Oman'; }
                else { detectedCurrency = 'USD'; detectedCountry = 'United States'; }
            }

            if (detectedCurrency && !isFatfBlacklisted(detectedCurrency)) {
                selectedCurrency = detectedCurrency;
                const sel = document.getElementById('currencySelect');
                if (sel) {
                    ensureCurrencyInSelect(detectedCurrency);
                    sel.value = detectedCurrency;
                }
                const regionEl = document.getElementById('detectedRegionText');
                if (regionEl) regionEl.textContent = `${detectedCountry} (${detectedCurrency})`;
            }

            // Asynchronously fetch live rate updates with base OMR from open.er-api.com
            fetch('https://open.er-api.com/v6/latest/OMR')
                .then(r => r.json())
                .then(d => {
                    if (d && d.rates) {
                        const otherGroup = document.getElementById('otherCurrenciesGroup');
                        for (const c in d.rates) {
                            if (isFatfBlacklisted(c)) continue; // Filter out FATF blacklist!

                            if (!exchangeRates[c]) {
                                exchangeRates[c] = {
                                    rate: d.rates[c],
                                    symbol: c,
                                    name: c,
                                    decimals: 2
                                };
                                if (otherGroup) {
                                    const opt = document.createElement('option');
                                    opt.value = c;
                                    opt.textContent = `${c} - ${c}`;
                                    otherGroup.appendChild(opt);
                                }
                            } else {
                                exchangeRates[c].rate = d.rates[c];
                            }
                        }
                        updatePdfPriceConversion();
                    }
                })
                .catch(() => {});

            updatePdfPriceConversion();
        }

        function ensureCurrencyInSelect(code) {
            const sel = document.getElementById('currencySelect');
            if (!sel || !code) return;
            let exists = false;
            for (let i = 0; i < sel.options.length; i++) {
                if (sel.options[i].value === code) { exists = true; break; }
            }
            if (!exists && !isFatfBlacklisted(code)) {
                const opt = document.createElement('option');
                opt.value = code;
                opt.textContent = `${code} (${code})`;
                sel.appendChild(opt);
            }
        }

        function formatCurrencyValue(val, currCode) {
            const curr = exchangeRates[currCode] || exchangeRates.OMR;
            const converted = val * curr.rate;
            const decimals = curr.decimals;
            return `${converted.toLocaleString(undefined, { minimumFractionDigits: decimals, maximumFractionDigits: decimals })} ${curr.symbol}`;
        }

        function onCurrencySelectChange(newCurrency) {
            if (isFatfBlacklisted(newCurrency)) {
                selectedCurrency = 'OMR';
            } else {
                selectedCurrency = newCurrency;
            }
            updatePdfPriceConversion();
        }

        function updatePdfPriceConversion() {
            const val = parseFloat(document.getElementById('pdfPriceInput').value) || 0;
            const convEl = document.getElementById('convertedPriceText');
            if (convEl) {
                convEl.textContent = val > 0 ? formatCurrencyValue(val, selectedCurrency) : `0.000 OMR`;
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            initSmartPriceConverter();
        });
    </script>
}