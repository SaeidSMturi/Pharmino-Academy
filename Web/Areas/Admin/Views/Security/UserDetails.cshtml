@using Domain.Entities.Security
@{
    ViewData["Title"] = "User Security Details";
    var activities = ViewBag.Activities as List<SuspiciousActivity>;
    var lockHistory = ViewBag.LockHistory as List<AccountLockHistory>;
    var userId = ViewBag.UserId as int?;

    int currentCount = ViewBag.RecentSuspiciousCount ?? 0;
    int threshold = ViewBag.BanThreshold ?? 5;
    bool isLocked = ViewBag.IsLocked ?? false;

    // Calculate risk percentage and dynamic progress bar color
    int riskPercentage = (int)Math.Min(100, ((double)currentCount / threshold) * 100);
    var progressColor = riskPercentage >= 100 ? "bg-red-500" : riskPercentage >= 60 ? "bg-yellow-500" : "bg-green-500";
}

<div class="fade-in" dir="ltr">
    <!-- Breadcrumb -->
    <div class="mb-6">
        <nav class="flex items-center space-x-2 text-sm">
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="text-purple-400 hover:text-purple-300 transition-colors">
                Dashboard
            </a>
            <i class="fas fa-chevron-right text-slate-500 text-xs"></i>
            <a asp-action="LockedAccounts" class="text-purple-400 hover:text-purple-300 transition-colors">
                Security & Locks
            </a>
            <i class="fas fa-chevron-right text-slate-500 text-xs"></i>
            <span class="text-slate-400">User Security Details</span>
        </nav>
    </div>

    <!-- Header -->
    <div class="mb-8">
        <h1 class="text-3xl font-bold text-white mb-2 flex items-center">
            <i class="fas fa-user-shield text-yellow-500 mr-3"></i>
            User Security Details - User ID: @userId
        </h1>
        <p class="text-slate-400">Security monitoring and account lock status</p>
    </div>

    <!-- Lock Status Monitoring -->
    <div class="glass-card rounded-xl p-6 mb-6 border border-slate-700/50">
        <div class="flex items-center space-x-3 mb-6">
            <div class="w-12 h-12 rounded-lg bg-indigo-500/20 flex items-center justify-center">
                <i class="fas fa-tachometer-alt text-indigo-400 text-xl"></i>
            </div>
            <div>
                <h2 class="text-xl font-bold text-white">Account Status & Risk Score</h2>
                <p class="text-sm text-slate-400">Real-time activity and security limit analysis</p>
            </div>
        </div>

        @if (isLocked)
        {
            <div class="p-4 bg-red-500/10 border border-red-500/30 rounded-lg text-red-300 flex items-start space-x-3">
                <i class="fas fa-ban mt-1"></i>
                <div>
                    <strong class="block text-red-400 mb-1">Lock Reason:</strong>
                    This user account is locked because suspicious activities in the last 30 days reached <b class="text-white font-mono">@currentCount</b> (limit is <b class="text-white font-mono">@threshold</b> incidents).
                </div>
            </div>
        }
        else
        {
            <div class="p-4 bg-green-500/10 border border-green-500/30 rounded-lg text-green-300 flex items-start space-x-3">
                <i class="fas fa-shield-alt mt-1"></i>
                <div>
                    <strong class="block text-green-400 mb-1">Status: Active (Not Locked)</strong>
                    This account is active and within normal limits (<b class="text-white font-mono">@currentCount</b> recorded events out of <b class="text-white font-mono">@threshold</b> allowed).
                </div>
            </div>
        }

        <!-- Risk Progress Bar -->
        <div class="mt-6 p-4 bg-slate-800/30 rounded-lg border border-slate-700/30">
            <div class="flex justify-between text-sm text-slate-300 mb-2">
                <span class="font-medium">Account Risk Level</span>
                <span class="font-mono text-white">@currentCount / @threshold</span>
            </div>
            <div class="w-full bg-slate-900 rounded-full h-2 border border-slate-700/50">
                <div class="@progressColor h-2 rounded-full transition-all duration-500" style="width: @riskPercentage%"></div>
            </div>
        </div>
    </div>

    @if (isLocked)
    {
        <!-- Account Unlock Form -->
        <div class="glass-card rounded-xl p-6 mb-6">
            <div class="flex items-center space-x-3 mb-6">
                <div class="w-12 h-12 rounded-lg bg-blue-500/20 flex items-center justify-center flex-shrink-0">
                    <i class="fas fa-unlock-alt text-blue-400 text-xl"></i>
                </div>
                <div>
                    <h2 class="text-xl font-bold text-white">Unlock Account</h2>
                    <p class="text-sm text-slate-400">Unlock user account and reset security error count</p>
                </div>
            </div>
            <form asp-action="UnlockAccount" method="post">
                <input type="hidden" name="userId" value="@userId" />
                <div class="mb-4">
                    <label class="block text-sm font-medium text-slate-300 mb-2">
                        <i class="fas fa-sticky-note text-slate-500 mr-2"></i>
                        Admin Notes (Required)
                    </label>
                    <textarea name="adminNotes" required
                              class="w-full px-4 py-3 bg-slate-800/50 border border-slate-700 rounded-lg text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all"
                              rows="3" placeholder="Enter the reason for unlocking the account..."></textarea>
                </div>
                <button type="submit" class="inline-flex items-center px-6 py-3 bg-blue-500/20 text-blue-400 rounded-lg hover:bg-blue-500/30 border border-blue-500/30 transition-all font-medium">
                    <i class="fas fa-unlock mr-2"></i>
                    Unlock Account
                </button>
            </form>
        </div>
    }

    <!-- List of Recorded Security Events -->
    @if (activities != null && activities.Any())
    {
        <div class="glass-card rounded-xl mb-6 overflow-hidden">
            <div class="px-6 py-4 border-b border-slate-700/50">
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 rounded-lg bg-red-500/20 flex items-center justify-center">
                        <i class="fas fa-list-ul text-red-400"></i>
                    </div>
                    <div>
                        <h2 class="text-xl font-bold text-white">Recorded Security Events</h2>
                        <p class="text-sm text-slate-400">All recorded security events for this user</p>
                    </div>
                </div>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left">
                    <thead>
                        <tr class="border-b border-slate-700/50 bg-slate-800/30">
                            <th class="px-6 py-4 text-xs font-semibold text-slate-400 uppercase tracking-wider">Activity Type</th>
                            <th class="px-6 py-4 text-xs font-semibold text-slate-400 uppercase tracking-wider text-center">Risk Score</th>
                            <th class="px-6 py-4 text-xs font-semibold text-slate-400 uppercase tracking-wider">Reason</th>
                            <th class="px-6 py-4 text-xs font-semibold text-slate-400 uppercase tracking-wider">IP Address</th>
                            <th class="px-6 py-4 text-xs font-semibold text-slate-400 uppercase tracking-wider text-center">Locked Account?</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-700/50">
                        @foreach (var activity in activities)
                        {
                            var bgClass = activity.SuspicionScore >= 80 ? "bg-red-500/5" : activity.SuspicionScore >= 60 ? "bg-yellow-500/5" : "";
                            <tr class="hover:bg-slate-800/40 transition-colors @bgClass">
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-medium bg-slate-700/50 text-slate-300">
                                        @activity.ActivityType
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-center">
                                    @{
                                        var scoreColor = activity.SuspicionScore >= 80 ? "red" : activity.SuspicionScore >= 60 ? "yellow" : "blue";
                                    }
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-@(scoreColor)-500/20 text-@(scoreColor)-400 border border-@(scoreColor)-500/30">
                                        @activity.SuspicionScore
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-sm text-slate-300 max-w-xs truncate" title="@activity.Reason">
                                    @activity.Reason
                                </td>
                                <td class="px-6 py-4 text-sm font-mono text-slate-400">
                                    @activity.IpAddress
                                </td>
                                <td class="px-6 py-4 text-center">
                                    @if (activity.ResultedInBlock)
                                    {
                                        <span class="inline-flex items-center px-2 py-1 rounded text-xs font-medium bg-red-500/20 text-red-400 border border-red-500/30">
                                            <i class="fas fa-lock mr-1.5"></i> Locked
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-xs text-slate-500 inline-flex items-center">
                                            <i class="fas fa-info-circle mr-1 text-slate-600"></i> Logged
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="glass-card rounded-xl p-8 text-center mb-6">
            <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-blue-500/20 flex items-center justify-center border border-blue-500/30">
                <i class="fas fa-shield-check text-3xl text-blue-400"></i>
            </div>
            <h3 class="text-lg font-bold text-white mb-2">No Suspicious Activities</h3>
            <p class="text-slate-400">No security incidents have been logged for this user.</p>
        </div>
    }

    <!-- Back Button -->
    <div class="flex justify-end">
        <a asp-action="LockedAccounts" class="inline-flex items-center px-6 py-3 bg-slate-700/50 text-slate-300 rounded-lg hover:bg-slate-700 transition-all font-medium border border-slate-600/50">
            <i class="fas fa-arrow-left mr-2"></i>
            Back to Locked Accounts
        </a>
    </div>
</div>