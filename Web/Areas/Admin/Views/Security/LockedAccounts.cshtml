@model IEnumerable<Domain.Entities.User.User>

@{
    var isRtl = System.Globalization.CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    ViewData["Title"] = Localizer["LockedAccounts"].Value;
}

<div class="animate-[fadeIn_0.4s_ease_forwards] w-full text-start" dir="@(isRtl ? "rtl" : "ltr")">
    <div class="mb-6">
        <nav class="flex items-center @(isRtl ? "space-x-reverse" : "space-x-2") text-xs font-semibold tracking-wide uppercase">
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="text-brand-cyan hover:text-white transition-colors">
                @Localizer["Dashboard"]
            </a>
            <i class="fas @(isRtl ? "fa-chevron-left" : "fa-chevron-right") text-slate-600 text-[10px]"></i>
            <span class="text-slate-400">@Localizer["SecurityAndLocks"]</span>
        </nav>
    </div>

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-10 @(isRtl ? "space-x-reverse" : "")">
        <div class="text-start">
            <h1 class="text-3xl font-extrabold bg-gradient-to-r from-brand-cyan to-brand-blue bg-clip-text text-transparent mb-2 tracking-wide flex items-center gap-3 @(isRtl ? "space-x-reverse" : "")">
                <i class="fas fa-user-shield text-rose-500 drop-shadow-[0_0_8px_rgba(244,63,94,0.4)]"></i>
                @Localizer["LockedAccountsControl"]
            </h1>
            <p class="text-slate-400 text-sm font-medium">@Localizer["LockedAccountsControlSub"]</p>
        </div>

        <div class="flex items-center @(isRtl ? "space-x-reverse text-start" : "space-x-3") bg-white/[0.01] border border-white/5 px-4 py-2.5 rounded-xl shadow-inner flex-shrink-0">
            <div class="w-9 h-9 rounded-xl bg-rose-500/10 border border-rose-500/20 flex items-center justify-center text-rose-400">
                <i class="fas fa-lock text-sm"></i>
            </div>
            <div>
                <p class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">@Localizer["TotalIsolated"]</p>
                <p class="text-lg font-black text-white font-mono leading-none mt-1">@Model.Count()</p>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="mb-6 p-4 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center @(isRtl ? "space-x-reverse" : "space-x-3") text-sm font-semibold shadow-[0_0_15px_rgba(16,185,129,0.1)]">
            <i class="fas fa-check-circle text-base"></i>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="mb-6 p-4 rounded-2xl bg-brand-orange/10 border border-brand-orange/20 text-brand-orange flex items-center @(isRtl ? "space-x-reverse" : "space-x-3") text-sm font-semibold shadow-[0_0_15px_rgba(255,126,66,0.1)]">
            <i class="fas fa-exclamation-circle text-base"></i>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    @if (Model.Any())
    {
        <div class="w-full overflow-x-auto custom-scrollbar">
            <table class="w-full text-start border-collapse">
                <thead>
                    <tr class="border-b border-white/5 text-slate-500 text-[10px] font-bold uppercase tracking-widest">
                        <th class="pb-3 px-4 font-bold text-start">@Localizer["IdentityNode"]</th>
                        <th class="pb-3 px-4 font-bold text-start">@Localizer["SuspensionTimestamp"]</th>
                        <th class="pb-3 px-4 font-bold text-start">@Localizer["SuspiciousMetric"]</th>
                        <th class="pb-3 px-4 font-bold text-start">@Localizer["ViolationReason"]</th>
                        <th class="pb-3 px-4 font-bold text-end">@Localizer["TerminalActions"]</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-white/[0.02]">
                    @foreach (var user in Model)
                    {
                        var lockedDuration = user.LockedAt.HasValue ? (DateTime.UtcNow - user.LockedAt.Value).TotalHours : 0;
                        var willAutoUnlock = lockedDuration < 24;
                        var hoursRemaining = willAutoUnlock ? (24 - lockedDuration) : 0;

                        <tr class="hover:bg-white/[0.01] transition-colors group">
                            <td class="py-4 px-4 whitespace-nowrap">
                                <div class="flex items-center @(isRtl ? "space-x-reverse" : "space-x-3")">
                                    <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-brand-orange to-brand-yellow flex items-center justify-center text-dark-bg font-black text-sm flex-shrink-0 shadow-[0_0_10px_rgba(255,126,66,0.2)]">
                                        @user.UserName.Substring(0, 1).ToUpper()
                                    </div>
                                    <div class="text-start">
                                        <p class="text-white text-xs font-bold group-hover:text-brand-cyan transition-colors">@user.UserName</p>
                                        <p class="text-[10px] text-slate-400 font-medium mt-0.5">
                                            @(string.IsNullOrEmpty(user.FirstName) && string.IsNullOrEmpty(user.LastName)
                                                ? Localizer["IdentityNameUnmapped"].Value
                                                : $"{user.FirstName} {user.LastName}")
                                        </p>
                                        <p class="text-[9px] text-slate-600 font-mono font-bold mt-0.5">UID: #@user.UserId</p>
                                    </div>
                                </div>
                            </td>

                            <td class="py-4 px-4 whitespace-nowrap text-start">
                                @if (user.LockedAt.HasValue)
                                {
                                    <div class="space-y-1 font-medium text-xs">
                                        <p class="text-slate-300 font-mono flex items-center gap-1.5" dir="ltr">
                                            <i class="far fa-calendar text-rose-400 text-[10px]"></i>
                                            @user.LockedAt.Value.ToString("yyyy/MM/dd HH:mm")
                                        </p>
                                        <p class="text-[10px] text-slate-400 font-semibold flex items-center gap-1.5">
                                            <i class="far fa-clock text-slate-600"></i>
                                            @if (lockedDuration < 1)
                                            {
                                                <span>@((int)(lockedDuration * 60)) @(isRtl ? "دقائق مضت" : "minutes ago")</span>
                                            }
                                            else if (lockedDuration < 24)
                                            {
                                                <span>@((int)lockedDuration) @(isRtl ? "ساعات مضت" : "hours ago")</span>
                                            }
                                            else
                                            {
                                                <span>@((int)(lockedDuration / 24)) @(isRtl ? "أيام مضت" : "days ago")</span>
                                            }
                                        </p>
                                        @if (willAutoUnlock)
                                        {
                                            <p class="text-[10px] font-bold text-brand-yellow flex items-center gap-1.5">
                                                <i class="fas fa-unlock text-[9px] drop-shadow-[0_0_6px_rgba(225,215,136,0.3)]"></i>
                                                @(isRtl ? $"فتح تلقائي في ~{(int)hoursRemaining} س" : $"Auto-unlock in ~{(int)hoursRemaining}h")
                                            </p>
                                        }
                                    </div>
                                }
                            </td>

                            <td class="py-4 px-4 whitespace-nowrap text-start">
                                <div class="inline-flex items-center px-2.5 py-1 rounded-lg text-[10px] font-bold font-mono bg-rose-500/10 text-rose-400 border border-rose-500/10 uppercase tracking-wide">
                                    <i class="fas fa-triangle-exclamation @(isRtl ? "ml-1.5" : "mr-1.5") text-[9px]"></i>
                                    @user.SuspiciousActivityCount @Localizer["Overbounds"]
                                </div>
                            </td>

                            <td class="py-4 px-4 max-w-xs truncate text-slate-400 text-xs font-medium text-start" title="@user.LockReason">
                                @(string.IsNullOrWhiteSpace(user.LockReason) ? "No reason specified." : user.LockReason)
                            </td>

                            <td class="py-4 px-4 text-end whitespace-nowrap">
                                <a asp-action="UserDetails" asp-route-userId="@user.UserId"
                                   class="inline-flex items-center px-3.5 py-1.5 bg-brand-blue/10 text-brand-blue border border-brand-blue/10 rounded-xl hover:bg-brand-blue hover:text-white transition-all text-xs font-bold shadow-sm">
                                    <i class="fas fa-eye @(isRtl ? "ml-1.5" : "mr-1.5") text-[10px]"></i> @Localizer["InspectDetails"]
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="p-16 text-center max-w-xl mx-auto border border-dashed border-white/5 rounded-3xl mt-6 relative overflow-hidden">
            <div class="w-16 h-16 mx-auto rounded-full bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center mb-4 shadow-[inset_0_0_15px_rgba(16,185,129,0.1)]">
                <i class="fas fa-shield-halved text-2xl text-emerald-400 drop-shadow-[0_0_8px_#10B981]"></i>
            </div>
            <h3 class="text-xl font-bold text-white mb-1">@Localizer["AllClearMatrix"]</h3>
            <p class="text-slate-500 text-xs font-medium max-w-xs mx-auto leading-relaxed mb-6">@Localizer["NoLockedAccountsSub"]</p>
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
               class="inline-flex items-center px-5 py-2 bg-white/5 border border-white/5 text-slate-300 rounded-xl hover:bg-white/10 text-xs font-bold transition-all">
                <i class="fas @(isRtl ? "fa-arrow-right ml-1.5" : "fa-arrow-left mr-1.5") text-[10px]"></i> @Localizer["ReturnToDashboard"]
            </a>
        </div>
    }

    <div class="pt-8 mt-4 border-t border-white/5 text-start">
        <div class="flex items-start @(isRtl ? "space-x-reverse" : "space-x-4") bg-brand-blue/5 p-5 rounded-2xl border border-brand-blue/10 backdrop-blur-xl">
            <div class="w-11 h-11 rounded-xl bg-brand-blue/10 border border-brand-blue/20 flex items-center justify-center flex-shrink-0 text-brand-blue">
                <i class="fas fa-info-circle text-base shadow-[0_0_8px_#4272FF] rounded-full"></i>
            </div>
            <div class="flex-1">
                <h4 class="text-white text-xs font-bold uppercase tracking-wider mb-1">@Localizer["AutoUnlockProtocolFramework"]</h4>
                <p class="text-slate-400 text-xs font-medium leading-relaxed">
                    @Localizer["AutoUnlockProtocolFrameworkSub"]
                </p>
            </div>
        </div>
    </div>
</div>