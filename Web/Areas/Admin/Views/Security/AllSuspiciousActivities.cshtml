@model IEnumerable<Domain.Entities.Security.SuspiciousActivity>

@{
    ViewData["Title"] = "Suspicious Activities";

    // Statistical calculations for monitoring dashboard
    var totalActivities = Model?.Count() ?? 0;
    var criticalActivities = Model?.Count(a => a.SuspicionScore >= 80) ?? 0;
    var warningActivities = Model?.Count(a => a.SuspicionScore >= 60 && a.SuspicionScore < 80) ?? 0;
    var pendingReviews = Model?.Count(a => !a.ReviewedByAdmin) ?? 0;
}

<div class="animate-[fadeIn_0.4s_ease_forwards] w-full" dir="ltr">
    <div class="mb-6">
        <nav class="flex items-center space-x-2 text-xs font-semibold tracking-wide uppercase">
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="text-brand-cyan hover:text-white transition-colors">Dashboard</a>
            <i class="fas fa-chevron-right text-slate-600 text-[10px]"></i>
            <a asp-action="LockedAccounts" class="text-brand-cyan hover:text-white transition-colors">Security</a>
            <i class="fas fa-chevron-right text-slate-600 text-[10px]"></i>
            <span class="text-slate-400">Suspicious Activities</span>
        </nav>
    </div>

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-10">
        <div>
            <h1 class="text-3xl font-extrabold bg-gradient-to-r from-brand-cyan to-brand-blue bg-clip-text text-transparent mb-2 tracking-wide flex items-center gap-3">
                <i class="fas fa-shield-halved text-rose-500 animate-pulse drop-shadow-[0_0_8px_rgba(244,63,94,0.4)]"></i>
                Security Activity Monitoring
            </h1>
            <p class="text-slate-400 text-sm font-medium">Monitor and review security alerts and suspicious user activities across the system.</p>
        </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
        <div class="relative p-5 rounded-3xl bg-white/[0.02] border border-white/[0.05] hover:border-brand-blue/30 transition-all duration-300 hover:-translate-y-1 group overflow-hidden">
            <div class="absolute -right-6 -top-6 w-24 h-24 bg-brand-blue/10 rounded-full blur-2xl group-hover:bg-brand-blue/20 transition-all"></div>
            <div class="flex items-center justify-between relative z-10">
                <div>
                    <p class="text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1">Total Activities</p>
                    <p class="text-2xl font-extrabold text-white font-mono">@totalActivities</p>
                </div>
                <div class="w-11 h-11 rounded-2xl bg-brand-blue/10 border border-brand-blue/20 flex items-center justify-center text-brand-blue text-lg shadow-[inset_0_0_12px_rgba(66,114,255,0.1)]">
                    <i class="fas fa-list-check"></i>
                </div>
            </div>
        </div>

        <div class="relative p-5 rounded-3xl bg-white/[0.02] border border-white/[0.05] hover:border-rose-500/30 transition-all duration-300 hover:-translate-y-1 group overflow-hidden">
            <div class="absolute -right-6 -top-6 w-24 h-24 bg-rose-500/10 rounded-full blur-2xl group-hover:bg-rose-500/20 transition-all"></div>
            <div class="flex items-center justify-between relative z-10">
                <div>
                    <p class="text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1">High Risk (Auto-Lock)</p>
                    <p class="text-2xl font-extrabold text-rose-400 font-mono">@criticalActivities</p>
                </div>
                <div class="w-11 h-11 rounded-2xl bg-rose-500/10 border border-rose-500/20 flex items-center justify-center text-rose-400 text-lg shadow-[inset_0_0_12px_rgba(244,63,94,0.1)]">
                    <i class="fas fa-exclamation-triangle text-xl"></i>
                </div>
            </div>
        </div>

        <div class="relative p-5 rounded-3xl bg-white/[0.02] border border-white/[0.05] hover:border-brand-yellow/30 transition-all duration-300 hover:-translate-y-1 group overflow-hidden">
            <div class="absolute -right-6 -top-6 w-24 h-24 bg-brand-yellow/10 rounded-full blur-2xl group-hover:bg-brand-yellow/20 transition-all"></div>
            <div class="flex items-center justify-between relative z-10">
                <div>
                    <p class="text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1">Medium Risk</p>
                    <p class="text-2xl font-extrabold text-brand-yellow font-mono">@warningActivities</p>
                </div>
                <div class="w-11 h-11 rounded-2xl bg-brand-yellow/10 border border-brand-yellow/20 flex items-center justify-center text-brand-yellow text-lg shadow-[inset_0_0_12px_rgba(255,179,67,0.1)]">
                    <i class="fas fa-shield-alt text-xl"></i>
                </div>
            </div>
        </div>

        <div class="relative p-5 rounded-3xl bg-white/[0.02] border border-white/[0.05] hover:border-brand-purple/30 transition-all duration-300 hover:-translate-y-1 group overflow-hidden">
            <div class="absolute -right-6 -top-6 w-24 h-24 bg-brand-cyan/10 rounded-full blur-2xl group-hover:bg-brand-cyan/20 transition-all"></div>
            <div class="flex items-center justify-between relative z-10">
                <div>
                    <p class="text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1">Pending Review</p>
                    <p class="text-2xl font-extrabold text-brand-cyan font-mono">@pendingReviews</p>
                </div>
                <div class="w-11 h-11 rounded-2xl bg-brand-cyan/10 border border-brand-cyan/20 flex items-center justify-center text-brand-cyan text-lg shadow-[inset_0_0_12px_rgba(66,234,255,0.1)]">
                    <i class="fas fa-clipboard-check text-xl"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="mb-8 flex items-start gap-4 bg-brand-blue/5 p-5 rounded-2xl border border-brand-blue/10 backdrop-blur-xl shadow-md">
        <i class="fas fa-info-circle text-brand-blue text-lg mt-0.5 drop-shadow-[0_0_6px_#4272FF]"></i>
        <div class="text-xs text-slate-400 leading-relaxed font-medium">
            <strong class="text-white">Security Notice:</strong> The system logs suspicious actions such as video download attempts, frequent IP changes, or unusual browser headers. Repeated violations that exceed the limit will automatically lock the user account.
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="w-full overflow-x-auto custom-scrollbar">
            <table class="w-full text-left border-collapse text-sm">
                <thead>
                    <tr class="border-b border-white/5 text-slate-500 text-[10px] font-bold uppercase tracking-widest bg-white/[0.01]">
                        <th class="py-4 px-3 font-bold w-20">ID</th>
                        <th class="py-4 px-3 font-bold">User</th>
                        <th class="py-4 px-3 font-bold">Activity Type</th>
                        <th class="py-4 px-3 font-bold text-center w-20">Risk Score</th>
                        <th class="py-4 px-3 font-bold">Reason</th>
                        <th class="py-4 px-3 font-bold">IP Address</th>
                        <th class="py-4 px-3 font-bold">Date</th>
                        <th class="py-4 px-3 font-bold text-center">Status</th>
                        <th class="py-4 px-3 font-bold text-center">Review</th>
                        <th class="py-4 px-3 font-bold text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-white/[0.02]">
                    @foreach (var activity in Model)
                    {
                        var rowBg = activity.SuspicionScore >= 80 ? "bg-rose-500/[0.02] hover:bg-rose-500/[0.05]" :
                                    activity.SuspicionScore >= 60 ? "bg-brand-yellow/[0.02] hover:bg-brand-yellow/[0.05]" : "hover:bg-white/[0.01]";

                        var scoreBadge = activity.SuspicionScore >= 80 ? "bg-rose-500/10 text-rose-400 border-rose-500/10" :
                                         activity.SuspicionScore >= 60 ? "bg-brand-yellow/10 text-brand-yellow border-brand-yellow/10" : "bg-brand-blue/10 text-brand-blue border-brand-blue/10";

                        <tr class="transition-colors duration-200 group @rowBg">
                            <td class="py-4 px-3 font-mono text-xs text-slate-500">#@activity.Id</td>

                            <td class="py-4 px-3 whitespace-nowrap">
                                <span class="inline-flex items-center gap-1.5 text-xs font-bold text-slate-300">
                                    <i class="fas fa-user text-slate-500 text-[10px]"></i>
                                    User: <span class="text-white font-mono">#@activity.UserId</span>
                                </span>
                            </td>

                            <td class="py-4 px-3 whitespace-nowrap">
                                <span class="px-2 py-0.5 rounded text-[10px] font-bold font-mono bg-dark-bg/60 text-slate-400 border border-white/5">
                                    @activity.ActivityType
                                </span>
                            </td>

                            <td class="py-4 px-3 text-center">
                                <span class="inline-block px-2.5 py-0.5 rounded-lg text-xs font-black font-mono border @scoreBadge shadow-sm">
                                    @activity.SuspicionScore
                                </span>
                            </td>

                            <td class="py-4 px-3 text-slate-300 max-w-xs truncate text-xs font-medium" title="@activity.Reason">
                                @activity.Reason
                            </td>

                            <td class="py-4 px-3 font-mono text-xs text-slate-400 whitespace-nowrap" dir="ltr">
                                @activity.IpAddress
                            </td>

                            <td class="py-4 px-3 text-slate-400 text-xs font-mono whitespace-nowrap">
                                @activity.DetectedAt.ToString("yyyy-MM-dd HH:mm")
                            </td>

                            <td class="py-4 px-3 text-center whitespace-nowrap">
                                @if (activity.ResultedInBlock)
                                {
                                    <span class="inline-flex items-center text-[10px] text-rose-400 font-bold bg-rose-400/10 px-2 py-0.5 rounded-lg border border-rose-500/20 uppercase tracking-wide">
                                        <i class="fas fa-lock mr-1.5 text-[9px] drop-shadow-[0_0_6px_#f43f5e]"></i> Account Locked
                                    </span>
                                }
                                else
                                {
                                    <span class="text-xs text-slate-500 font-semibold">Logged</span>
                                }
                            </td>

                            <td class="py-4 px-3 text-center whitespace-nowrap">
                                @if (activity.ReviewedByAdmin)
                                {
                                    <span class="text-emerald-400 text-xs font-bold inline-flex items-center gap-1" title="Reviewed by admin ID: @activity.ReviewedByAdminId">
                                        <i class="fas fa-check-circle"></i> Reviewed
                                    </span>
                                }
                                else
                                {
                                    <span class="text-slate-500 text-xs font-semibold inline-flex items-center gap-1">
                                        <i class="far fa-circle"></i> Pending
                                    </span>
                                }
                            </td>

                            <td class="py-4 px-3 text-right whitespace-nowrap">
                                <div class="inline-flex items-center gap-1.5" dir="ltr">
                                    <button type="button" class="details-btn w-8 h-8 bg-brand-blue/10 text-brand-blue rounded-lg hover:bg-brand-blue hover:text-white border border-brand-blue/10 transition-all text-xs flex items-center justify-center"
                                            data-details='@activity.AdditionalData' title="View Details">
                                        <i class="fas fa-code"></i>
                                    </button>

                                    @if (!activity.ReviewedByAdmin)
                                    {
                                        <button type="button" class="review-btn w-8 h-8 bg-brand-cyan/10 text-brand-cyan rounded-lg hover:bg-brand-cyan hover:text-dark-bg border border-brand-cyan/10 transition-all text-xs flex items-center justify-center"
                                                data-activity-id="@activity.Id" title="Review Activity">
                                            <i class="fas fa-clipboard-check"></i>
                                        </button>
                                    }

                                    <a asp-action="UserDetails" asp-route-userId="@activity.UserId"
                                       class="w-8 h-8 bg-white/5 text-slate-400 rounded-lg hover:bg-white/10 hover:text-white border border-white/5 transition-all text-xs flex items-center justify-center" title="User Security Profile">
                                        <i class="fas fa-user-shield"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="p-16 text-center max-w-xl mx-auto border border-dashed border-white/5 rounded-3xl mt-6 relative overflow-hidden">
            <div class="w-16 h-16 mx-auto rounded-full bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center mb-4 shadow-[inset_0_0_15px_rgba(16,185,129,0.1)]">
                <i class="fas fa-shield text-2xl text-emerald-400 drop-shadow-[0_0_8px_#10B981]"></i>
            </div>
            <h3 class="text-xl font-bold text-white mb-2">No Suspicious Activities</h3>
            <p class="text-slate-500 text-xs max-w-sm mx-auto leading-relaxed">No suspicious security activities or violations have been recorded.</p>
        </div>
    }
</div>

<div id="detailsModal" class="hidden fixed inset-0 bg-dark-bg/80 backdrop-blur-md z-50 items-center justify-center p-4">
    <div class="bg-[#0B0D14]/90 border border-white/10 rounded-3xl shadow-2xl max-w-2xl w-full max-h-[85vh] overflow-hidden animate-[fadeIn_0.3s_ease]">
        <div class="px-6 py-4 border-b border-white/5 flex items-center justify-between bg-white/[0.01]">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl bg-brand-blue/10 flex items-center justify-center text-brand-blue border border-brand-blue/20">
                    <i class="fas fa-info-circle"></i>
                </div>
                <div>
                    <h3 class="text-sm font-bold text-white uppercase tracking-wider">Activity Details</h3>
                    <p class="text-[11px] text-slate-500 font-medium">Request headers and technical parameters</p>
                </div>
            </div>
            <button type="button" class="close-modal text-slate-400 hover:text-white transition-colors">
                <i class="fas fa-times text-base"></i>
            </button>
        </div>
        <div class="p-6 overflow-y-auto max-h-[calc(85vh-100px)] custom-scrollbar">
            <pre id="detailsContent" class="bg-dark-bg/50 text-emerald-400 p-4 rounded-2xl overflow-x-auto text-xs font-mono text-left select-all custom-scrollbar" dir="ltr"></pre>
        </div>
    </div>
</div>

<div id="reviewModal" class="hidden fixed inset-0 bg-dark-bg/80 backdrop-blur-md z-50 items-center justify-center p-4">
    <div class="bg-[#0B0D14]/95 border border-white/10 rounded-3xl shadow-2xl max-w-md w-full overflow-hidden animate-[fadeIn_0.3s_ease]">
        <div class="px-6 py-4 border-b border-white/5 flex items-center justify-between bg-white/[0.01]">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl bg-brand-cyan/10 flex items-center justify-center text-brand-cyan border border-brand-cyan/20">
                    <i class="fas fa-comment-dots"></i>
                </div>
                <div>
                    <h3 class="text-sm font-bold text-white uppercase tracking-wider">Review Activity</h3>
                    <p class="text-[11px] text-slate-500 font-medium">Add review notes to resolve this security item</p>
                </div>
            </div>
            <button type="button" class="close-modal text-slate-400 hover:text-white transition-colors">
                <i class="fas fa-times text-base"></i>
            </button>
        </div>
        <div class="p-6 space-y-5">
            <input type="hidden" id="reviewActivityId" />
            <div class="space-y-2">
                <label class="block text-xs font-bold text-slate-400 uppercase tracking-wide">Admin Notes:</label>
                <div class="border-b border-white/10 focus-within:border-brand-cyan/80 transition-colors">
                    <textarea id="reviewNotes" rows="3" class="w-full bg-transparent py-2.5 text-white text-sm placeholder-slate-600 focus:outline-none resize-none leading-relaxed"
                              placeholder="e.g., Checked with user / False alarm / Resolved..."></textarea>
                </div>
            </div>

            <div class="flex items-center justify-end gap-3 pt-2">
                <button type="button" class="close-modal px-4 py-2 bg-white/5 text-slate-400 hover:text-white rounded-xl text-xs font-bold transition-all">
                    Cancel
                </button>
                <button type="button" id="submitReview" class="px-5 py-2.5 bg-gradient-to-r from-brand-cyan to-brand-blue text-dark-bg rounded-xl hover:shadow-[0_0_15px_rgba(66,234,255,0.3)] text-xs font-black transition-all">
                    <i class="fas fa-check mr-1.5 text-xs"></i> Save Review
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openModal(modalId) {
            const m = document.getElementById(modalId);
            m.classList.remove('hidden');
            m.classList.add('flex');
            document.body.style.overflow = 'hidden';
        }

        function closeModal(modalId) {
            const m = document.getElementById(modalId);
            m.classList.add('hidden');
            m.classList.remove('flex');
            document.body.style.overflow = 'auto';
        }

        document.querySelectorAll('#detailsModal, #reviewModal').forEach(modal => {
            modal.addEventListener('click', function(e) {
                if (e.target === this) closeModal(this.id);
            });
        });

        document.querySelectorAll('.close-modal').forEach(btn => {
            btn.addEventListener('click', function() {
                const modal = this.closest('[id$="Modal"]');
                closeModal(modal.id);
            });
        });

        document.querySelectorAll('.details-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const details = this.getAttribute('data-details');
                const contentArea = document.getElementById('detailsContent');
                try {
                    const parsed = JSON.parse(details);
                    contentArea.textContent = JSON.stringify(parsed, null, 4);
                } catch {
                    contentArea.textContent = details || 'No additional details available for this activity.';
                }
                openModal('detailsModal');
            });
        });

        document.querySelectorAll('.review-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const activityId = this.getAttribute('data-activity-id');
                document.getElementById('reviewActivityId').value = activityId;
                document.getElementById('reviewNotes').value = '';
                openModal('reviewModal');
            });
        });

        document.getElementById('submitReview').addEventListener('click', function() {
            const activityId = document.getElementById('reviewActivityId').value;
            const notes = document.getElementById('reviewNotes').value;

            if (!notes.trim()) {
                showNotification('Please enter review notes.', 'error');
                return;
            }

            this.disabled = true;
            this.innerHTML = '<i class="fas fa-spinner fa-spin mr-1.5"></i>Saving...';

            fetch('@Url.Action("ReviewActivity", "Security", new { area = "Admin" })', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: `activityId=${activityId}&adminNotes=${encodeURIComponent(notes)}`
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    showNotification('Activity reviewed successfully.', 'success');
                    setTimeout(() => location.reload(), 1200);
                } else {
                    showNotification('Error saving review.', 'error');
                    this.disabled = false;
                    this.innerHTML = '<i class="fas fa-check mr-1.5"></i>Save Review';
                }
            })
            .catch(error => {
                console.error('Error:', error);
                showNotification('Network error occurred.', 'error');
                this.disabled = false;
                this.innerHTML = '<i class="fas fa-check mr-1.5"></i>Save Review';
            });
        });

        function showNotification(message, type) {
            const colors = {
                success: 'bg-emerald-500/10 border-emerald-500/20 text-emerald-400',
                error: 'bg-brand-orange/10 border-brand-orange/20 text-brand-orange'
            };
            const icons = {
                success: 'fa-check-circle',
                error: 'fa-exclamation-circle'
            };

            const notification = document.createElement('div');
            notification.className = `fixed top-4 left-4 z-50 p-4 rounded-2xl border flex items-center gap-3 shadow-2xl backdrop-blur-xl animate-[fadeIn_0.3s_ease] ${colors[type]}`;
            notification.innerHTML = `<i class="fas ${icons[type]} text-lg"></i><span class="text-xs font-bold">${message}</span>`;
            document.body.appendChild(notification);

            setTimeout(() => {
                notification.style.opacity = '0';
                notification.style.transition = 'opacity 0.3s ease';
                setTimeout(() => notification.remove(), 300);
            }, 3000);
        }

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                document.querySelectorAll('[id$="Modal"]:not(.hidden)').forEach(modal => {
                    closeModal(modal.id);
                });
            }
        });
    </script>
}