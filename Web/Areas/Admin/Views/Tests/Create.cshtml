@{
    var isRtl = System.Globalization.CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    ViewData["Title"] = "Create Mock Test / Upload PDF";
    var courses = ViewBag.Courses as List<Domain.Entities.Course.Course> ?? new List<Domain.Entities.Course.Course>();
}

<div class="animate-[fadeIn_0.4s_ease_forwards] w-full text-start max-w-5xl mx-auto" dir="@(isRtl ? "rtl" : "ltr")">
    <!-- Header -->
    <div class="flex items-center justify-between mb-8">
        <div>
            <div class="flex items-center gap-3">
                <a asp-area="Admin" asp-controller="Tests" asp-action="Index" class="w-9 h-9 rounded-xl bg-white/5 hover:bg-white/10 text-slate-400 hover:text-white flex items-center justify-center transition-colors">
                    <i class="fas @(isRtl ? "fa-arrow-right" : "fa-arrow-left")"></i>
                </a>
                <h1 class="text-3xl font-extrabold bg-gradient-to-r from-brand-cyan to-brand-blue bg-clip-text text-transparent tracking-wide">
                    Create Mock Test
                </h1>
            </div>
            <p class="text-slate-400 text-sm font-medium mt-1">Upload a PDF or paste question text to automatically extract MCQs, options, and answer keys.</p>
        </div>
    </div>

    <!-- Step 1: Exam Settings -->
    <div class="p-6 rounded-3xl bg-white/[0.02] border border-white/[0.05] mb-8 shadow-xl">
        <h2 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
            <span class="w-7 h-7 rounded-lg bg-brand-cyan/20 text-brand-cyan flex items-center justify-center text-xs font-mono font-bold">1</span>
            Test Configuration
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="md:col-span-2">
                <label class="block text-xs uppercase font-bold text-slate-400 mb-2">Test Title *</label>
                <input type="text" id="examTitle" class="w-full px-4 py-3 rounded-xl bg-dark-bg/60 border border-white/10 text-white placeholder-slate-500 focus:outline-none focus:border-brand-cyan focus:ring-1 focus:ring-brand-cyan transition-all text-sm" placeholder="e.g. Clinical Pharmacology Mock Exam - Part 1" required />
            </div>

            <div class="md:col-span-2">
                <label class="block text-xs uppercase font-bold text-slate-400 mb-2">Description / Instructions</label>
                <textarea id="examDescription" rows="2" class="w-full px-4 py-3 rounded-xl bg-dark-bg/60 border border-white/10 text-white placeholder-slate-500 focus:outline-none focus:border-brand-cyan focus:ring-1 focus:ring-brand-cyan transition-all text-sm" placeholder="Brief directions or overview for the students..."></textarea>
            </div>

            <div>
                <label class="block text-xs uppercase font-bold text-slate-400 mb-2">Associated Course (Optional)</label>
                <select id="examCourseId" class="w-full px-4 py-3 rounded-xl bg-dark-bg/60 border border-white/10 text-white focus:outline-none focus:border-brand-cyan focus:ring-1 focus:ring-brand-cyan transition-all text-sm">
                    <option value="">-- General Mock Test (No Course Link) --</option>
                    @foreach (var c in courses)
                    {
                        <option value="@c.CourseId">@c.Title</option>
                    }
                </select>
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs uppercase font-bold text-slate-400 mb-2">Duration (Minutes, 0 = no limit)</label>
                    <input type="number" id="examDuration" value="30" min="0" max="1440" class="w-full px-4 py-3 rounded-xl bg-dark-bg/60 border border-white/10 text-white focus:outline-none focus:border-brand-cyan focus:ring-1 focus:ring-brand-cyan transition-all text-sm" />
                </div>
                <div>
                    <label class="block text-xs uppercase font-bold text-slate-400 mb-2">Passing Score (%)</label>
                    <input type="number" id="examPassingScore" value="70" min="1" max="100" class="w-full px-4 py-3 rounded-xl bg-dark-bg/60 border border-white/10 text-white focus:outline-none focus:border-brand-cyan focus:ring-1 focus:ring-brand-cyan transition-all text-sm" />
                </div>
            </div>

            <div class="md:col-span-2 flex flex-wrap gap-6 pt-2">
                <label class="inline-flex items-center gap-2 cursor-pointer">
                    <input type="checkbox" id="examShuffleQuestions" class="w-4 h-4 rounded bg-dark-bg border-white/20 text-brand-cyan focus:ring-brand-cyan" />
                    <span class="text-sm text-slate-300">Shuffle Questions order per attempt</span>
                </label>
                <label class="inline-flex items-center gap-2 cursor-pointer">
                    <input type="checkbox" id="examShuffleOptions" class="w-4 h-4 rounded bg-dark-bg border-white/20 text-brand-cyan focus:ring-brand-cyan" />
                    <span class="text-sm text-slate-300">Shuffle Multiple Choice Options (A, B, C, D)</span>
                </label>
            </div>
        </div>
    </div>

    <!-- Step 2: Automated Parser (PDF / Raw Text) -->
    <div class="p-6 rounded-3xl bg-white/[0.02] border border-white/[0.05] mb-8 shadow-xl">
        <h2 class="text-lg font-bold text-white mb-2 flex items-center gap-2">
            <span class="w-7 h-7 rounded-lg bg-brand-cyan/20 text-brand-cyan flex items-center justify-center text-xs font-mono font-bold">2</span>
            Automated PDF &amp; MCQ Recognition Engine
        </h2>
        <p class="text-xs text-slate-400 mb-4">Upload an English exam PDF (digital or clean scan) or paste raw text. The recognition engine extracts question numbers, 4-choice MCQs, and detected answer keys.</p>

        <!-- Tabs -->
        <div class="flex gap-2 border-b border-white/10 pb-3 mb-4">
            <button type="button" id="tabPdfBtn" onclick="switchParserTab('pdf')" class="px-4 py-2 rounded-xl text-xs font-bold transition-all bg-brand-cyan/20 text-brand-cyan border border-brand-cyan/30">
                <i class="fas fa-file-pdf mr-1.5"></i> PDF File Upload
            </button>
            <button type="button" id="tabTextBtn" onclick="switchParserTab('text')" class="px-4 py-2 rounded-xl text-xs font-bold transition-all text-slate-400 hover:text-white hover:bg-white/5 border border-transparent">
                <i class="fas fa-align-left mr-1.5"></i> Paste Raw Exam Text
            </button>
        </div>

        <!-- PDF Upload Tab Pane -->
        <div id="pdfUploadPane" class="space-y-4">
            <div id="dropZone" class="border-2 border-dashed border-white/15 hover:border-brand-cyan/50 rounded-2xl p-8 text-center bg-white/[0.01] hover:bg-white/[0.02] transition-all cursor-pointer">
                <input type="file" id="pdfFileInput" accept=".pdf" class="hidden" />
                <div class="w-14 h-14 mx-auto mb-3 rounded-2xl bg-brand-cyan/10 flex items-center justify-center border border-brand-cyan/20 text-brand-cyan text-2xl">
                    <i class="fas fa-cloud-arrow-up"></i>
                </div>
                <p class="text-white font-bold text-sm mb-1">Click to browse or drag &amp; drop exam PDF here</p>
                <p class="text-xs text-slate-400" id="selectedFileName">Supports digital English PDFs with standard MCQ formatting (Q1, 1., A., B., C., D.)</p>
            </div>
        </div>

        <!-- Raw Text Tab Pane -->
        <div id="rawTextPane" class="space-y-4 hidden">
            <textarea id="rawTextInput" rows="8" class="w-full px-4 py-3 rounded-xl bg-dark-bg/60 border border-white/10 text-white placeholder-slate-500 font-mono text-xs focus:outline-none focus:border-brand-cyan transition-all" placeholder="1. What is the mechanism of action of Aspirin?&#10;A) Irreversible inhibition of COX-1 and COX-2&#10;B) Reversible inhibition of COX-2 only&#10;C) Beta-1 adrenergic blocker&#10;D) H1 receptor antagonist&#10;Answer: A&#10;&#10;2. Which antibiotic inhibits bacterial cell wall synthesis?&#10;A) Amoxicillin&#10;B) Ciprofloxacin&#10;C) Gentamicin&#10;D) Azithromycin&#10;Answer: A"></textarea>
        </div>

        <div class="mt-5 flex items-center justify-between">
            <span id="parseStatus" class="text-xs font-medium text-slate-400"></span>
            <button type="button" id="parseBtn" onclick="runParser()" class="px-6 py-2.5 bg-gradient-to-r from-brand-cyan to-brand-blue rounded-xl text-dark-bg font-extrabold hover:shadow-[0_0_20px_rgba(66,234,255,0.4)] transition-all text-xs flex items-center gap-2">
                <i class="fas fa-bolt"></i>
                <span>⚡ Parse Questions &amp; Answers</span>
            </button>
        </div>
    </div>

    <!-- Step 3: Question Editor & Live Preview -->
    <div class="p-6 rounded-3xl bg-white/[0.02] border border-white/[0.05] mb-8 shadow-xl">
        <div class="flex items-center justify-between mb-4">
            <h2 class="text-lg font-bold text-white flex items-center gap-2">
                <span class="w-7 h-7 rounded-lg bg-brand-cyan/20 text-brand-cyan flex items-center justify-center text-xs font-mono font-bold">3</span>
                Questions &amp; MCQs Preview (<span id="questionCountBadge" class="text-brand-cyan">0</span>)
            </h2>
            <button type="button" onclick="addNewBlankQuestion()" class="px-3 py-1.5 rounded-lg bg-white/5 hover:bg-white/10 text-xs font-bold text-slate-300 hover:text-white border border-white/10 transition-colors flex items-center gap-1.5">
                <i class="fas fa-plus text-brand-cyan"></i>
                Add Question
            </button>
        </div>

        <!-- Question Cards Container -->
        <div id="questionsContainer" class="space-y-4">
            <div id="emptyQuestionsPrompt" class="p-8 text-center text-slate-500 text-sm border border-white/5 rounded-2xl bg-white/[0.01]">
                <i class="fas fa-arrow-up block text-xl mb-2 text-brand-cyan/50"></i>
                Upload an exam PDF above or click "Add Question" to start building your test.
            </div>
        </div>
    </div>

    <!-- Save Actions Bar -->
    <div class="sticky bottom-6 p-4 rounded-2xl glass-panel border border-brand-cyan/20 flex items-center justify-between shadow-2xl backdrop-blur-xl bg-dark-bg/80">
        <div class="text-xs text-slate-400">
            Ensure at least 1 question is configured and correct answers are highlighted in green.
        </div>
        <div class="flex items-center gap-3">
            <a asp-area="Admin" asp-controller="Tests" asp-action="Index" class="px-5 py-2.5 rounded-xl bg-white/5 hover:bg-white/10 text-slate-300 font-bold text-sm transition-colors">
                Cancel
            </a>
            <button type="button" id="saveExamBtn" onclick="saveExam()" class="px-7 py-2.5 rounded-xl bg-gradient-to-r from-brand-cyan to-brand-blue text-dark-bg font-extrabold text-sm hover:shadow-[0_0_25px_rgba(66,234,255,0.5)] hover:scale-[1.02] transition-all flex items-center gap-2">
                <i class="fas fa-floppy-disk"></i>
                <span>Save &amp; Publish Test</span>
            </button>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        let currentTab = 'pdf';
        let parsedQuestions = [];

        function antiForgeryToken() {
            return document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        }

        function switchParserTab(tab) {
            currentTab = tab;
            const pdfBtn = document.getElementById('tabPdfBtn');
            const textBtn = document.getElementById('tabTextBtn');
            const pdfPane = document.getElementById('pdfUploadPane');
            const textPane = document.getElementById('rawTextPane');

            if (tab === 'pdf') {
                pdfBtn.className = "px-4 py-2 rounded-xl text-xs font-bold transition-all bg-brand-cyan/20 text-brand-cyan border border-brand-cyan/30";
                textBtn.className = "px-4 py-2 rounded-xl text-xs font-bold transition-all text-slate-400 hover:text-white hover:bg-white/5 border border-transparent";
                pdfPane.classList.remove('hidden');
                textPane.classList.add('hidden');
            } else {
                textBtn.className = "px-4 py-2 rounded-xl text-xs font-bold transition-all bg-brand-cyan/20 text-brand-cyan border border-brand-cyan/30";
                pdfBtn.className = "px-4 py-2 rounded-xl text-xs font-bold transition-all text-slate-400 hover:text-white hover:bg-white/5 border border-transparent";
                textPane.classList.remove('hidden');
                pdfPane.classList.add('hidden');
            }
        }

        // Setup Drag & Drop
        const dropZone = document.getElementById('dropZone');
        const pdfFileInput = document.getElementById('pdfFileInput');
        const selectedFileName = document.getElementById('selectedFileName');

        dropZone.addEventListener('click', () => pdfFileInput.click());
        dropZone.addEventListener('dragover', (e) => {
            e.preventDefault();
            dropZone.classList.add('border-brand-cyan');
        });
        dropZone.addEventListener('dragleave', () => dropZone.classList.remove('border-brand-cyan'));
        dropZone.addEventListener('drop', (e) => {
            e.preventDefault();
            dropZone.classList.remove('border-brand-cyan');
            if (e.dataTransfer.files.length > 0) {
                pdfFileInput.files = e.dataTransfer.files;
                updateFileLabel();
            }
        });
        pdfFileInput.addEventListener('change', updateFileLabel);

        function updateFileLabel() {
            if (pdfFileInput.files.length > 0) {
                const file = pdfFileInput.files[0];
                selectedFileName.innerHTML = `<span class="text-brand-cyan font-bold"><i class="fas fa-file-pdf mr-1"></i> ${file.name}</span> (${(file.size / 1024 / 1024).toFixed(2)} MB)`;
                
                // Auto-fill test title if empty
                const titleInput = document.getElementById('examTitle');
                if (!titleInput.value.trim()) {
                    let cleanName = file.name.replace(/\.[^/.]+$/, "").replace(/[_-]/g, " ");
                    titleInput.value = cleanName.charAt(0).toUpperCase() + cleanName.slice(1);
                }
            }
        }

        async function runParser() {
            const statusLabel = document.getElementById('parseStatus');
            const parseBtn = document.getElementById('parseBtn');

            const formData = new FormData();
            if (currentTab === 'pdf') {
                if (!pdfFileInput.files || pdfFileInput.files.length === 0) {
                    alert("Please select or drop a PDF file first.");
                    return;
                }
                formData.append('pdfFile', pdfFileInput.files[0]);
            } else {
                const text = document.getElementById('rawTextInput').value.trim();
                if (!text) {
                    alert("Please paste exam text first.");
                    return;
                }
                formData.append('rawText', text);
            }

            parseBtn.disabled = true;
            parseBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Parsing PDF...';
            statusLabel.innerHTML = '<span class="text-brand-cyan"><i class="fas fa-circle-notch fa-spin mr-1"></i> Reading PDF and detecting MCQs...</span>';

            try {
                const res = await fetch('/Admin/Tests/UploadAndParsePdf', {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': antiForgeryToken() },
                    body: formData
                });
                const data = await res.json();

                if (data.success && data.questions) {
                    parsedQuestions = data.questions;
                    renderQuestions();
                    const docWarnings = (data.warnings || [])
                        .map(w => `<span class="block text-amber-400 font-semibold mt-1"><i class="fas fa-triangle-exclamation mr-1"></i> ${escapeHtml(w)}</span>`)
                        .join('');
                    statusLabel.innerHTML = `<span class="text-emerald-400 font-bold"><i class="fas fa-check mr-1"></i> Successfully recognized ${data.questions.length} questions!</span>${docWarnings}`;
                } else {
                    statusLabel.innerHTML = `<span class="text-rose-400 font-bold"><i class="fas fa-triangle-exclamation mr-1"></i> ${data.message || 'Parsing failed.'}</span>`;
                }
            } catch (err) {
                console.error(err);
                statusLabel.innerHTML = '<span class="text-rose-400 font-bold">Error communicating with server parser.</span>';
            } finally {
                parseBtn.disabled = false;
                parseBtn.innerHTML = '<i class="fas fa-bolt"></i> ⚡ Parse Questions &amp; Answers';
            }
        }

        function renderQuestions() {
            const container = document.getElementById('questionsContainer');
            const countBadge = document.getElementById('questionCountBadge');
            countBadge.innerText = parsedQuestions.length;

            if (parsedQuestions.length === 0) {
                container.innerHTML = `
                    <div id="emptyQuestionsPrompt" class="p-8 text-center text-slate-500 text-sm border border-white/5 rounded-2xl bg-white/[0.01]">
                        <i class="fas fa-arrow-up block text-xl mb-2 text-brand-cyan/50"></i>
                        No questions loaded. Upload an exam PDF above or click "Add Question".
                    </div>`;
                return;
            }

            container.innerHTML = '';
            parsedQuestions.forEach((q, qIndex) => {
                const warnings = q.warnings || [];
                const qCard = document.createElement('div');
                qCard.className = warnings.length > 0
                    ? "p-5 rounded-2xl bg-amber-500/[0.04] border border-amber-500/40 transition-all space-y-4"
                    : "p-5 rounded-2xl bg-white/[0.02] border border-white/10 hover:border-brand-cyan/30 transition-all space-y-4";
                qCard.id = `qCard_${qIndex}`;
                const warningsHtml = warnings.length === 0 ? '' : `
                    <div class="p-3 rounded-xl bg-amber-500/10 border border-amber-500/30 text-xs text-amber-300 space-y-1">
                        ${warnings.map(w => `<div><i class="fas fa-triangle-exclamation mr-1"></i> ${escapeHtml(w)}</div>`).join('')}
                    </div>`;

                let optionsHtml = '';
                q.options.forEach((opt, optIndex) => {
                    const isCorrect = opt.isCorrect || opt.label.toUpperCase() === (q.detectedCorrectOption || '').toUpperCase();
                    optionsHtml += `
                        <div class="flex items-center gap-3 p-2.5 rounded-xl ${isCorrect ? 'bg-emerald-500/10 border border-emerald-500/30' : 'bg-dark-bg/40 border border-white/5'} transition-all option-row" id="optRow_${qIndex}_${optIndex}">
                            <button type="button" 
                                    onclick="setCorrectOption(${qIndex}, ${optIndex})" 
                                    class="w-7 h-7 rounded-lg font-mono font-bold text-xs flex items-center justify-center shrink-0 transition-all ${isCorrect ? 'bg-emerald-500 text-dark-bg shadow-[0_0_10px_rgba(16,185,129,0.5)]' : 'bg-white/5 text-slate-400 hover:text-white hover:bg-white/10'}"
                                    title="Click to mark as correct answer">
                                ${opt.label}
                            </button>
                            <input type="text" 
                                   value="${escapeHtml(opt.text)}" 
                                   onchange="updateOptionText(${qIndex}, ${optIndex}, this.value)"
                                   class="flex-1 bg-transparent text-sm text-white focus:outline-none focus:underline" 
                                   placeholder="Option text..." />
                            ${isCorrect ? '<span class="text-[11px] font-bold text-emerald-400 mr-2 shrink-0"><i class="fas fa-check"></i> Correct</span>' : ''}
                        </div>`;
                });

                qCard.innerHTML = `
                    <div class="flex items-start justify-between gap-4">
                        <div class="flex items-center gap-3">
                            <span class="w-8 h-8 rounded-xl bg-gradient-to-br from-brand-cyan/20 to-brand-blue/20 border border-brand-cyan/30 text-brand-cyan font-mono font-bold text-sm flex items-center justify-center shrink-0">
                                ${qIndex + 1}
                            </span>
                            <span class="text-xs uppercase font-bold text-slate-400 tracking-wider">Question ${qIndex + 1}</span>
                            ${q.domain ? `<span class="px-2 py-0.5 rounded-md bg-white/5 border border-white/10 text-[10px] text-slate-400">${escapeHtml(q.domain)}</span>` : ''}
                        </div>
                        <button type="button" onclick="deleteQuestion(${qIndex})" class="text-slate-500 hover:text-rose-400 text-xs p-1 transition-colors" title="Delete Question">
                            <i class="fas fa-trash-can"></i>
                        </button>
                    </div>

                    ${warningsHtml}

                    <div>
                        <textarea rows="2"
                                  onchange="updateQuestionText(${qIndex}, this.value)"
                                  class="w-full px-3.5 py-2.5 rounded-xl bg-dark-bg/60 border border-white/10 text-white font-medium text-sm focus:outline-none focus:border-brand-cyan transition-all"
                                  placeholder="Enter question text...">${escapeHtml(q.questionText)}</textarea>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" id="optionsGrid_${qIndex}">
                        ${optionsHtml}
                    </div>

                    <div>
                        <input type="text" 
                               value="${escapeHtml(q.explanation || '')}" 
                               onchange="updateExplanation(${qIndex}, this.value)"
                               class="w-full px-3 py-1.5 rounded-lg bg-dark-bg/30 border border-white/5 text-xs text-slate-300 placeholder-slate-600 focus:outline-none focus:border-brand-cyan/50"
                               placeholder="Explanation / Rationale (shown to students upon completion)..." />
                    </div>
                `;

                container.appendChild(qCard);
            });
        }

        function setCorrectOption(qIndex, optIndex) {
            if (!parsedQuestions[qIndex]) return;
            parsedQuestions[qIndex].options.forEach((opt, idx) => {
                opt.isCorrect = (idx === optIndex);
                if (opt.isCorrect) {
                    parsedQuestions[qIndex].detectedCorrectOption = opt.label;
                }
            });
            // The admin has now decided the answer, so answer-related warnings no longer apply.
            parsedQuestions[qIndex].warnings = (parsedQuestions[qIndex].warnings || [])
                .filter(w => !/correct answer|says [A-H]\b/i.test(w));
            renderQuestions();
        }

        function updateQuestionText(qIndex, text) {
            if (parsedQuestions[qIndex]) parsedQuestions[qIndex].questionText = text;
        }

        function updateOptionText(qIndex, optIndex, text) {
            if (parsedQuestions[qIndex] && parsedQuestions[qIndex].options[optIndex]) {
                parsedQuestions[qIndex].options[optIndex].text = text;
            }
        }

        function updateExplanation(qIndex, exp) {
            if (parsedQuestions[qIndex]) parsedQuestions[qIndex].explanation = exp;
        }

        function deleteQuestion(qIndex) {
            parsedQuestions.splice(qIndex, 1);
            renderQuestions();
        }

        function addNewBlankQuestion() {
            parsedQuestions.push({
                questionIndex: parsedQuestions.length + 1,
                questionText: "",
                explanation: "",
                detectedCorrectOption: "A",
                options: [
                    { label: "A", text: "", isCorrect: true },
                    { label: "B", text: "", isCorrect: false },
                    { label: "C", text: "", isCorrect: false },
                    { label: "D", text: "", isCorrect: false }
                ]
            });
            renderQuestions();
            // Scroll to newly added card
            const newCard = document.getElementById(`qCard_${parsedQuestions.length - 1}`);
            if (newCard) newCard.scrollIntoView({ behavior: 'smooth' });
        }

        function escapeHtml(text) {
            if (!text) return '';
            return text
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }

        async function saveExam() {
            const title = document.getElementById('examTitle').value.trim();
            if (!title) {
                alert("Please provide an Exam Title.");
                document.getElementById('examTitle').focus();
                return;
            }

            if (parsedQuestions.length === 0) {
                alert("Please add or parse at least one question before saving.");
                return;
            }

            // Verify each question has text and at least 2 options
            for (let i = 0; i < parsedQuestions.length; i++) {
                const q = parsedQuestions[i];
                if (!q.questionText.trim()) {
                    alert(`Question ${i + 1} has empty question text.`);
                    return;
                }
                const filledOptions = q.options.filter(o => o.text.trim().length > 0);
                if (filledOptions.length < 2) {
                    alert(`Question ${i + 1} must have at least 2 option choices.`);
                    return;
                }
            }

            const payload = {
                title: title,
                description: document.getElementById('examDescription').value.trim(),
                courseId: parseInt(document.getElementById('examCourseId').value) || null,
                durationMinutes: Math.max(0, parseInt(document.getElementById('examDuration').value) || 0),
                passingScorePercent: parseFloat(document.getElementById('examPassingScore').value) || 70,
                isActive: true,
                shuffleQuestions: document.getElementById('examShuffleQuestions').checked,
                shuffleOptions: document.getElementById('examShuffleOptions').checked,
                questions: parsedQuestions
            };

            const saveBtn = document.getElementById('saveExamBtn');
            saveBtn.disabled = true;
            saveBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving Test...';

            try {
                const res = await fetch('/Admin/Tests/SaveExam', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': antiForgeryToken() },
                    body: JSON.stringify(payload)
                });
                const result = await res.json();

                if (result.success) {
                    window.location.href = '/Admin/Tests';
                } else {
                    alert("Error saving exam: " + (result.message || "Unknown error"));
                    saveBtn.disabled = false;
                    saveBtn.innerHTML = '<i class="fas fa-floppy-disk"></i> <span>Save &amp; Publish Test</span>';
                }
            } catch (err) {
                console.error(err);
                alert("Failed to communicate with the server.");
                saveBtn.disabled = false;
                saveBtn.innerHTML = '<i class="fas fa-floppy-disk"></i> <span>Save &amp; Publish Test</span>';
            }
        }
    </script>
}
