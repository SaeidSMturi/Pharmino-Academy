@using System.Globalization
@{
    var currentCulture = CultureInfo.CurrentUICulture.Name;
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    var isFarsi = currentCulture.StartsWith("fa", StringComparison.OrdinalIgnoreCase);
    var isArabic = currentCulture.StartsWith("ar", StringComparison.OrdinalIgnoreCase);

    ViewData["Title"] = isFarsi ? "دسترسی غیرمجاز" : (isArabic ? "تم رفض الوصول" : "Access Denied");
    Layout = null;
}

<!DOCTYPE html>
<html lang="@currentCulture" dir="@(isRtl ? "rtl" : "ltr")">
<head>
    <script>
        (function () {
            try {
                var theme = localStorage.getItem('pharmino_theme') || 'dark';
                document.documentElement.setAttribute('data-theme', theme);
                if (theme === 'light') {
                    document.documentElement.classList.add('light', 'light-theme');
                } else {
                    document.documentElement.classList.add('dark', 'dark-theme');
                }
            } catch (e) { }
        })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    @if (isFarsi)
    {
        <style>
            @@font-face {
                font-family: 'B Nazanin';
                src: url('/fonts/BNazanin.ttf') format('truetype');
                font-weight: normal;
                font-style: normal;
                font-display: swap;
            }
            * {
                font-family: 'B Nazanin', Tahoma, sans-serif !important;
            }
        </style>
    }
    else if (isArabic)
    {
        <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">
        <style>
            * {
                font-family: 'Cairo', sans-serif !important;
            }
        </style>
    }
    else
    {
        <style>
            * {
                font-family: 'Inter', sans-serif;
            }
        </style>
    }
</head>
<body class="bg-gradient-to-br from-slate-900 via-purple-900/10 to-slate-900 min-h-screen flex items-center justify-center p-6 relative">
    <div class="absolute top-6 @(isRtl ? "left-6" : "right-6") flex items-center gap-3 z-50">
        <partial name="_ThemeToggle" />
        <partial name="_LanguageSwitcher" />
    </div>

    <div class="max-w-md w-full">
        <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center w-24 h-24 rounded-full bg-red-500/20 mb-6">
                <i class="fas fa-ban text-5xl text-red-400"></i>
            </div>
            <h1 class="text-4xl font-bold text-white mb-3">
                @(isFarsi ? "دسترسی غیرمجاز" : (isArabic ? "تم رفض الوصول" : "Access Denied"))
            </h1>
            <p class="text-slate-400 text-lg">
                @(isFarsi ? "شما مجوز دسترسی به این بخش را ندارید" : (isArabic ? "ليس لديك الإذن للوصول إلى هذا القسم" : "You do not have permission to access this section"))
            </p>
        </div>

        <div class="bg-slate-800/30 backdrop-blur-lg border border-slate-700/50 rounded-xl p-6 mb-6">
            <h2 class="text-lg font-bold text-white mb-4 flex items-center">
                <i class="fas fa-info-circle @(isRtl ? "ml-2" : "mr-2") text-blue-400"></i>
                @(isFarsi ? "چرا این پیام را می‌بینید؟" : (isArabic ? "لماذا ترى هذه الرسالة؟" : "Why are you seeing this message?"))
            </h2>
            <ul class="space-y-3 text-slate-300">
                <li class="flex items-start">
                    <i class="fas fa-check text-purple-400 @(isRtl ? "ml-2" : "mr-2") mt-1"></i>
                    <span>
                        @(isFarsi ? "حساب شما ممکن است مجوزهای مدیریتی نداشته باشد" : (isArabic ? "قد لا يمتلك حسابك صلاحيات إدارية" : "Your account may not have administrative permissions"))
                    </span>
                </li>
                <li class="flex items-start">
                    <i class="fas fa-check text-purple-400 @(isRtl ? "ml-2" : "mr-2") mt-1"></i>
                    <span>
                        @(isFarsi ? "برای دسترسی به پنل مدیریت، باید با حساب مدیر وارد شوید" : (isArabic ? "للوصول إلى لوحة الإدارة، يجب تسجيل الدخول بحساب مسؤول" : "To access the admin panel, you must log in with an administrator account"))
                    </span>
                </li>
                <li class="flex items-start">
                    <i class="fas fa-check text-purple-400 @(isRtl ? "ml-2" : "mr-2") mt-1"></i>
                    <span>
                        @(isFarsi ? "اگر فکر می‌کنید این یک خطاست، لطفاً با پشتیبانی تماس بگیرید" : (isArabic ? "إذا كنت تعتقد أن هذا خطأ، يرجى التواصل مع الدعم الفني" : "If you think this is an error, please contact support"))
                    </span>
                </li>
            </ul>
        </div>

        <div class="flex flex-col sm:flex-row gap-3">
            <a href="/" class="flex-1 px-6 py-3 bg-gradient-to-r from-purple-500 to-pink-500 text-white rounded-lg hover:from-purple-600 hover:to-pink-600 transition-all text-center font-medium">
                <i class="fas fa-home @(isRtl ? "ml-2" : "mr-2")"></i>
                @(isFarsi ? "بازگشت به خانه" : (isArabic ? "العودة للرئيسية" : "Back to Home"))
            </a>
            <a asp-area="" asp-controller="Account" asp-action="Logout" class="flex-1 px-6 py-3 bg-slate-700/50 text-slate-300 rounded-lg hover:bg-slate-700 transition-all text-center font-medium">
                <i class="fas fa-sign-out-alt @(isRtl ? "ml-2" : "mr-2")"></i>
                @(isFarsi ? "خروج از حساب" : (isArabic ? "تسجيل الخروج" : "Logout"))
            </a>
        </div>
    </div>
    <script src="~/js/theme.js"></script>
</body>
</html>
