@model string
@{
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.Name;
    var isRtl = currentCulture.StartsWith("fa", StringComparison.OrdinalIgnoreCase) || currentCulture.StartsWith("ar", StringComparison.OrdinalIgnoreCase);
    ViewData["Title"] = Localizer["RobotsTxtEditor"].Value;
}

<div class="animate-[fadeIn_0.4s_ease_forwards] w-full @(isRtl ? "font-fa" : "") text-start" dir="@(isRtl ? "rtl" : "ltr")">

    <!-- Back to Dashboard -->
    <a href="@Url.Action("Index", "Seo", new { area = "Admin" })" class="inline-flex items-center gap-2 text-xs font-bold text-slate-500 hover:text-brand-cyan transition-colors uppercase tracking-wider mb-6">
        <i class="fa @(isRtl ? "fa-arrow-right" : "fa-arrow-left") text-[10px]"></i> <span>@Localizer["BackToSeoDashboard"]</span>
    </a>

    <!-- Flash Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="mb-6 p-4 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center space-x-3 text-sm font-semibold shadow-[0_0_15px_rgba(16,185,129,0.1)]">
            <i class="fas fa-check-circle text-base"></i>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="mb-6 p-4 rounded-2xl bg-rose-500/10 border border-rose-500/20 text-rose-400 flex items-center space-x-3 text-sm font-semibold shadow-[0_0_15px_rgba(244,63,94,0.1)]">
            <i class="fas fa-exclamation-circle text-base"></i>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <!-- Main Two-Column Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

        <!-- Left Column: Editor -->
        <div class="lg:col-span-8 space-y-6">
            <div class="pb-2 border-b border-white/5 mb-4">
                <h3 class="text-base font-bold text-white uppercase tracking-wider">@Localizer["RobotsTxtEditor"]</h3>
                <p class="text-slate-500 text-[11px] font-medium mt-1">@Localizer["RobotsTxtEditorDesc"]</p>
            </div>

            <form action="@Url.Action("SaveRobotsTxt", "Seo", new { area = "Admin" })" method="post" class="space-y-6">
                @Html.AntiForgeryToken()

                <!-- Textarea Container -->
                <div class="relative rounded-2xl overflow-hidden border border-white/10 focus-within:border-brand-cyan/40 focus-within:ring-4 focus-within:ring-brand-cyan/5 transition-all bg-black/40 backdrop-blur-xl">
                    <div class="flex items-center justify-between px-4 py-2 bg-white/[0.02] border-b border-white/5 select-none" dir="ltr">
                        <div class="flex items-center gap-1.5">
                            <span class="w-2 h-2 rounded-full bg-rose-500/60 inline-block shadow-[0_0_6px_#f43f5e]"></span>
                            <span class="w-2 h-2 rounded-full bg-brand-yellow/60 inline-block"></span>
                            <span class="w-2 h-2 rounded-full bg-emerald-500/60 inline-block"></span>
                            <span class="text-[10px] font-mono font-bold text-slate-500 pl-2 uppercase tracking-wide">robots.txt</span>
                        </div>
                    </div>

                    <textarea name="content" id="robotsTextarea" rows="16" dir="ltr"
                              class="w-full bg-transparent p-5 font-mono text-sm text-emerald-400 focus:outline-none resize-y leading-relaxed selection:bg-brand-cyan/20 custom-scrollbar text-left"
                              spellcheck="false">@Model</textarea>
                </div>

                <!-- Submit Button -->
                <div class="flex justify-end">
                    <button type="submit" class="w-full sm:w-auto text-center px-6 py-2.5 bg-gradient-to-r from-brand-cyan to-brand-blue text-dark-bg font-black text-xs uppercase tracking-wide rounded-xl hover:shadow-[0_0_20px_rgba(66,234,255,0.3)] hover:scale-[1.01] transition-all flex items-center justify-center gap-1.5 h-9">
                        <i class="fa fa-save text-sm"></i> <span>@Localizer["SaveRobotsTxt"]</span>
                    </button>
                </div>
            </form>
        </div>

        <!-- Right Column: Templates & Guidelines -->
        <div class="lg:col-span-4 space-y-8">

            <!-- Quick Templates -->
            <div class="space-y-4">
                <div class="pb-2 border-b border-white/5 mb-4">
                    <h3 class="text-sm font-bold text-white uppercase tracking-wider">@Localizer["QuickTemplates"]</h3>
                    <p class="text-slate-500 text-[11px] font-medium mt-1">@Localizer["QuickTemplatesDesc"]</p>
                </div>

                <div class="space-y-2.5">
                    <button type="button" class="w-full px-4 py-2.5 bg-white/5 border border-white/5 text-slate-300 hover:text-white hover:bg-white/10 text-xs font-bold rounded-xl transition-all flex items-center gap-2.5" onclick="loadTemplate('standard')">
                        <i class="fa fa-file-text-o text-brand-blue"></i> <span>@Localizer["LoadStandardTemplate"]</span>
                    </button>
                    <button type="button" class="w-full px-4 py-2.5 bg-brand-yellow/5 border border-brand-yellow/10 text-brand-yellow hover:bg-brand-yellow hover:text-dark-bg text-xs font-bold rounded-xl transition-all flex items-center gap-2.5 shadow-sm" onclick="loadTemplate('allow-all')">
                        <i class="fa fa-check-circle-o"></i> <span>@Localizer["AllowAllCrawlers"]</span>
                    </button>
                    <button type="button" class="w-full px-4 py-2.5 bg-rose-500/5 border border-rose-500/10 text-rose-400 hover:bg-rose-500 hover:text-white text-xs font-bold rounded-xl transition-all flex items-center gap-2.5 shadow-sm" onclick="loadTemplate('block-all')">
                        <i class="fa fa-ban"></i> <span>@Localizer["BlockAllCrawlers"]</span>
                    </button>
                </div>
            </div>

            <!-- Guidelines -->
            <div class="space-y-4">
                <div class="pb-2 border-b border-white/5 mb-4">
                    <h3 class="text-xs font-bold text-slate-400 uppercase tracking-widest">@Localizer["SyntaxGuidelines"]</h3>
                </div>

                <ul class="space-y-3.5 text-xs font-medium text-slate-400 leading-relaxed pl-1">
                    <li class="flex items-start gap-2.5">
                        <span class="w-1.5 h-1.5 rounded-full bg-brand-cyan mt-1.5 flex-shrink-0"></span>
                        <span><code dir="ltr">User-agent: *</code> @(isRtl ? "قوانین را برای تمام خزنده‌های وب اعمال می‌کند." : "applies rules to all search engine web crawlers.")</span>
                    </li>
                    <li class="flex items-start gap-2.5">
                        <span class="w-1.5 h-1.5 rounded-full bg-brand-cyan mt-1.5 flex-shrink-0"></span>
                        <span><code dir="ltr">Disallow: /admin/</code> @(isRtl ? "دسترسی خزنده‌ها به صفحات ادمین را مسدود می‌کند." : "blocks crawlers from accessing any page under /admin/.")</span>
                    </li>
                    <li class="flex items-start gap-2.5">
                        <span class="w-1.5 h-1.5 rounded-full bg-brand-cyan mt-1.5 flex-shrink-0"></span>
                        <span>@(isRtl ? "آدرس کامل نقشه سایت را با استفاده از دستور Sitemap اضافه کنید:" : "Include a full URL for your sitemap using the") <code dir="ltr">Sitemap:</code></span>
                    </li>
                </ul>
            </div>

        </div>
    </div>
</div>

<script>
    function loadTemplate(type) {
        const textarea = document.getElementById('robotsTextarea');
        const baseUrl = window.location.protocol + "//" + window.location.host;

        if (type === 'standard') {
            textarea.value = `# Standard Robots.txt Configuration\nUser-agent: *\nAllow: /\nDisallow: /Admin/\nDisallow: /Account/\n\nSitemap: ${baseUrl}/sitemap_index.xml\n`;
        } else if (type === 'allow-all') {
            textarea.value = `# Allow all search engines\nUser-agent: *\nAllow: /\n\nSitemap: ${baseUrl}/sitemap_index.xml\n`;
        } else if (type === 'block-all') {
            textarea.value = `# Disallow all crawlers\nUser-agent: *\nDisallow: /\n`;
        }
    }
</script>