@model List<Domain.Entities.Permission.Role>

@{
    var isRtl = System.Globalization.CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    ViewData["Title"] = Localizer["RolesAndPermissions"].Value;
}

<div class="animate-[fadeIn_0.4s_ease_forwards] w-full text-start" dir="@(isRtl ? "rtl" : "ltr")">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-8">
        <div>
            <h1 class="text-3xl font-extrabold bg-gradient-to-r from-brand-cyan to-brand-blue bg-clip-text text-transparent mb-2 tracking-wide">
                @Localizer["RolesAndPermissions"]
            </h1>
            <p class="text-slate-400 text-sm font-medium">@Localizer["RolesAndPermissionsSub"]</p>
        </div>

        <div class="flex flex-col sm:flex-row sm:items-center gap-4 w-full md:w-auto">
            <div class="relative w-full sm:w-64 group">
                <input type="text" id="searchInput" placeholder="@Localizer["SearchRoles"]"
                       class="w-full bg-dark-bg/60 border border-white/10 rounded-xl px-4 py-2.5 @(isRtl ? "pr-11 pl-4" : "pl-11 pr-4") text-white placeholder-slate-500 focus:outline-none focus:border-brand-cyan/50 focus:ring-2 focus:ring-brand-cyan/20 transition-all text-sm font-medium backdrop-blur-md">
                <i class="fas fa-search absolute @(isRtl ? "right-4" : "left-4") top-1/2 transform -translate-y-1/2 text-slate-500 group-focus-within:text-brand-cyan transition-colors"></i>
            </div>

            <a asp-action="Create" class="w-full sm:w-auto text-center px-6 py-2.5 bg-gradient-to-r from-brand-cyan to-brand-blue rounded-xl text-dark-bg font-extrabold hover:shadow-[0_0_20px_rgba(66,234,255,0.4)] hover:scale-[1.02] transition-all duration-300 whitespace-nowrap text-sm flex items-center justify-center">
                <i class="fas fa-plus @(isRtl ? "ml-2" : "mr-2") text-lg"></i>
                @Localizer["CreateRole"]
            </a>
        </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
        <div class="relative p-5 rounded-3xl bg-white/[0.02] border border-white/[0.05] hover:border-brand-blue/30 transition-all duration-300 hover:-translate-y-1 group overflow-hidden">
            <div class="absolute @(isRtl ? "-left-6" : "-right-6") -top-6 w-24 h-24 bg-brand-blue/10 rounded-full blur-2xl group-hover:bg-brand-blue/20 transition-all"></div>
            <div class="flex items-center justify-between relative z-10">
                <div>
                    <p class="text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1">@Localizer["TotalRoles"]</p>
                    <p class="text-3xl font-extrabold text-white">@Model.Count</p>
                </div>
                <div class="w-12 h-12 rounded-2xl bg-brand-blue/10 border border-brand-blue/20 flex items-center justify-center shadow-[inset_0_0_15px_rgba(66,114,255,0.1)] group-hover:scale-110 transition-transform">
                    <i class="fas fa-user-shield text-brand-blue text-lg"></i>
                </div>
            </div>
        </div>

        <div class="relative p-5 rounded-3xl bg-white/[0.02] border border-white/[0.05] hover:border-emerald-500/30 transition-all duration-300 hover:-translate-y-1 group overflow-hidden">
            <div class="absolute @(isRtl ? "-left-6" : "-right-6") -top-6 w-24 h-24 bg-emerald-500/10 rounded-full blur-2xl group-hover:bg-emerald-500/20 transition-all"></div>
            <div class="flex items-center justify-between relative z-10">
                <div>
                    <p class="text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1">@Localizer["ActiveRoles"]</p>
                    <p class="text-3xl font-extrabold text-white">@Model.Count(r => r.IsActive)</p>
                </div>
                <div class="w-12 h-12 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center shadow-[inset_0_0_15px_rgba(16,185,129,0.1)] group-hover:scale-110 transition-transform">
                    <i class="fas fa-circle-check text-emerald-400 text-lg"></i>
                </div>
            </div>
        </div>

        <div class="relative p-5 rounded-3xl bg-white/[0.02] border border-white/[0.05] hover:border-brand-yellow/30 transition-all duration-300 hover:-translate-y-1 group overflow-hidden">
            <div class="absolute @(isRtl ? "-left-6" : "-right-6") -top-6 w-24 h-24 bg-brand-yellow/10 rounded-full blur-2xl group-hover:bg-brand-yellow/20 transition-all"></div>
            <div class="flex items-center justify-between relative z-10">
                <div>
                    <p class="text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1">@Localizer["TotalPermissions"]</p>
                    <p class="text-3xl font-extrabold text-white">@Model.SelectMany(r => r.RolePermissions).Select(rp => rp.PermissionId).Distinct().Count()</p>
                </div>
                <div class="w-12 h-12 rounded-2xl bg-brand-yellow/10 border border-brand-yellow/20 flex items-center justify-center shadow-[inset_0_0_15px_rgba(255,179,67,0.1)] group-hover:scale-110 transition-transform">
                    <i class="fas fa-key text-brand-yellow text-lg"></i>
                </div>
            </div>
        </div>

        <div class="relative p-5 rounded-3xl bg-white/[0.02] border border-white/[0.05] hover:border-brand-orange/30 transition-all duration-300 hover:-translate-y-1 group overflow-hidden">
            <div class="absolute @(isRtl ? "-left-6" : "-right-6") -top-6 w-24 h-24 bg-brand-orange/10 rounded-full blur-2xl group-hover:bg-brand-orange/20 transition-all"></div>
            <div class="flex items-center justify-between relative z-10">
                <div>
                    <p class="text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1">@Localizer["AssignedUsers"]</p>
                    <p class="text-3xl font-extrabold text-white">@Model.SelectMany(r => r.UserRoles).Count()</p>
                </div>
                <div class="w-12 h-12 rounded-2xl bg-brand-orange/10 border border-brand-orange/20 flex items-center justify-center shadow-[inset_0_0_15px_rgba(255,126,66,0.1)] group-hover:scale-110 transition-transform">
                    <i class="fas fa-users text-brand-orange text-lg"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="p-1 rounded-3xl bg-white/[0.02] border border-white/[0.05] relative shadow-2xl">
        <div class="bg-dark-bg/60 rounded-[22px] overflow-hidden backdrop-blur-xl">
            <div class="overflow-x-auto custom-scrollbar">
                <table class="w-full text-start border-collapse">
                    <thead>
                        <tr class="bg-white/[0.02] border-b border-white/[0.05]">
                            <th class="px-6 py-5 text-[10px] font-bold text-slate-500 uppercase tracking-widest text-start">@Localizer["RoleName"]</th>
                            <th class="px-6 py-5 text-[10px] font-bold text-slate-500 uppercase tracking-widest text-start">@Localizer["RoleDescription"]</th>
                            <th class="px-6 py-5 text-[10px] font-bold text-slate-500 uppercase tracking-widest text-start">@Localizer["Permissions"]</th>
                            <th class="px-6 py-5 text-[10px] font-bold text-slate-500 uppercase tracking-widest text-start">@Localizer["Users"]</th>
                            <th class="px-6 py-5 text-[10px] font-bold text-slate-500 uppercase tracking-widest text-start">@Localizer["Status"]</th>
                            <th class="px-6 py-5 text-[10px] font-bold text-slate-500 uppercase tracking-widest @(isRtl ? "text-left" : "text-right")">@Localizer["Actions"]</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-white/[0.02]" id="rolesTable">
                        @foreach (var role in Model)
                        {
                            <tr class="hover:bg-white/[0.02] transition-colors duration-200 role-row group" data-role-id="@role.RoleId">
                                <td class="px-6 py-5 whitespace-nowrap">
                                    <div class="flex items-center @(isRtl ? "space-x-reverse" : "space-x-4")">
                                        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-brand-cyan/20 to-brand-blue/20 border border-brand-cyan/30 flex items-center justify-center text-brand-cyan shadow-[inset_0_0_12px_rgba(66,234,255,0.1)] group-hover:scale-105 transition-transform">
                                            <i class="fas fa-user-shield text-sm"></i>
                                        </div>
                                        <div>
                                            <div class="font-bold text-white text-sm group-hover:text-brand-cyan transition-colors">@Localizer[role.DisplayName]</div>
                                            <div class="text-[11px] font-mono font-semibold text-slate-500 mt-0.5" dir="ltr">@role.RoleName</div>
                                        </div>
                                    </div>
                                </td>

                                <td class="px-6 py-5">
                                    <p class="text-xs font-medium text-slate-400 max-w-xs break-words leading-relaxed">
                                        @(string.IsNullOrEmpty(role.Description) ? "-" : Localizer[role.Description].Value)
                                    </p>
                                </td>

                                <td class="px-6 py-5 whitespace-nowrap">
                                    <span class="px-2.5 py-1 inline-flex items-center text-[10px] font-bold tracking-wide rounded-lg bg-brand-cyan/10 text-brand-cyan border border-brand-cyan/20 uppercase">
                                        <i class="fas fa-key @(isRtl ? "ml-1.5" : "mr-1.5") text-[9px]"></i>
                                        @role.RolePermissions.Count() @Localizer["Permissions"]
                                    </span>
                                </td>

                                <td class="px-6 py-5 whitespace-nowrap">
                                    <span class="text-xs font-semibold text-slate-300 bg-white/[0.03] border border-white/5 px-2.5 py-1 rounded-md">
                                        <i class="fas fa-users @(isRtl ? "ml-1.5" : "mr-1.5") text-slate-500 text-[10px]"></i>@role.UserRoles.Count() @Localizer["Users"]
                                    </span>
                                </td>

                                <td class="px-6 py-5 whitespace-nowrap">
                                    @if (role.IsActive)
                                    {
                                        <span class="px-2.5 py-1 inline-flex items-center text-[10px] font-bold tracking-wide rounded-lg bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 uppercase">
                                            <i class="fas fa-circle-check @(isRtl ? "ml-1.5" : "mr-1.5")"></i>@Localizer["Active"]
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="px-2.5 py-1 inline-flex items-center text-[10px] font-bold tracking-wide rounded-lg bg-rose-500/10 text-rose-400 border border-rose-500/20 uppercase">
                                            <i class="fas fa-circle-xmark @(isRtl ? "ml-1.5" : "mr-1.5")"></i>@Localizer["Inactive"]
                                        </span>
                                    }
                                </td>

                                <td class="px-6 py-5 whitespace-nowrap @(isRtl ? "text-left" : "text-right")">
                                    <div class="flex items-center @(isRtl ? "justify-start space-x-reverse" : "justify-end space-x-2") opacity-70 group-hover:opacity-100 transition-opacity">
                                        <a asp-action="Details" asp-route-id="@role.RoleId"
                                           class="w-8 h-8 rounded-lg bg-brand-cyan/10 text-brand-cyan flex items-center justify-center hover:bg-brand-cyan hover:text-dark-bg hover:shadow-[0_0_15px_rgba(66,234,255,0.4)] transition-all" title="@Localizer["Details"]">
                                            <i class="fas fa-eye text-xs"></i>
                                        </a>

                                        @if (role.RoleName != "SuperAdmin")
                                        {
                                            <a asp-action="Edit" asp-route-id="@role.RoleId"
                                               class="w-8 h-8 rounded-lg bg-brand-blue/10 text-brand-blue flex items-center justify-center hover:bg-brand-blue hover:text-white hover:shadow-[0_0_15px_rgba(66,114,255,0.4)] transition-all" title="@Localizer["Edit"]">
                                                <i class="fas fa-edit text-xs"></i>
                                            </a>

                                            <button onclick="toggleActive(@role.RoleId, '@role.RoleName', @role.IsActive.ToString().ToLower())"
                                                    class="w-8 h-8 rounded-lg bg-brand-yellow/10 text-brand-yellow flex items-center justify-center hover:bg-brand-yellow hover:text-dark-bg hover:shadow-[0_0_15px_rgba(255,179,67,0.4)] transition-all" title="@(role.IsActive ? Localizer["Deactivate"] : Localizer["Activate"])">
                                                <i class="fas fa-power-off text-xs"></i>
                                            </button>

                                            <button onclick="deleteRole(@role.RoleId, '@role.RoleName')"
                                                    class="w-8 h-8 rounded-lg bg-rose-500/10 text-rose-400 flex items-center justify-center hover:bg-rose-500 hover:text-white hover:shadow-[0_0_15px_rgba(244,63,94,0.4)] transition-all" title="@Localizer["Delete"]">
                                                <i class="fas fa-trash text-xs"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center px-2.5 py-1 text-[9px] font-black bg-white/[0.05] text-slate-400 rounded-md border border-white/[0.05] tracking-wider uppercase" title="@Localizer["DefaultSystemRoleNotice"]">
                                                <i class="fas fa-lock text-brand-yellow @(isRtl ? "ml-1.5" : "mr-1.5")"></i> @Localizer["DefaultSystemRole"]
                                            </span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (!Model.Any())
                {
                    <div class="flex flex-col items-center justify-center py-16 px-4">
                        <div class="w-20 h-20 rounded-full bg-white/[0.02] border border-white/[0.05] flex items-center justify-center mb-4">
                            <i class="fas fa-user-shield text-3xl text-slate-600"></i>
                        </div>
                        <h3 class="text-base font-bold text-white mb-1">@Localizer["NoRolesFound"]</h3>
                        <p class="text-xs text-slate-500 font-medium">@Localizer["NoRolesFoundSub"]</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Real-time search filter
        document.getElementById('searchInput').addEventListener('input', function(e) {
            const searchTerm = e.target.value.toLowerCase();
            const rows = document.querySelectorAll('.role-row');

            rows.forEach(row => {
                const text = row.textContent.toLowerCase();
                row.style.display = text.includes(searchTerm) ? '' : 'none';
            });
        });

        // Toggle active status
        async function toggleActive(roleId, roleName, isActive) {
            if (roleName === 'SuperAdmin') {
                alert('System Error: SuperAdmin status cannot be modified.');
                return;
            }

            const action = isActive ? 'deactivate' : 'activate';
            if (!confirm(`Are you sure you want to ${action} the role "${roleName}"?`)) {
                return;
            }

            try {
                const response = await fetch('/Admin/Roles/ToggleActive', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id: roleId })
                });
                const result = await response.json();

                if (result.success) {
                    location.reload();
                } else {
                    alert(result.message || 'Operation failed.');
                }
            } catch (error) {
                alert('Connection error while updating status.');
            }
        }

        // Delete role
        async function deleteRole(roleId, roleName) {
            if (roleName === 'SuperAdmin') {
                alert('System Error: SuperAdmin role cannot be deleted.');
                return;
            }

            if (!confirm(`WARNING: Are you sure you want to delete the role "${roleName}"? Users with this role will lose their assigned permissions.`)) {
                return;
            }

            try {
                const response = await fetch('/Admin/Roles/Delete?id=' + roleId, { method: 'POST' });
                const result = await response.json();

                if (result.success) {
                    location.reload();
                } else {
                    alert(result.message || 'Deletion failed.');
                }
            } catch (error) {
                alert('Connection error while deleting role.');
            }
        }
    </script>
}