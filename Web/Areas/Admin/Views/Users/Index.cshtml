@model List<Domain.Entities.User.User>

@{
    var isRtl = System.Globalization.CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    var rawTitle = (ViewData["Title"] as string) ?? "Users";
    var localizedTitle = rawTitle switch
    {
        "Students" => Localizer["Students"].Value,
        "Admin Users" => Localizer["AdminUsers"].Value,
        _ => Localizer["Users"].Value
    };
    ViewData["Title"] = localizedTitle;
    var pageDescription = rawTitle switch
    {
        "Students" => Localizer["StudentsDescription"].Value,
        "Admin Users" => Localizer["AdminUsersDescription"].Value,
        _ => ""
    };
}

<div class="animate-[fadeIn_0.4s_ease_forwards] w-full text-start" dir="@(isRtl ? "rtl" : "ltr")">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-8">
        <div>
            <h1 class="text-3xl font-extrabold bg-gradient-to-r from-brand-cyan to-brand-blue bg-clip-text text-transparent mb-2 tracking-wide">
                @localizedTitle
            </h1>
            @if (!string.IsNullOrWhiteSpace(pageDescription))
            {
                <p class="text-slate-400 text-sm font-medium">@pageDescription</p>
            }
        </div>

        <div class="flex flex-col sm:flex-row sm:items-center gap-4 w-full md:w-auto">
            <div class="relative w-full sm:w-80 group">
                <input type="text" id="searchInput" placeholder="@Localizer["SearchUsersPlaceholder"]"
                       class="w-full bg-dark-bg/60 border border-white/10 rounded-xl px-4 py-2.5 @(isRtl ? "pr-11 pl-4" : "pl-11 pr-4") text-white placeholder-slate-500 focus:outline-none focus:border-brand-cyan/50 focus:ring-2 focus:ring-brand-cyan/20 transition-all text-sm font-medium backdrop-blur-md">
                <i class="fas fa-search absolute @(isRtl ? "right-4" : "left-4") top-1/2 transform -translate-y-1/2 text-slate-500 group-focus-within:text-brand-cyan transition-colors"></i>
            </div>

            <a asp-action="Create" class="w-full sm:w-auto text-center px-6 py-2.5 bg-gradient-to-r from-brand-cyan to-brand-blue rounded-xl text-dark-bg font-extrabold hover:shadow-[0_0_20px_rgba(66,234,255,0.4)] hover:scale-[1.02] transition-all duration-300 whitespace-nowrap text-sm flex items-center justify-center">
                <i class="fas fa-user-plus @(isRtl ? "ml-2" : "mr-2") text-lg"></i>
                @Localizer["AddUser"]
            </a>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">

        <div class="relative p-5 rounded-3xl bg-white/[0.02] border border-white/[0.05] hover:border-brand-blue/30 transition-all duration-300 hover:-translate-y-1 group overflow-hidden">
            <div class="absolute @(isRtl ? "-left-6" : "-right-6") -top-6 w-24 h-24 bg-brand-blue/10 rounded-full blur-2xl group-hover:bg-brand-blue/20 transition-all"></div>
            <div class="flex items-center justify-between mb-4 relative z-10">
                <div>
                    <p class="text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1">@Localizer["TotalUsers"]</p>
                    <p class="text-3xl font-extrabold text-white">@Model.Count</p>
                </div>
                <div class="w-12 h-12 rounded-2xl bg-brand-blue/10 border border-brand-blue/20 flex items-center justify-center shadow-[inset_0_0_15px_rgba(66,114,255,0.1)] group-hover:scale-110 transition-transform">
                    <i class="fas fa-users text-brand-blue text-xl"></i>
                </div>
            </div>
        </div>

        <div class="relative p-5 rounded-3xl bg-white/[0.02] border border-white/[0.05] hover:border-emerald-500/30 transition-all duration-300 hover:-translate-y-1 group overflow-hidden">
            <div class="absolute @(isRtl ? "-left-6" : "-right-6") -top-6 w-24 h-24 bg-emerald-500/10 rounded-full blur-2xl group-hover:bg-emerald-500/20 transition-all"></div>
            <div class="flex items-center justify-between mb-4 relative z-10">
                <div>
                    <p class="text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1">@Localizer["ActiveUsers"]</p>
                    <p class="text-3xl font-extrabold text-white">@Model.Count(u => !u.IsBan)</p>
                </div>
                <div class="w-12 h-12 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center shadow-[inset_0_0_15px_rgba(16,185,129,0.1)] group-hover:scale-110 transition-transform">
                    <i class="fas fa-user-check text-emerald-400 text-xl"></i>
                </div>
            </div>
        </div>

        <div class="relative p-5 rounded-3xl bg-white/[0.02] border border-white/[0.05] hover:border-rose-500/30 transition-all duration-300 hover:-translate-y-1 group overflow-hidden">
            <div class="absolute @(isRtl ? "-left-6" : "-right-6") -top-6 w-24 h-24 bg-rose-500/10 rounded-full blur-2xl group-hover:bg-rose-500/20 transition-all"></div>
            <div class="flex items-center justify-between mb-4 relative z-10">
                <div>
                    <p class="text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1">@Localizer["IsBan"]</p>
                    <p class="text-3xl font-extrabold text-white">@Model.Count(u => u.IsBan)</p>
                </div>
                <div class="w-12 h-12 rounded-2xl bg-rose-500/10 border border-rose-500/20 flex items-center justify-center shadow-[inset_0_0_15px_rgba(244,63,94,0.1)] group-hover:scale-110 transition-transform">
                    <i class="fas fa-user-lock text-rose-400 text-xl"></i>
                </div>
            </div>
        </div>

        <div class="relative p-5 rounded-3xl bg-white/[0.02] border border-white/[0.05] hover:border-brand-yellow/30 transition-all duration-300 hover:-translate-y-1 group overflow-hidden">
            <div class="absolute @(isRtl ? "-left-6" : "-right-6") -top-6 w-24 h-24 bg-brand-yellow/10 rounded-full blur-2xl group-hover:bg-brand-yellow/20 transition-all"></div>
            <div class="flex items-center justify-between mb-4 relative z-10">
                <div>
                    <p class="text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1">@Localizer["RegisteredOn"]</p>
                    <p class="text-3xl font-extrabold text-white">@Model.Count(u => u.RegisterDate.Date == DateTime.Today)</p>
                </div>
                <div class="w-12 h-12 rounded-2xl bg-brand-yellow/10 border border-brand-yellow/20 flex items-center justify-center shadow-[inset_0_0_15px_rgba(255,179,67,0.1)] group-hover:scale-110 transition-transform">
                    <i class="fas fa-calendar-plus text-brand-yellow text-xl"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="p-1 rounded-3xl bg-white/[0.02] border border-white/[0.05] relative shadow-2xl">
        <div class="bg-dark-bg/60 rounded-[22px] overflow-hidden backdrop-blur-xl">
            <div class="overflow-x-auto custom-scrollbar">
                <table class="w-full text-start border-collapse">
                    <thead>
                        <tr class="bg-white/[0.02] border-b border-white/[0.05]">
                            <th class="px-6 py-5 text-[10px] font-bold text-slate-500 uppercase tracking-widest text-start">@Localizer["UserProfile"]</th>
                            <th class="px-6 py-5 text-[10px] font-bold text-slate-500 uppercase tracking-widest text-start">@Localizer["AccountInformation"]</th>
                            <th class="px-6 py-5 text-[10px] font-bold text-slate-500 uppercase tracking-widest text-start">@Localizer["RegisteredOn"]</th>
                            <th class="px-6 py-5 text-[10px] font-bold text-slate-500 uppercase tracking-widest text-start">@Localizer["Status"]</th>
                            <th class="px-6 py-5 text-[10px] font-bold text-slate-500 uppercase tracking-widest @(isRtl ? "text-left" : "text-right")">@Localizer["Actions"]</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-white/[0.02]" id="usersTable">
                        @foreach (var user in Model)
                        {
                            <tr class="hover:bg-white/[0.02] transition-colors duration-200 user-row group" data-user-id="@user.UserId">

                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="flex items-center @(isRtl ? "space-x-reverse" : "space-x-4")">
                                        <div class="w-11 h-11 rounded-full bg-gradient-to-tr from-brand-orange to-brand-yellow flex items-center justify-center text-dark-bg font-extrabold text-lg shadow-[0_0_15px_rgba(255,126,66,0.3)] group-hover:scale-105 transition-transform">
                                            @user.UserName.Substring(0, 1).ToUpper()
                                        </div>
                                        <div>
                                            <div class="font-bold text-white text-sm group-hover:text-brand-cyan transition-colors">@(user.FirstName + " " + user.LastName)</div>
                                            <div class="text-xs font-medium text-slate-500 mt-0.5" dir="ltr">@@@user.UserName</div>
                                        </div>
                                    </div>
                                </td>

                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="flex flex-col gap-2">
                                        <div class="flex items-center @(isRtl ? "space-x-reverse" : "space-x-2")">
                                            <i class="fas fa-envelope text-slate-500 w-3 text-center text-[10px]"></i>
                                            <span class="text-sm text-slate-300 font-medium">@user.Email</span>
                                            @if (user.IsEmailActive)
                                            {
                                                <i class="fas fa-circle-check text-emerald-400 text-xs @(isRtl ? "mr-1" : "ml-1") shadow-[0_0_10px_rgba(16,185,129,0.3)] rounded-full"></i>
                                            }
                                            else
                                            {
                                                <i class="fas fa-circle-exclamation text-brand-yellow text-xs @(isRtl ? "mr-1" : "ml-1")"></i>
                                            }
                                        </div>

                                        <div class="flex items-center @(isRtl ? "space-x-reverse" : "space-x-2")">
                                            <i class="fas fa-phone text-slate-500 w-3 text-center text-[10px]"></i>
                                            <span class="text-sm text-slate-300 font-medium">@user.PhoneNumber</span>
                                            @if (user.IsPhoneNumberActive)
                                            {
                                                <i class="fas fa-circle-check text-emerald-400 text-xs @(isRtl ? "mr-1" : "ml-1") shadow-[0_0_10px_rgba(16,185,129,0.3)] rounded-full"></i>
                                            }
                                            else
                                            {
                                                <i class="fas fa-circle-exclamation text-brand-yellow text-xs @(isRtl ? "mr-1" : "ml-1")"></i>
                                            }
                                        </div>
                                    </div>
                                </td>

                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="flex items-center @(isRtl ? "space-x-reverse" : "space-x-2") bg-white/[0.03] px-3 py-1.5 rounded-lg w-max border border-white/[0.02]">
                                        <i class="far fa-calendar-alt text-brand-cyan text-xs"></i>
                                        <span class="text-xs font-semibold text-slate-300" dir="ltr">@user.RegisterDate.ToString("yyyy/MM/dd")</span>
                                    </div>
                                    <div class="text-[10px] text-slate-500 font-medium mt-1 @(isRtl ? "mr-1" : "ml-1")" dir="ltr">
                                        @user.RegisterDate.ToString("HH:mm tt")
                                    </div>
                                </td>

                                <td class="px-6 py-4 whitespace-nowrap">
                                    @if (user.IsBan)
                                    {
                                        <span class="px-3 py-1.5 inline-flex text-[10px] leading-5 font-bold tracking-wide rounded-lg bg-rose-500/10 text-rose-400 border border-rose-500/20">
                                            <i class="fas fa-lock @(isRtl ? "ml-1.5" : "mr-1.5") mt-0.5"></i> @Localizer["AccountBanned"]
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="px-3 py-1.5 inline-flex text-[10px] leading-5 font-bold tracking-wide rounded-lg bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                                            <i class="fas fa-shield-check @(isRtl ? "ml-1.5" : "mr-1.5") mt-0.5"></i> @Localizer["AccountActive"]
                                        </span>
                                    }
                                </td>

                                <td class="px-6 py-4 whitespace-nowrap @(isRtl ? "text-left" : "text-right")">
                                    <div class="flex items-center @(isRtl ? "justify-start space-x-reverse" : "justify-end space-x-2") opacity-70 group-hover:opacity-100 transition-opacity">

                                        <a asp-action="Details" asp-route-id="@user.UserId"
                                           class="w-8 h-8 rounded-lg bg-brand-cyan/10 text-brand-cyan flex items-center justify-center hover:bg-brand-cyan hover:text-dark-bg hover:shadow-[0_0_15px_rgba(66,234,255,0.4)] transition-all" title="@Localizer["Details"]">
                                            <i class="fas fa-eye text-sm"></i>
                                        </a>

                                        @if (!user.UserName.Equals("Admin", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <a asp-action="Edit" asp-route-id="@user.UserId"
                                               class="w-8 h-8 rounded-lg bg-brand-blue/10 text-brand-blue flex items-center justify-center hover:bg-brand-blue hover:text-white hover:shadow-[0_0_15px_rgba(66,114,255,0.4)] transition-all" title="@Localizer["Edit"]">
                                                <i class="fas fa-pen text-sm"></i>
                                            </a>

                                            <button onclick="toggleBan(@user.UserId, @user.IsBan.ToString().ToLower())"
                                                    class="w-8 h-8 rounded-lg bg-brand-yellow/10 text-brand-yellow flex items-center justify-center hover:bg-brand-yellow hover:text-dark-bg hover:shadow-[0_0_15px_rgba(255,179,67,0.4)] transition-all" title="@(user.IsBan ? Localizer["UnbanAccount"] : Localizer["BanAccount"])">
                                                <i class="fas @(user.IsBan ? "fa-unlock" : "fa-user-lock") text-sm"></i>
                                            </button>

                                            <button onclick="deleteUser(@user.UserId)"
                                                    class="w-8 h-8 rounded-lg bg-rose-500/10 text-rose-400 flex items-center justify-center hover:bg-rose-500 hover:text-white hover:shadow-[0_0_15px_rgba(244,63,94,0.4)] transition-all" title="@Localizer["Delete"]">
                                                <i class="fas fa-trash text-sm"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center px-3 py-1.5 text-[10px] font-bold bg-white/[0.05] text-slate-400 rounded-lg border border-white/[0.05]" title="@Localizer["DefaultSystemRoleNotice"]">
                                                <i class="fas fa-crown text-brand-yellow @(isRtl ? "ml-1.5" : "mr-1.5")"></i> @Localizer["AdminUsers"]
                                            </span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (!Model.Any())
                {
                    <div class="flex flex-col items-center justify-center py-16 px-4">
                        <div class="w-20 h-20 rounded-full bg-white/[0.02] border border-white/[0.05] flex items-center justify-center mb-4">
                            <i class="fas fa-users-slash text-3xl text-slate-500"></i>
                        </div>
                        <h3 class="text-lg font-bold text-white mb-1">@Localizer["NoUsersFound"]</h3>
                        <p class="text-sm text-slate-400 font-medium">@Localizer["NoUsersFoundSub"]</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Search functionality with slight delay for better UX
        document.getElementById('searchInput').addEventListener('input', function(e) {
            const searchTerm = e.target.value.toLowerCase();
            const rows = document.querySelectorAll('.user-row');

            rows.forEach(row => {
                const text = row.textContent.toLowerCase();
                if (text.includes(searchTerm)) {
                    row.style.display = '';
                    row.classList.add('animate-[fadeIn_0.3s_ease]');
                } else {
                    row.style.display = 'none';
                    row.classList.remove('animate-[fadeIn_0.3s_ease]');
                }
            });
        });

        // Toggle ban status
        async function toggleBan(userId, isBan) {
            const actionText = isBan ? 'unban' : 'ban';
            if (!confirm(`Are you sure you want to ${actionText} this user?`)) {
                return;
            }

            try {
                const response = await fetch('/Admin/Users/ToggleBan', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ id: userId })
                });
                const result = await response.json();

                if (result.success) {
                    location.reload();
                } else {
                    alert(result.message || 'Operation failed.');
                }
            } catch (error) {
                alert('Connection error while performing the operation.');
            }
        }

        // Delete user
        async function deleteUser(userId) {
            if (!confirm('Are you sure you want to delete this user? This action cannot be undone.')) {
                return;
            }

            try {
                const response = await fetch('/Admin/Users/Delete?id=' + userId, {
                    method: 'POST'
                });
                const result = await response.json();

                if (result.success) {
                    location.reload();
                } else {
                    alert(result.message || 'Deletion failed.');
                }
            } catch (error) {
                alert('Connection error while performing the operation.');
            }
        }
    </script>
}