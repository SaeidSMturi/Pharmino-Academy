@model Web.Areas.Admin.ViewModels.CreateUserViewModel

@{
    var isRtl = System.Globalization.CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    ViewData["Title"] = Localizer["CreateUser"].Value;
}

<div class="animate-[fadeIn_0.4s_ease_forwards] w-full max-w-4xl mx-auto text-start" dir="@(isRtl ? "rtl" : "ltr")">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6 mb-8">
        <div>
            <h1 class="text-3xl font-extrabold bg-gradient-to-r from-brand-cyan to-brand-blue bg-clip-text text-transparent mb-2 tracking-wide">
                @Localizer["CreateUser"]
            </h1>
            <p class="text-slate-400 text-sm font-medium">@Localizer["CreateUserSub"]</p>
        </div>
        <a asp-action="Students" class="w-full sm:w-auto text-center px-5 py-2.5 bg-white/5 border border-white/5 text-slate-300 rounded-xl hover:bg-white/10 hover:text-white transition-all text-sm font-bold flex items-center justify-center shadow-lg whitespace-nowrap">
            <i class="fas @(isRtl ? "fa-arrow-right ml-2" : "fa-arrow-left mr-2") text-xs"></i>
            @Localizer["BackToList"]
        </a>
    </div>

    <div class="p-1 rounded-3xl bg-white/[0.02] border border-white/[0.05] relative shadow-2xl">
        <div class="bg-dark-bg/60 rounded-[22px] p-6 md:p-8 backdrop-blur-xl">

            <form asp-action="Create" method="post" class="space-y-8">
                @Html.AntiForgeryToken()

                @if (!Html.ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="ModelOnly" class="bg-rose-500/10 border border-rose-500/20 rounded-2xl p-4 text-rose-400 text-sm font-semibold flex items-center @(isRtl ? "space-x-reverse" : "space-x-3") shadow-[0_0_15px_rgba(244,63,94,0.1)]">
                        <i class="fas fa-triangle-exclamation text-lg"></i>
                        <span>@Localizer["PleaseFixErrors"]</span>
                    </div>
                }

                <div>
                    <h3 class="text-sm font-bold text-slate-400 uppercase tracking-widest mb-6 flex items-center">
                        <i class="fas fa-id-badge text-brand-cyan @(isRtl ? "ml-2.5" : "mr-2.5") text-base"></i> @Localizer["AccountInformation"]
                    </h3>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="space-y-2">
                            <label asp-for="UserName" class="block text-xs font-bold text-slate-400 uppercase tracking-wide">
                                @Localizer["UserName"] <span class="text-brand-orange">*</span>
                            </label>
                            <div class="relative group">
                                <input asp-for="UserName" class="w-full bg-dark-bg/50 border border-white/10 rounded-xl px-4 py-3 @(isRtl ? "pr-11 pl-4" : "pl-11 pr-4") text-white placeholder-slate-600 focus:outline-none focus:border-brand-cyan/40 focus:ring-4 focus:ring-brand-cyan/5 transition-all text-sm font-medium border-collapse" placeholder="e.g., saeid_ahmad" />
                                <i class="fas fa-user absolute @(isRtl ? "right-4" : "left-4") top-1/2 transform -translate-y-1/2 text-slate-600 group-focus-within:text-brand-cyan transition-colors text-xs"></i>
                            </div>
                            <span asp-validation-for="UserName" class="text-rose-400 text-xs font-semibold mt-1 block"></span>
                        </div>

                        <div class="space-y-2">
                            <label asp-for="Email" class="block text-xs font-bold text-slate-400 uppercase tracking-wide">
                                @Localizer["EmailAddress"] <span class="text-brand-orange">*</span>
                            </label>
                            <div class="relative group">
                                <input asp-for="Email" type="email" class="w-full bg-dark-bg/50 border border-white/10 rounded-xl px-4 py-3 @(isRtl ? "pr-11 pl-4" : "pl-11 pr-4") text-white placeholder-slate-600 focus:outline-none focus:border-brand-cyan/40 focus:ring-4 focus:ring-brand-cyan/5 transition-all text-sm font-medium" placeholder="name@domain.com" />
                                <i class="fas fa-envelope absolute @(isRtl ? "right-4" : "left-4") top-1/2 transform -translate-y-1/2 text-slate-600 group-focus-within:text-brand-cyan transition-colors text-xs"></i>
                            </div>
                            <span asp-validation-for="Email" class="text-rose-400 text-xs font-semibold mt-1 block"></span>
                        </div>

                        <div class="space-y-2">
                            <label asp-for="FirstName" class="block text-xs font-bold text-slate-400 uppercase tracking-wide">
                                @Localizer["FirstName"]
                            </label>
                            <div class="relative group">
                                <input asp-for="FirstName" class="w-full bg-dark-bg/50 border border-white/10 rounded-xl px-4 py-3 @(isRtl ? "pr-11 pl-4" : "pl-11 pr-4") text-white placeholder-slate-600 focus:outline-none focus:border-brand-cyan/40 focus:ring-4 focus:ring-brand-cyan/5 transition-all text-sm font-medium" placeholder="@Localizer["FirstName"]" />
                                <i class="fas fa-id-card absolute @(isRtl ? "right-4" : "left-4") top-1/2 transform -translate-y-1/2 text-slate-600 group-focus-within:text-brand-cyan transition-colors text-xs"></i>
                            </div>
                            <span asp-validation-for="FirstName" class="text-rose-400 text-xs font-semibold mt-1 block"></span>
                        </div>

                        <div class="space-y-2">
                            <label asp-for="LastName" class="block text-xs font-bold text-slate-400 uppercase tracking-wide">
                                @Localizer["LastName"]
                            </label>
                            <div class="relative group">
                                <input asp-for="LastName" class="w-full bg-dark-bg/50 border border-white/10 rounded-xl px-4 py-3 @(isRtl ? "pr-11 pl-4" : "pl-11 pr-4") text-white placeholder-slate-600 focus:outline-none focus:border-brand-cyan/40 focus:ring-4 focus:ring-brand-cyan/5 transition-all text-sm font-medium" placeholder="@Localizer["LastName"]" />
                                <i class="fas fa-id-card absolute @(isRtl ? "right-4" : "left-4") top-1/2 transform -translate-y-1/2 text-slate-600 group-focus-within:text-brand-cyan transition-colors text-xs"></i>
                            </div>
                            <span asp-validation-for="LastName" class="text-rose-400 text-xs font-semibold mt-1 block"></span>
                        </div>

                        <div class="space-y-2 md:col-span-2">
                            <label asp-for="PhoneNumber" class="block text-xs font-bold text-slate-400 uppercase tracking-wide">
                                @Localizer["PhoneNumber"] <span class="text-brand-orange">*</span>
                            </label>
                            <div class="relative group">
                                <input asp-for="PhoneNumber" class="w-full bg-dark-bg/50 border border-white/10 rounded-xl px-4 py-3 @(isRtl ? "pr-11 pl-4" : "pl-11 pr-4") text-white placeholder-slate-600 focus:outline-none focus:border-brand-cyan/40 focus:ring-4 focus:ring-brand-cyan/5 transition-all text-sm font-medium" placeholder="+971 XX XXX XXXX" />
                                <i class="fas fa-phone absolute @(isRtl ? "right-4" : "left-4") top-1/2 transform -translate-y-1/2 text-slate-600 group-focus-within:text-brand-cyan transition-colors text-xs"></i>
                            </div>
                            <span asp-validation-for="PhoneNumber" class="text-rose-400 text-xs font-semibold mt-1 block"></span>
                        </div>
                    </div>
                </div>

                <div class="border-t border-white/5 pt-6">
                    <h3 class="text-sm font-bold text-slate-400 uppercase tracking-widest mb-6 flex items-center">
                        <i class="fas fa-key text-brand-blue @(isRtl ? "ml-2.5" : "mr-2.5") text-base"></i> @Localizer["Password"]
                    </h3>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="space-y-2">
                            <label asp-for="Password" class="block text-xs font-bold text-slate-400 uppercase tracking-wide">
                                @Localizer["Password"] <span class="text-brand-orange">*</span>
                            </label>
                            <div class="relative group">
                                <input asp-for="Password" type="password" class="w-full bg-dark-bg/50 border border-white/10 rounded-xl px-4 py-3 @(isRtl ? "pr-11 pl-4" : "pl-11 pr-4") text-white placeholder-slate-600 focus:outline-none focus:border-brand-cyan/40 focus:ring-4 focus:ring-brand-cyan/5 transition-all text-sm font-medium" placeholder="••••••••••••" />
                                <i class="fas fa-lock absolute @(isRtl ? "right-4" : "left-4") top-1/2 transform -translate-y-1/2 text-slate-600 group-focus-within:text-brand-cyan transition-colors text-xs"></i>
                            </div>
                            <span asp-validation-for="Password" class="text-rose-400 text-xs font-semibold mt-1 block"></span>
                        </div>

                        <div class="space-y-2">
                            <label asp-for="ConfirmPassword" class="block text-xs font-bold text-slate-400 uppercase tracking-wide">
                                @Localizer["ConfirmPassword"] <span class="text-brand-orange">*</span>
                            </label>
                            <div class="relative group">
                                <input asp-for="ConfirmPassword" type="password" class="w-full bg-dark-bg/50 border border-white/10 rounded-xl px-4 py-3 @(isRtl ? "pr-11 pl-4" : "pl-11 pr-4") text-white placeholder-slate-600 focus:outline-none focus:border-brand-cyan/40 focus:ring-4 focus:ring-brand-cyan/5 transition-all text-sm font-medium" placeholder="••••••••••••" />
                                <i class="fas fa-lock absolute @(isRtl ? "right-4" : "left-4") top-1/2 transform -translate-y-1/2 text-slate-600 group-focus-within:text-brand-cyan transition-colors text-xs"></i>
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-rose-400 text-xs font-semibold mt-1 block"></span>
                        </div>
                    </div>
                </div>

                <div class="border-t border-white/5 pt-6">
                    <h3 class="text-sm font-bold text-slate-400 uppercase tracking-widest mb-6 flex items-center">
                        <i class="fas fa-sliders text-brand-yellow @(isRtl ? "ml-2.5" : "mr-2.5") text-base"></i> @Localizer["AccountStatusAndVerification"]
                    </h3>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <label class="flex items-center @(isRtl ? "space-x-reverse" : "space-x-3") bg-white/[0.01] border border-white/5 p-4 rounded-xl cursor-pointer hover:bg-white/[0.03] transition-colors group">
                            <input asp-for="IsEmailActive" type="checkbox" class="w-4 h-4 rounded border-white/10 bg-dark-bg text-brand-cyan focus:ring-brand-cyan/20 focus:ring-offset-0" />
                            <span class="text-xs font-bold text-slate-400 group-hover:text-slate-200 transition-colors flex items-center">
                                <i class="fas fa-envelope-circle-check @(isRtl ? "ml-2" : "mr-2") text-slate-500 text-sm group-hover:text-brand-cyan transition-colors"></i>
                                @Localizer["IsEmailActive"]
                            </span>
                        </label>

                        <label class="flex items-center @(isRtl ? "space-x-reverse" : "space-x-3") bg-white/[0.01] border border-white/5 p-4 rounded-xl cursor-pointer hover:bg-white/[0.03] transition-colors group">
                            <input asp-for="IsPhoneNumberActive" type="checkbox" class="w-4 h-4 rounded border-white/10 bg-dark-bg text-brand-cyan focus:ring-brand-cyan/20 focus:ring-offset-0" />
                            <span class="text-xs font-bold text-slate-400 group-hover:text-slate-200 transition-colors flex items-center">
                                <i class="fas fa-phone-circle-check @(isRtl ? "ml-2" : "mr-2") text-slate-500 text-sm group-hover:text-brand-cyan transition-colors"></i>
                                @Localizer["IsPhoneNumberActive"]
                            </span>
                        </label>

                        <label class="flex items-center @(isRtl ? "space-x-reverse" : "space-x-3") bg-white/[0.01] border border-white/5 p-4 rounded-xl cursor-pointer hover:bg-white/[0.03] transition-colors group">
                            <input asp-for="IsBan" type="checkbox" class="w-4 h-4 rounded border-white/10 bg-dark-bg text-rose-500 focus:ring-rose-500/20 focus:ring-offset-0" />
                            <span class="text-xs font-bold text-slate-400 group-hover:text-slate-200 transition-colors flex items-center">
                                <i class="fas fa-ban @(isRtl ? "ml-2" : "mr-2") text-slate-500 text-sm group-hover:text-rose-400 transition-colors"></i>
                                @Localizer["IsBan"]
                            </span>
                        </label>
                    </div>
                </div>

                <div class="flex flex-col-reverse sm:flex-row sm:items-center sm:justify-end gap-4 pt-6 border-t border-white/5">
                    <a asp-action="Students" class="w-full sm:w-auto text-center px-5 py-2.5 bg-white/5 border border-white/5 text-slate-300 rounded-xl hover:bg-white/10 hover:text-white transition-all text-xs font-bold flex items-center justify-center">
                        <i class="fas fa-times @(isRtl ? "ml-1.5" : "mr-1.5") text-[10px]"></i> @Localizer["Cancel"]
                    </a>
                    <button type="submit" class="w-full sm:w-auto text-center px-6 py-2.5 bg-gradient-to-r from-brand-cyan to-brand-blue text-dark-bg font-black text-xs rounded-xl hover:shadow-[0_0_20px_rgba(66,234,255,0.3)] hover:scale-[1.01] transition-all flex items-center justify-center">
                        <i class="fas fa-save @(isRtl ? "ml-1.5" : "mr-1.5") text-sm"></i> @Localizer["CreateUser"]
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}