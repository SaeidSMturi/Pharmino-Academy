@using Infrastructure.Persistence
@using Microsoft.EntityFrameworkCore
@using Application.Interfaces
@using System.Security.Claims
@inject IApplicationDbContext _context
@inject IPermissionService _permissionService

@{
    var isRtl = System.Globalization.CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    ViewData["Title"] = Localizer["AdminDashboard"].Value;

    // Get current user ID
    var userIdClaim = User.FindFirst(ClaimTypes.NameIdentifier);
    var currentUserId = userIdClaim != null ? int.Parse(userIdClaim.Value) : 0;

    // Check user permissions
    var canViewUsers = await _permissionService.UserHasPermissionAsync(currentUserId, "Users.View");
    var canViewPosts = await _permissionService.UserHasPermissionAsync(currentUserId, "Dashboard.View");
    var canViewActivities = await _permissionService.UserHasPermissionAsync(currentUserId, "Dashboard.View");

    // Get data based on permissions
    var totalUsers = canViewUsers ? _context.Users.Count() : 0;
    var totalPosts = canViewPosts ? (_context.Posts?.Count() ?? 0) : 0;
    var totalVisitors = _context.Visitors.Count();
    var recentActivitiesCount = canViewActivities ? _context.RecentActivities.Count() : 0;

    var recentUsers = canViewUsers ? _context.Users.OrderByDescending(u => u.RegisterDate).Take(5).ToList() : new List<Domain.Entities.User.User>();
    var recentPosts = canViewPosts ? (_context.Posts?.Include(p => p.User).OrderByDescending(p => p.CreateDate).Take(5).ToList() ?? new List<Domain.Entities.Post.Post>()) : new List<Domain.Entities.Post.Post>();
    var recentActivities = canViewActivities ? _context.RecentActivities.Include(a => a.RecentActivityPriority).OrderByDescending(a => a.CreateDate).Take(5).ToList() : new List<Domain.Entities.RecentActivity.RecentActivity>();
}

<div class="animate-[fadeIn_0.5s_ease_forwards] w-full text-start">

    <div class="mb-8 lg:hidden">
        <h1 class="text-3xl font-extrabold bg-gradient-to-r from-brand-cyan to-brand-blue bg-clip-text text-transparent mb-2 tracking-wide">
            @Localizer["DashboardOverview"]
        </h1>
        <p class="text-slate-400 text-sm font-medium">@Localizer["DashboardOverviewSub"]</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">

        @if (canViewUsers)
        {
            <div class="relative p-6 rounded-3xl bg-white/[0.02] border border-white/[0.05] hover:border-brand-cyan/30 transition-all duration-300 hover:shadow-[0_10px_30px_-10px_rgba(66,234,255,0.2)] hover:-translate-y-1 group overflow-hidden">
                <div class="absolute -right-6 -top-6 w-24 h-24 bg-brand-cyan/10 rounded-full blur-2xl group-hover:bg-brand-cyan/20 transition-all"></div>
                <div class="flex items-center justify-between mb-6 relative z-10">
                    <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-brand-cyan/20 to-brand-blue/20 border border-brand-cyan/20 flex items-center justify-center shadow-[inset_0_0_15px_rgba(66,234,255,0.1)]">
                        <i class="fas fa-users-rays text-brand-cyan text-xl group-hover:scale-110 transition-transform"></i>
                    </div>
                    <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500">@Localizer["TotalUsers"]</span>
                </div>
                <h3 class="text-4xl font-extrabold text-white mb-1 tracking-tight font-sans">@totalUsers.ToString("N0")</h3>
                <p class="text-sm text-slate-400 font-medium flex items-center">
                    <span class="text-emerald-400 @(isRtl ? "ml-2" : "mr-2") text-xs"><i class="fas fa-arrow-up"></i> @Localizer["Active"]</span> @Localizer["Registered"]
                </p>
            </div>
        }

        @if (canViewPosts)
        {
            <div class="relative p-6 rounded-3xl bg-white/[0.02] border border-white/[0.05] hover:border-brand-blue/30 transition-all duration-300 hover:shadow-[0_10px_30px_-10px_rgba(66,114,255,0.2)] hover:-translate-y-1 group overflow-hidden">
                <div class="absolute -right-6 -top-6 w-24 h-24 bg-brand-blue/10 rounded-full blur-2xl group-hover:bg-brand-blue/20 transition-all"></div>
                <div class="flex items-center justify-between mb-6 relative z-10">
                    <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-brand-blue/20 to-indigo-500/20 border border-brand-blue/20 flex items-center justify-center shadow-[inset_0_0_15px_rgba(66,114,255,0.1)]">
                        <i class="fas fa-newspaper text-brand-blue text-xl group-hover:scale-110 transition-transform"></i>
                    </div>
                    <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500">@Localizer["TotalContent"]</span>
                </div>
                <h3 class="text-4xl font-extrabold text-white mb-1 tracking-tight font-sans">@totalPosts.ToString("N0")</h3>
                <p class="text-sm text-slate-400 font-medium flex items-center">
                    <span class="text-brand-cyan @(isRtl ? "ml-2" : "mr-2") text-xs"><i class="fas fa-check-circle"></i> @Localizer["Published"]</span> @Localizer["Articles"]
                </p>
            </div>
        }

        <div class="relative p-6 rounded-3xl bg-white/[0.02] border border-white/[0.05] hover:border-brand-orange/30 transition-all duration-300 hover:shadow-[0_10px_30px_-10px_rgba(255,126,66,0.2)] hover:-translate-y-1 group overflow-hidden">
            <div class="absolute -right-6 -top-6 w-24 h-24 bg-brand-orange/10 rounded-full blur-2xl group-hover:bg-brand-orange/20 transition-all"></div>
            <div class="flex items-center justify-between mb-6 relative z-10">
                <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-brand-orange/20 to-brand-yellow/20 border border-brand-orange/20 flex items-center justify-center shadow-[inset_0_0_15px_rgba(255,126,66,0.1)]">
                    <i class="fas fa-chart-pie text-brand-orange text-xl group-hover:scale-110 transition-transform"></i>
                </div>
                <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500">@Localizer["TotalVisits"]</span>
            </div>
            <h3 class="text-4xl font-extrabold text-white mb-1 tracking-tight font-sans">@totalVisitors.ToString("N0")</h3>
            <p class="text-sm text-slate-400 font-medium flex items-center">
                <span class="text-brand-yellow @(isRtl ? "ml-2" : "mr-2") text-xs"><i class="fas fa-eye"></i> @Localizer["Tracked"]</span> @Localizer["Views"]
            </p>
        </div>

        @if (canViewActivities)
        {
            <div class="relative p-6 rounded-3xl bg-white/[0.02] border border-white/[0.05] hover:border-brand-yellow/30 transition-all duration-300 hover:shadow-[0_10px_30px_-10px_rgba(255,179,67,0.2)] hover:-translate-y-1 group overflow-hidden">
                <div class="absolute -right-6 -top-6 w-24 h-24 bg-brand-yellow/10 rounded-full blur-2xl group-hover:bg-brand-yellow/20 transition-all"></div>
                <div class="flex items-center justify-between mb-6 relative z-10">
                    <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-brand-yellow/20 to-brand-orange/20 border border-brand-yellow/20 flex items-center justify-center shadow-[inset_0_0_15px_rgba(255,179,67,0.1)]">
                        <i class="fas fa-bolt text-brand-yellow text-xl group-hover:scale-110 transition-transform"></i>
                    </div>
                    <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500">@Localizer["SystemLogs"]</span>
                </div>
                <h3 class="text-4xl font-extrabold text-white mb-1 tracking-tight font-sans">@recentActivitiesCount.ToString("N0")</h3>
                <p class="text-sm text-slate-400 font-medium flex items-center">
                    <span class="text-slate-300 @(isRtl ? "ml-2" : "mr-2") text-xs"><i class="fas fa-history"></i> @Localizer["Recorded"]</span> @Localizer["Actions"]
                </p>
            </div>
        }
    </div>

    <div class="grid grid-cols-1 xl:grid-cols-2 gap-6 mb-8">

        @if (canViewUsers)
        {
            <div class="p-6 md:p-8 rounded-3xl bg-white/[0.02] border border-white/[0.05] relative overflow-hidden group/card">
                <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-brand-cyan/0 via-brand-cyan/50 to-brand-cyan/0 opacity-0 group-hover/card:opacity-100 transition-opacity duration-500"></div>

                <div class="flex items-center justify-between mb-8">
                    <h2 class="text-lg font-bold text-white flex items-center">
                        <i class="fas fa-user-plus @(isRtl ? "ml-3" : "mr-3") text-brand-cyan text-xl"></i>
                        @Localizer["RecentUsers"]
                    </h2>
                    <a asp-area="Admin" asp-controller="Users" asp-action="Students" class="text-xs font-bold uppercase tracking-wider text-brand-cyan hover:text-white transition-colors flex items-center group/link">
                        @Localizer["ViewAll"]
                        <i class="fas @(isRtl ? "fa-arrow-left mr-2" : "fa-arrow-right ml-2") group-hover/link:translate-x-1 transition-transform"></i>
                    </a>
                </div>

                <div class="space-y-3">
                    @if (recentUsers.Any())
                    {
                        @foreach (var user in recentUsers)
                        {
                            <div class="flex items-center justify-between p-4 rounded-2xl bg-white/[0.01] border border-white/[0.03] hover:bg-white/[0.04] hover:border-brand-cyan/20 @(isRtl ? "space-x-reverse" : "") transition-all duration-300 group gap-4">
                                <div class="flex items-center @(isRtl ? "space-x-reverse" : "space-x-4") min-w-0 flex-1">
                                    <div class="flex-shrink-0 w-11 h-11 rounded-full bg-gradient-to-tr from-brand-orange to-brand-yellow flex items-center justify-center text-[#0B0D14] font-bold text-lg shadow-[0_0_15px_rgba(255,126,66,0.2)] group-hover:scale-105 transition-transform">
                                        @user.UserName.Substring(0, 1).ToUpper()
                                    </div>
                                    <div class="min-w-0 flex-1 text-start">
                                        <p class="font-bold text-white truncate text-sm">@(user.FirstName + " " + user.LastName)</p>
                                        <p class="text-xs text-slate-400 truncate mt-0.5 font-medium">@user.Email</p>
                                    </div>
                                </div>
                                <div class="flex flex-col items-end flex-shrink-0">
                                    <span class="text-xs font-semibold text-brand-cyan/80 bg-brand-cyan/10 px-2.5 py-1 rounded-lg">
                                        @Localizer["New"]
                                    </span>
                                    <span class="text-[10px] text-slate-500 mt-1 font-medium font-sans">
                                        @user.RegisterDate.ToString("yyyy/MM/dd")
                                    </span>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="flex flex-col items-center justify-center py-12 px-4 rounded-2xl bg-white/[0.01] border border-white/[0.03] border-dashed">
                            <i class="fas fa-user-slash text-4xl text-slate-600 mb-4"></i>
                            <p class="text-sm font-medium text-slate-400">@Localizer["NoRecentUsers"]</p>
                        </div>
                    }
                </div>
            </div>
        }

        @if (canViewPosts)
        {
            <div class="p-6 md:p-8 rounded-3xl bg-white/[0.02] border border-white/[0.05] relative overflow-hidden group/card">
                <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-brand-blue/0 via-brand-blue/50 to-brand-blue/0 opacity-0 group-hover/card:opacity-100 transition-opacity duration-500"></div>

                <div class="flex items-center justify-between mb-8">
                    <h2 class="text-lg font-bold text-white flex items-center">
                        <i class="fas fa-file-lines @(isRtl ? "ml-3" : "mr-3") text-brand-blue text-xl"></i>
                        @Localizer["RecentContent"]
                    </h2>
                    <a asp-area="Admin" asp-controller="Posts" asp-action="Index" class="text-xs font-bold uppercase tracking-wider text-brand-blue hover:text-white transition-colors flex items-center group/link">
                        @Localizer["ViewAll"]
                        <i class="fas @(isRtl ? "fa-arrow-left mr-2" : "fa-arrow-right ml-2") group-hover/link:translate-x-1 transition-transform"></i>
                    </a>
                </div>

                <div class="space-y-3">
                    @if (recentPosts != null && recentPosts.Any())
                    {
                        @foreach (var post in recentPosts)
                        {
                            <div class="flex flex-col justify-center p-4 rounded-2xl bg-white/[0.01] border border-white/[0.03] hover:bg-white/[0.04] hover:border-brand-blue/20 transition-all duration-300 group">
                                <div class="flex items-start justify-between mb-3 gap-4 min-w-0 @(isRtl ? "space-x-reverse" : "")">
                                    <h3 class="font-bold text-white text-sm truncate flex-1 group-hover:text-brand-blue transition-colors text-start">@post.Title</h3>
                                    @if (post.IsPublish)
                                    {
                                        <span class="text-[10px] font-bold tracking-wide bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 px-2.5 py-1.5 rounded-lg flex-shrink-0">
                                            <i class="fas fa-check @(isRtl ? "ml-1" : "mr-1")"></i> @Localizer["Published"]
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-[10px] font-bold tracking-wide bg-brand-yellow/10 border border-brand-yellow/20 text-brand-yellow px-2.5 py-1.5 rounded-lg flex-shrink-0">
                                            <i class="fas fa-pen @(isRtl ? "ml-1" : "mr-1")"></i> @Localizer["Draft"]
                                        </span>
                                    }
                                </div>
                                <div class="flex items-center justify-between text-xs font-medium text-slate-400 gap-3 min-w-0 mt-1 @(isRtl ? "space-x-reverse" : "")">
                                    <span class="truncate flex items-center bg-white/[0.03] px-2.5 py-1 rounded-md @(isRtl ? "space-x-reverse" : "")">
                                        <i class="fas fa-user text-slate-500 @(isRtl ? "ml-2" : "mr-2") text-[10px]"></i>
                                        @post.User.UserName
                                    </span>
                                    <span class="flex-shrink-0 flex items-center font-sans @(isRtl ? "space-x-reverse" : "")">
                                        <i class="far fa-calendar text-slate-500 @(isRtl ? "ml-1.5" : "mr-1.5")"></i>
                                        @post.CreateDate.ToString("yyyy/MM/dd")
                                    </span>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="flex flex-col items-center justify-center py-12 px-4 rounded-2xl bg-white/[0.01] border border-white/[0.03] border-dashed">
                            <i class="fas fa-folder-open text-4xl text-slate-600 mb-4"></i>
                            <p class="text-sm font-medium text-slate-400">@Localizer["NoRecentPosts"]</p>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    @if (canViewActivities)
    {
        <div class="p-6 md:p-8 rounded-3xl bg-white/[0.02] border border-white/[0.05] relative overflow-hidden group/card">
            <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-brand-orange/0 via-brand-orange/50 to-brand-orange/0 opacity-0 group-hover/card:opacity-100 transition-opacity duration-500"></div>

            <div class="flex items-center justify-between mb-8">
                <h2 class="text-lg font-bold text-white flex items-center">
                    <i class="fas fa-wave-square @(isRtl ? "ml-3" : "mr-3") text-brand-orange text-xl"></i>
                    @Localizer["SystemLogsAndActivities"]
                </h2>
                <a asp-area="Admin" asp-controller="Activities" asp-action="Index" class="text-xs font-bold uppercase tracking-wider text-brand-orange hover:text-white transition-colors flex items-center group/link">
                    @Localizer["ViewLogs"]
                    <i class="fas @(isRtl ? "fa-arrow-left mr-2" : "fa-arrow-right ml-2") group-hover/link:translate-x-1 transition-transform"></i>
                </a>
            </div>

            <div class="space-y-3">
                @if (recentActivities.Any())
                {
                    @foreach (var activity in recentActivities)
                    {
                        <div class="flex items-start p-4 rounded-2xl bg-white/[0.01] border border-white/[0.03] hover:bg-white/[0.04] hover:border-brand-orange/20 @(isRtl ? "space-x-reverse" : "") transition-all duration-300 min-w-0 gap-4 group">

                            <div class="flex-shrink-0 mt-1">
                                @if (activity.PriorityId == 1)
                                {
                                    <div class="w-8 h-8 rounded-full bg-rose-500/10 border border-rose-500/30 flex items-center justify-center shadow-[0_0_10px_rgba(244,63,94,0.2)]">
                                        <i class="fas fa-exclamation text-rose-400 text-[10px]"></i>
                                    </div>
                                }
                                else if (activity.PriorityId == 2)
                                {
                                    <div class="w-8 h-8 rounded-full bg-brand-yellow/10 border border-brand-yellow/30 flex items-center justify-center shadow-[0_0_10px_rgba(255,179,67,0.2)]">
                                        <i class="fas fa-triangle-exclamation text-brand-yellow text-[10px]"></i>
                                    </div>
                                }
                                else
                                {
                                    <div class="w-8 h-8 rounded-full bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center shadow-[0_0_10px_rgba(16,185,129,0.2)]">
                                        <i class="fas fa-info text-emerald-400 text-[10px]"></i>
                                    </div>
                                }
                            </div>

                            <div class="flex-1 min-w-0 text-start">
                                <p class="text-white text-sm font-medium break-words leading-relaxed group-hover:text-brand-orange/90 transition-colors">
                                    @activity.Message
                                </p>
                                <div class="flex items-center justify-between mt-3 gap-2 min-w-0 @(isRtl ? "space-x-reverse" : "")">
                                    <span class="text-xs font-medium text-slate-500 flex items-center bg-white/[0.03] px-2.5 py-1 rounded-md font-sans @(isRtl ? "space-x-reverse" : "")">
                                        <i class="far fa-clock @(isRtl ? "ml-1.5" : "mr-1.5")"></i> @activity.CreateDate.ToString("yyyy/MM/dd HH:mm")
                                    </span>

                                    <span class="text-[10px] font-bold tracking-wide px-2.5 py-1.5 rounded-lg flex-shrink-0 border
                                        @(activity.PriorityId == 1 ? "bg-rose-500/10 text-rose-400 border-rose-500/20" :
                                            activity.PriorityId == 2 ? "bg-brand-yellow/10 text-brand-yellow border-brand-yellow/20" :
                                            "bg-emerald-500/10 text-emerald-400 border-emerald-500/20")">
                                        @activity.RecentActivityPriority.Title
                                    </span>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="flex flex-col items-center justify-center py-12 px-4 rounded-2xl bg-white/[0.01] border border-white/[0.03] border-dashed">
                        <i class="fas fa-clipboard-list text-4xl text-slate-600 mb-4"></i>
                        <p class="text-sm font-medium text-slate-400">@Localizer["NoSystemActivities"]</p>
                    </div>
                }
            </div>
        </div>
    }

    @if (!canViewUsers && !canViewPosts && !canViewActivities)
    {
        <div class="flex flex-col items-center justify-center py-20 px-4 rounded-3xl bg-white/[0.01] border border-white/[0.05] relative overflow-hidden">
            <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjAiIGhlaWdodD0iMjAiIHhtbG5zPSJodHRwOi8vd3d3LnczLm9yZy8yMDAwL3N2ZyI+PGNpcmNsZSBjeD0iMiIgY3k9IjIiIHI9IjIiIGZpbGw9InJnYmEoMjU1LDI1NSwyNTUsMC4wMykiLz48L3N2Zz4=')] [mask-image:radial-gradient(ellipse_at_center,black_50%,transparent_100%)]"></div>

            <div class="w-24 h-24 rounded-full bg-rose-500/10 border border-rose-500/20 flex items-center justify-center mb-6 relative z-10 shadow-[0_0_30px_rgba(244,63,94,0.2)]">
                <i class="fas fa-shield-halved text-4xl text-rose-400"></i>
            </div>
            <h3 class="text-2xl font-extrabold text-white mb-2 relative z-10 tracking-wide">@Localizer["AccessDenied"]</h3>
            <p class="text-slate-400 mb-6 text-center max-w-md relative z-10 text-sm font-medium leading-relaxed">
                @Localizer["RoleAccessRestrictedSub"]
            </p>
            <button class="relative z-10 px-6 py-2.5 rounded-xl bg-white/[0.05] border border-white/[0.1] text-white text-sm font-bold hover:bg-white/[0.1] hover:border-white/[0.2] transition-all">
                @Localizer["ContactAdmin"]
            </button>
        </div>
    }
</div>