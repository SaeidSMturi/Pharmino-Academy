@model Web.Areas.Admin.ViewModels.BulkTransferViewModel

@{
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.Name;
    var isRtl = currentCulture.StartsWith("fa", StringComparison.OrdinalIgnoreCase) || currentCulture.StartsWith("ar", StringComparison.OrdinalIgnoreCase);
    ViewData["Title"] = Localizer["BulkEnrollmentTransfer"].Value;
}

<div class="fade-in @(isRtl ? "font-fa" : "") text-start" dir="@(isRtl ? "rtl" : "ltr")">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
        <div>
            <h1 class="text-3xl font-bold bg-gradient-to-r from-purple-400 to-pink-400 bg-clip-text text-transparent mb-2">
                @Localizer["BulkEnrollmentTransfer"]
            </h1>
            <p class="text-slate-400">@Localizer["TransferStudentsDesc"]</p>
        </div>
        <div class="flex gap-2">
            <a asp-action="Index"
               class="px-5 py-2.5 bg-slate-700/50 text-slate-300 rounded-lg hover:bg-slate-700 transition-all text-sm whitespace-nowrap flex items-center gap-2">
                <i class="fas @(isRtl ? "fa-arrow-right" : "fa-arrow-left")"></i>
                <span>@Localizer["BackToEnrollments"]</span>
            </a>
        </div>
    </div>

    @if (Model.Result != null)
    {
        @if (Model.Result.IsSuccess)
        {
            <div class="mb-6 p-5 rounded-xl border border-emerald-500/30 bg-emerald-500/10">
                <h4 class="text-emerald-400 font-bold mb-3 flex items-center gap-2">
                    <i class="fas fa-check-circle"></i>
                    <span>@Localizer["TransferCompletedSuccessfully"]</span>
                </h4>
                <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
                    <div class="bg-slate-800/50 rounded-lg p-3 text-center">
                        <p class="text-2xl font-bold text-emerald-400">@Model.Result.Transferred</p>
                        <p class="text-xs text-slate-400 mt-1">@Localizer["Transferred"]</p>
                    </div>
                    <div class="bg-slate-800/50 rounded-lg p-3 text-center">
                        <p class="text-2xl font-bold text-amber-400">@Model.Result.Skipped</p>
                        <p class="text-xs text-slate-400 mt-1">@Localizer["SkippedAlreadyEnrolled"]</p>
                    </div>
                    @if (Model.Result.Removed > 0)
                    {
                        <div class="bg-slate-800/50 rounded-lg p-3 text-center">
                            <p class="text-2xl font-bold text-red-400">@Model.Result.Removed</p>
                            <p class="text-xs text-slate-400 mt-1">@Localizer["RemovedFromSource"]</p>
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="mb-6 p-5 rounded-xl border border-red-500/30 bg-red-500/10">
                <h4 class="text-red-400 font-bold mb-2 flex items-center gap-2">
                    <i class="fas fa-exclamation-triangle"></i>
                    <span>@Localizer["TransferErrors"]</span>
                </h4>
                <ul class="space-y-1">
                    @foreach (var err in Model.Result.Errors)
                    {
                        <li class="text-red-300 text-sm flex items-center gap-1.5"><i class="fas fa-circle-dot text-xs"></i><span>@err</span></li>
                    }
                </ul>
            </div>
        }
    }

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Transfer Form -->
        <div class="lg:col-span-2">
            <form asp-action="BulkTransfer" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="mb-4 p-4 rounded-lg border border-red-500/30 bg-red-500/10 text-red-300 text-sm hidden [&:not(:empty)]:block"></div>

                <!-- Source / Destination -->
                <div class="glass-card rounded-xl p-6 mb-6">
                    <h3 class="text-lg font-bold text-white mb-5 flex items-center gap-3">
                        <i class="fas fa-route text-purple-400"></i>
                        <span>@Localizer["TransferRoute"]</span>
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 items-start">
                        <!-- From -->
                        <div>
                            <label asp-for="FromCourseId" class="text-sm text-slate-400 mb-2 block">@Localizer["FromCourseSource"]</label>
                            <select asp-for="FromCourseId" id="fromCourse" onchange="updatePreview()"
                                    class="w-full px-3 py-2.5 bg-slate-800 border border-slate-700 rounded-lg text-white focus:outline-none focus:border-purple-500 text-sm">
                                <option value="">@Localizer["SelectSource"]</option>
                                @foreach (var c in Model.AvailableCourses)
                                {
                                    <option value="@c.CourseId" data-count="@c.EnrollmentCount">
                                        @c.Title (@c.EnrollmentCount @(isRtl ? "دانشجو" : "enrolled"))
                                    </option>
                                }
                            </select>
                            <span asp-validation-for="FromCourseId" class="text-red-400 text-xs mt-1 block"></span>
                        </div>

                        <!-- Arrow -->
                        <div class="hidden md:flex items-center justify-center pt-8">
                            <div class="flex flex-col items-center">
                                <i class="fas @(isRtl ? "fa-arrow-left" : "fa-arrow-right") text-3xl text-slate-600"></i>
                                <span class="text-xs text-slate-600 mt-1" id="transferCountLabel">— @(isRtl ? "کاربر" : "users")</span>
                            </div>
                        </div>

                        <!-- To (spans full row on md) -->
                        <div class="md:col-start-1">
                            <label asp-for="ToCourseId" class="text-sm text-slate-400 mb-2 block">@Localizer["ToCourseDestination"]</label>
                            <select asp-for="ToCourseId"
                                    class="w-full px-3 py-2.5 bg-slate-800 border border-slate-700 rounded-lg text-white focus:outline-none focus:border-purple-500 text-sm">
                                <option value="">@Localizer["SelectDestination"]</option>
                                @foreach (var c in Model.AvailableCourses)
                                {
                                    <option value="@c.CourseId">
                                        @c.Title (@c.EnrollmentCount @(isRtl ? "دانشجو" : "enrolled"))
                                    </option>
                                }
                            </select>
                            <span asp-validation-for="ToCourseId" class="text-red-400 text-xs mt-1 block"></span>
                        </div>
                    </div>
                </div>

                <!-- Options -->
                <div class="glass-card rounded-xl p-6 mb-6">
                    <h3 class="text-lg font-bold text-white mb-5 flex items-center gap-3">
                        <i class="fas fa-sliders text-blue-400"></i>
                        <span>@Localizer["TransferOptions"]</span>
                    </h3>
                    <div class="space-y-4">
                        <label class="flex items-start gap-3 cursor-pointer p-3 rounded-lg hover:bg-slate-800/50 transition-colors">
                            <input asp-for="OverrideExisting" type="checkbox"
                                   class="mt-1 rounded text-blue-500 focus:ring-blue-500" />
                            <div>
                                <p class="text-white text-sm font-medium">@Localizer["OverrideExistingEnrollments"]</p>
                                <p class="text-slate-500 text-xs mt-0.5">
                                    @Localizer["OverrideExistingDesc"]
                                </p>
                            </div>
                        </label>
                        <label class="flex items-start gap-3 cursor-pointer p-3 rounded-lg hover:bg-slate-800/50 transition-colors">
                            <input asp-for="CopyPaymentInfo" type="checkbox"
                                   class="mt-1 rounded text-blue-500 focus:ring-blue-500" />
                            <div>
                                <p class="text-white text-sm font-medium">@Localizer["CopyPaymentInfo"]</p>
                                <p class="text-slate-500 text-xs mt-0.5">
                                    @Localizer["CopyPaymentInfoDesc"]
                                </p>
                            </div>
                        </label>
                        <label class="flex items-start gap-3 cursor-pointer p-3 rounded-lg hover:bg-slate-800/50 transition-colors border border-red-500/20">
                            <input asp-for="RemoveFromSource" type="checkbox"
                                   class="mt-1 rounded text-red-500 focus:ring-red-500" />
                            <div>
                                <p class="text-red-400 text-sm font-medium flex items-center gap-1.5">
                                    <i class="fas fa-exclamation-triangle text-xs"></i>
                                    <span>@Localizer["RemoveFromSourceAfterTransfer"]</span>
                                </p>
                                <p class="text-slate-500 text-xs mt-0.5">
                                    @Localizer["RemoveFromSourceDesc"]
                                </p>
                            </div>
                        </label>
                    </div>
                </div>

                <!-- Submit -->
                <div class="flex items-center justify-between gap-4">
                    <a asp-action="Index" class="px-5 py-3 bg-slate-700/50 text-slate-300 rounded-lg hover:bg-slate-700 transition-all text-sm">
                        @Localizer["Cancel"]
                    </a>
                    <button type="submit"
                            onclick="return confirmTransfer()"
                            class="px-8 py-3 bg-gradient-to-r from-purple-500 to-pink-500 text-white rounded-lg hover:from-purple-600 hover:to-pink-600 transition-all text-sm font-bold flex items-center gap-2">
                        <i class="fas fa-exchange-alt"></i>
                        <span>@Localizer["ExecuteTransfer"]</span>
                    </button>
                </div>
            </form>
        </div>

        <!-- Info Sidebar -->
        <div class="space-y-5">
            <div class="glass-card rounded-xl p-5">
                <h4 class="text-white font-bold mb-4 flex items-center gap-2">
                    <i class="fas fa-info-circle text-blue-400"></i>
                    <span>@Localizer["HowItWorks"]</span>
                </h4>
                <ol class="space-y-3 text-sm text-slate-400">
                    <li class="flex items-start gap-2">
                        <span class="w-5 h-5 rounded-full bg-purple-500/20 text-purple-400 flex items-center justify-center text-xs flex-shrink-0 mt-0.5">1</span>
                        <span>@(isRtl ? "تمام دانشجویان ثبت‌نام‌شده در دوره مبدا شناسایی می‌شوند." : "All students enrolled in the source course are identified.")</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="w-5 h-5 rounded-full bg-purple-500/20 text-purple-400 flex items-center justify-center text-xs flex-shrink-0 mt-0.5">2</span>
                        <span>@(isRtl ? "ثبت‌نام‌های جدید در دوره مقصد برای هر دانشجو ایجاد می‌شود." : "New enrollments are created in the destination course for each student.")</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="w-5 h-5 rounded-full bg-purple-500/20 text-purple-400 flex items-center justify-center text-xs flex-shrink-0 mt-0.5">3</span>
                        <span>@(isRtl ? "ثبت‌نام‌های جدید با ۰٪ پیشرفت در مقصد آغاز می‌شوند." : "New enrollments start at 0% progress in the destination.")</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="w-5 h-5 rounded-full bg-red-500/20 text-red-400 flex items-center justify-center text-xs flex-shrink-0 mt-0.5">4</span>
                        <span>@(isRtl ? "در صورت فعال بودن «حذف از مبدا»، ثبت‌نام قبلی و پیشرفت ویدیوها پاک خواهد شد." : "If Remove from source is enabled, the source enrollment and video progress are permanently deleted.")</span>
                    </li>
                </ol>
            </div>

            <div class="glass-card rounded-xl p-5">
                <h4 class="text-white font-bold mb-4 flex items-center gap-2">
                    <i class="fas fa-bomb text-red-400"></i>
                    <span>@Localizer["BulkRevoke"]</span>
                </h4>
                <p class="text-slate-400 text-sm mb-4">
                    @Localizer["BulkRevokeDesc"]
                </p>
                <div class="space-y-2">
                    <select id="revokeSelect"
                            class="w-full px-3 py-2.5 bg-slate-800 border border-slate-700 rounded-lg text-white focus:outline-none focus:border-red-500 text-sm">
                        <option value="">@Localizer["SelectCourse"]</option>
                        @foreach (var c in Model.AvailableCourses)
                        {
                            <option value="@c.CourseId" data-count="@c.EnrollmentCount">
                                @c.Title (@c.EnrollmentCount @(isRtl ? "دانشجو" : "enrolled"))
                            </option>
                        }
                    </select>
                    <button onclick="executeBulkRevoke()"
                            class="w-full px-4 py-2.5 bg-red-500/20 text-red-400 rounded-lg hover:bg-red-500/30 transition-colors text-sm font-medium flex items-center justify-center gap-2">
                        <i class="fas fa-user-slash"></i>
                        <span>@Localizer["RevokeAllEnrollments"]</span>
                    </button>
                </div>
                <div id="revokeResult" class="hidden mt-3 p-3 bg-emerald-500/10 border border-emerald-500/30 rounded-lg text-emerald-400 text-sm"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Update the transfer count hint when source course changes
        function updatePreview() {
            const sel = document.getElementById('fromCourse');
            const opt = sel.options[sel.selectedIndex];
            const count = opt?.dataset?.count ?? '0';
            document.getElementById('transferCountLabel').textContent = count + ' users';
        }

        function confirmTransfer() {
            const from = document.getElementById('fromCourse');
            const removeCheck = document.querySelector('[name="RemoveFromSource"]');
            const fromLabel = from.options[from.selectedIndex]?.text ?? 'source';
            if (removeCheck?.checked) {
                return confirm(
                    `⚠️ WARNING: This will remove all enrollments from "${fromLabel}" permanently.\n\n` +
                    `Their video progress in that course will be deleted and cannot be recovered.\n\nContinue?`
                );
            }
            return confirm('Start bulk transfer? This may affect many users.');
        }

        async function executeBulkRevoke() {
            const sel = document.getElementById('revokeSelect');
            const courseId = parseInt(sel.value);
            if (!courseId) { alert('Please select a course.'); return; }
            const opt = sel.options[sel.selectedIndex];
            const count = opt?.dataset?.count ?? '0';
            const label = opt?.text ?? 'this course';
            if (!confirm(`Remove ALL ${count} enrollment(s) from "${label}"?\n\nVideo progress will also be permanently deleted. This cannot be undone.`)) return;

            try {
                const r = await fetch('/Admin/Enrollment/BulkRevoke', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ courseId })
                });
                const result = await r.json();
                const box = document.getElementById('revokeResult');
                if (result.success) {
                    box.textContent = `✓ ${result.message}`;
                    box.className = 'mt-3 p-3 bg-emerald-500/10 border border-emerald-500/30 rounded-lg text-emerald-400 text-sm block';
                    opt.text = opt.text.replace(/\(\d+ enrolled\)/, '(0 enrolled)');
                    opt.dataset.count = '0';
                } else {
                    box.textContent = `✗ ${result.message}`;
                    box.className = 'mt-3 p-3 bg-red-500/10 border border-red-500/30 rounded-lg text-red-400 text-sm block';
                }
            } catch { alert('An error occurred.'); }
        }
    </script>
}
