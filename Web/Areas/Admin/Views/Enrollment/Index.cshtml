@model Web.Areas.Admin.ViewModels.EnrollmentIndexViewModel

@{
    ViewData["Title"] = "Enrollment Management";
}

<div class="animate-[fadeIn_0.4s_ease_forwards] w-full">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-10">
        <div>
            <h1 class="text-3xl font-extrabold bg-gradient-to-r from-brand-cyan to-brand-blue bg-clip-text text-transparent mb-2 tracking-wide">
                Enrollment Management
            </h1>
            <p class="text-slate-400 text-sm font-medium">
                Total course enrollments: <span class="text-brand-cyan font-bold font-mono">@Model.TotalCount</span>
            </p>
        </div>
        <div class="flex flex-wrap gap-3 w-full md:w-auto justify-end">
            <a asp-action="BulkTransfer"
               class="w-full sm:w-auto text-center px-5 py-2.5 bg-brand-orange/10 text-brand-orange border border-brand-orange/20 rounded-xl hover:bg-brand-orange hover:text-dark-bg hover:shadow-[0_0_20px_rgba(255,126,66,0.4)] font-extrabold text-xs transition-all flex items-center justify-center whitespace-nowrap">
                <i class="fas fa-exchange-alt mr-2"></i>Bulk Transfer
            </a>
            <button onclick="openAddModal()"
                    class="w-full sm:w-auto text-center px-6 py-2.5 bg-gradient-to-r from-brand-cyan to-brand-blue rounded-xl text-dark-bg font-extrabold hover:shadow-[0_0_20px_rgba(66,234,255,0.4)] hover:scale-[1.02] transition-all duration-300 whitespace-nowrap text-sm flex items-center justify-center">
                <i class="fas fa-user-plus mr-2 text-lg"></i>Add Enrollment
            </button>
        </div>
    </div>

    <div class="pb-8 mb-8 border-b border-white/5">
        <form method="get" asp-action="Index" class="flex flex-wrap gap-6 items-end">

            <div class="flex-1 min-w-[220px] space-y-2">
                <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wide">Search</label>
                <div class="relative group border-b border-white/10 focus-within:border-brand-cyan/80 transition-colors">
                    <i class="fas fa-search absolute left-2 top-1/2 -translate-y-1/2 text-slate-600 group-focus-within:text-brand-cyan transition-colors text-xs"></i>
                    <input type="text" name="searchQuery" value="@Model.Filter.SearchQuery"
                           placeholder="Student name, email, or course..."
                           class="w-full pl-9 pr-4 py-2.5 bg-transparent text-white placeholder-slate-600 focus:outline-none text-sm font-medium" />
                </div>
            </div>

            <div class="min-w-[180px] space-y-2">
                <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wide">Course</label>
                <div class="border-b border-white/10 focus-within:border-brand-cyan/80 transition-colors">
                    <select name="courseId" class="w-full bg-transparent py-2.5 text-slate-300 focus:outline-none text-sm font-medium cursor-pointer">
                        <option value="" class="bg-[#0B0D14] text-slate-400">All Courses</option>
                        @foreach (var c in Model.Courses)
                        {
                            <option value="@c.CourseId" selected="@(Model.Filter.CourseId == c.CourseId)" class="bg-[#0B0D14] text-white">
                                @c.Title (@c.EnrollmentCount)
                            </option>
                        }
                    </select>
                </div>
            </div>

            <div class="min-w-[140px] space-y-2">
                <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wide">Status</label>
                <div class="border-b border-white/10 focus-within:border-brand-cyan/80 transition-colors">
                    <select name="isCompleted" class="w-full bg-transparent py-2.5 text-slate-300 focus:outline-none text-sm font-medium cursor-pointer">
                        <option value="" class="bg-[#0B0D14] text-slate-400">All Statuses</option>
                        <option value="false" selected="@(Model.Filter.IsCompleted == false)" class="bg-[#0B0D14] text-white">In Progress</option>
                        <option value="true" selected="@(Model.Filter.IsCompleted == true)" class="bg-[#0B0D14] text-white">Completed</option>
                    </select>
                </div>
            </div>

            <div class="min-w-[140px] space-y-2">
                <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wide">Payment Status</label>
                <div class="border-b border-white/10 focus-within:border-brand-cyan/80 transition-colors">
                    <select name="isPaid" class="w-full bg-transparent py-2.5 text-slate-300 focus:outline-none text-sm font-medium cursor-pointer">
                        <option value="" class="bg-[#0B0D14] text-slate-400">All Types</option>
                        <option value="false" selected="@(Model.Filter.IsPaid == false)" class="bg-[#0B0D14] text-white">Free</option>
                        <option value="true" selected="@(Model.Filter.IsPaid == true)" class="bg-[#0B0D14] text-white">Paid</option>
                    </select>
                </div>
            </div>

            <div class="min-w-[160px] space-y-2">
                <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wide">Sort By</label>
                <div class="border-b border-white/10 focus-within:border-brand-cyan/80 transition-colors">
                    <select name="sortBy" class="w-full bg-transparent py-2.5 text-slate-300 focus:outline-none text-sm font-medium cursor-pointer">
                        <option value="date_desc" selected="@(Model.Filter.SortBy == "date_desc")" class="bg-[#0B0D14] text-white">Newest First</option>
                        <option value="date_asc" selected="@(Model.Filter.SortBy == "date_asc")" class="bg-[#0B0D14] text-white">Oldest First</option>
                        <option value="progress_desc" selected="@(Model.Filter.SortBy == "progress_desc")" class="bg-[#0B0D14] text-white">Progress: High to Low</option>
                        <option value="progress_asc" selected="@(Model.Filter.SortBy == "progress_asc")" class="bg-[#0B0D14] text-white">Progress: Low to High</option>
                        <option value="name_asc" selected="@(Model.Filter.SortBy == "name_asc")" class="bg-[#0B0D14] text-white">Student Name: A–Z</option>
                        <option value="course_asc" selected="@(Model.Filter.SortBy == "course_asc")" class="bg-[#0B0D14] text-white">Course Title: A–Z</option>
                    </select>
                </div>
            </div>

            <div class="flex gap-2 self-end">
                <button type="submit" class="px-5 py-2.5 bg-brand-cyan/10 border border-brand-cyan/20 text-brand-cyan rounded-xl hover:bg-brand-cyan hover:text-dark-bg transition-all text-xs font-bold shadow-md">
                    <i class="fas fa-filter mr-1.5"></i>Apply Filter
                </button>
                <a asp-action="Index" class="px-4 py-2.5 bg-white/5 border border-white/5 text-slate-400 rounded-xl hover:text-white hover:bg-white/10 transition-all text-xs flex items-center justify-center">
                    <i class="fas fa-rotate-left"></i>
                </a>
            </div>
        </form>
    </div>

    <div class="space-y-3">
        @if (Model.Enrollments.Any())
        {
            @foreach (var row in Model.Enrollments)
            {
                <div class="p-4 rounded-2xl bg-white/[0.01] border border-white/[0.03] hover:bg-white/[0.02] hover:border-white/10 transition-all duration-200" id="row-@row.EnrollmentId">
                    <div class="grid grid-cols-1 md:grid-cols-12 items-center gap-4">

                        <div class="md:col-span-3 min-w-0">
                            <a asp-area="Admin" asp-controller="Users" asp-action="Details" asp-route-id="@row.UserId" class="flex items-center space-x-3 group">
                                <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-brand-orange to-brand-yellow flex items-center justify-center text-dark-bg font-extrabold text-sm flex-shrink-0 shadow-[0_0_12px_rgba(255,126,66,0.2)]">
                                    @(row.UserFullName.FirstOrDefault().ToString().ToUpper())
                                </div>
                                <div class="min-w-0">
                                    <p class="text-white text-sm font-bold group-hover:text-brand-cyan transition-colors truncate">
                                        @row.UserFullName.Trim()
                                    </p>
                                    <p class="text-slate-500 text-xs truncate mt-0.5 font-medium">@row.UserEmail</p>
                                </div>
                            </a>
                        </div>

                        <div class="md:col-span-3 min-w-0">
                            <a asp-area="Admin" asp-controller="Courses" asp-action="Details" asp-route-id="@row.CourseId" class="group block">
                                <p class="text-slate-200 text-sm font-bold group-hover:text-brand-blue transition-colors truncate">
                                    @row.CourseTitle
                                </p>
                                @if (!row.CourseIsActive)
                                {
                                    <span class="inline-flex items-center text-[10px] font-bold text-rose-400 mt-0.5"><i class="fas fa-circle text-[5px] mr-1.5 animate-pulse"></i>Inactive Course</span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center text-[10px] font-bold text-emerald-400 mt-0.5"><i class="fas fa-circle text-[5px] mr-1.5"></i>Active Course</span>
                                }
                            </a>
                        </div>

                        <div class="md:col-span-2 text-slate-400 font-medium text-xs whitespace-nowrap">
                            <div class="flex items-center space-x-1.5"><i class="far fa-calendar text-brand-cyan text-[10px]"></i><span>@row.EnrollmentDate.ToString("yyyy/MM/dd")</span></div>
                            <div class="text-[10px] text-slate-600 mt-1 ml-4 font-mono font-semibold">@row.EnrollmentDate.ToString("HH:mm")</div>
                        </div>

                        <div class="md:col-span-2">
                            <div class="flex items-center space-x-3">
                                <span class="text-xs font-bold @(row.IsCompleted ? "text-emerald-400" : "text-brand-blue") w-10 text-right">
                                    @row.ProgressPercentage%
                                </span>
                                <div class="w-20 h-1 bg-white/5 rounded-full overflow-hidden shadow-inner flex-shrink-0">
                                    <div class="h-full @(row.IsCompleted ? "bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.5)]" : "bg-brand-blue shadow-[0_0_8px_rgba(66,114,255,0.5)]") rounded-full"
                                         style="width: @row.ProgressPercentage%"></div>
                                </div>
                            </div>
                            @if (row.CompletionDate.HasValue)
                            {
                                <p class="text-[9px] text-slate-600 font-mono font-bold mt-1 ml-10">Completed @row.CompletionDate.Value.ToString("yyyy/MM/dd")</p>
                            }
                        </div>

                        <div class="md:col-span-1 whitespace-nowrap">
                            @if (row.IsPaid)
                            {
                                <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[10px] font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/10">
                                    <i class="fas fa-coins mr-1"></i>$@row.PaymentAmount?.ToString("N0")
                                </span>
                            }
                            else
                            {
                                <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[10px] font-bold bg-brand-yellow/10 text-brand-yellow border border-brand-yellow/10 uppercase tracking-wide">
                                    <i class="fas fa-gift mr-1"></i>Free
                                </span>
                            }
                        </div>

                        <div class="md:col-span-1 text-right whitespace-nowrap">
                            <button onclick="removeEnrollmentRow(@row.EnrollmentId, '@row.UserFullName.Trim().Replace("'", "\\'")', '@row.CourseTitle.Replace("'", "\\'")')"
                                    class="px-2.5 py-1.5 bg-rose-500/10 text-rose-400 border border-rose-500/10 rounded-lg hover:bg-rose-500 hover:text-white transition-all text-[10px] font-bold" title="Remove Enrollment">
                                <i class="fas fa-user-minus mr-1"></i>Remove
                            </button>
                        </div>

                    </div>
                </div>
            }

            @if (Model.TotalPages > 1)
            {
                <div class="pt-8 border-t border-white/5 flex flex-col sm:flex-row items-center justify-between gap-4 mt-6">
                    <p class="text-xs text-slate-500 font-medium">
                        Showing @((Model.Page - 1) * Model.PageSize + 1)–@(Math.Min(Model.Page * Model.PageSize, Model.TotalCount)) of @Model.TotalCount
                    </p>
                    <div class="flex items-center gap-1 font-mono text-xs">
                        @if (Model.Page > 1)
                        {
                            <a asp-action="Index"
                               asp-route-searchQuery="@Model.Filter.SearchQuery" asp-route-courseId="@Model.Filter.CourseId"
                               asp-route-isCompleted="@Model.Filter.IsCompleted" asp-route-isPaid="@Model.Filter.IsPaid"
                               asp-route-sortBy="@Model.Filter.SortBy" asp-route-page="@(Model.Page - 1)"
                               class="px-2.5 py-1.5 bg-white/5 text-slate-400 rounded-lg hover:bg-white/10 hover:text-white transition-colors">
                                <i class="fas fa-chevron-left"></i>
                            </a>
                        }
                        @for (int i = Math.Max(1, Model.Page - 2); i <= Math.Min(Model.TotalPages, Model.Page + 2); i++)
                        {
                            <a asp-action="Index"
                               asp-route-searchQuery="@Model.Filter.SearchQuery" asp-route-courseId="@Model.Filter.CourseId"
                               asp-route-isCompleted="@Model.Filter.IsCompleted" asp-route-isPaid="@Model.Filter.IsPaid"
                               asp-route-sortBy="@Model.Filter.SortBy" asp-route-page="@i"
                               class="px-3 py-1.5 @(i == Model.Page ? "bg-gradient-to-r from-brand-cyan to-brand-blue text-dark-bg font-black" : "bg-white/5 text-slate-400 hover:bg-white/10 hover:text-white") rounded-lg transition-colors">
                                @i
                            </a>
                        }
                        @if (Model.Page < Model.TotalPages)
                        {
                            <a asp-action="Index"
                               asp-route-searchQuery="@Model.Filter.SearchQuery" asp-route-courseId="@Model.Filter.CourseId"
                               asp-route-isCompleted="@Model.Filter.IsCompleted" asp-route-isPaid="@Model.Filter.IsPaid"
                               asp-route-sortBy="@Model.Filter.SortBy" asp-route-page="@(Model.Page + 1)"
                               class="px-2.5 py-1.5 bg-white/5 text-slate-400 rounded-lg hover:bg-white/10 hover:text-white transition-colors">
                                <i class="fas fa-chevron-right"></i>
                            </a>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div class="p-16 text-center max-w-xl mx-auto border border-dashed border-white/5 rounded-3xl mt-6">
                <i class="fas fa-graduation-cap text-5xl text-slate-700 mb-4 animate-pulse"></i>
                <h3 class="text-white font-bold text-lg mb-1">No Enrollments Found</h3>
                <p class="text-slate-500 text-xs max-w-xs mx-auto mb-6 font-medium">
                    @if (!string.IsNullOrEmpty(Model.Filter.SearchQuery) || Model.Filter.CourseId.HasValue)
                    {
                        <text>No enrollments match your current search filters. Try adjusting your search.</text>
                    }
                    else
                    {
                        <text>No enrollments have been created yet. Click below to add a student to a course.</text>
                    }
                </p>
                <button onclick="openAddModal()"
                        class="inline-flex px-5 py-2.5 bg-gradient-to-r from-brand-cyan to-brand-blue text-dark-bg rounded-xl font-extrabold hover:shadow-[0_0_15px_rgba(66,234,255,0.3)] transition-all text-sm">
                    <i class="fas fa-user-plus mr-2 mt-0.5"></i>Add Enrollment
                </button>
            </div>
        }
    </div>
</div>

<div id="addModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-dark-bg/80 backdrop-blur-md transition-all p-4">
    <div class="bg-[#0B0D14]/90 border border-white/10 rounded-3xl shadow-2xl w-full max-w-lg overflow-hidden animate-[fadeIn_0.3s_ease_forwards]">
        <div class="flex items-center justify-between px-6 py-4 border-b border-white/5 bg-white/[0.01]">
            <h4 class="text-white font-bold text-base flex items-center">
                <i class="fas fa-user-plus mr-2 text-brand-cyan shadow-[0_0_8px_#42EAFF]"></i>Add Student to Course
            </h4>
            <button onclick="closeAddModal()" class="text-slate-400 hover:text-white transition-colors">
                <i class="fas fa-times text-sm"></i>
            </button>
        </div>
        <div class="p-6 space-y-6">

            <div class="space-y-2">
                <label class="block text-xs font-bold text-slate-400 uppercase tracking-wide">Student</label>
                <div class="relative group border-b border-white/10 focus-within:border-brand-cyan/80 transition-colors">
                    <input type="text" id="addUserSearch" placeholder="Search student by name or email..."
                           oninput="searchUsersAjax(this.value)" autocomplete="off"
                           class="w-full bg-transparent px-2 py-2.5 text-white placeholder-slate-600 focus:outline-none text-sm font-medium" />
                    <div id="addUserResults" class="absolute left-0 right-0 top-full mt-2 bg-[#121622] border border-white/10 rounded-xl shadow-2xl z-20 hidden max-h-48 overflow-y-auto custom-scrollbar divide-y divide-white/[0.03]"></div>
                </div>
                <p id="addUserSelected" class="mt-2 text-xs font-bold text-brand-cyan hidden flex items-center">
                    <i class="fas fa-check-circle mr-1.5 shadow-[0_0_6px_#42EAFF] rounded-full"></i>Selected: <span id="addUserSelectedName" class="font-mono"></span>
                </p>
                <input type="hidden" id="addUserId" />
            </div>

            <div class="space-y-2">
                <label class="block text-xs font-bold text-slate-400 uppercase tracking-wide">Course</label>
                <div class="relative group border-b border-white/10 focus-within:border-brand-cyan/80 transition-colors">
                    <input type="text" id="addCourseSearch" placeholder="Search course by title..."
                           oninput="searchCoursesAjax(this.value)" autocomplete="off"
                           class="w-full bg-transparent px-2 py-2.5 text-white placeholder-slate-600 focus:outline-none text-sm font-medium" />
                    <div id="addCourseResults" class="absolute left-0 right-0 top-full mt-2 bg-[#121622] border border-white/10 rounded-xl shadow-2xl z-20 hidden max-h-48 overflow-y-auto custom-scrollbar divide-y divide-white/[0.03]"></div>
                </div>
                <p id="addCourseSelected" class="mt-2 text-xs font-bold text-brand-blue hidden flex items-center">
                    <i class="fas fa-check-circle mr-1.5 shadow-[0_0_6px_#4272FF] rounded-full"></i>Selected: <span id="addCourseSelectedName"></span>
                </p>
                <input type="hidden" id="addCourseId" />
            </div>

            <div>
                <label class="flex items-center space-x-3 bg-white/[0.01] border border-white/5 p-4 rounded-xl cursor-pointer hover:bg-white/[0.03] transition-colors group">
                    <input type="checkbox" id="addIsPaid" class="w-4 h-4 rounded border-white/10 bg-dark-bg text-brand-cyan focus:ring-brand-cyan/20 focus:ring-offset-0" />
                    <span class="text-xs font-bold text-slate-400 group-hover:text-slate-200 transition-colors flex items-center">
                        <i class="fas fa-coins mr-2 text-slate-500 text-sm group-hover:text-brand-cyan transition-colors"></i>
                        Mark as Paid Course
                    </span>
                </label>
            </div>
        </div>

        <div class="px-6 py-4 border-t border-white/5 flex justify-end space-x-3 bg-white/[0.01]">
            <button onclick="closeAddModal()" class="px-4 py-2 bg-white/5 text-slate-300 rounded-xl hover:bg-white/10 transition-colors text-xs font-bold">Cancel</button>
            <button onclick="submitAddEnrollment()" class="px-5 py-2.5 bg-gradient-to-r from-brand-cyan to-brand-blue text-dark-bg rounded-xl hover:shadow-[0_0_15px_rgba(66,234,255,0.3)] transition-all text-xs font-black"><i class="fas fa-user-plus mr-1.5"></i>Save Enrollment</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openAddModal() {
            document.getElementById('addModal').classList.remove('hidden');
            document.getElementById('addModal').classList.add('flex');
            resetAddModal();
        }
        function closeAddModal() {
            document.getElementById('addModal').classList.add('hidden');
            document.getElementById('addModal').classList.remove('flex');
        }
        function resetAddModal() {
            document.getElementById('addUserSearch').value = '';
            document.getElementById('addCourseSearch').value = '';
            document.getElementById('addUserId').value = '';
            document.getElementById('addCourseId').value = '';
            document.getElementById('addUserSelected').classList.add('hidden');
            document.getElementById('addCourseSelected').classList.add('hidden');
            document.getElementById('addUserResults').classList.add('hidden');
            document.getElementById('addCourseResults').classList.add('hidden');
            document.getElementById('addIsPaid').checked = false;
        }
        document.getElementById('addModal').addEventListener('click', e => { if (e.target === e.currentTarget) closeAddModal(); });

        let _userSearchTimer;
        function searchUsersAjax(q) {
            clearTimeout(_userSearchTimer);
            const results = document.getElementById('addUserResults');
            if (!q.trim()) { results.classList.add('hidden'); return; }
            _userSearchTimer = setTimeout(async () => {
                const courseId = document.getElementById('addCourseId').value;
                const url = `/Admin/Enrollment/SearchUsers?q=${encodeURIComponent(q)}` + (courseId ? `&excludeCourseId=${courseId}` : '');
                const data = await (await fetch(url)).json();

                if (!data.length) {
                    results.innerHTML = '<p class="px-4 py-3 text-slate-500 text-xs font-semibold">No students found</p>';
                } else {
                    results.innerHTML = data.map(u =>
                        `<button type="button" onclick="selectUser(${u.userId}, '${escapeHtml(u.fullName)} (${escapeHtml(u.userName)})')"
                            class="w-full text-left px-4 py-3 hover:bg-white/5 text-slate-300 hover:text-white transition-colors flex flex-col text-xs">
                            <span class="font-bold text-sm text-white">${escapeHtml(u.fullName)}</span>
                            <span class="text-slate-500 font-mono mt-0.5">${escapeHtml(u.email ?? u.userName)}</span>
                         </button>`
                    ).join('');
                }
                results.classList.remove('hidden');
            }, 280);
        }
        function selectUser(id, label) {
            document.getElementById('addUserId').value = id;
            document.getElementById('addUserSelectedName').textContent = label;
            document.getElementById('addUserSelected').classList.remove('hidden');
            document.getElementById('addUserResults').classList.add('hidden');
            document.getElementById('addUserSearch').value = label;
        }

        let _courseSearchTimer;
        function searchCoursesAjax(q) {
            clearTimeout(_courseSearchTimer);
            const results = document.getElementById('addCourseResults');
            if (!q.trim()) { results.classList.add('hidden'); return; }
            _courseSearchTimer = setTimeout(async () => {
                const userId = document.getElementById('addUserId').value;
                const url = `/Admin/Enrollment/SearchCourses?q=${encodeURIComponent(q)}` + (userId ? `&excludeUserId=${userId}` : '');
                const data = await (await fetch(url)).json();

                if (!data.length) {
                    results.innerHTML = '<p class="px-4 py-3 text-slate-500 text-xs font-semibold">No courses found</p>';
                } else {
                    results.innerHTML = data.map(c =>
                        `<button type="button" onclick="selectCourse(${c.courseId}, '${escapeHtml(c.title)}')"
                            class="w-full text-left px-4 py-3 hover:bg-white/5 text-slate-300 hover:text-white transition-colors flex flex-col text-xs">
                            <span class="font-bold text-sm text-white">${escapeHtml(c.title)}</span>
                            <span class="text-slate-500 mt-1 font-semibold">$${c.price} · ${c.enrollmentCount} enrolled · ${c.isActive ? 'Active' : 'Inactive'}</span>
                         </button>`
                    ).join('');
                }
                results.classList.remove('hidden');
            }, 280);
        }
        function selectCourse(id, label) {
            document.getElementById('addCourseId').value = id;
            document.getElementById('addCourseSelectedName').textContent = label;
            document.getElementById('addCourseSelected').classList.remove('hidden');
            document.getElementById('addCourseResults').classList.add('hidden');
            document.getElementById('addCourseSearch').value = label;
        }

        async function submitAddEnrollment() {
            const userId = parseInt(document.getElementById('addUserId').value);
            const courseId = parseInt(document.getElementById('addCourseId').value);
            const isPaid = document.getElementById('addIsPaid').checked;
            if (!userId) { alert('Please select a student.'); return; }
            if (!courseId) { alert('Please select a course.'); return; }
            try {
                const r = await fetch('/Admin/Enrollment/AddEnrollment', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ userId, courseId, isPaid })
                });
                const result = await r.json();
                if (result.success) { closeAddModal(); location.reload(); }
                else { alert('Error: ' + result.message); }
            } catch { alert('An error occurred. Please try again.'); }
        }

        async function removeEnrollmentRow(enrollmentId, userName, courseTitle) {
            if (!confirm(`Are you sure you want to remove ${userName} from ${courseTitle}?`)) return;
            try {
                const r = await fetch('/Admin/Enrollment/RemoveEnrollment', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ enrollmentId })
                });
                const result = await r.json();
                if (result.success) {
                    const row = document.getElementById('row-' + enrollmentId);
                    if (row) {
                        row.style.transition = 'all 0.3s ease';
                        row.style.opacity = '0';
                        row.style.transform = 'translateY(10px)';
                        setTimeout(() => row.remove(), 300);
                    }
                } else { alert('Error: ' + result.message); }
            } catch { alert('An error occurred. Please try again.'); }
        }

        function escapeHtml(str) {
            if (!str) return '';
            return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#039;');
        }
    </script>
}