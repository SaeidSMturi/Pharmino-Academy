@section Scripts {
    <script>
        // Toggle Listed for Sale (Store visibility)
        async function toggleListedForSale(courseId, isListed) {
            const promptMsg = isListed 
                ? 'Are you sure you want to unlist this course from public sale? It will remain active and usable in bundles, but hidden from standalone store purchases.'
                : 'Are you sure you want to list this course for individual sale in the public catalog?';
            
            if (!confirm(promptMsg)) {
                return;
            }

            try {
                const response = await fetch('/Admin/Courses/ToggleListedForSale', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id: courseId })
                });
                const result = await response.json();

                if (result.success) {
                    location.reload();
                } else {
                    alert(result.message || 'Operation failed.');
                }
            } catch (error) {
                alert('Connection error while updating store visibility.');
            }
        }

        // Toggle course status
        async function toggleActive(courseId, isActive) {
            if (!confirm(isActive ? 'Are you sure you want to deactivate this course?' : 'Are you sure you want to activate this course?')) {
                return;
            }

            try {
                const response = await fetch('/Admin/Courses/ToggleActive', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id: courseId })
                });
                const result = await response.json();

                if (result.success) {
                    location.reload();
                } else {
                    alert(result.message || 'Operation failed.');
                }
            } catch (error) {
                alert('Connection error while updating status.');
            }
        }

        // Delete course
        async function deleteCourse(courseId) {
            if (!confirm('Are you sure you want to delete this course? This action cannot be undone.')) {
                return;
            }

            try {
                const response = await fetch('/Admin/Courses/Delete', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id: courseId })
                });
                const result = await response.json();

                if (result.success) {
                    window.location.href = '/Admin/Courses';
                } else {
                    alert(result.message || 'Deletion failed.');
                }
            } catch (error) {
                alert('Connection error while deleting course.');
            }
        }

        // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        // HLS Async Progress Tracking Operations (Toast Framework)
        // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        let _hlsPollInterval = null;
        let _hlsActiveVideoId = null;

        function hlsToastShow() {
            document.getElementById('hlsToast').classList.remove('hidden');
        }
        function hlsToastHide() {
            document.getElementById('hlsToast').classList.add('hidden');
        }
        function hlsToastUpdate(percent, status, error) {
            const bar = document.getElementById('hlsToastBar');
            const pct = document.getElementById('hlsToastPct');
            const msg = document.getElementById('hlsToastMsg');
            const icon = document.getElementById('hlsToastIcon');
            const title = document.getElementById('hlsToastTitle');

            if (status === 'completed') {
                bar.style.width = '100%';
                bar.className = 'h-full rounded-full bg-gradient-to-r from-emerald-400 to-emerald-600 shadow-[0_0_10px_#10B981]';
                pct.textContent = '100%';
                msg.textContent = 'Encoding complete! Refreshing page...';
                icon.className = 'fas fa-check-circle text-emerald-400 shadow-[0_0_8px_#10B981]';
                title.textContent = 'HLS Conversion Ready';
                hlsPollStop();
                setTimeout(() => location.reload(), 1800);
            } else if (status === 'failed') {
                bar.style.width = '100%';
                bar.className = 'h-full rounded-full bg-rose-500';
                msg.textContent = 'Encoding failed: ' + (error || 'Unknown error occurred');
                icon.className = 'fas fa-exclamation-circle text-rose-500';
                title.textContent = 'Conversion Failed';
                pct.textContent = '!';
                hlsPollStop();
            } else {
                const p = Math.min(percent ?? 0, 99);
                bar.style.width = p + '%';
                pct.textContent = p + '%';
                msg.textContent = status === 'queued' ? 'Queued — waiting to start...' : 'Converting video to HLS...';
            }
        }
        function hlsPollStart(videoId) {
            hlsPollStop();
            _hlsActiveVideoId = videoId;
            _hlsPollInterval = setInterval(async () => {
                try {
                    const r = await fetch('/Admin/CourseVideos/GetConversionProgress?videoId=' + videoId);
                    const d = await r.json();
                    if (!d.found) { hlsPollStop(); return; }
                    hlsToastUpdate(d.percent, d.status, d.error);
                } catch { /* connection fault mitigation drop */ }
            }, 2000);
        }
        function hlsPollStop() {
            if (_hlsPollInterval) { clearInterval(_hlsPollInterval); _hlsPollInterval = null; }
        }

        // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        // HLS Modal & Conversion Handlers (Option B)
        // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        let _currentHlsVideoId = null;
        let _currentHlsBtn = null;

        function openHlsModal(videoId, title, btn) {
            _currentHlsVideoId = videoId;
            _currentHlsBtn = btn;
            const titleEl = document.getElementById('hlsModalVideoTitle');
            if (titleEl) titleEl.textContent = title || ('Video #' + videoId);
            const modal = document.getElementById('hlsOptionsModal');
            if (modal) modal.classList.remove('hidden');
        }

        function closeHlsModal() {
            const modal = document.getElementById('hlsOptionsModal');
            if (modal) modal.classList.add('hidden');
        }

        async function startHlsConversion(multiQuality) {
            closeHlsModal();
            if (!_currentHlsVideoId) return;
            await convertToHls(_currentHlsVideoId, multiQuality, _currentHlsBtn);
        }

        // Trigger background ffmpeg conversion
        async function convertToHls(videoId, multiQuality, btn) {
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<i class="fas fa-spinner fa-spin text-xs"></i>';
            }

            try {
                const response = await fetch('/Admin/CourseVideos/ProcessHls', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                    body: JSON.stringify({ id: videoId, multiQuality: multiQuality })
                });
                const result = await response.json();
                if (result.success) {
                    if (btn) {
                        btn.innerHTML = '<i class="fas fa-film fa-spin text-xs text-brand-cyan"></i>';
                        btn.title = 'Processing video in background...';
                    }

                    document.getElementById('hlsToastBar').style.width = '0%';
                    document.getElementById('hlsToastPct').textContent = '0%';
                    document.getElementById('hlsToastMsg').textContent = multiQuality 
                        ? 'Starting Multi-Quality conversion (1080p, 720p, 480p)...' 
                        : 'Starting Fast Smart Copy conversion (~25s)...';
                    document.getElementById('hlsToastIcon').className = 'fas fa-film text-brand-cyan';
                    document.getElementById('hlsToastTitle').textContent = multiQuality ? 'Multi-Quality HLS' : 'Fast HLS (~25s)';
                    hlsToastShow();
                    hlsPollStart(videoId);
                } else {
                    if (btn) {
                        btn.disabled = false;
                        btn.innerHTML = '<i class="fas fa-film text-xs"></i>';
                    }
                    alert('Error: ' + result.message);
                }
            } catch (error) {
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fas fa-film text-xs"></i>';
                }
                alert('Connection error: ' + error.message);
            }
        }

        // Toggle video visibility & status
        async function toggleVideoActive(videoId, isActive) {
            const action = isActive ? 'deactivate' : 'activate';
            if (!confirm(`Are you sure you want to ${action} this video?`)) return;
            try {
                const response = await fetch('/Admin/CourseVideos/ToggleActive', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                    body: JSON.stringify({ id: videoId })
                });
                const result = await response.json();
                if (result.success) location.reload();
                else alert('Error: ' + result.message);
            } catch (error) { alert('Connection error: ' + error.message); }
        }

        async function toggleVideoFree(videoId, isFree) {
            try {
                const response = await fetch('/Admin/CourseVideos/ToggleFree', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                    body: JSON.stringify({ id: videoId })
                });
                const result = await response.json();
                if (result.success) location.reload();
                else alert('Error: ' + result.message);
            } catch (error) { alert('Connection error: ' + error.message); }
        }

        async function deleteVideo(videoId) {
            if (!confirm('Are you sure you want to delete this video?')) return;
            try {
                const response = await fetch('/Admin/CourseVideos/Delete', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                    body: JSON.stringify({ id: videoId })
                });
                const result = await response.json();
                if (result.success) location.reload();
                else alert('Error: ' + result.message);
            } catch (error) { alert('Connection error: ' + error.message); }
        }

        async function deletePdf(pdfId) {
            if (!confirm('Are you sure you want to delete this PDF file?')) return;
            try {
                const response = await fetch('/Admin/CoursePdfs/Delete', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id: pdfId })
                });
                const result = await response.json();
                if (result.success) { location.reload(); }
                else { alert(result.message); }
            } catch (error) { alert('Connection error while deleting PDF.'); }
        }

        // ── Student Enrollment Modal Controls ──────────────────────────────────
        if (document.getElementById('studentEnrollModal')) {
            document.getElementById('studentEnrollModal').addEventListener('click', function(e) {
                if (e.target === this) closeStudentEnrollModal();
            });
        }

        function openStudentEnrollModal() {
            document.getElementById('studentEnrollModal').classList.remove('hidden');
            document.getElementById('studentEnrollModal').classList.add('flex');
            document.getElementById('studentSearch').value = '';
            filterStudents();
        }
        function closeStudentEnrollModal() {
            document.getElementById('studentEnrollModal').classList.add('hidden');
            document.getElementById('studentEnrollModal').classList.remove('flex');
            document.querySelectorAll('input[name="selectedStudent"]').forEach(r => r.checked = false);
        }
        function filterStudents() {
            const q = document.getElementById('studentSearch').value.toLowerCase();
            document.querySelectorAll('.student-option').forEach(el => {
                const name = (el.querySelector('[data-student-name]')?.dataset.studentName ?? '').toLowerCase();
                el.style.display = name.includes(q) ? '' : 'none';
            });
        }
        async function submitStudentEnrollment() {
            const selected = document.querySelector('input[name="selectedStudent"]:checked');
            if (!selected) { alert('Please select a student.'); return; }
            const isPaid = document.getElementById('studentMarkAsPaid').checked;
            try {
                const response = await fetch('/Admin/Enrollment/AddEnrollment', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ userId: parseInt(selected.value), courseId: @Model.CourseId, isPaid: isPaid })
                });
                const result = await response.json();
                if (result.success) { closeStudentEnrollModal(); location.reload(); }
                else { alert('Error: ' + result.message); }
            } catch (e) { alert('Connection error while enrolling student.'); }
        }
        async function removeCourseStudent(enrollmentId, userName) {
            if (!confirm(`Are you sure you want to remove student "${userName}" from this course?`)) return;
            try {
                const response = await fetch('/Admin/Enrollment/RemoveEnrollment', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ enrollmentId: enrollmentId })
                });
                const result = await response.json();
                if (result.success) { location.reload(); }
                else { alert('Error: ' + result.message); }
            } catch (e) { alert('Connection error while removing student.'); }
        }

        // Test Method Execution
        async function createTestVideo() {
            const videoUrl = prompt('Enter a valid video URL (mp4) to download as a Test Mock:', 'https://www.w3schools.com/html/mov_bbb.mp4');

            if (!videoUrl) return;

            if (!confirm('This will trigger a backend download and HLS conversion. Proceed?')) return;

            const btn = document.querySelector('button[onclick="createTestVideo()"]');
            const originalText = btn.innerHTML;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-1.5"></i> Processing...';
            btn.disabled = true;

            try {
                const formData = new URLSearchParams({
                    courseId: '@Model.CourseId',
                    videoUrl: videoUrl
                });

                const response = await fetch('/Admin/CourseVideos/TestOnly_DownloadVideoFromUrl', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: formData
                });

                if (!response.ok) {
                    const errText = await response.text();
                    console.error("Server Error:", errText);
                    alert(`Server Error (${response.status}): Operation failed.`);
                    btn.innerHTML = originalText;
                    btn.disabled = false;
                    return;
                }

                const result = await response.json();

                if (result.success) {
                    alert('Test video downloaded successfully! Refreshing...');
                    location.reload();
                } else {
                    alert('Test failed: ' + result.message);
                    btn.innerHTML = originalText;
                    btn.disabled = false;
                }
            } catch (error) {
                alert('Connection error: ' + error.message);
                btn.innerHTML = originalText;
                btn.disabled = false;
            }
        }

        // 📦 Bundle Operations
        function openAttachCourseModal() {
            const modal = document.getElementById('attachCourseModal');
            if (modal) {
                modal.classList.remove('hidden');
                modal.classList.add('flex');
            }
        }

        function closeAttachCourseModal() {
            const modal = document.getElementById('attachCourseModal');
            if (modal) {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
            }
        }

        async function submitAttachCourse(bundleId) {
            const select = document.getElementById('attachCourseSelect');
            if (!select || !select.value) {
                alert('Please select a course to attach.');
                return;
            }

            const courseId = parseInt(select.value);
            const btn = document.getElementById('btnConfirmAttach');
            const originalText = btn.innerHTML;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-1.5"></i> Attaching...';
            btn.disabled = true;

            try {
                const formData = new URLSearchParams({
                    bundleId: bundleId,
                    courseId: courseId
                });

                const response = await fetch('/Admin/Courses/AddCourseToBundle', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: formData
                });

                const result = await response.json();
                if (result.success) {
                    location.reload();
                } else {
                    alert(result.message || 'Failed to attach course.');
                    btn.innerHTML = originalText;
                    btn.disabled = false;
                }
            } catch (err) {
                alert('Network error: ' + err.message);
                btn.innerHTML = originalText;
                btn.disabled = false;
            }
        }

        async function removeCourseFromBundle(bundleId, courseId, title) {
            if (!confirm(`Are you sure you want to remove "${title}" from this bundle?`)) {
                return;
            }

            try {
                const formData = new URLSearchParams({
                    bundleId: bundleId,
                    courseId: courseId
                });

                const response = await fetch('/Admin/Courses/RemoveCourseFromBundle', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: formData
                });

                const result = await response.json();
                if (result.success) {
                    location.reload();
                } else {
                    alert(result.message || 'Failed to remove course from bundle.');
                }
            } catch (err) {
                alert('Network error: ' + err.message);
            }
        }
    </script>
}