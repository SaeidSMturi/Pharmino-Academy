@model Domain.Entities.Course.Course

@{
    var isRtl = System.Globalization.CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    ViewData["Title"] = Localizer["CreateNewCourse"].Value;
}

<div class="animate-[fadeIn_0.4s_ease_forwards] w-full max-w-4xl mx-auto text-start" dir="@(isRtl ? "rtl" : "ltr")">
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="mb-6 p-4 rounded-2xl bg-brand-orange/10 border border-brand-orange/20 text-brand-orange flex items-center @(isRtl ? "space-x-reverse" : "space-x-3") shadow-[0_0_20px_rgba(255,126,66,0.1)]">
            <i class="fas fa-exclamation-triangle text-lg"></i>
            <span class="font-medium text-sm">@TempData["ErrorMessage"]</span>
        </div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="mb-6 p-4 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center @(isRtl ? "space-x-reverse" : "space-x-3") shadow-[0_0_20px_rgba(16,185,129,0.1)]">
            <i class="fas fa-check-circle text-lg"></i>
            <span class="font-medium text-sm">@TempData["SuccessMessage"]</span>
        </div>
    }

    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6 mb-10">
        <div>
            <h1 class="text-3xl font-extrabold bg-gradient-to-r from-brand-cyan to-brand-blue bg-clip-text text-transparent mb-2 tracking-wide">
                @Localizer["CreateNewCourse"]
            </h1>
            <p class="text-slate-400 text-sm font-medium">@Localizer["CreateNewCourseSub"]</p>
        </div>
        <a asp-action="Index" class="w-full sm:w-auto text-center px-5 py-2.5 bg-white/5 border border-white/5 text-slate-300 rounded-xl hover:bg-white/10 hover:text-white transition-all text-sm font-bold flex items-center justify-center shadow-lg whitespace-nowrap">
            <i class="fas @(isRtl ? "fa-arrow-right ml-2" : "fa-arrow-left mr-2") text-xs"></i> @Localizer["BackToCourses"]
        </a>
    </div>

    <div class="w-full">
        <form asp-action="Create" method="post" enctype="multipart/form-data" class="space-y-10">
            @Html.AntiForgeryToken()

            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="All" class="bg-rose-500/10 border border-rose-500/20 rounded-2xl p-4 text-rose-400 text-sm font-semibold flex items-center @(isRtl ? "space-x-reverse" : "space-x-3") shadow-[0_0_15px_rgba(244,63,94,0.1)] mb-6">
                    <i class="fas fa-triangle-exclamation text-lg"></i>
                    <span>@Localizer["PleaseFixErrors"]</span>
                </div>
            }

            <div class="space-y-6">
                <h3 class="text-sm font-bold text-brand-cyan uppercase tracking-widest mb-6 flex items-center">
                    <i class="fas fa-id-card @(isRtl ? "ml-2.5" : "mr-2.5") text-base"></i> @Localizer["GeneralInformation"]
                </h3>

                <div class="space-y-2">
                    <label asp-for="Title" class="block text-xs font-bold text-slate-400 uppercase tracking-wide">
                        @Localizer["CourseTitle"] <span class="text-brand-orange">*</span>
                    </label>
                    <div class="relative group border-b border-white/10 focus-within:border-brand-cyan/80 transition-colors">
                        <input asp-for="Title" class="w-full bg-transparent px-4 py-3.5 @(isRtl ? "pr-11 pl-4" : "pl-11 pr-4") text-white placeholder-slate-600 focus:outline-none text-base font-medium" placeholder="@Localizer["CourseTitle"]" />
                        <i class="fas fa-heading absolute @(isRtl ? "right-2" : "left-2") top-1/2 transform -translate-y-1/2 text-slate-600 group-focus-within:text-brand-cyan transition-colors text-sm"></i>
                    </div>
                    <span asp-validation-for="Title" class="text-rose-400 text-xs font-semibold mt-1 block"></span>
                </div>

                <div class="space-y-2">
                    <label asp-for="Description" class="block text-xs font-bold text-slate-400 uppercase tracking-wide">
                        @Localizer["CourseDescription"] <span class="text-brand-orange">*</span>
                    </label>
                    <div class="border-b border-white/10 focus-within:border-brand-cyan/80 transition-colors">
                        <textarea asp-for="Description" rows="4" class="w-full bg-transparent py-3 text-white placeholder-slate-600 focus:outline-none text-sm font-medium leading-relaxed resize-none" placeholder="@Localizer["CourseDescription"]..."></textarea>
                    </div>
                    <span asp-validation-for="Description" class="text-rose-400 text-xs font-semibold mt-1 block"></span>
                </div>
            </div>

            <div class="pt-6">
                <h3 class="text-sm font-bold text-brand-blue uppercase tracking-widest mb-6 flex items-center">
                    <i class="fas fa-image @(isRtl ? "ml-2.5" : "mr-2.5") text-base"></i> @Localizer["CourseImage"]
                </h3>

                <div class="space-y-4">
                    <div class="flex flex-col-reverse sm:flex-row items-center sm:items-start gap-6 bg-white/[0.01] p-5 rounded-2xl border border-white/[0.03]">
                        <div class="w-full sm:flex-1 space-y-2">
                            <input type="file" name="ImageFile" accept="image/*" class="w-full bg-dark-bg/40 border border-white/5 rounded-xl px-4 py-2.5 text-white text-xs font-medium file:mr-4 file:py-1.5 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-bold file:bg-brand-blue/20 file:text-brand-blue hover:file:bg-brand-blue/30 file:transition-colors" />
                            <p class="text-[10px] text-slate-500 font-semibold leading-relaxed">@Localizer["ImageUploadConstraints"]</p>
                        </div>

                        <div class="w-full sm:w-32 h-32 rounded-xl overflow-hidden bg-dark-bg/60 flex items-center justify-center flex-shrink-0 border border-white/5 shadow-inner" id="imagePreview">
                            <div class="text-center">
                                <i class="fas fa-cloud-arrow-up text-3xl text-slate-600 mb-1.5 block animate-pulse"></i>
                                <span class="text-[10px] text-slate-500 font-bold uppercase tracking-wider block">@Localizer["NoImage"]</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="pt-6">
                <h3 class="text-sm font-bold text-brand-yellow uppercase tracking-widest mb-6 flex items-center">
                    <i class="fas fa-coins @(isRtl ? "ml-2.5" : "mr-2.5") text-base"></i> @Localizer["CoursePricing"]
                </h3>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="space-y-2">
                        <label asp-for="Price" class="block text-xs font-bold text-slate-400 uppercase tracking-wide">
                            @Localizer["PriceUSD"] <span class="text-brand-orange">*</span>
                        </label>
                        <div class="relative group border-b border-white/10 focus-within:border-brand-cyan/80 transition-colors">
                            <input asp-for="Price" type="number" step="0.01" min="0" class="w-full bg-transparent px-4 py-3.5 @(isRtl ? "pr-11 pl-4" : "pl-11 pr-4") text-white placeholder-slate-600 focus:outline-none text-base font-bold font-mono" placeholder="0.00" />
                            <i class="fas fa-tag absolute @(isRtl ? "right-2" : "left-2") top-1/2 transform -translate-y-1/2 text-slate-600 group-focus-within:text-brand-cyan transition-colors text-sm"></i>
                        </div>
                        <span asp-validation-for="Price" class="text-rose-400 text-xs font-semibold mt-1 block"></span>
                        <p class="text-[10px] text-slate-500 font-medium flex items-center mt-2">
                            <i class="fas fa-circle-info @(isRtl ? "ml-1.5" : "mr-1.5") text-brand-blue"></i> @Localizer["SetPriceZeroFree"]
                        </p>
                    </div>
                </div>
            </div>

            <div class="pt-6">
                <h3 class="text-sm font-bold text-brand-orange uppercase tracking-widest mb-6 flex items-center">
                    <i class="fas fa-sliders @(isRtl ? "ml-2.5" : "mr-2.5") text-base"></i> @Localizer["CourseStatus"]
                </h3>

                <div class="space-y-2">
                    <label class="flex items-center @(isRtl ? "space-x-reverse" : "space-x-3") bg-white/[0.01] border border-white/5 p-4 rounded-xl cursor-pointer hover:bg-white/[0.03] transition-colors group">
                        <input asp-for="IsActive" type="checkbox" class="w-4 h-4 rounded border-white/10 bg-dark-bg text-brand-cyan focus:ring-brand-cyan/20 focus:ring-offset-0" />
                        <span class="text-xs font-bold text-slate-400 group-hover:text-slate-200 transition-colors flex items-center">
                            <i class="fas fa-circle-check @(isRtl ? "ml-2" : "mr-2") text-emerald-400 shadow-[0_0_8px_rgba(16,185,129,0.3)]"></i>
                            @Localizer["PublishCourseImmediately"]
                        </span>
                    </label>
                </div>
            </div>

            <div class="bg-brand-cyan/5 border border-brand-cyan/10 rounded-2xl p-4 flex items-start @(isRtl ? "space-x-reverse" : "space-x-3") shadow-sm">
                <i class="fas fa-circle-info text-brand-cyan text-sm mt-0.5"></i>
                <div class="text-xs text-slate-400 font-medium leading-relaxed">
                    <p>@Localizer["RequiredFieldsNote"]</p>
                </div>
            </div>

            <div class="flex flex-col-reverse sm:flex-row sm:items-center sm:justify-end gap-4 pt-6 border-t border-white/5">
                <a asp-action="Index" class="w-full sm:w-auto text-center px-5 py-2.5 bg-white/5 border border-white/5 text-slate-300 rounded-xl hover:bg-white/10 hover:text-white transition-all text-xs font-bold flex items-center justify-center">
                    @Localizer["Cancel"]
                </a>
                <button type="submit" class="w-full sm:w-auto text-center px-6 py-2.5 bg-gradient-to-r from-brand-cyan to-brand-blue text-dark-bg font-black text-xs rounded-xl hover:shadow-[0_0_20px_rgba(66,234,255,0.3)] hover:scale-[1.01] transition-all flex items-center justify-center">
                    <i class="fas fa-plus @(isRtl ? "ml-1.5" : "mr-1.5") text-sm"></i> @Localizer["Create"]
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.querySelector('input[type="file"]')?.addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(event) {
                    const preview = document.getElementById('imagePreview');
                    if (preview) {
                        preview.innerHTML = `<img src="${event.target.result}" class="w-full h-full object-cover rounded-xl animate-[fadeIn_0.3s_ease]" alt="Preview">`;
                    }
                }
                reader.readAsDataURL(file);
            }
        });
    </script>
}