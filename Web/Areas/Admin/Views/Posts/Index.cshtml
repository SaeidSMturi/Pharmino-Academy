@model List<Domain.Entities.Post.Post>

@{
    var isRtl = System.Globalization.CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    ViewData["Title"] = Localizer["Posts"].Value;
}

<div class="animate-[fadeIn_0.4s_ease_forwards] w-full text-start" dir="@(isRtl ? "rtl" : "ltr")">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-10">
        <div>
            <h1 class="text-3xl font-extrabold bg-gradient-to-r from-brand-cyan to-brand-blue bg-clip-text text-transparent mb-2 tracking-wide">
                @Localizer["Posts"]
            </h1>
            <p class="text-slate-400 text-sm font-medium">@Localizer["PostsManagementSub"]</p>
        </div>
        <a asp-action="Create" class="w-full sm:w-auto text-center px-6 py-2.5 bg-gradient-to-r from-brand-cyan to-brand-blue rounded-xl text-dark-bg font-extrabold hover:shadow-[0_0_20px_rgba(66,234,255,0.4)] hover:scale-[1.02] transition-all duration-300 whitespace-nowrap text-sm flex items-center justify-center">
            <i class="fas fa-plus @(isRtl ? "ml-2" : "mr-2") text-lg"></i>
            @Localizer["CreateNewPost"]
        </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
        <div class="relative p-5 rounded-3xl bg-white/[0.02] border border-white/[0.05] hover:border-brand-blue/30 transition-all duration-300 hover:-translate-y-1 group overflow-hidden">
            <div class="absolute @(isRtl ? "-left-6" : "-right-6") -top-6 w-24 h-24 bg-brand-blue/10 rounded-full blur-2xl group-hover:bg-brand-blue/20 transition-all"></div>
            <div class="flex items-center justify-between relative z-10">
                <div>
                    <p class="text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1">@Localizer["TotalPosts"]</p>
                    <p class="text-3xl font-extrabold text-white">@Model.Count</p>
                </div>
                <div class="w-12 h-12 rounded-2xl bg-brand-blue/10 border border-brand-blue/20 flex items-center justify-center shadow-[inset_0_0_15px_rgba(66,114,255,0.1)] group-hover:scale-110 transition-transform">
                    <i class="fas fa-newspaper text-brand-blue text-lg"></i>
                </div>
            </div>
        </div>

        <div class="relative p-5 rounded-3xl bg-white/[0.02] border border-white/[0.05] hover:border-emerald-500/30 transition-all duration-300 hover:-translate-y-1 group overflow-hidden">
            <div class="absolute @(isRtl ? "-left-6" : "-right-6") -top-6 w-24 h-24 bg-emerald-500/10 rounded-full blur-2xl group-hover:bg-emerald-500/20 transition-all"></div>
            <div class="flex items-center justify-between relative z-10">
                <div>
                    <p class="text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1">@Localizer["Published"]</p>
                    <p class="text-3xl font-extrabold text-white">@Model.Count(p => p.IsPublish)</p>
                </div>
                <div class="w-12 h-12 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center shadow-[inset_0_0_15px_rgba(16,185,129,0.1)] group-hover:scale-110 transition-transform">
                    <i class="fas fa-circle-check text-emerald-400 text-lg"></i>
                </div>
            </div>
        </div>

        <div class="relative p-5 rounded-3xl bg-white/[0.02] border border-white/[0.05] hover:border-brand-yellow/30 transition-all duration-300 hover:-translate-y-1 group overflow-hidden">
            <div class="absolute @(isRtl ? "-left-6" : "-right-6") -top-6 w-24 h-24 bg-brand-yellow/10 rounded-full blur-2xl group-hover:bg-brand-yellow/20 transition-all"></div>
            <div class="flex items-center justify-between relative z-10">
                <div>
                    <p class="text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1">@Localizer["Drafts"]</p>
                    <p class="text-3xl font-extrabold text-white">@Model.Count(p => !p.IsPublish)</p>
                </div>
                <div class="w-12 h-12 rounded-2xl bg-brand-yellow/10 border border-brand-yellow/20 flex items-center justify-center shadow-[inset_0_0_15px_rgba(255,179,67,0.1)] group-hover:scale-110 transition-transform">
                    <i class="fas fa-file-alt text-brand-yellow text-lg"></i>
                </div>
            </div>
        </div>

        <div class="relative p-5 rounded-3xl bg-white/[0.02] border border-white/[0.05] hover:border-brand-orange/30 transition-all duration-300 hover:-translate-y-1 group overflow-hidden">
            <div class="absolute @(isRtl ? "-left-6" : "-right-6") -top-6 w-24 h-24 bg-brand-orange/10 rounded-full blur-2xl group-hover:bg-brand-orange/20 transition-all"></div>
            <div class="flex items-center justify-between relative z-10">
                <div>
                    <p class="text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1">@Localizer["TotalViews"]</p>
                    <p class="text-3xl font-extrabold text-white">@Model.Sum(p => p.Visit).ToString("N0")</p>
                </div>
                <div class="w-12 h-12 rounded-2xl bg-brand-orange/10 border border-brand-orange/20 flex items-center justify-center shadow-[inset_0_0_15px_rgba(255,126,66,0.1)] group-hover:scale-110 transition-transform">
                    <i class="fas fa-eye text-brand-orange text-lg"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        @foreach (var post in Model)
        {
            <div class="rounded-3xl bg-white/[0.02] border border-white/[0.05] overflow-hidden hover:border-brand-blue/20 hover:shadow-[0_20px_40px_rgba(0,0,0,0.4)] transition-all duration-300 flex flex-col group post-card" data-post-id="@post.PostId">
                <div class="p-6 flex flex-col flex-1">

                    <div class="flex items-start justify-between mb-4 gap-4 min-w-0">
                        <div class="flex-1 min-w-0">
                            <h3 class="text-lg font-bold text-white mb-2 truncate group-hover:text-brand-cyan transition-colors">@post.Title</h3>
                            <p class="text-slate-400 text-xs font-medium line-clamp-2 leading-relaxed">@post.Description</p>
                        </div>

                        <div class="flex-shrink-0">
                            @if (post.IsPublish)
                            {
                                <span class="px-2.5 py-1 text-[10px] font-bold tracking-wide rounded-lg bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 uppercase whitespace-nowrap">
                                    <i class="fas fa-check-circle @(isRtl ? "ml-1" : "mr-1") text-[9px]"></i>@Localizer["Published"]
                                </span>
                            }
                            else
                            {
                                <span class="px-2.5 py-1 text-[10px] font-bold tracking-wide rounded-lg bg-brand-yellow/10 text-brand-yellow border border-brand-yellow/20 uppercase whitespace-nowrap">
                                    <i class="fas fa-file-alt @(isRtl ? "ml-1" : "mr-1") text-[9px]"></i>@Localizer["Draft"]
                                </span>
                            }
                        </div>
                    </div>

                    <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-xs font-semibold text-slate-500 mb-6 pb-4 border-b border-white/5 mt-auto">
                        <div class="flex items-center bg-white/[0.02] px-2.5 py-1.5 rounded-lg border border-white/[0.02]">
                            <i class="fas fa-user text-slate-600 @(isRtl ? "ml-2" : "mr-2") text-[10px]"></i>
                            <span class="text-slate-300">@post.User.UserName</span>
                        </div>
                        <div class="flex items-center bg-white/[0.02] px-2.5 py-1.5 rounded-lg border border-white/[0.02]">
                            <i class="fas fa-calendar text-slate-600 @(isRtl ? "ml-2" : "mr-2") text-[10px]"></i>
                            <span class="text-slate-300">@post.CreateDate.ToString("yyyy/MM/dd")</span>
                        </div>
                        <div class="flex items-center bg-brand-cyan/5 text-brand-cyan px-2.5 py-1.5 rounded-lg border border-brand-cyan/10 font-mono">
                            <i class="fas fa-eye @(isRtl ? "ml-1.5" : "mr-1.5") text-[10px]"></i>
                            <span>@post.Visit.ToString("N0")</span>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 sm:flex sm:items-center sm:justify-end gap-2">
                        <a asp-action="Details" asp-route-id="@post.PostId"
                           class="px-3 py-2 bg-white/5 border border-white/5 text-slate-300 rounded-xl hover:bg-white/10 hover:text-white text-xs font-bold transition-all text-center flex items-center justify-center gap-1.5 sm:flex-1">
                            <i class="fas fa-eye text-[11px]"></i>@Localizer["Details"]
                        </a>
                        <a asp-action="Edit" asp-route-id="@post.PostId"
                           class="px-3 py-2 bg-brand-blue/10 text-brand-blue border border-brand-blue/10 rounded-xl hover:bg-brand-blue hover:text-white text-xs font-bold transition-all text-center flex items-center justify-center gap-1.5 sm:flex-1">
                            <i class="fas fa-edit text-[11px]"></i>@Localizer["Edit"]
                        </a>
                        <button onclick="togglePublish(@post.PostId, @post.IsPublish.ToString().ToLower())"
                                class="px-3 py-2 bg-brand-yellow/10 text-brand-yellow border border-brand-yellow/10 rounded-xl hover:bg-brand-yellow hover:text-dark-bg text-xs font-bold transition-all flex items-center justify-center sm:w-10" title="@(post.IsPublish ? Localizer["UnpublishPost"] : Localizer["PublishPost"])">
                            <i class="fas fa-@(post.IsPublish ? "eye-slash" : "eye") text-[11px]"></i>
                        </button>
                        <button onclick="deletePost(@post.PostId)"
                                class="px-3 py-2 bg-rose-500/10 text-rose-400 border border-rose-500/10 rounded-xl hover:bg-rose-500 hover:text-white text-xs font-bold transition-all flex items-center justify-center sm:w-10" title="@Localizer["Delete"]">
                            <i class="fas fa-trash text-[11px]"></i>
                        </button>
                    </div>

                </div>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="p-12 rounded-3xl bg-white/[0.01] border border-white/[0.05] border-dashed text-center max-w-xl mx-auto mt-12 relative overflow-hidden">
            <div class="w-16 h-16 mx-auto rounded-full bg-white/[0.02] border border-white/5 flex items-center justify-center mb-4">
                <i class="fas fa-newspaper text-3xl text-slate-600 animate-pulse"></i>
            </div>
            <h3 class="text-xl font-bold text-white mb-2">@Localizer["NoPostsFound"]</h3>
            <p class="text-slate-500 text-sm max-w-xs mx-auto mb-6 font-medium">@Localizer["NoPostsFoundSub"]</p>
            <a asp-action="Create"
               class="inline-flex px-6 py-2.5 bg-gradient-to-r from-brand-cyan to-brand-blue text-dark-bg rounded-xl font-extrabold hover:shadow-[0_0_15px_rgba(66,234,255,0.3)] transition-all text-sm">
                <i class="fas fa-plus @(isRtl ? "ml-2" : "mr-2") mt-0.5"></i> @Localizer["CreateNewPost"]
            </a>
        </div>
    }
</div>

@section Scripts {
    <script>
        // Toggle publish status
        async function togglePublish(postId, isPublish) {
            const action = isPublish ? 'unpublish' : 'publish';
            if (!confirm(`Are you sure you want to ${action} this post?`)) {
                return;
            }

            try {
                const response = await fetch('/Admin/Posts/TogglePublish', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ id: postId })
                });
                const result = await response.json();

                if (result.success) {
                    location.reload();
                } else {
                    alert(result.message || 'Failed to update post status.');
                }
            } catch (error) {
                alert('Connection error.');
            }
        }

        // Delete post
        async function deletePost(postId) {
            if (!confirm('Are you sure you want to permanently delete this post? This action cannot be undone.')) {
                return;
            }

            try {
                const response = await fetch('/Admin/Posts/Delete', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ id: postId })
                });
                const result = await response.json();

                if (result.success) {
                    location.reload();
                } else {
                    alert(result.message || 'Failed to delete post.');
                }
            } catch (error) {
                alert('Connection error.');
            }
        }
    </script>
}