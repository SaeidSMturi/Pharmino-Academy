@model Domain.Entities.Post.Post

@{
    var isRtl = System.Globalization.CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    ViewData["Title"] = Localizer["PostDetails"].Value;
}

<div class="animate-[fadeIn_0.4s_ease_forwards] w-full text-start" dir="@(isRtl ? "rtl" : "ltr")">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-10">
        <div>
            <h1 class="text-3xl font-extrabold bg-gradient-to-r from-brand-cyan to-brand-blue bg-clip-text text-transparent mb-2 tracking-wide">
                @Localizer["PostDetails"]
            </h1>
            <p class="text-slate-400 text-sm font-medium">@string.Format(Localizer["PostDetailsSub"].Value, Model.PostId)</p>
        </div>
        <div class="flex flex-col sm:flex-row gap-3 w-full md:w-auto">
            <a asp-action="Edit" asp-route-id="@Model.PostId" class="w-full sm:w-auto text-center px-5 py-2.5 bg-brand-blue/10 border border-brand-blue/20 text-brand-blue rounded-xl hover:bg-brand-blue hover:text-white transition-all text-sm font-bold flex items-center justify-center shadow-lg">
                <i class="fas fa-edit @(isRtl ? "ml-2" : "mr-2") text-xs"></i> @Localizer["EditPost"]
            </a>
            <a asp-action="Index" class="w-full sm:w-auto text-center px-5 py-2.5 bg-white/5 border border-white/5 text-slate-300 rounded-xl hover:bg-white/10 hover:text-white transition-all text-sm font-bold flex items-center justify-center shadow-lg whitespace-nowrap">
                <i class="fas @(isRtl ? "fa-arrow-right ml-2" : "fa-arrow-left mr-2") text-xs"></i> @Localizer["BackToPosts"]
            </a>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">

        <div class="lg:col-span-2 space-y-6">

            <div class="rounded-3xl bg-white/[0.02] border border-white/[0.05] overflow-hidden relative shadow-2xl backdrop-blur-xl">
                @if (!string.IsNullOrEmpty(Model.ImageName) && Model.ImageName != "default.jpg")
                {
                    <div class="w-full h-80 bg-dark-bg border-b border-white/5">
                        <img src="~/uploads/posts/@Model.ImageName" alt="@Model.Title" class="w-full h-full object-cover" />
                    </div>
                }
                else
                {
                    <div class="w-full h-80 bg-gradient-to-br from-brand-blue/10 to-brand-cyan/5 flex items-center justify-center border-b border-white/5">
                        <i class="fas fa-image text-7xl text-brand-cyan/20 drop-shadow-[0_0_15px_rgba(66,234,255,0.1)]"></i>
                    </div>
                }

                <div class="p-6 md:p-8">
                    <div class="mb-4">
                        @if (Model.IsPublish)
                        {
                            <span class="px-3 py-1.5 text-[10px] font-bold tracking-wide rounded-lg bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 uppercase">
                                <i class="fas fa-circle-check @(isRtl ? "ml-1.5" : "mr-1.5")"></i>@Localizer["Published"]
                            </span>
                        }
                        else
                        {
                            <span class="px-3 py-1.5 text-[10px] font-bold tracking-wide rounded-lg bg-brand-yellow/10 text-brand-yellow border border-brand-yellow/20 uppercase">
                                <i class="fas fa-file-alt @(isRtl ? "ml-1.5" : "mr-1.5")"></i>@Localizer["Draft"]
                            </span>
                        }
                    </div>

                    <h2 class="text-2xl font-bold text-white mb-4">@Model.Title</h2>

                    <p class="text-sm font-medium text-slate-400 mb-6 leading-relaxed bg-white/[0.01] border border-white/[0.02] p-4 rounded-xl">@Model.Description</p>

                    <div class="flex flex-wrap items-center gap-4 pb-6 border-b border-white/5 text-xs font-semibold text-slate-500">
                        <div class="flex items-center bg-white/[0.02] px-2.5 py-1.5 rounded-lg border border-white/[0.02]">
                            <i class="fas fa-user text-brand-purple @(isRtl ? "ml-2" : "mr-2") text-[10px]"></i>
                            <span>@Localizer["Student"]: <span class="text-slate-300">@Model.User.UserName</span></span>
                        </div>
                        <div class="flex items-center bg-white/[0.02] px-2.5 py-1.5 rounded-lg border border-white/[0.02]">
                            <i class="far fa-clock text-brand-blue @(isRtl ? "ml-2" : "mr-2") text-[10px]"></i>
                            <span class="font-mono" dir="ltr">@Model.CreateDate.ToString("yyyy/MM/dd HH:mm")</span>
                        </div>
                        <div class="flex items-center bg-white/[0.02] px-2.5 py-1.5 rounded-lg border border-white/[0.02]">
                            <i class="fas fa-eye text-emerald-400 @(isRtl ? "ml-2" : "mr-2") text-[10px]"></i>
                            <span class="font-mono">@Model.Visit.ToString("N0")</span>
                        </div>
                        <div class="flex items-center bg-white/[0.02] px-2.5 py-1.5 rounded-lg border border-white/[0.02]">
                            <i class="fas fa-fingerprint text-brand-orange @(isRtl ? "ml-2" : "mr-2") text-[10px]"></i>
                            <span class="font-mono">ID: #@Model.PostId</span>
                        </div>
                    </div>

                    <div class="mt-8">
                        <h3 class="text-xs font-bold text-slate-500 uppercase tracking-widest mb-4 flex items-center">
                            <i class="fas fa-file-lines text-brand-cyan @(isRtl ? "ml-2" : "mr-2") text-sm"></i> @Localizer["PostContent"]
                        </h3>
                        <div class="prose prose-invert max-w-none selection:bg-brand-cyan/20">
                            <div class="text-slate-300 text-sm leading-7 font-medium space-y-4 break-words">
                                @Html.Raw(Model.Body)
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @if (Model.PostComments != null && Model.PostComments.Any())
            {
                <div class="p-6 md:p-8 rounded-3xl bg-white/[0.02] border border-white/[0.05]">
                    <h3 class="text-base font-bold text-white mb-4 flex items-center">
                        <i class="fas fa-comments @(isRtl ? "ml-3" : "mr-3") text-brand-blue text-lg"></i> @Localizer["Comments"] (@Model.PostComments.Count)
                    </h3>
                </div>
            }
        </div>

        <div class="space-y-6">

            <div class="p-6 rounded-3xl bg-white/[0.02] border border-white/[0.05]">
                <h3 class="text-sm font-bold text-slate-400 uppercase tracking-widest mb-4 flex items-center">
                    <i class="fas fa-bolt text-brand-yellow @(isRtl ? "ml-2" : "mr-2")"></i> @Localizer["Actions"]
                </h3>

                <div class="space-y-2.5">
                    <button onclick="togglePublish(@Model.PostId, @Model.IsPublish.ToString().ToLower())"
                            class="w-full px-4 py-2.5 bg-brand-yellow/10 text-brand-yellow border border-brand-yellow/20 rounded-xl hover:bg-brand-yellow hover:text-dark-bg transition-all text-xs font-bold flex items-center justify-center gap-2 shadow-sm">
                        <i class="fas fa-@(Model.IsPublish ? "eye-slash" : "eye") text-sm"></i>
                        <span>@(Model.IsPublish ? Localizer["UnpublishPost"] : Localizer["PublishPost"])</span>
                    </button>

                    <a asp-action="Edit" asp-route-id="@Model.PostId"
                       class="block w-full px-4 py-2.5 bg-brand-blue/10 text-brand-blue border border-brand-blue/10 rounded-xl hover:bg-brand-blue hover:text-white transition-all text-xs font-bold text-center">
                        <i class="fas fa-edit @(isRtl ? "ml-1.5" : "mr-1.5")"></i> @Localizer["EditPost"]
                    </a>

                    <button onclick="deletePost(@Model.PostId)"
                            class="w-full px-4 py-2.5 bg-rose-500/10 text-rose-400 border border-rose-500/20 rounded-xl hover:bg-rose-500 hover:text-white transition-all text-xs font-bold flex items-center justify-center gap-2 shadow-sm">
                        <i class="fas fa-trash text-sm"></i> @Localizer["Delete"]
                    </button>
                </div>
            </div>

            <div class="p-6 rounded-3xl bg-white/[0.02] border border-white/[0.05]">
                <h3 class="text-sm font-bold text-white mb-6 flex items-center">
                    <i class="fas fa-search-plus @(isRtl ? "ml-3" : "mr-3") text-brand-cyan text-base"></i> @Localizer["SEOAndTags"]
                </h3>

                <div class="space-y-5">
                    <div>
                        <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block mb-1.5">@Localizer["MetaDescription"]</label>
                        <p class="text-xs font-medium text-slate-300 leading-relaxed bg-white/[0.01] p-3 rounded-xl border border-white/[0.02]">
                            @(string.IsNullOrWhiteSpace(Model.MetaDescription) ? "-" : Model.MetaDescription)
                        </p>
                    </div>

                    <div>
                        <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block mb-2.5">@Localizer["Tags"]</label>
                        <div class="flex flex-wrap gap-1.5">
                            @if (!string.IsNullOrEmpty(Model.Tags))
                            {
                                @foreach (var tag in Model.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                {
                                    <span class="px-2.5 py-1 bg-brand-cyan/5 text-brand-cyan border border-brand-cyan/10 rounded-lg text-[10px] font-bold font-mono">
                                        #@tag.Trim()
                                    </span>
                                }
                            }
                            else
                            {
                                <span class="text-slate-600 text-xs font-medium italic">-</span>
                            }
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.ShortKey))
                    {
                        <div>
                            <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block mb-1.5">@Localizer["URLSlug"]</label>
                            <p class="text-xs font-bold text-brand-blue font-mono bg-white/[0.01] p-3 rounded-xl border border-white/[0.02] select-all" dir="ltr">
                                @Model.ShortKey
                            </p>
                        </div>
                    }
                </div>
            </div>

            <div class="p-6 rounded-3xl bg-white/[0.02] border border-white/[0.05]">
                <h3 class="text-sm font-bold text-white mb-4 flex items-center">
                    <i class="fas fa-chart-line @(isRtl ? "ml-3" : "mr-3") text-brand-blue text-base"></i> @Localizer["Statistics"]
                </h3>
                <div class="space-y-2 font-medium text-xs">
                    <div class="flex items-center justify-between p-3 bg-white/[0.01] border border-white/[0.02] rounded-xl">
                        <span class="text-slate-400 flex items-center"><i class="fas fa-eye text-brand-cyan w-4 @(isRtl ? "ml-2" : "mr-2")"></i>@Localizer["TotalViews"]</span>
                        <span class="text-white font-bold font-mono">@Model.Visit.ToString("N0")</span>
                    </div>
                    <div class="flex items-center justify-between p-3 bg-white/[0.01] border border-white/[0.02] rounded-xl">
                        <span class="text-slate-400 flex items-center"><i class="fas fa-comments text-emerald-400 w-4 @(isRtl ? "ml-2" : "mr-2")"></i>@Localizer["CommentsCount"]</span>
                        <span class="text-white font-bold font-mono">@(Model.PostComments?.Count ?? 0)</span>
                    </div>
                    <div class="flex items-center justify-between p-3 bg-white/[0.01] border border-white/[0.02] rounded-xl">
                        <span class="text-slate-400 flex items-center"><i class="fas fa-tags text-brand-blue w-4 @(isRtl ? "ml-2" : "mr-2")"></i>@Localizer["TagsCount"]</span>
                        <span class="text-white font-bold font-mono">@(string.IsNullOrEmpty(Model.Tags) ? 0 : Model.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries).Length)</span>
                    </div>
                </div>
            </div>

            <div class="p-6 rounded-3xl bg-white/[0.02] border border-white/[0.05]">
                <h3 class="text-sm font-bold text-white mb-4 flex items-center">
                    <i class="fas fa-user-pen @(isRtl ? "ml-3" : "mr-3") text-brand-purple text-base"></i> @Localizer["AuthorInformation"]
                </h3>
                <div class="flex items-center @(isRtl ? "space-x-reverse" : "space-x-3.5") bg-white/[0.01] p-3 rounded-2xl border border-white/[0.02]">
                    <div class="w-11 h-11 rounded-xl bg-gradient-to-tr from-brand-orange to-brand-yellow flex items-center justify-center text-dark-bg font-black text-lg shadow-[0_0_12px_rgba(255,126,66,0.2)]">
                        @Model.User.UserName.Substring(0, 1).ToUpper()
                    </div>
                    <div class="flex-1 min-w-0">
                        <div class="font-bold text-white text-sm truncate">@Model.User.UserName</div>
                        @if (!string.IsNullOrEmpty(Model.User.Email))
                        {
                            <div class="text-[11px] text-slate-500 font-medium truncate font-mono mt-0.5" dir="ltr">@Model.User.Email</div>
                        }
                    </div>
                </div>
            </div>

            <div class="p-6 rounded-3xl bg-white/[0.02] border border-white/[0.05]">
                <h3 class="text-sm font-bold text-slate-400 uppercase tracking-widest mb-3 flex items-center">
                    <i class="fas fa-image text-brand-orange @(isRtl ? "ml-2" : "mr-2") text-base"></i> @Localizer["CoverImageName"]
                </h3>
                <div class="flex items-center justify-between text-xs font-semibold bg-white/[0.01] p-3 rounded-xl border border-white/[0.02] font-mono">
                    <span class="text-slate-500">@Localizer["CoverImageName"]:</span>
                    <span class="text-slate-300 truncate max-w-[140px]" title="@Model.ImageName" dir="ltr">@Model.ImageName</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Toggle publish status
        async function togglePublish(postId, isPublish) {
            const action = isPublish ? 'unpublish' : 'publish';
            if (!confirm(`Are you sure you want to ${action} this post?`)) {
                return;
            }

            try {
                const response = await fetch(`/Admin/Posts/TogglePublish?id=${postId}`, {
                    method: 'POST'
                });
                const result = await response.json();

                if (result.success) {
                    location.reload();
                } else {
                    alert(result.message || 'Failed to update post status.');
                }
            } catch (error) {
                alert('Connection error.');
            }
        }

        // Delete post
        async function deletePost(postId) {
            if (!confirm('Are you sure you want to permanently delete this post? This action cannot be undone.')) {
                return;
            }

            try {
                const response = await fetch(`/Admin/Posts/Delete?id=${postId}`, {
                    method: 'POST'
                });
                const result = await response.json();

                if (result.success) {
                    window.location.href = '/Admin/Posts';
                } else {
                    alert(result.message || 'Failed to delete post.');
                }
            } catch (error) {
                alert('Connection error.');
            }
        }
    </script>
}