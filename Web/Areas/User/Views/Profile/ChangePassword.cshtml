@model Application.DTOs.User.ChangePasswordDto
@{
    var isRtl = System.Globalization.CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    ViewData["Title"] = Localizer["ChangePassword"].Value;
}

<div class="mx-auto animate-fade-in-up">
    <!-- Main Form Glass Container -->
    <div class="rounded-[2rem] p-6 lg:p-10 relative overflow-hidden">
        <!-- Header -->
        <div class="mb-8 relative z-10 flex items-center @(isRtl ? "space-x-reverse sm:mr-4" : "space-x-4")">
            <div class="w-12 h-12 rounded-xl bg-brand-orange/10 flex items-center justify-center border border-brand-orange/20 shadow-[0_0_15px_rgba(255,126,66,0.05)]">
                <i class="fas fa-shield-halved text-brand-orange text-lg"></i>
            </div>
            <div class="text-start">
                <h1 class="text-2xl font-extrabold text-white tracking-tight">@Localizer["ChangePassword"]</h1>
                <p class="text-slate-400 text-xs mt-1">@Localizer["ChangePasswordSub"]</p>
            </div>
        </div>

        <!-- Secure Form Structure -->
        <form asp-action="ChangePassword" method="post" class="space-y-6 relative z-10">

            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="ModelOnly" class="p-4 rounded-xl bg-[#1A0B0B] border border-brand-orange/20 text-brand-orange text-xs font-bold uppercase tracking-wide flex items-center gap-2 @(isRtl ? "space-x-reverse" : "")">
                    <i class="fas fa-triangle-exclamation text-sm"></i>
                    <span>@Localizer["ErrorCorrectionRequired"]</span>
                </div>
            }

            <!-- Current Password Inputs Matrix -->
            <div class="space-y-1.5 text-start">
                <label asp-for="CurrentPassword" class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">@Localizer["CurrentPassword"]</label>
                <div class="relative">
                    <input asp-for="CurrentPassword" type="password"
                           class="w-full bg-brand-dark/50 border border-white/5 rounded-xl p-3.5 focus:border-brand-cyan/50 focus:ring-1 focus:ring-brand-cyan/20 focus:outline-none transition-all text-sm text-white placeholder-slate-600 font-sans tracking-widest shadow-inner"
                           placeholder="••••••••••••" />
                </div>
                <span asp-validation-for="CurrentPassword" class="text-brand-orange text-xs font-medium mt-1 block"></span>
            </div>

            <!-- New Password Box -->
            <div class="space-y-1.5 text-start">
                <label asp-for="NewPassword" class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">@Localizer["NewPassword"]</label>
                <div class="relative">
                    <input asp-for="NewPassword" type="password"
                           class="w-full bg-brand-dark/50 border border-white/5 rounded-xl p-3.5 focus:border-brand-cyan/50 focus:ring-1 focus:ring-brand-cyan/20 focus:outline-none transition-all text-sm text-white placeholder-slate-600 font-sans tracking-widest shadow-inner"
                           placeholder="••••••••••••" />
                </div>
                <span asp-validation-for="NewPassword" class="text-brand-orange text-xs font-medium mt-1 block"></span>
                <p class="text-[10px] text-slate-500 font-bold uppercase tracking-wider mt-1 flex items-center gap-1.5 @(isRtl ? "space-x-reverse" : "")">
                    <i class="fas fa-circle-info text-brand-blue text-xs"></i> @Localizer["PasswordMinLengthConstraint"]
                </p>
            </div>

            <!-- Confirm New Password Field -->
            <div class="space-y-1.5 text-start">
                <label asp-for="ConfirmNewPassword" class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">@Localizer["ConfirmNewPassword"]</label>
                <div class="relative">
                    <input asp-for="ConfirmNewPassword" type="password"
                           class="w-full bg-brand-dark/50 border border-white/5 rounded-xl p-3.5 focus:border-brand-cyan/50 focus:ring-1 focus:ring-brand-cyan/20 focus:outline-none transition-all text-sm text-white placeholder-slate-600 font-sans tracking-widest shadow-inner"
                           placeholder="••••••••••••" />
                </div>
                <span asp-validation-for="ConfirmNewPassword" class="text-brand-orange text-xs font-medium mt-1 block"></span>
            </div>

            <!-- Premium Security Notice Card -->
            <div class="p-4 rounded-xl bg-white/[0.01] border border-white/5 relative overflow-hidden text-start">
                <div class="absolute -right-8 -bottom-8 w-24 h-24 bg-brand-blue/5 rounded-full blur-xl"></div>
                <div class="flex items-start @(isRtl ? "space-x-reverse" : "") space-x-3.5 relative z-10">
                    <div class="w-8 h-8 rounded-lg bg-brand-blue/10 flex items-center justify-center border border-brand-blue/10 shrink-0">
                        <i class="fas fa-shield text-brand-blue text-xs"></i>
                    </div>
                    <div class="text-xs font-medium">
                        <p class="font-bold text-white uppercase tracking-wider mb-1.5">@Localizer["SecuritySafeguards"]</p>
                        <ul class="space-y-1 text-slate-400 list-none @(isRtl ? "pr-0" : "pl-0")">
                            <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-brand-cyan"></span> @Localizer["Safeguard1"]</li>
                            <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-brand-cyan"></span> @Localizer["Safeguard2"]</li>
                            <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-brand-cyan"></span> @Localizer["Safeguard3"]</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Interactive Action Triggers -->
            <div class="flex flex-col-reverse sm:flex-row sm:items-center justify-between gap-4 pt-6 border-t border-white/5 @(isRtl ? "space-x-reverse" : "")">
                <a asp-action="Index" asp-controller="Dashboard"
                   class="w-full sm:w-auto text-center px-6 py-3 rounded-xl bg-white/5 border border-white/5 text-slate-400 hover:text-white hover:bg-white/10 font-bold text-xs uppercase tracking-wider transition-all duration-200">
                    @Localizer["Cancel"]
                </a>
                <button type="submit"
                        class="w-full sm:w-auto px-6 py-3 rounded-xl bg-brand-blue hover:bg-brand-blue/80 text-white font-bold text-xs uppercase tracking-widest transition-all duration-300 shadow-lg shadow-brand-blue/10 hover:shadow-brand-blue/30 group">
                    <i class="fas fa-key @(isRtl ? "ml-2" : "mr-2") group-hover:rotate-45 transition-transform duration-300 text-brand-cyan"></i>
                    @Localizer["ChangePassword"]
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}