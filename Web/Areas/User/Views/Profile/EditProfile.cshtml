@model Application.DTOs.User.EditProfileDto
@{
    var isRtl = System.Globalization.CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    ViewData["Title"] = Localizer["EditProfile"].Value;
}

<div class="mx-auto animate-fade-in-up">
    <!-- Main Profile Card Glass Container -->
    <div class="rounded-[2rem] p-6 lg:p-10 relative overflow-hidden">

           <!-- Form Structure -->
        <form asp-action="EditProfile" method="post" class="space-y-6 relative z-10">

            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="ModelOnly" class="p-4 rounded-xl bg-[#1A0B0B] border border-brand-orange/20 text-brand-orange text-xs font-bold uppercase tracking-wide flex items-center gap-2 @(isRtl ? "space-x-reverse" : "")">
                    <i class="fas fa-triangle-exclamation text-sm"></i>
                    <span>@Localizer["ValidationFailed"]</span>
                </div>
            }

            @Html.HiddenFor(dto => dto.LoginWithGoogle)

            <!-- Name Grid Layout -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-start">
                <!-- First Name -->
                <div class="space-y-1.5">
                    <label asp-for="FirstName" class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">@Localizer["FirstName"]</label>
                    <input asp-for="FirstName"
                           class="w-full bg-brand-dark/50 border border-white/5 rounded-xl p-3.5 focus:border-brand-cyan/50 focus:ring-1 focus:ring-brand-cyan/20 focus:outline-none transition-all text-sm text-white placeholder-slate-600 shadow-inner"
                           placeholder="@Localizer["EnterFirstName"]" />
                    <span asp-validation-for="FirstName" class="text-brand-orange text-xs font-medium mt-1 block"></span>
                </div>

                <!-- Last Name -->
                <div class="space-y-1.5">
                    <label asp-for="LastName" class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">@Localizer["LastName"]</label>
                    <input asp-for="LastName"
                           class="w-full bg-brand-dark/50 border border-white/5 rounded-xl p-3.5 focus:border-brand-cyan/50 focus:ring-1 focus:ring-brand-cyan/20 focus:outline-none transition-all text-sm text-white placeholder-slate-600 shadow-inner"
                           placeholder="@Localizer["EnterLastName"]" />
                    <span asp-validation-for="LastName" class="text-brand-orange text-xs font-medium mt-1 block"></span>
                </div>
            </div>

            <!-- Username Box -->
            <div class="space-y-1.5 text-start">
                <label asp-for="UserName" class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">@Localizer["Username"]</label>
                <input asp-for="UserName"
                       class="w-full bg-brand-dark/50 border border-white/5 rounded-xl p-3.5 focus:border-brand-cyan/50 focus:ring-1 focus:ring-brand-cyan/20 focus:outline-none transition-all text-sm text-white placeholder-slate-600 shadow-inner"
                       placeholder="@Localizer["Username"]" />
                <span asp-validation-for="UserName" class="text-brand-orange text-xs font-medium mt-1 block"></span>
            </div>

            <!-- Email Box with Google Auth Handler -->
            <div class="space-y-1.5 text-start">
                <label asp-for="Email" class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">@Localizer["Email"]</label>
                @if (!Model.LoginWithGoogle)
                {
                    <input asp-for="Email" type="email"
                           class="w-full bg-brand-dark/50 border border-white/5 rounded-xl p-3.5 focus:border-brand-cyan/50 focus:ring-1 focus:ring-brand-cyan/20 focus:outline-none transition-all text-sm text-white placeholder-slate-600 shadow-inner"
                           placeholder="example@domain.com" />
                    <span asp-validation-for="Email" class="text-brand-orange text-xs font-medium mt-1 block"></span>
                }
                else
                {
                    @Html.HiddenFor(dto => dto.Email)
                    <div class="relative">
                        <input asp-for="Email" type="email" disabled
                               class="w-full bg-brand-dark/30 border border-white/5 rounded-xl p-3.5 @(isRtl ? "pr-10" : "pl-10") text-slate-500 cursor-not-allowed opacity-50 text-sm font-medium shadow-inner" />
                        <div class="absolute @(isRtl ? "right-3.5" : "left-3.5") top-1/2 transform -translate-y-1/2 text-slate-600">
                            <i class="fab fa-google text-xs"></i>
                        </div>
                    </div>
                    <span asp-validation-for="Email" class="text-brand-orange text-xs font-medium mt-1 block"></span>
                    <p class="text-[10px] text-brand-blue font-bold uppercase tracking-wider mt-1 flex items-center gap-1.5 @(isRtl ? "space-x-reverse" : "")">
                        <i class="fas fa-lock text-xs"></i> @Localizer["SSOGoogleLock"]
                    </p>
                }
            </div>

            <!-- Phone Number Box -->
            <div class="space-y-1.5 text-start">
                <label asp-for="PhoneNumber" class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">@Localizer["Phone"]</label>
                <input asp-for="PhoneNumber" type="tel"
                       class="w-full bg-brand-dark/50 border border-white/5 rounded-xl p-3.5 focus:border-brand-cyan/50 focus:ring-1 focus:ring-brand-cyan/20 focus:outline-none transition-all text-sm text-white placeholder-slate-600 shadow-inner"
                       placeholder="@Localizer["Phone"]" />
                <span asp-validation-for="PhoneNumber" class="text-brand-orange text-xs font-medium mt-1 block"></span>
            </div>

            <!-- Action Buttons Footer -->
            <div class="flex flex-col-reverse sm:flex-row sm:items-center justify-between gap-4 pt-6 border-t border-white/5 @(isRtl ? "space-x-reverse" : "")">
                <a asp-action="Index" asp-controller="Dashboard"
                   class="w-full sm:w-auto text-center px-6 py-3 rounded-xl bg-white/5 border border-white/5 text-slate-400 hover:text-white hover:bg-white/10 font-bold text-xs uppercase tracking-wider transition-all duration-200">
                    @Localizer["AbortChanges"]
                </a>
                <button type="submit"
                        class="w-full sm:w-auto px-6 py-3 rounded-xl bg-brand-blue hover:bg-brand-blue/80 text-white font-bold text-xs uppercase tracking-widest transition-all duration-300 shadow-lg shadow-brand-blue/10 hover:shadow-brand-blue/30 group">
                    <i class="fas fa-arrow-up-from-bracket @(isRtl ? "ml-2" : "mr-2") group-hover:-translate-y-0.5 transition-transform duration-200 text-brand-cyan"></i>
                    @Localizer["SyncProfile"]
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
}