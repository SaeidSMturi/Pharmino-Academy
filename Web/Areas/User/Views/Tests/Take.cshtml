@model Domain.Entities.Exam.Exam

@{
    var isRtl = System.Globalization.CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    ViewData["Title"] = $"{Model.Title} - Examination";
    var attempt = ViewBag.Attempt as Domain.Entities.Exam.ExamAttempt;
    var remainingSeconds = (int)(ViewBag.RemainingSeconds ?? (Model.DurationMinutes * 60)); // -1 = no time limit
    var answeredQuestionIds = attempt?.Answers?.Select(a => a.QuestionId).ToHashSet() ?? new HashSet<int>();
    var selectedOptionMap = attempt?.Answers?.Where(a => a.SelectedOptionId.HasValue).ToDictionary(a => a.QuestionId, a => a.SelectedOptionId!.Value) ?? new Dictionary<int, int>();

    // Already in this attempt's display order (shuffled when the test asks for it).
    var displayQuestions = ViewBag.Questions as List<Web.Areas.User.Controllers.TestsController.TakeQuestion>
        ?? Model.Questions.OrderBy(q => q.OrderIndex).Select(q => new Web.Areas.User.Controllers.TestsController.TakeQuestion(q, q.Options.ToList())).ToList();
    var questions = displayQuestions.Select(d => d.Question).ToList();
}

@Html.AntiForgeryToken()

<div class="w-full text-start max-w-5xl mx-auto space-y-6 pb-24" dir="@(isRtl ? "rtl" : "ltr")">
    <!-- Top Cyberpunk Countdown Timer Bar (Sticky) -->
    <div class="sticky top-4 z-40 glass-panel rounded-2xl p-4 border border-brand-cyan/20 shadow-2xl backdrop-blur-xl bg-dark-bg/85">
        <div class="flex items-center justify-between gap-4">
            <div class="flex items-center gap-3 min-w-0">
                <div class="w-10 h-10 rounded-xl bg-brand-cyan/10 border border-brand-cyan/20 flex items-center justify-center text-brand-cyan shrink-0">
                    <i class="fas fa-file-signature"></i>
                </div>
                <div class="min-w-0">
                    <h1 class="text-sm md:text-base font-bold text-white truncate">@Model.Title</h1>
                    <span class="text-xs text-slate-400">Answered: <strong id="answeredCountLabel" class="text-brand-cyan font-mono">@answeredQuestionIds.Count</strong> / @questions.Count questions</span>
                </div>
            </div>

            <!-- Digital Countdown Display -->
            <div class="flex items-center gap-3 shrink-0">
                <div id="timerContainer" class="px-4 py-2 rounded-xl bg-dark-bg border border-brand-cyan/30 flex items-center gap-2.5 shadow-[0_0_15px_rgba(66,234,255,0.15)] transition-all">
                    <i id="timerIcon" class="fas fa-stopwatch text-brand-cyan animate-pulse"></i>
                    <span id="timerDisplay" class="font-mono text-base md:text-xl font-extrabold tracking-widest text-brand-cyan">00:00:00</span>
                </div>

                <button type="button" onclick="confirmSubmitExam()" class="px-4 py-2.5 rounded-xl bg-gradient-to-r from-brand-cyan to-brand-blue text-dark-bg font-extrabold text-xs md:text-sm hover:shadow-[0_0_20px_rgba(66,234,255,0.4)] transition-all flex items-center gap-1.5">
                    <i class="fas fa-check-double"></i>
                    <span class="hidden sm:inline">Finish &amp; Submit</span>
                    <span class="sm:hidden">Submit</span>
                </button>
            </div>
        </div>

        <!-- Remaining Time Linear Gauge -->
        <div class="w-full bg-white/5 h-1.5 rounded-full mt-3 overflow-hidden">
            <div id="timeProgressBar" class="h-full bg-gradient-to-r from-brand-cyan to-brand-blue rounded-full transition-all duration-1000" style="width: 100%;"></div>
        </div>
    </div>

    <!-- Main Content Area: Questions & Question Navigator Dock -->
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
        <!-- Question Navigator Dock (Desktop sticky) -->
        <div class="lg:col-span-1 order-2 lg:order-1">
            <div class="glass-panel rounded-2xl p-4 sticky top-28 border border-white/5 shadow-xl">
                <div class="flex items-center justify-between mb-3 pb-2 border-b border-white/5">
                    <span class="text-xs font-bold uppercase text-slate-400 tracking-wider">Question Navigator</span>
                    <span class="text-[11px] font-mono text-brand-cyan font-bold" id="progressPercentage">
                        @(questions.Count > 0 ? (int)((double)answeredQuestionIds.Count / questions.Count * 100) : 0)%
                    </span>
                </div>

                <div class="grid grid-cols-5 sm:grid-cols-6 lg:grid-cols-4 gap-2 max-h-[350px] overflow-y-auto pr-1">
                    @for (int i = 0; i < questions.Count; i++)
                    {
                        var q = questions[i];
                        var isAnswered = answeredQuestionIds.Contains(q.QuestionId);
                        <button type="button"
                                id="navBtn_@q.QuestionId"
                                onclick="scrollToQuestion(@i)"
                                class="h-9 rounded-xl font-mono text-xs font-bold transition-all flex items-center justify-center border @(isAnswered ? "bg-brand-cyan/20 text-brand-cyan border-brand-cyan/40 shadow-[0_0_8px_rgba(66,234,255,0.2)]" : "bg-dark-bg/60 text-slate-400 border-white/5 hover:text-white hover:bg-white/5")">
                            @(i + 1)
                        </button>
                    }
                </div>

                <div class="mt-4 pt-3 border-t border-white/5 flex items-center justify-around text-[10px] text-slate-400 font-medium">
                    <span class="flex items-center gap-1.5">
                        <span class="w-2.5 h-2.5 rounded-full bg-brand-cyan/40 border border-brand-cyan"></span> Answered
                    </span>
                    <span class="flex items-center gap-1.5">
                        <span class="w-2.5 h-2.5 rounded-full bg-dark-bg border border-white/20"></span> Pending
                    </span>
                </div>
            </div>
        </div>

        <!-- Questions Stream -->
        <div class="lg:col-span-3 order-1 lg:order-2 space-y-6" id="questionsList">
            @for (int i = 0; i < questions.Count; i++)
            {
                var q = questions[i];
                var currentSelectedOptionId = selectedOptionMap.ContainsKey(q.QuestionId) ? selectedOptionMap[q.QuestionId] : 0;
                var options = displayQuestions[i].Options;

                <div class="glass-panel rounded-2xl p-6 border border-white/10 hover:border-white/20 transition-all shadow-xl question-card" id="qBlock_@i">
                    <!-- Question Header -->
                    <div class="flex items-start justify-between gap-4 mb-4">
                        <div class="flex items-center gap-3">
                            <span class="w-9 h-9 rounded-xl bg-gradient-to-br from-brand-cyan to-brand-blue text-dark-bg font-mono font-extrabold text-sm flex items-center justify-center shrink-0 shadow-md">
                                @(i + 1)
                            </span>
                            <span class="text-xs uppercase font-bold text-slate-400 tracking-wider">Question @(i + 1) of @questions.Count</span>
                        </div>
                        <span id="savedIndicator_@q.QuestionId" class="text-xs text-emerald-400 font-bold transition-opacity duration-300 opacity-0 flex items-center gap-1">
                            <i class="fas fa-check-circle"></i> Saved
                        </span>
                    </div>

                    <!-- Question Body -->
                    <div class="text-base text-white font-medium mb-6 leading-relaxed">
                        @q.QuestionText
                    </div>

                    <!-- Options Grid -->
                    <div class="space-y-3">
                        @foreach (var opt in options)
                        {
                            var isSelected = (opt.OptionId == currentSelectedOptionId);
                            <label class="flex items-center gap-3.5 p-3.5 rounded-xl border transition-all cursor-pointer group @(isSelected ? "bg-brand-cyan/15 border-brand-cyan shadow-[0_0_15px_rgba(66,234,255,0.15)] text-white" : "bg-dark-bg/40 border-white/5 hover:border-white/20 text-slate-300 hover:text-white")"
                                   id="optLabel_@opt.OptionId">
                                <input type="radio"
                                       name="question_@q.QuestionId"
                                       value="@opt.OptionId"
                                       @(isSelected ? "checked" : "")
                                       onchange="selectOption(@attempt?.AttemptId, @q.QuestionId, @opt.OptionId, @i)"
                                       class="hidden" />

                                <span class="w-7 h-7 rounded-lg font-mono font-bold text-xs flex items-center justify-center shrink-0 transition-all @(isSelected ? "bg-brand-cyan text-dark-bg shadow-sm" : "bg-white/5 text-slate-400 group-hover:text-white")"
                                      id="optBadge_@opt.OptionId">
                                    @* Position letter, so shuffled options still read A, B, C, D *@
                                    @((char)('A' + options.IndexOf(opt)))
                                </span>

                                <span class="flex-1 text-sm font-medium">@opt.OptionText</span>

                                <i class="fas fa-check text-brand-cyan text-sm @(isSelected ? "opacity-100" : "opacity-0") transition-opacity" id="optCheck_@opt.OptionId"></i>
                            </label>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Submit Confirmation Modal -->
<div id="submitModal" class="fixed inset-0 z-50 bg-dark-bg/90 backdrop-blur-md flex items-center justify-center p-4 hidden">
    <div class="glass-panel rounded-3xl p-8 max-w-md w-full border border-brand-cyan/30 text-center shadow-2xl animate-[scaleIn_0.3s_ease]">
        <div class="w-16 h-16 rounded-2xl bg-brand-cyan/10 border border-brand-cyan/30 text-brand-cyan flex items-center justify-center mx-auto mb-4 text-2xl">
            <i class="fas fa-flag-checkered"></i>
        </div>
        <h3 class="text-xl font-bold text-white mb-2">Ready to Submit?</h3>
        <p class="text-slate-300 text-sm mb-6 leading-relaxed" id="modalProgressSummary">
            You have completed all questions. Would you like to finalize and view your score?
        </p>
        <div class="flex gap-3">
            <button type="button" onclick="closeSubmitModal()" class="flex-1 py-3 rounded-xl bg-white/5 hover:bg-white/10 text-slate-300 font-bold text-sm transition-colors">
                Return to Test
            </button>
            <button type="button" id="finalSubmitBtn" onclick="submitExamNow()" class="flex-1 py-3 rounded-xl bg-gradient-to-r from-brand-cyan to-brand-blue text-dark-bg font-extrabold text-sm hover:shadow-[0_0_20px_rgba(66,234,255,0.4)] transition-all">
                Submit Now
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const attemptId = @(attempt?.AttemptId ?? 0);
        const totalQuestions = @questions.Count;
        let answeredQuestionsSet = new Set([@string.Join(",", answeredQuestionIds)]);
        let remainingSeconds = @remainingSeconds;
        const totalDurationSeconds = @(Model.DurationMinutes * 60);
        const hasTimeLimit = remainingSeconds >= 0 && totalDurationSeconds > 0;

        function antiForgeryToken() {
            return document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        }

        // Timer Execution
        const timerDisplay = document.getElementById('timerDisplay');
        const timerContainer = document.getElementById('timerContainer');
        const timerIcon = document.getElementById('timerIcon');
        const timeProgressBar = document.getElementById('timeProgressBar');

        function updateTimerUI() {
            if (!hasTimeLimit) {
                timerDisplay.innerText = "No limit";
                timerIcon.classList.remove('animate-pulse');
                timeProgressBar.style.width = "100%";
                return;
            }

            if (remainingSeconds <= 0) {
                timerDisplay.innerText = "00:00:00";
                timeProgressBar.style.width = "0%";
                autoSubmitExamOnTimeout();
                return;
            }

            const h = Math.floor(remainingSeconds / 3600);
            const m = Math.floor((remainingSeconds % 3600) / 60);
            const s = remainingSeconds % 60;

            timerDisplay.innerText = 
                `${h.toString().padStart(2, '0')}:${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;

            const percentRemaining = Math.max(0, Math.min(100, (remainingSeconds / totalDurationSeconds) * 100));
            timeProgressBar.style.width = `${percentRemaining}%`;

            // Amber warning under 5 minutes
            if (remainingSeconds <= 300 && remainingSeconds > 60) {
                timerContainer.className = "px-4 py-2 rounded-xl bg-dark-bg border border-amber-500/50 flex items-center gap-2.5 shadow-[0_0_15px_rgba(245,158,11,0.3)] transition-all";
                timerIcon.className = "fas fa-stopwatch text-amber-400 animate-pulse";
                timerDisplay.className = "font-mono text-base md:text-xl font-extrabold tracking-widest text-amber-400";
                timeProgressBar.className = "h-full bg-gradient-to-r from-amber-500 to-brand-orange rounded-full transition-all duration-1000";
            }
            // Red warning under 1 minute
            else if (remainingSeconds <= 60) {
                timerContainer.className = "px-4 py-2 rounded-xl bg-dark-bg border border-rose-500 flex items-center gap-2.5 shadow-[0_0_20px_rgba(244,63,94,0.6)] animate-pulse transition-all";
                timerIcon.className = "fas fa-triangle-exclamation text-rose-500 animate-bounce";
                timerDisplay.className = "font-mono text-base md:text-xl font-extrabold tracking-widest text-rose-500";
                timeProgressBar.className = "h-full bg-gradient-to-r from-rose-500 to-rose-700 rounded-full transition-all duration-1000";
            }

            remainingSeconds--;
        }

        updateTimerUI();
        const countdownInterval = hasTimeLimit ? setInterval(updateTimerUI, 1000) : null;
        let autoSubmitting = false;

        async function selectOption(attId, questionId, optionId, qIndex) {
            // Update UI state immediately
            const labels = document.querySelectorAll(`[id^="optLabel_"]`);
            // Clear current question's sibling options styling
            const qCard = document.getElementById(`qBlock_${qIndex}`);
            const qLabels = qCard.querySelectorAll(`label[id^="optLabel_"]`);
            qLabels.forEach(lbl => {
                lbl.className = "flex items-center gap-3.5 p-3.5 rounded-xl border transition-all cursor-pointer group bg-dark-bg/40 border-white/5 hover:border-white/20 text-slate-300 hover:text-white";
                const badge = lbl.querySelector(`[id^="optBadge_"]`);
                if (badge) badge.className = "w-7 h-7 rounded-lg font-mono font-bold text-xs flex items-center justify-center shrink-0 transition-all bg-white/5 text-slate-400 group-hover:text-white";
                const check = lbl.querySelector(`[id^="optCheck_"]`);
                if (check) check.classList.add('opacity-0');
            });

            // Highlight chosen
            const chosenLabel = document.getElementById(`optLabel_${optionId}`);
            if (chosenLabel) {
                chosenLabel.className = "flex items-center gap-3.5 p-3.5 rounded-xl border transition-all cursor-pointer group bg-brand-cyan/15 border-brand-cyan shadow-[0_0_15px_rgba(66,234,255,0.15)] text-white";
                const badge = chosenLabel.querySelector(`[id^="optBadge_"]`);
                if (badge) badge.className = "w-7 h-7 rounded-lg font-mono font-bold text-xs flex items-center justify-center shrink-0 transition-all bg-brand-cyan text-dark-bg shadow-sm";
                const check = chosenLabel.querySelector(`[id^="optCheck_"]`);
                if (check) check.classList.remove('opacity-0');
            }

            // Update Navigator Dock
            answeredQuestionsSet.add(questionId);
            const navBtn = document.getElementById(`navBtn_${questionId}`);
            if (navBtn) {
                navBtn.className = "h-9 rounded-xl font-mono text-xs font-bold transition-all flex items-center justify-center border bg-brand-cyan/20 text-brand-cyan border-brand-cyan/40 shadow-[0_0_8px_rgba(66,234,255,0.2)]";
            }
            updateCounters();

            // Background Auto-Save
            try {
                const res = await fetch('/User/Tests/SubmitAnswer', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': antiForgeryToken() },
                    body: JSON.stringify({
                        attemptId: attId,
                        questionId: questionId,
                        optionId: optionId
                    })
                });
                const data = await res.json();
                if (data.success) {
                    showSavedIndicator(questionId);
                } else if (data.expired) {
                    autoSubmitExamOnTimeout();
                }
            } catch (err) {
                console.error("Auto-save answer error:", err);
            }
        }

        function showSavedIndicator(questionId) {
            const ind = document.getElementById(`savedIndicator_${questionId}`);
            if (ind) {
                ind.classList.remove('opacity-0');
                setTimeout(() => ind.classList.add('opacity-0'), 2000);
            }
        }

        function updateCounters() {
            const count = answeredQuestionsSet.size;
            const countLabel = document.getElementById('answeredCountLabel');
            if (countLabel) countLabel.innerText = count;

            const progressPct = document.getElementById('progressPercentage');
            if (progressPct) {
                progressPct.innerText = `${Math.round((count / totalQuestions) * 100)}%`;
            }
        }

        function scrollToQuestion(index) {
            const card = document.getElementById(`qBlock_${index}`);
            if (card) {
                card.scrollIntoView({ behavior: 'smooth', block: 'center' });
                card.classList.add('ring-2', 'ring-brand-cyan/60');
                setTimeout(() => card.classList.remove('ring-2', 'ring-brand-cyan/60'), 1500);
            }
        }

        function confirmSubmitExam() {
            const answered = answeredQuestionsSet.size;
            const summary = document.getElementById('modalProgressSummary');
            if (answered < totalQuestions) {
                summary.innerHTML = `You have answered <strong class="text-brand-cyan">${answered}</strong> out of <strong class="text-white">${totalQuestions}</strong> questions.<br/><span class="text-amber-400 font-semibold">${totalQuestions - answered} unanswered questions will receive 0 points.</span><br/>Are you sure you want to finish?`;
            } else {
                summary.innerHTML = `You have completed all <strong class="text-emerald-400">${totalQuestions}</strong> questions!<br/>Ready to finalize your test and calculate your final score?`;
            }
            document.getElementById('submitModal').classList.remove('hidden');
        }

        function closeSubmitModal() {
            document.getElementById('submitModal').classList.add('hidden');
        }

        async function submitExamNow() {
            clearInterval(countdownInterval);
            const submitBtn = document.getElementById('finalSubmitBtn');
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Calculating Score...';

            try {
                const res = await fetch('/User/Tests/FinishExam', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': antiForgeryToken() },
                    body: JSON.stringify({ attemptId: attemptId })
                });
                const data = await res.json();
                if (data.success && data.redirectUrl) {
                    window.location.href = data.redirectUrl;
                } else {
                    alert("Submission error: " + (data.message || "Unknown error"));
                    submitBtn.disabled = false;
                    submitBtn.innerText = "Submit Now";
                }
            } catch (err) {
                console.error(err);
                alert("Failed to submit exam. Please try again.");
                submitBtn.disabled = false;
                submitBtn.innerText = "Submit Now";
            }
        }

        function autoSubmitExamOnTimeout() {
            if (autoSubmitting) return;
            autoSubmitting = true;
            clearInterval(countdownInterval);
            alert("Time has expired! Your answers are being submitted automatically.");
            submitExamNow();
        }
    </script>
}
