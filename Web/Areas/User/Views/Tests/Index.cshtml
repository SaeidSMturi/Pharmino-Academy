@model List<Domain.Entities.Exam.Exam>

@{
    var isRtl = System.Globalization.CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    ViewData["Title"] = "My Tests";
    var userAttempts = ViewBag.UserAttempts as List<Domain.Entities.Exam.ExamAttempt> ?? new List<Domain.Entities.Exam.ExamAttempt>();
}

<div class="space-y-8 animate-fade-in-up" dir="@(isRtl ? "rtl" : "ltr")">
    <!-- Header -->
    <div class="glass-panel rounded-[2rem] p-8 lg:p-10 relative overflow-hidden">
        <div class="relative z-10 flex items-center @(isRtl ? "space-x-reverse sm:mr-4" : "space-x-4")">
            <div class="w-12 h-12 rounded-xl bg-brand-cyan/10 flex items-center justify-center border border-brand-cyan/20">
                <i class="fas fa-file-pen text-brand-cyan text-xl"></i>
            </div>
            <div>
                <h1 class="text-2xl lg:text-3xl font-extrabold text-white tracking-tight">
                    My Tests &amp; Mock Exams
                </h1>
                <p class="text-slate-400 text-sm mt-1">Practice timed MCQ examinations, sharpen your pharmaceutical skills, and evaluate your progress.</p>
            </div>
        </div>
        <!-- Internal Ambient Glow -->
        <div class="absolute top-0 right-0 w-64 h-64 bg-brand-cyan/5 rounded-full blur-[80px] pointer-events-none"></div>
    </div>

    <!-- Active Available Tests Grid -->
    <div>
        <div class="flex items-center justify-between mb-6">
            <h2 class="text-xl font-bold text-white flex items-center gap-2">
                <i class="fas fa-clipboard-check text-brand-cyan"></i>
                Available Mock Tests
            </h2>
            <span class="text-xs text-slate-400 font-medium">@Model.Count Tests Available</span>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="glass-panel rounded-[2rem] p-16 text-center max-w-2xl mx-auto relative overflow-hidden">
                <div class="w-20 h-20 mx-auto mb-6 rounded-2xl bg-white/5 flex items-center justify-center border border-white/5">
                    <i class="fas fa-file-lines text-slate-500 text-3xl"></i>
                </div>
                <h3 class="text-2xl font-bold text-white mb-2">No Mock Tests Available</h3>
                <p class="text-slate-400 text-sm mb-6 leading-relaxed">
                    There are currently no active mock tests published. Check back soon or consult your course instructor.
                </p>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                @foreach (var exam in Model)
                {
                    var attemptsForThisExam = userAttempts.Where(a => a.ExamId == exam.ExamId && a.IsCompleted).ToList();
                    var latestAttempt = attemptsForThisExam.OrderByDescending(a => a.StartTime).FirstOrDefault();
                    var bestAttempt = attemptsForThisExam.OrderByDescending(a => a.ScorePercent).FirstOrDefault();
                    var inProgressAttempt = userAttempts.FirstOrDefault(a => a.ExamId == exam.ExamId && !a.IsCompleted);

                    <div class="glass-panel rounded-2xl p-6 transition-all duration-300 hover:-translate-y-1.5 hover:border-brand-cyan/30 flex flex-col justify-between group shadow-xl relative overflow-hidden">
                        <!-- Top Accent Glow -->
                        <div class="absolute -top-12 -right-12 w-32 h-32 bg-brand-cyan/10 rounded-full blur-2xl group-hover:bg-brand-cyan/20 transition-all"></div>

                        <div>
                            <!-- Course / Category Tag -->
                            <div class="flex items-center justify-between mb-4">
                                @if (exam.Course != null)
                                {
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-semibold bg-brand-blue/15 text-brand-blue border border-brand-blue/30">
                                        <i class="fas fa-video mr-1.5 text-[10px]"></i>
                                        @exam.Course.Title
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-semibold bg-white/5 text-slate-400 border border-white/10">
                                        General Assessment
                                    </span>
                                }

                                @if (bestAttempt != null)
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[11px] font-bold @(bestAttempt.IsPassed ? "bg-emerald-500/20 text-emerald-400 border border-emerald-500/30" : "bg-rose-500/20 text-rose-400 border border-rose-500/30")">
                                        Best: @bestAttempt.ScorePercent%
                                    </span>
                                }
                            </div>

                            <h3 class="text-lg font-bold text-white mb-2 group-hover:text-brand-cyan transition-colors line-clamp-2">
                                @exam.Title
                            </h3>

                            @if (!string.IsNullOrEmpty(exam.Description))
                            {
                                <p class="text-xs text-slate-400 mb-4 line-clamp-2 leading-relaxed">
                                    @exam.Description
                                </p>
                            }

                            <!-- Metadata Badges -->
                            <div class="grid grid-cols-3 gap-2 py-3 border-y border-white/5 text-center mb-6">
                                <div>
                                    <span class="block text-[10px] text-slate-500 uppercase font-bold">Questions</span>
                                    <span class="font-mono font-bold text-sm text-white">@(exam.Questions?.Count ?? 0)</span>
                                </div>
                                <div>
                                    <span class="block text-[10px] text-slate-500 uppercase font-bold">Duration</span>
                                    <span class="font-mono font-bold text-sm text-brand-cyan">@(exam.DurationMinutes > 0 ? $"{exam.DurationMinutes} min" : "No limit")</span>
                                </div>
                                <div>
                                    <span class="block text-[10px] text-slate-500 uppercase font-bold">Passing</span>
                                    <span class="font-mono font-bold text-sm text-amber-400">@exam.PassingScorePercent%</span>
                                </div>
                            </div>
                        </div>

                        <!-- Action Button -->
                        <div>
                            @if (inProgressAttempt != null)
                            {
                                <a asp-area="User" asp-controller="Tests" asp-action="Take" asp-route-id="@exam.ExamId"
                                   class="w-full py-3 rounded-xl bg-gradient-to-r from-amber-500 to-brand-orange text-dark-bg font-extrabold text-sm hover:shadow-[0_0_20px_rgba(245,158,11,0.4)] transition-all flex items-center justify-center gap-2">
                                    <i class="fas fa-play animate-pulse"></i>
                                    Resume Test in Progress
                                </a>
                            }
                            else if (attemptsForThisExam.Any())
                            {
                                <div class="flex gap-2">
                                    <a asp-area="User" asp-controller="Tests" asp-action="Take" asp-route-id="@exam.ExamId"
                                       class="flex-1 py-2.5 rounded-xl bg-gradient-to-r from-brand-cyan to-brand-blue text-dark-bg font-extrabold text-xs hover:shadow-[0_0_15px_rgba(66,234,255,0.4)] transition-all flex items-center justify-center gap-1.5">
                                        <i class="fas fa-rotate-right"></i>
                                        Retake Test
                                    </a>
                                    @if (latestAttempt != null)
                                    {
                                        <a asp-area="User" asp-controller="Tests" asp-action="Result" asp-route-attemptId="@latestAttempt.AttemptId"
                                           class="px-3 py-2.5 rounded-xl bg-white/5 hover:bg-white/10 text-slate-300 text-xs font-bold border border-white/10 transition-colors flex items-center justify-center"
                                           title="View Last Result">
                                            <i class="fas fa-chart-simple"></i>
                                        </a>
                                    }
                                </div>
                            }
                            else
                            {
                                <a asp-area="User" asp-controller="Tests" asp-action="Take" asp-route-id="@exam.ExamId"
                                   class="w-full py-3 rounded-xl bg-gradient-to-r from-brand-cyan to-brand-blue text-dark-bg font-extrabold text-sm hover:shadow-[0_0_20px_rgba(66,234,255,0.4)] transition-all flex items-center justify-center gap-2">
                                    <i class="fas fa-stopwatch"></i>
                                    Start Timed Test
                                </a>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- History / Past Attempts Section -->
    @if (userAttempts.Any(a => a.IsCompleted))
    {
        <div class="mt-12">
            <h2 class="text-xl font-bold text-white mb-6 flex items-center gap-2">
                <i class="fas fa-clock-rotate-left text-brand-cyan"></i>
                Your Test Attempt History
            </h2>

            <div class="glass-panel rounded-2xl overflow-hidden border border-white/5 shadow-xl">
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm text-slate-300">
                        <thead class="bg-white/[0.03] text-xs uppercase font-bold text-slate-400 tracking-wider border-b border-white/[0.05]">
                            <tr>
                                <th class="px-6 py-4">Test</th>
                                <th class="px-6 py-4 text-center">Date Taken</th>
                                <th class="px-6 py-4 text-center">Score</th>
                                <th class="px-6 py-4 text-center">Result</th>
                                <th class="px-6 py-4 text-right">Review</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-white/[0.05]">
                            @foreach (var attempt in userAttempts.Where(a => a.IsCompleted).OrderByDescending(a => a.StartTime))
                            {
                                <tr class="hover:bg-white/[0.02] transition-colors">
                                    <td class="px-6 py-4 font-bold text-white">
                                        @attempt.Exam?.Title
                                    </td>
                                    <td class="px-6 py-4 text-center text-xs text-slate-400 font-mono">
                                        @attempt.StartTime.ToString("MMM dd, yyyy - HH:mm")
                                    </td>
                                    <td class="px-6 py-4 text-center">
                                        <span class="font-mono font-bold text-sm @(attempt.IsPassed ? "text-emerald-400" : "text-rose-400")">
                                            @attempt.ScorePercent%
                                        </span>
                                        <span class="text-xs text-slate-500 block">(@attempt.Score / @attempt.TotalPoints pts)</span>
                                    </td>
                                    <td class="px-6 py-4 text-center">
                                        @if (attempt.IsPassed)
                                        {
                                            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">
                                                <i class="fas fa-check-circle mr-1 text-[10px]"></i> Passed
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-rose-500/20 text-rose-400 border border-rose-500/30">
                                                <i class="fas fa-circle-xmark mr-1 text-[10px]"></i> Failed
                                            </span>
                                        }
                                    </td>
                                    <td class="px-6 py-4 text-right">
                                        <a asp-area="User" asp-controller="Tests" asp-action="Result" asp-route-attemptId="@attempt.AttemptId"
                                           class="inline-flex items-center px-3 py-1.5 rounded-lg bg-brand-cyan/10 hover:bg-brand-cyan/20 text-brand-cyan border border-brand-cyan/20 text-xs font-bold transition-all">
                                            <span>Detailed Answers</span>
                                            <i class="fas @(isRtl ? "fa-arrow-left mr-1.5" : "fa-arrow-right ml-1.5") text-[10px]"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
