@model Domain.Entities.Exam.ExamAttempt

@{
    var isRtl = System.Globalization.CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    ViewData["Title"] = $"{Model.Exam?.Title} - Results";

    var exam = Model.Exam!;
    var questions = exam.Questions.OrderBy(q => q.OrderIndex).ToList();
    var answersMap = Model.Answers.ToDictionary(a => a.QuestionId, a => a);
    var correctCount = Model.Answers.Count(a => a.IsCorrect);
    var incorrectCount = Model.Answers.Count(a => !a.IsCorrect);
    var unansweredCount = questions.Count - Model.Answers.Count;

    var durationSpan = (Model.EndTime ?? DateTime.UtcNow) - Model.StartTime;
    var minutesSpent = Math.Max(1, (int)durationSpan.TotalMinutes);
}

<div class="space-y-8 animate-fade-in-up max-w-4xl mx-auto text-start pb-20" dir="@(isRtl ? "rtl" : "ltr")">
    <!-- Header Back Navigation -->
    <div class="flex items-center justify-between">
        <a asp-area="User" asp-controller="Tests" asp-action="Index" class="inline-flex items-center gap-2 text-slate-400 hover:text-white text-sm font-semibold transition-colors">
            <i class="fas @(isRtl ? "fa-arrow-right" : "fa-arrow-left")"></i>
            <span>Back to My Tests</span>
        </a>
        <span class="text-xs text-slate-500 font-mono">Attempt #@Model.AttemptId • @Model.StartTime.ToString("MMM dd, yyyy")</span>
    </div>

    <!-- Hero Scorecard -->
    <div class="glass-panel rounded-[2rem] p-8 md:p-10 border @(Model.IsPassed ? "border-emerald-500/30 shadow-[0_0_50px_rgba(16,185,129,0.15)]" : "border-rose-500/30 shadow-[0_0_50px_rgba(244,63,94,0.15)]") relative overflow-hidden">
        <!-- Ambient Radial Glow -->
        <div class="absolute -top-24 -right-24 w-80 h-80 @(Model.IsPassed ? "bg-emerald-500/10" : "bg-rose-500/10") rounded-full blur-3xl pointer-events-none"></div>

        <div class="flex flex-col md:flex-row items-center justify-between gap-8 relative z-10">
            <!-- Score & Status -->
            <div class="flex items-center gap-6">
                <!-- Circular Percentage Badge -->
                <div class="w-28 h-28 rounded-full border-4 @(Model.IsPassed ? "border-emerald-400 bg-emerald-500/10 shadow-[0_0_25px_rgba(16,185,129,0.3)]" : "border-rose-500 bg-rose-500/10 shadow-[0_0_25px_rgba(244,63,94,0.3)]") flex flex-col items-center justify-center shrink-0">
                    <span class="font-mono text-3xl font-black text-white">@Model.ScorePercent%</span>
                    <span class="text-[10px] uppercase font-bold tracking-wider @(Model.IsPassed ? "text-emerald-400" : "text-rose-400")">
                        @(Model.IsPassed ? "PASSED" : "FAILED")
                    </span>
                </div>

                <div>
                    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-extrabold uppercase tracking-wider mb-2 @(Model.IsPassed ? "bg-emerald-500/20 text-emerald-400 border border-emerald-500/30" : "bg-rose-500/20 text-rose-400 border border-rose-500/30")">
                        <i class="fas @(Model.IsPassed ? "fa-circle-check" : "fa-triangle-exclamation")"></i>
                        @(Model.IsPassed ? "Exam Completed Successfully" : "Passing Threshold Not Met")
                    </div>
                    <h1 class="text-2xl font-extrabold text-white">@exam.Title</h1>
                    <p class="text-xs text-slate-400 mt-1">
                        Passing grade: <span class="text-amber-400 font-bold font-mono">@exam.PassingScorePercent%</span> • You scored <span class="font-bold text-white font-mono">@Model.Score / @Model.TotalPoints</span> points.
                    </p>
                </div>
            </div>

            <!-- Actions -->
            <div class="flex flex-col sm:flex-row gap-3 w-full md:w-auto">
                <a asp-area="User" asp-controller="Tests" asp-action="Take" asp-route-id="@exam.ExamId"
                   class="px-6 py-3 rounded-xl bg-gradient-to-r from-brand-cyan to-brand-blue text-dark-bg font-extrabold text-xs md:text-sm hover:shadow-[0_0_20px_rgba(66,234,255,0.4)] transition-all flex items-center justify-center gap-2">
                    <i class="fas fa-rotate-right"></i>
                    Retake Examination
                </a>
            </div>
        </div>

        <!-- Metric Badges -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mt-8 pt-6 border-t border-white/5 text-center">
            <div class="p-3 rounded-xl bg-white/[0.02] border border-white/5">
                <span class="block text-[10px] font-bold uppercase text-slate-500 mb-1">Correct Answers</span>
                <span class="font-mono text-xl font-bold text-emerald-400">@correctCount</span>
            </div>
            <div class="p-3 rounded-xl bg-white/[0.02] border border-white/5">
                <span class="block text-[10px] font-bold uppercase text-slate-500 mb-1">Incorrect Answers</span>
                <span class="font-mono text-xl font-bold text-rose-400">@incorrectCount</span>
            </div>
            <div class="p-3 rounded-xl bg-white/[0.02] border border-white/5">
                <span class="block text-[10px] font-bold uppercase text-slate-500 mb-1">Unanswered</span>
                <span class="font-mono text-xl font-bold text-slate-400">@unansweredCount</span>
            </div>
            <div class="p-3 rounded-xl bg-white/[0.02] border border-white/5">
                <span class="block text-[10px] font-bold uppercase text-slate-500 mb-1">Time Elapsed</span>
                <span class="font-mono text-xl font-bold text-brand-cyan">@minutesSpent min</span>
            </div>
        </div>
    </div>

    <!-- Question-by-Question Solution Breakdown -->
    <div class="space-y-6">
        <h2 class="text-xl font-bold text-white flex items-center gap-2">
            <i class="fas fa-list-check text-brand-cyan"></i>
            Detailed Answer Review &amp; Explanations
        </h2>

        @for (int i = 0; i < questions.Count; i++)
        {
            var q = questions[i];
            var ans = answersMap.ContainsKey(q.QuestionId) ? answersMap[q.QuestionId] : null;
            var isAnswered = ans != null;
            var isCorrect = ans != null && ans.IsCorrect;

            <div class="glass-panel rounded-2xl p-6 border @(isCorrect ? "border-emerald-500/30 bg-emerald-500/[0.01]" : (isAnswered ? "border-rose-500/30 bg-rose-500/[0.01]" : "border-white/5")) shadow-lg space-y-4">
                <!-- Question Header -->
                <div class="flex items-start justify-between gap-4">
                    <div class="flex items-center gap-3">
                        <span class="w-8 h-8 rounded-xl @(isCorrect ? "bg-emerald-500 text-dark-bg" : (isAnswered ? "bg-rose-500 text-white" : "bg-slate-700 text-slate-300")) font-mono font-extrabold text-xs flex items-center justify-center shrink-0">
                            @(i + 1)
                        </span>
                        <span class="text-xs uppercase font-bold text-slate-400 tracking-wider">Question @(i + 1)</span>
                    </div>

                    <div>
                        @if (isCorrect)
                        {
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">
                                <i class="fas fa-check mr-1 text-[10px]"></i> +1.0 pt
                            </span>
                        }
                        else if (isAnswered)
                        {
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-rose-500/20 text-rose-400 border border-rose-500/30">
                                <i class="fas fa-xmark mr-1 text-[10px]"></i> 0.0 pt (Incorrect)
                            </span>
                        }
                        else
                        {
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-slate-500/20 text-slate-400 border border-slate-500/30">
                                <i class="fas fa-minus mr-1 text-[10px]"></i> Unanswered (0.0 pt)
                            </span>
                        }
                    </div>
                </div>

                <!-- Question Text -->
                <p class="text-sm md:text-base font-semibold text-white leading-relaxed">
                    @q.QuestionText
                </p>

                <!-- Options -->
                <div class="space-y-2 pt-2">
                    @foreach (var opt in q.Options)
                    {
                        var isOptCorrect = opt.IsCorrect;
                        var isOptUserSelected = ans != null && ans.SelectedOptionId == opt.OptionId;

                        string optClass;
                        string badgeClass;

                        if (isOptCorrect && isOptUserSelected)
                        {
                            // Correctly selected
                            optClass = "bg-emerald-500/20 border-emerald-500/50 text-emerald-300 font-bold shadow-[0_0_12px_rgba(16,185,129,0.2)]";
                            badgeClass = "bg-emerald-500 text-dark-bg";
                        }
                        else if (isOptCorrect)
                        {
                            // Correct answer that user missed
                            optClass = "bg-emerald-500/10 border-emerald-500/30 text-emerald-400 font-bold";
                            badgeClass = "bg-emerald-500/30 text-emerald-300 border border-emerald-500/50";
                        }
                        else if (isOptUserSelected)
                        {
                            // Wrong choice chosen by user
                            optClass = "bg-rose-500/20 border-rose-500/50 text-rose-300 line-through";
                            badgeClass = "bg-rose-500 text-white";
                        }
                        else
                        {
                            // Other neutral option
                            optClass = "bg-dark-bg/40 border-white/5 text-slate-400";
                            badgeClass = "bg-white/5 text-slate-500";
                        }

                        <div class="flex items-center gap-3 p-3 rounded-xl border text-xs md:text-sm @optClass transition-all">
                            <span class="w-6 h-6 rounded-lg font-mono font-bold text-xs flex items-center justify-center shrink-0 @badgeClass">
                                @opt.OptionLabel
                            </span>
                            <span class="flex-1">@opt.OptionText</span>

                            @if (isOptCorrect)
                            {
                                <span class="inline-flex items-center gap-1 text-[11px] font-bold text-emerald-400 uppercase tracking-wider shrink-0">
                                    <i class="fas fa-check-circle"></i> Correct Answer
                                </span>
                            }
                            else if (isOptUserSelected)
                            {
                                <span class="inline-flex items-center gap-1 text-[11px] font-bold text-rose-400 uppercase tracking-wider shrink-0">
                                    <i class="fas fa-xmark"></i> Your Answer
                                </span>
                            }
                        </div>
                    }
                </div>

                <!-- Explanation Rationale -->
                @if (!string.IsNullOrWhiteSpace(q.Explanation))
                {
                    <div class="mt-4 p-4 rounded-xl bg-brand-cyan/5 border border-brand-cyan/20 flex items-start gap-3 text-xs leading-relaxed text-slate-300">
                        <i class="fas fa-lightbulb text-brand-cyan text-sm shrink-0 mt-0.5"></i>
                        <div>
                            <strong class="text-brand-cyan block font-bold mb-0.5">Explanation &amp; Scientific Rationale:</strong>
                            <span>@q.Explanation</span>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
