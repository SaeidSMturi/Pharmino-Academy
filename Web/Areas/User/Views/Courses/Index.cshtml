@model List<Domain.Entities.Course.Course>
@{
    var isRtl = System.Globalization.CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    ViewData["Title"] = Localizer["MyEnrolledCourses"].Value;
}

<div class="space-y-8 animate-fade-in-up">
    <!-- Header -->
    <div class="glass-panel rounded-[2rem] p-8 lg:p-10 relative overflow-hidden">
        <div class="relative z-10 flex items-center @(isRtl ? "space-x-reverse sm:mr-4" : "space-x-4")">
            <div class="w-12 h-12 rounded-xl bg-brand-cyan/10 flex items-center justify-center border border-brand-cyan/20">
                <i class="fas fa-graduation-cap text-brand-cyan text-xl"></i>
            </div>
            <div>
                <h1 class="text-2xl lg:text-3xl font-extrabold text-white tracking-tight">
                    @Localizer["MyEnrolledCourses"]
                </h1>
                <p class="text-slate-400 text-sm mt-1">@Localizer["MyEnrolledCoursesSub"]</p>
            </div>
        </div>
        <!-- Internal Ambient Glow -->
        <div class="absolute top-0 right-0 w-64 h-64 bg-brand-cyan/5 rounded-full blur-[80px] pointer-events-none"></div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <!-- Ultra-Premium Empty State -->
        <div class="glass-panel rounded-[2rem] p-16 text-center max-w-2xl mx-auto relative overflow-hidden">
            <div class="w-20 h-20 mx-auto mb-6 rounded-2xl bg-white/5 flex items-center justify-center border border-white/5">
                <i class="fas fa-box-open text-slate-500 text-3xl"></i>
            </div>
            <h3 class="text-2xl font-bold text-white mb-2">@Localizer["NoEnrolledCourses"]</h3>
            <p class="text-slate-400 text-sm mb-8 leading-relaxed">@Localizer["NoEnrolledCoursesSub"]</p>
            <a href="/Courses" class="inline-flex items-center px-6 py-3.5 rounded-xl bg-brand-cyan hover:bg-brand-cyan/80 text-brand-dark font-extrabold text-sm transition-all duration-300 shadow-lg shadow-brand-cyan/20 hover:scale-[1.02]">
                <i class="fas fa-magnifying-glass @(isRtl ? "ml-2" : "mr-2")"></i>
                @Localizer["BrowseAllCourses"]
            </a>
            <div class="absolute -bottom-24 -right-24 w-64 h-64 bg-brand-blue/5 rounded-full blur-3xl pointer-events-none"></div>
        </div>
    }
    else
    {
        <!-- Courses Premium Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var course in Model)
            {
                <div class="glass-panel rounded-2xl overflow-hidden transition-all duration-300 hover:-translate-y-1.5 hover:border-white/10 group flex flex-col h-full shadow-xl">
                    <!-- Course Image & Badges -->
                    <div class="h-48 bg-brand-dark relative overflow-hidden shrink-0 border-b border-white/5">
                        @if (!string.IsNullOrEmpty(course.ImageName))
                        {
                            <img src="~/uploads/courses/@course.ImageName"
                                 alt="@course.Title"
                                 class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700" />
                            <div class="absolute inset-0 bg-gradient-to-t from-brand-dark via-transparent to-transparent opacity-80"></div>
                        }
                        else
                        {
                            <div class="w-full h-full bg-gradient-to-br from-brand-blue/10 to-brand-cyan/10 flex items-center justify-center">
                                <i class="fas fa-book-open text-slate-600 text-5xl opacity-40"></i>
                            </div>
                        }
                        <!-- Premium Float Tag -->
                        <div class="absolute top-4 @(isRtl ? "left-4" : "right-4") flex items-center gap-1.5">
                            @if (course.IsBundle)
                            {
                                <span class="px-3 py-1.5 rounded-xl bg-gradient-to-r from-purple-500 to-indigo-500 text-white text-[10px] font-black shadow-lg shadow-purple-500/20 tracking-wider">
                                    <i class="fas fa-cubes @(isRtl ? "ml-1" : "mr-1")"></i> @(isRtl ? "پکیج" : "Bundle")
                                </span>
                            }
                            <span class="px-3 py-1.5 rounded-xl bg-brand-cyan text-brand-dark text-[10px] font-extrabold shadow-lg shadow-brand-cyan/20 tracking-wider">
                                <i class="fas fa-check-circle @(isRtl ? "ml-1" : "mr-1")"></i> @Localizer["Enrolled"]
                            </span>
                        </div>
                    </div>

                    <!-- Course Content Wrapper -->
                    <div class="p-6 flex flex-col flex-1 justify-between">
                        <div>
                            <!-- Title -->
                            <h3 class="text-lg font-bold text-slate-100 group-hover:text-brand-cyan transition-colors line-clamp-2 min-h-[3.5rem] tracking-tight">
                                @course.Title
                            </h3>

                            <!-- Description -->
                            <p class="text-slate-400 text-xs leading-relaxed mb-6 line-clamp-3 min-h-[4rem]">
                                @course.Description
                            </p>
                        </div>

                        <div>
                            <!-- Course Metadata -->
                            <div class="flex items-center justify-between mb-5 text-xs font-bold text-slate-500 border-t border-white/5 pt-4">
                                @if (course.DurationHours.HasValue && course.DurationHours.Value > 0)
                                {
                                    <span class="flex items-center">
                                        <i class="far fa-clock @(isRtl ? "ml-2" : "mr-2") text-brand-blue text-sm"></i>
                                        @course.DurationHours @Localizer["Hours"]
                                    </span>
                                }
                                else
                                {
                                    <span></span>
                                }

                                <span class="flex items-center text-emerald-400">
                                    <i class="fas fa-unlock-keyhole @(isRtl ? "ml-2" : "mr-2") text-sm"></i>
                                    @Localizer["FullAccess"]
                                </span>
                            </div>

                            <!-- Premium Interactive Button -->
                            <a href="@Url.Action("MyCourseDetails", new { id = course.CourseId })"
                               class="flex items-center justify-center w-full px-4 py-3.5 rounded-xl bg-white/5 border border-white/5 text-slate-200 hover:text-white hover:bg-brand-blue hover:border-brand-blue font-bold text-sm text-center transition-all duration-300 group/btn shadow-inner">
                                <span class="group-hover/btn:translate-x-[-4px] transition-transform duration-200">@Localizer["ContinueLearning"]</span>
                                <i class="fas @(isRtl ? "fa-chevron-left mr-2" : "fa-chevron-right ml-2") text-xs opacity-0 group-hover/btn:opacity-100 group-hover/btn:translate-x-[4px] transition-all duration-200"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Styles {
    <style>
        /* Multi-line trimming standard constraints */
        .line-clamp-2 {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .line-clamp-3 {
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
    </style>
}