@model Domain.Entities.Course.CourseVideo
@using Application.Interfaces
@inject IPermissionService _permissionService

@{
    Layout = "_CourseWatchLayout";
    ViewData["Title"] = Model.Title;

    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.Name;
    var isRtl = System.Globalization.CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;

    var courseTitle = ViewBag.CourseTitle as string ?? "Course";
    var courseId = ViewBag.CourseId != null ? (int)ViewBag.CourseId : Model.CourseId;
    var videoToken = ViewBag.VideoToken as string ?? "";
    var sessionId = ViewBag.SessionId as string ?? "";
    var userId = ViewBag.UserId != null ? (int)ViewBag.UserId : 0;
    var hlsAvailable = (bool)(ViewBag.HlsAvailable ?? false);
    var videoGuid = ViewBag.VideoGuid as string ?? "";

    var courseVideos = ViewBag.CourseVideos as List<Domain.Entities.Course.CourseVideo> ?? new List<Domain.Entities.Course.CourseVideo>();
    var videoProgress = ViewBag.VideoProgress as Dictionary<int, Domain.Entities.Course.VideoProgress> ?? new Dictionary<int, Domain.Entities.Course.VideoProgress>();
    var enrollment = ViewBag.Enrollment as Domain.Entities.Course.CourseEnrollment;

    var currentIndex = courseVideos.FindIndex(v => v.VideoId == Model.VideoId);
    var prevVideo = currentIndex > 0 ? courseVideos[currentIndex - 1] : null;
    var nextVideo = (currentIndex >= 0 && currentIndex < courseVideos.Count - 1) ? courseVideos[currentIndex + 1] : null;

    var completedCount = courseVideos.Count(v => videoProgress.TryGetValue(v.VideoId, out var p) && p.Completed);
    var totalCount = courseVideos.Count > 0 ? courseVideos.Count : 1;
    var percentComplete = (int)Math.Round((double)completedCount / totalCount * 100);

    // Strictly check for IT Administrator authority (IT / ITAdministrator role or IT claim), excluding SuperAdmin/SuperUser
    var userRoles = userId > 0 ? await _permissionService.GetUserRolesAsync(userId) : new List<string>();
    var isItAdmin = userRoles.Any(r => r.Equals("IT", StringComparison.OrdinalIgnoreCase) || r.Equals("ITAdministrator", StringComparison.OrdinalIgnoreCase))
                    || User.IsInRole("IT")
                    || User.IsInRole("ITAdministrator")
                    || User.HasClaim(c => (c.Type == System.Security.Claims.ClaimTypes.Role || c.Type == "Permission" || c.Type == "Role")
                                          && (c.Value.Equals("IT", StringComparison.OrdinalIgnoreCase) || c.Value.Equals("ITAdministrator", StringComparison.OrdinalIgnoreCase)));
}

<!-- 🎬 Advanced Video Player CSS & Fonts -->
<link rel="stylesheet" href="~/css/advanced-video-player.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    /* Theater Mode Transitions */
    body.theater-mode-active #curriculum-sidebar {
        display: none !important;
    }

    /* Cyberpunk Styled Terminal Scrollbar */
    #dev-debug-logs::-webkit-scrollbar {
        width: 4px;
    }
    #dev-debug-logs::-webkit-scrollbar-track {
        background: rgba(3, 7, 18, 0.5);
    }
    #dev-debug-logs::-webkit-scrollbar-thumb {
        background: rgba(66, 234, 255, 0.2);
        border-radius: 4px;
    }
    #dev-debug-logs::-webkit-scrollbar-thumb:hover {
        background: #42EAFF;
    }

    /* Curriculum Active Lesson Styling matching Screenshot */
    .lesson-item-active {
        background-color: rgba(45, 212, 191, 0.12) !important;
        border-inline-start: 4px solid #14b8a6 !important;
        color: #ffffff !important;
    }
    html.light .lesson-item-active {
        background-color: #e6fffa !important;
        border-inline-start: 4px solid #0d9488 !important;
        color: #0f766e !important;
    }
</style>

<!-- 🌟 Outer Split Workspace (Curriculum Playlist Sidebar + Video Main Stage) -->
<div class="flex-1 w-full flex flex-col lg:flex-row overflow-hidden relative" dir="@(isRtl ? "rtl" : "ltr")">

    <!-- 📚 1. Course Curriculum / Playlist Sidebar (Matching Image 2) -->
    <aside id="curriculum-sidebar"
           class="w-full lg:w-80 xl:w-96 shrink-0 bg-brand-dark/95 border-b lg:border-b-0 @(isRtl ? "lg:border-l" : "lg:border-r") border-white/10 flex flex-col h-[400px] lg:h-[calc(100vh-61px)] transition-all duration-300 z-30 select-none">

        <!-- Progress Header (Image 2: "82% COMPLETE") -->
        <div class="p-4 lg:p-5 border-b border-white/10 bg-white/[0.02]">
            <div class="flex items-center justify-between mb-2">
                <div class="flex items-center gap-2">
                    <span class="w-6 h-6 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center text-xs">
                        <i class="fas fa-check"></i>
                    </span>
                    <h3 class="text-sm font-black text-white tracking-wider uppercase">
                        @percentComplete% @(isRtl ? "تکمیل شده" : "COMPLETE")
                    </h3>
                </div>
                <span class="text-xs font-semibold text-slate-400">
                    @completedCount / @courseVideos.Count @(isRtl ? "درس" : "Lessons")
                </span>
            </div>

            <!-- Progress Bar -->
            <div class="w-full bg-white/10 h-2 rounded-full overflow-hidden">
                <div class="bg-gradient-to-r from-teal-400 to-emerald-400 h-full rounded-full transition-all duration-500"
                     style="width: @percentComplete%"></div>
            </div>

            <!-- Filter Input -->
            <div class="relative mt-3">
                <input type="text" id="curriculum-search"
                       placeholder="@Localizer["SearchLessons"]"
                       class="w-full px-3 py-1.5 pl-8 pr-3 text-xs bg-white/5 border border-white/10 rounded-lg text-slate-200 placeholder-slate-500 focus:outline-none focus:border-brand-cyan/40 transition-colors" />
                <i class="fas fa-search absolute top-2.5 @(isRtl ? "right-2.5" : "left-2.5") text-slate-500 text-[10px]"></i>
            </div>
        </div>

        <!-- Scrollable Lessons List -->
        <div class="flex-1 overflow-y-auto curriculum-scrollbar divide-y divide-white/[0.04]">
            @if (!courseVideos.Any())
            {
                <div class="p-8 text-center text-slate-500 text-xs">
                    <i class="fas fa-video-slash text-2xl mb-2 block"></i>
                    @Localizer["NoContentYet"]
                </div>
            }
            else
            {
                int lessonNumber = 1;
                @foreach (var v in courseVideos)
                {
                    var isCurrent = v.VideoId == Model.VideoId;
                    var isCompleted = videoProgress.TryGetValue(v.VideoId, out var vp) && vp.Completed;
                    var inProgress = vp != null && vp.WatchedPercent > 0 && !isCompleted;
                    var durationText = v.DurationSeconds.HasValue
                        ? TimeSpan.FromSeconds(v.DurationSeconds.Value).ToString(@"m\:ss")
                        : "--:--";

                    <a href="@Url.Action("Watch", new { videoId = v.VideoId })"
                       data-title="@v.Title.ToLower()"
                       class="curriculum-lesson-item group flex items-start gap-3 p-3.5 hover:bg-white/[0.04] transition-all text-xs @(isCurrent ? "lesson-item-active" : "text-slate-300")">

                        <!-- Status Circle Icon (Image 2) -->
                        <div class="mt-0.5 shrink-0">
                            @if (isCompleted)
                            {
                                <span class="w-5 h-5 rounded-full border-2 border-emerald-400 bg-emerald-400 text-slate-950 flex items-center justify-center text-[10px] shadow-[0_0_8px_rgba(52,211,153,0.4)]">
                                    <i class="fas fa-check"></i>
                                </span>
                            }
                            else if (isCurrent)
                            {
                                <span class="w-5 h-5 rounded-full border-2 border-teal-400 bg-teal-400/20 text-teal-300 flex items-center justify-center text-[8px] animate-pulse">
                                    <i class="fas fa-play"></i>
                                </span>
                            }
                            else if (inProgress)
                            {
                                <span class="w-5 h-5 rounded-full border-2 border-brand-yellow/80 bg-brand-yellow/20 text-brand-yellow flex items-center justify-center text-[8px]" title="@Math.Round(vp?.WatchedPercent ?? 0)%">
                                    <i class="fas fa-circle-dot"></i>
                                </span>
                            }
                            else
                            {
                                <span class="w-5 h-5 rounded-full border-2 border-slate-600 group-hover:border-slate-400 transition-colors inline-block"></span>
                            }
                        </div>

                        <!-- Video Icon + Title + Duration (Image 2) -->
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-1.5 flex-wrap">
                                <i class="fas fa-tv text-[11px] text-slate-400 shrink-0"></i>
                                <span class="font-bold leading-snug truncate max-w-[210px] @(isCurrent ? "text-white" : "text-slate-300 group-hover:text-white")">
                                    @v.Title
                                </span>
                                <span class="text-[11px] text-slate-400 font-medium shrink-0">
                                    (@durationText)
                                </span>
                            </div>
                            @if (v.IsFree)
                            {
                                <span class="inline-block mt-1 px-1.5 py-0.5 text-[9px] font-black uppercase tracking-wider bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 rounded">
                                    @Localizer["Free"]
                                </span>
                            }
                        </div>
                    </a>
                    lessonNumber++;
                }
            }
        </div>
    </aside>

    <!-- 🎬 2. Main Video Player Stage -->
    <main class="flex-1 overflow-y-auto h-[calc(100vh-61px)] p-4 md:p-6 lg:p-8 space-y-6 curriculum-scrollbar">

        @if (isItAdmin)
        {
            <!-- Cyberpunk Security Debugger Panel (IT Administrator Exclusive) -->
            <details open class="group border border-brand-orange/30 bg-brand-dark/95 rounded-2xl p-4 shadow-[0_0_25px_rgba(255,126,66,0.1)] relative overflow-hidden text-xs">
                <summary class="flex justify-between items-center cursor-pointer select-none">
                    <h3 class="text-brand-orange font-extrabold font-mono text-xs tracking-wider uppercase flex items-center">
                        <span class="w-2 h-2 rounded-full bg-brand-orange animate-ping mr-2.5 ml-2.5"></span>
                        <i class="fas fa-terminal mr-2 ml-2"></i> Live Security Operations Center (IT Administrator)
                    </h3>
                    <div class="flex items-center gap-2">
                        <span class="text-[10px] text-slate-500 group-open:rotate-180 transition-transform">
                            <i class="fas fa-chevron-down"></i>
                        </span>
                    </div>
                </summary>

                <div class="pt-4 border-t border-white/5 mt-3">
                    <div id="dev-server-sync" class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-3 p-3 bg-white/[0.02] border border-white/5 rounded-xl font-mono text-[11px]">
                        <div class="bg-brand-dark/50 p-2 rounded-lg border border-white/5">Suspicion Score: <span id="dbg-score" class="text-white font-extrabold block mt-0.5 text-brand-orange">0</span></div>
                        <div class="bg-brand-dark/50 p-2 rounded-lg border border-white/5">Firewall: <span id="dbg-status" class="text-green-400 font-extrabold block mt-0.5">SECURE</span></div>
                        <div class="bg-brand-dark/50 p-2 rounded-lg border border-white/5">Total Payload: <span id="dbg-total-req" class="text-brand-cyan font-extrabold block mt-0.5">0</span></div>
                        <div class="bg-brand-dark/50 p-2 rounded-lg border border-white/5">Sync Rate: <div class="mt-0.5 flex items-baseline gap-1"><span id="dbg-speed" class="text-brand-yellow font-extrabold">0</span> <span class="text-[9px] text-slate-500 uppercase">KB/s</span></div></div>
                    </div>

                    <div id="dev-debug-logs" class="h-28 overflow-y-auto font-mono text-[10px] space-y-1 p-2 bg-black/60 rounded-xl border border-white/5 shadow-inner">
                        <div class="text-slate-500 flex items-center gap-2"><i class="fas fa-circle-info text-brand-cyan text-[9px]"></i> Core agent initialized. Securing pipeline...</div>
                    </div>
                </div>
            </details>
        }

        <!-- Watermark & Traceability Notice -->
        <div class="rounded-xl p-3 bg-brand-cyan/5 border border-brand-cyan/20 shadow flex items-center justify-between gap-4 text-xs">
            <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-lg bg-brand-cyan/10 flex items-center justify-center border border-brand-cyan/20 shrink-0">
                    <i class="fas fa-fingerprint text-brand-cyan text-sm"></i>
                </div>
                <div>
                    <span class="text-brand-cyan font-bold">Forensically Protected Content:</span>
                    <span class="text-slate-300 text-[11px] hidden sm:inline ml-1">This video is uniquely watermarked and traceable to your student account. Unauthorized sharing or recording will result in account suspension.</span>
                </div>
            </div>
            <span class="text-[10px] font-mono text-slate-500 uppercase shrink-0">HLS Secure</span>
        </div>

        <!-- 🎬 Floating Video Player Viewport Container -->
        <div class="glass-panel rounded-[2rem] overflow-hidden shadow-2xl relative border border-white/10">
            <div id="player-container" class="bg-black aspect-video w-full">
                <!-- Video player injected here -->
            </div>
        </div>

        <!-- 🧭 3. Bottom Lesson Navigation Bar (Matching Image 3) -->
        <div class="flex items-center justify-between gap-4 p-4 rounded-2xl glass-panel border border-white/10 shadow-xl">
            <!-- < Previous Lesson Button -->
            @if (prevVideo != null)
            {
                <a href="@Url.Action("Watch", new { videoId = prevVideo.VideoId })"
                   class="inline-flex items-center gap-2 px-4 sm:px-6 py-2.5 rounded-xl border border-white/20 bg-white/5 hover:bg-white/10 text-white font-bold text-xs sm:text-sm hover:border-brand-cyan/40 transition-all shadow">
                    <i class="fas @(isRtl ? "fa-chevron-right" : "fa-chevron-left") text-xs"></i>
                    <span>@Localizer["PreviousLesson"]</span>
                </a>
            }
            else
            {
                <span class="inline-flex items-center gap-2 px-4 sm:px-6 py-2.5 rounded-xl border border-white/5 bg-white/[0.02] text-slate-600 font-bold text-xs sm:text-sm cursor-not-allowed">
                    <i class="fas @(isRtl ? "fa-chevron-right" : "fa-chevron-left") text-xs"></i>
                    <span>@Localizer["PreviousLesson"]</span>
                </span>
            }

            <!-- Center Lesson Progress Indicator -->
            <div class="hidden sm:flex items-center gap-2 text-xs font-semibold text-slate-400">
                <span class="text-white font-bold">@(currentIndex + 1)</span>
                <span>/</span>
                <span>@courseVideos.Count</span>
            </div>

            <!-- Complete and Continue > Button (Image 3: Teal Background with White Text) -->
            @if (nextVideo != null)
            {
                <button type="button" id="btn-complete-continue" onclick="completeAndNavigate(@nextVideo.VideoId)"
                        class="inline-flex items-center gap-2.5 px-5 sm:px-7 py-2.5 rounded-xl bg-gradient-to-r from-teal-400 to-emerald-400 hover:from-teal-500 hover:to-emerald-500 text-slate-950 font-extrabold text-xs sm:text-sm shadow-[0_0_20px_rgba(45,212,191,0.35)] hover:scale-[1.02] active:scale-[0.98] transition-all">
                    <span>@Localizer["CompleteAndContinue"]</span>
                    <i class="fas @(isRtl ? "fa-chevron-left" : "fa-chevron-right") text-xs"></i>
                </button>
            }
            else
            {
                <button type="button" id="btn-complete-continue" onclick="completeAndFinishCourse()"
                        class="inline-flex items-center gap-2.5 px-5 sm:px-7 py-2.5 rounded-xl bg-gradient-to-r from-brand-cyan to-brand-blue hover:from-brand-cyan/90 hover:to-brand-blue/90 text-slate-950 font-extrabold text-xs sm:text-sm shadow-[0_0_20px_rgba(66,234,255,0.35)] hover:scale-[1.02] active:scale-[0.98] transition-all">
                    <i class="fas fa-trophy text-sm"></i>
                    <span>@Localizer["CompleteCourse"]</span>
                </button>
            }
        </div>

        <!-- Video Info & Description -->
        <div class="glass-panel rounded-2xl p-6 border border-white/10 space-y-4">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-white/5 pb-4">
                <div>
                    <h1 class="text-xl md:text-2xl font-extrabold text-white tracking-tight mb-1">@Model.Title</h1>
                    <p class="text-slate-400 text-xs font-bold uppercase tracking-wider flex items-center">
                        <i class="fas fa-folder-open text-brand-blue mr-2 ml-2 text-sm"></i> @courseTitle
                    </p>
                </div>
                @if (Model.DurationSeconds.HasValue)
                {
                    <div class="inline-flex items-center px-3.5 py-1.5 rounded-xl bg-white/5 border border-white/5 text-brand-cyan text-xs font-extrabold tracking-wider shrink-0 self-start md:self-center">
                        <i class="far fa-clock mr-2 ml-2 text-sm"></i>
                        @TimeSpan.FromSeconds(Model.DurationSeconds.Value).ToString(@"hh\:mm\:ss")
                    </div>
                }
            </div>

            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <div class="p-4 bg-white/[0.01] border border-white/5 rounded-xl">
                    <h4 class="text-xs font-bold text-white mb-1.5 flex items-center">
                        <i class="fas fa-align-left mr-2 ml-2 text-brand-blue"></i> @(isRtl ? "درباره این درس" : "About This Lesson")
                    </h4>
                    <p class="text-slate-400 text-xs leading-relaxed">@Model.Description</p>
                </div>
            }
        </div>

        <!-- Hotkeys & Security Matrix -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <!-- Console Hotkeys -->
            <div class="glass-panel rounded-2xl p-5 border border-white/5">
                <h3 class="text-xs font-bold text-white tracking-wider uppercase mb-3 flex items-center">
                    <i class="fas fa-keyboard mr-2 ml-2 text-brand-cyan"></i> Console Hotkeys
                </h3>
                <div class="grid grid-cols-2 gap-2 text-xs">
                    <div class="flex items-center justify-between p-2 rounded-lg bg-white/[0.01] border border-white/5">
                        <span class="text-slate-400">Play / Pause</span>
                        <kbd class="px-1.5 py-0.5 bg-white/10 rounded text-brand-cyan font-mono text-[10px]">Space</kbd>
                    </div>
                    <div class="flex items-center justify-between p-2 rounded-lg bg-white/[0.01] border border-white/5">
                        <span class="text-slate-400">Skip 10s</span>
                        <kbd class="px-1.5 py-0.5 bg-white/10 rounded text-brand-cyan font-mono text-[10px]">← / →</kbd>
                    </div>
                    <div class="flex items-center justify-between p-2 rounded-lg bg-white/[0.01] border border-white/5">
                        <span class="text-slate-400">Fullscreen</span>
                        <kbd class="px-1.5 py-0.5 bg-white/10 rounded text-brand-cyan font-mono text-[10px]">F</kbd>
                    </div>
                    <div class="flex items-center justify-between p-2 rounded-lg bg-white/[0.01] border border-white/5">
                        <span class="text-slate-400">Mute</span>
                        <kbd class="px-1.5 py-0.5 bg-white/10 rounded text-brand-cyan font-mono text-[10px]">M</kbd>
                    </div>
                </div>
            </div>

            <!-- Cryptography Matrix -->
            <div class="glass-panel rounded-2xl p-5 border border-white/5">
                <h3 class="text-xs font-bold text-white tracking-wider uppercase mb-3 flex items-center">
                    <i class="fas fa-shield-halved mr-2 ml-2 text-brand-blue"></i> Cryptography Matrix
                </h3>
                <ul class="grid grid-cols-2 gap-2 text-[11px] font-bold text-slate-400">
                    <li class="flex items-center gap-2 p-1.5 rounded-lg bg-white/[0.01] border border-white/5"><i class="fas fa-shield text-brand-cyan text-xs"></i> <span>AES-128 Encryption</span></li>
                    <li class="flex items-center gap-2 p-1.5 rounded-lg bg-white/[0.01] border border-white/5"><i class="fas fa-eye-slash text-brand-cyan text-xs"></i> <span>Anti-Capture</span></li>
                    <li class="flex items-center gap-2 p-1.5 rounded-lg bg-white/[0.01] border border-white/5"><i class="fas fa-ban-smoke text-brand-cyan text-xs"></i> <span>Hook Defenses</span></li>
                    <li class="flex items-center gap-2 p-1.5 rounded-lg bg-white/[0.01] border border-white/5"><i class="fas fa-fingerprint text-brand-cyan text-xs"></i> <span>Dynamic Overlays</span></li>
                </ul>
            </div>
        </div>

    </main>
</div>

@section Scripts {
    @* --- hls.js via CDN --- *@
    @if (hlsAvailable)
    {
        <script src="https://cdn.jsdelivr.net/npm/hls.js@1.5.13/dist/hls.min.js"></script>
        <script src="~/js/hls-secure-player.js"></script>
    }

    <script type="module" src="~/js/advanced-video-player/index.js"></script>
    <script type="module" src="~/js/advanced-video-protection/index.js"></script>
    <script src="~/js/secure-video-loader.js"></script>

    <script type="module">
        const VIDEO_ID      = @Model.VideoId;
        const TOKEN         = '@videoToken';
        const SESSION_ID    = '@sessionId';
        const USER_ID       = @userId;
        const HLS_AVAILABLE = @(hlsAvailable ? "true" : "false");
        const FORENSIC_CODE = '@ViewBag.ForensicCode';
        const MASKED_EMAIL  = '@ViewBag.MaskedEmail';

        let MANIFEST_URL = '';
        @if (hlsAvailable)
        {
            <text>
                MANIFEST_URL = `@Url.Action("Manifest", "Hls", new { Area = "User" })?videoId=${VIDEO_ID}&sid=${encodeURIComponent(SESSION_ID)}&ct=${encodeURIComponent(TOKEN)}`;
            </text>
        }

        window.avpInstance = new window.AdvancedVideoPlayer({
            containerId:     'player-container',
            videoId:         'secureVideoPlayer',
            videoSrc:        '', // Direct MP4 fallback disabled; stream strictly served via HLS
            sessionId:       SESSION_ID,
            userId:          USER_ID,
            courseVideoId:   VIDEO_ID,
            title:           '@Model.Title.Replace("'", "\\'")',
            forensicCode:    FORENSIC_CODE,
            maskedEmail:     MASKED_EMAIL,
            reportUrl:       '@Url.Action("ReportSuspiciousActivity", "Courses", new { Area = "User" })',
            saveProgressUrl: '@Url.Action("SaveVideoProgress", "Courses", new { Area = "User" })',
            getProgressUrl:  '@Url.Action("GetVideoProgress", "Courses", new { Area = "User" })',
            chapters:        []
        });

        let hlsStreamer;

        if (HLS_AVAILABLE && typeof HlsSecurePlayer !== 'undefined') {
            hlsStreamer = new HlsSecurePlayer({
                videoId:        'secureVideoPlayer',
                sessionId:      SESSION_ID,
                contentToken:   TOKEN,
                manifestUrl:    MANIFEST_URL
            });
        }

        const protection = new window.AdvancedVideoProtection({
            videoElementId:  'secureVideoPlayer',
            sessionId:       SESSION_ID,
            userId:          USER_ID,
            videoId:         VIDEO_ID,
            heartbeatUrl:    '@Url.Action("PlayerHeartbeat", "Courses", new { Area = "User" })',
            fingerprintUrl:  '@Url.Action("ValidateFingerprint", "Courses", new { Area = "User" })',
            reportUrl:       '@Url.Action("ReportSuspiciousActivity", "Courses", new { Area = "User" })',
            heartbeatInterval: 3000,
            debug: @(isItAdmin ? "true" : "false")
        });

        // Hide URLs in logs console hooks
        (function () {
            const originalLog = console.log;
            console.log = function (...args) {
                const filtered = args.map(a =>
                    typeof a === 'string' && (a.includes('StreamVideo') || a.includes('/Hls/'))
                        ? '[Protected URL Hidden]'
                        : a
                );
                originalLog.apply(console, filtered);
            };
        })();

        // Theater Mode Integration
        window.addEventListener('theaterModeChanged', (e) => {
            document.body.classList.toggle('theater-mode-active', e.detail.isTheaterMode);
        });

        // Memory Leak Cleanup Guard
        window.addEventListener('beforeunload', () => {
            if (hlsStreamer) hlsStreamer.destroy();
            if (window.avpInstance) window.avpInstance.destroy();
        });

        console.log('%c🛑 STOP!', 'color:red;font-size:50px;font-weight:bold;');
        console.log(
            HLS_AVAILABLE
                ? '%c✅ HLS Encrypted Stream Active (AES-128)'
                : '%c✅ Secure MP4 Stream Active',
            'color:green;font-size:14px;'
        );
    </script>

    <!-- Complete and Continue & Playlist Toggle Handlers -->
    <script>
        // 1. Toggle Curriculum Playlist Sidebar
        const toggleBtn = document.getElementById('toggle-curriculum-btn');
        const curriculumSidebar = document.getElementById('curriculum-sidebar');
        if (toggleBtn && curriculumSidebar) {
            toggleBtn.addEventListener('click', () => {
                curriculumSidebar.classList.toggle('hidden');
            });
        }

        // 2. Curriculum Quick Search Filter
        document.getElementById('curriculum-search')?.addEventListener('input', function(e) {
            const q = (e.target.value || '').toLowerCase().trim();
            document.querySelectorAll('.curriculum-lesson-item').forEach(el => {
                const title = el.getAttribute('data-title') || '';
                el.style.display = title.includes(q) ? 'flex' : 'none';
            });
        });

        // 3. Complete and Continue Navigation (Image 3)
        async function completeAndNavigate(nextVideoId) {
            const btn = document.getElementById('btn-complete-continue');
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> @(isRtl ? "در حال ثبت..." : "Saving...")';
            }

            try {
                const videoEl = document.getElementById('secureVideoPlayer');
                const position = videoEl?.currentTime || 0;
                const duration = videoEl?.duration || 1;

                await fetch('@Url.Action("SaveVideoProgress", "Courses", new { Area = "User" })', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        videoId: @Model.VideoId,
                        position: position,
                        duration: duration,
                        completed: true
                    })
                });
            } catch (err) {
                console.warn('Progress save failed:', err);
            }

            // Navigate to next lesson
            window.location.href = '@Url.Action("Watch", "Courses", new { Area = "User" })?videoId=' + nextVideoId;
        }

        // 4. Complete and Finish Course (Last video)
        async function completeAndFinishCourse() {
            const btn = document.getElementById('btn-complete-continue');
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> @(isRtl ? "در حال ثبت..." : "Completing...")';
            }

            try {
                const videoEl = document.getElementById('secureVideoPlayer');
                const position = videoEl?.currentTime || 0;
                const duration = videoEl?.duration || 1;

                await fetch('@Url.Action("SaveVideoProgress", "Courses", new { Area = "User" })', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        videoId: @Model.VideoId,
                        position: position,
                        duration: duration,
                        completed: true
                    })
                });
            } catch (err) {
                console.warn('Progress save failed:', err);
            }

            window.location.href = '@Url.Action("MyCourseDetails", "Courses", new { id = courseId })';
        }

        // 🐛 Dev Logger UI Adapter System
        window.DevLogger = {
            log: function(message, type = 'info', data = null) {
                const logsDiv = document.getElementById('dev-debug-logs');
                if (!logsDiv) return;

                const time = new Date().toLocaleTimeString();
                let color = 'text-slate-400';
                let icon = '<i class="fas fa-circle-info text-brand-cyan text-[9px]"></i>';

                if (type === 'warn') {
                    color = 'text-brand-yellow';
                    icon = '<i class="fas fa-triangle-exclamation text-brand-yellow text-[9px]"></i>';
                }
                if (type === 'error' || type === 'block') {
                    color = 'text-brand-orange font-bold';
                    icon = '<i class="fas fa-circle-radiation text-brand-orange text-[9px]"></i>';
                }

                let dataStr = '';
                if (data) {
                    try { dataStr = typeof data === 'object' ? JSON.stringify(data) : data; } catch(e) {}
                }

                const html = `<div class="${color} flex items-start gap-2 border-b border-white/[0.02] pb-1">
                    <span class="text-slate-600 shrink-0">[${time}]</span>
                    <span class="shrink-0">${icon}</span>
                    <div class="flex-1 break-all">
                        ${message}
                        ${dataStr ? `<span class="text-slate-500 block text-[10px] mt-0.5 bg-black/20 p-1 rounded font-sans">${dataStr}</span>` : ''}
                    </div>
                </div>`;

                logsDiv.insertAdjacentHTML('afterbegin', html);
            },

            updateServerSync: function(data) {
                if(!data) return;

                const scoreEl = document.getElementById('dbg-score');
                if (scoreEl) scoreEl.innerText = data.suspicionScore || 0;

                const statusEl = document.getElementById('dbg-status');
                if (statusEl) {
                    if (data.isBlocked) {
                        statusEl.innerText = 'BLOCKED / CRITICAL';
                        statusEl.className = 'text-brand-orange font-extrabold animate-pulse';
                    } else if (data.isThrottled) {
                        statusEl.innerText = 'THROTTLED';
                        statusEl.className = 'text-brand-yellow font-extrabold';
                    } else {
                        statusEl.innerText = 'SECURE';
                        statusEl.className = 'text-green-400 font-extrabold';
                    }
                }

                if(data.debugInfo) {
                    const reqEl = document.getElementById('dbg-total-req');
                    if (reqEl) reqEl.innerText = data.debugInfo.totalRequests || 0;

                    const kbps = data.debugInfo.currentSpeedKBps || 0;
                    let speedText = "0";
                    let unitText = "KB/s";

                    if (kbps >= 1024 * 1024) {
                        speedText = (kbps / (1024 * 1024)).toFixed(2);
                        unitText = "GB/s";
                    } else if (kbps >= 1024) {
                        speedText = (kbps / 1024).toFixed(2);
                        unitText = "MB/s";
                    } else {
                        speedText = Math.round(kbps).toString();
                        unitText = "KB/s";
                    }

                    const speedEl = document.getElementById('dbg-speed');
                    if (speedEl) {
                        speedEl.innerText = speedText;
                        if (speedEl.nextElementSibling) {
                            speedEl.nextElementSibling.innerText = unitText;
                        }
                    }

                    if(data.debugInfo.reasons && Object.keys(data.debugInfo.reasons).length > 0) {
                        this.log('Server flagged reasons:', 'warn', data.debugInfo.reasons);
                    }
                }
            }
        };

        const originalLog = console.log;
        const originalWarn = console.warn;
        const originalError = console.error;

        console.log = function(...args) {
            if(args[0] && typeof args[0] === 'string' && args[0].includes('[VideoProtection]')) {
                window.DevLogger.log(args[1] || args[0], 'info', args[2]);
            }
            originalLog.apply(console, args);
        };

        console.warn = function(...args) {
            window.DevLogger.log(args[0], 'warn', args[1]);
            originalWarn.apply(console, args);
        };

        console.error = function(...args) {
            window.DevLogger.log(args[0], 'error', args[1]);
            originalError.apply(console, args);
        };

        const originalFetch = window.fetch;
        window.fetch = async function(...args) {
            const response = await originalFetch.apply(this, args);

            if (response.ok) {
                const clone = response.clone();
                clone.json().then(data => {
                    if(args[0] && (args[0].includes('PlayerHeartbeat') || args[0].includes('ValidateFingerprint'))) {
                        window.DevLogger.updateServerSync(data);

                        if (data.flags && data.flags.length > 0) {
                            window.DevLogger.log('Fingerprint Flags:', 'warn', data.flags);
                        }
                    }
                }).catch(e => {});
            }

            return response;
        };
    </script>
}