@model Domain.Entities.Course.CoursePdf
@inject Application.Interfaces.IPermissionService PermissionService

@{
    ViewData["Title"] = ViewBag.PdfTitle;
    var courseTitle = ViewBag.CourseTitle as string;
    var courseId = (int)ViewBag.CourseId;
    // Staff tools (Forensic Reveal, admin back link) appear only in the admin view (/Admin/Course/Pdf/{id});
    // (Roles are not in the login cookie, so the permission service decides, as in the admin area.)
    var staffUserId = int.TryParse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var uid) ? uid : 0;
    var isStaff = staffUserId > 0 && await PermissionService.UserHasPermissionAsync(staffUserId, "Courses.View");
    // Opened from the admin panel (/Admin/Course/Pdf/{id}): keep the admin layout and menu.
    var adminMode = isStaff && (ViewBag.AdminMode as bool? ?? false);
    if (adminMode) { Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml"; }
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

<div class="space-y-4 select-none antialiased animate-fade-in-up" oncontextmenu="return false;" style="font-family: 'Plus Jakarta Sans', sans-serif;">

    <!-- Top Action Bar -->
    <div class="flex items-center justify-between gap-2 px-1">
        @if (adminMode)
        {
            <a asp-area="Admin" asp-controller="Courses" asp-action="Details" asp-route-id="@courseId" class="group inline-flex items-center px-4 py-2 rounded-xl bg-brand-cyan/10 text-brand-cyan hover:bg-brand-cyan hover:text-dark-bg border border-brand-cyan/20 transition-all duration-300">
                <i class="fas fa-arrow-left mr-2 transform group-hover:-translate-x-0.5 transition-transform"></i>
                <span class="text-xs font-bold uppercase tracking-wider">Back to Admin Course</span>
            </a>
        }
        else
        {
            <a asp-area="User" asp-controller="Courses" asp-action="MyCourseDetails" asp-route-id="@courseId" class="group inline-flex items-center min-w-0 max-w-full px-4 py-2 rounded-xl bg-white/5 text-slate-400 hover:text-brand-cyan border border-white/5 hover:border-brand-cyan/20 transition-all duration-300">
                <i class="fas fa-arrow-left mr-2 shrink-0 transform group-hover:-translate-x-0.5 transition-transform"></i>
                <span class="text-xs font-bold uppercase tracking-wider truncate">Back to <span class="text-slate-300 group-hover:text-brand-cyan transition-colors ml-1">@courseTitle</span></span>
            </a>
        }
        <div class="hidden sm:flex shrink-0 items-center gap-2 text-[10px] bg-brand-cyan/10 border border-brand-cyan/20 text-brand-cyan px-3 py-1.5 rounded-xl font-bold tracking-widest uppercase shadow-[0_0_15px_rgba(66,234,255,0.1)]">
            <span class="w-1.5 h-1.5 rounded-full bg-brand-cyan animate-pulse"></span>
            Cryptographic Node Stream
        </div>
    </div>

    <!-- Main PDF Viewer Frame -->
    <!-- Height is set by the script so the viewer fills the screen below the page header (min 420px). -->
    <div id="pdf-container" class="flex flex-col bg-brand-dark/40 rounded-2xl sm:rounded-[2rem] overflow-hidden border border-white/5 shadow-2xl backdrop-blur-xl relative" style="height: 80vh;">

        <!-- Toolbar: wraps to a second row on phones -->
        <div id="pdf-toolbar" class="bg-gradient-to-r from-white/[0.03] to-white/[0.01] border-b border-white/5 p-2 sm:p-3.5 flex flex-wrap items-center justify-between gap-2 sm:gap-4 text-slate-200 z-10 shadow-sm backdrop-blur-md">

            <!-- Pagination Controls -->
            <div class="flex shrink-0 items-center gap-0.5 bg-black/40 p-1 rounded-xl border border-white/5">
                <button id="first-page" class="hidden sm:block p-2 text-slate-400 hover:text-brand-cyan hover:bg-white/5 rounded-lg transition-all disabled:opacity-20 disabled:hover:bg-transparent" title="First Page">
                    <i class="fas fa-angle-double-left text-xs"></i>
                </button>
                <button id="prev-page" class="p-2 text-slate-400 hover:text-brand-cyan hover:bg-white/5 rounded-lg transition-all disabled:opacity-20 disabled:hover:bg-transparent" title="Previous Page">
                    <i class="fas fa-angle-left text-xs"></i>
                </button>

                <div class="flex items-center gap-1.5 sm:gap-2 px-2 sm:px-3 text-xs font-bold text-slate-400 border-x border-white/5 mx-1">
                    <span class="hidden sm:inline">Page</span>
                    <input type="number" id="page-idx-input" class="w-12 text-center bg-brand-dark border border-white/10 rounded-lg py-1 px-0.5 text-brand-cyan font-extrabold focus:outline-none focus:border-brand-cyan/50 focus:ring-1 focus:ring-brand-cyan/30 transition-all" value="1" min="1" />
                    <span>of</span>
                    <span id="page-count" class="font-extrabold text-slate-200">...</span>
                </div>

                <button id="next-page" class="p-2 text-slate-400 hover:text-brand-cyan hover:bg-white/5 rounded-lg transition-all disabled:opacity-20 disabled:hover:bg-transparent" title="Next Page">
                    <i class="fas fa-angle-right text-xs"></i>
                </button>
                <button id="last-page" class="hidden sm:block p-2 text-slate-400 hover:text-brand-cyan hover:bg-white/5 rounded-lg transition-all disabled:opacity-20 disabled:hover:bg-transparent" title="Last Page">
                    <i class="fas fa-angle-double-right text-xs"></i>
                </button>
            </div>

            <!-- Zoom Controls -->
            <div class="flex shrink-0 items-center gap-0.5 bg-black/40 p-1 rounded-xl border border-white/5">
                <button id="zoom-out" class="p-2 text-slate-400 hover:text-brand-cyan hover:bg-white/5 rounded-lg transition-all" title="Zoom Out">
                    <i class="fas fa-minus text-[10px]"></i>
                </button>
                <span id="zoom-percent" class="px-1 sm:px-2 text-xs font-extrabold font-mono w-12 sm:w-14 text-center text-slate-200">100%</span>
                <button id="zoom-in" class="p-2 text-slate-400 hover:text-brand-cyan hover:bg-white/5 rounded-lg transition-all" title="Zoom In">
                    <i class="fas fa-plus text-[10px]"></i>
                </button>
                <div class="w-px h-4 bg-white/5 mx-1"></div>
                <!-- Switches between showing the whole page and filling the width; the label names what a click does -->
                <button id="zoom-fit" class="px-2 sm:px-3 py-1.5 text-slate-400 hover:text-brand-cyan hover:bg-white/5 rounded-lg transition-all text-xs font-bold flex items-center gap-1.5 whitespace-nowrap" title="Fit to Width">
                    <i class="fas fa-arrows-left-right text-[11px]"></i> <span id="zoom-fit-label" class="hidden sm:inline">Fit Width</span>
                </button>
            </div>

            <!-- Utility Action Buttons -->
            <div class="flex shrink-0 items-center gap-1.5 sm:gap-2">
                @if (adminMode)
                {
                    <button id="forensic-toggle" class="px-3 py-2 text-slate-400 hover:text-rose-400 bg-black/40 hover:bg-rose-500/10 border border-white/5 hover:border-rose-500/30 rounded-xl transition-all flex items-center gap-1.5" title="Forensic Reveal (Expose Watermarks)">
                        <i class="fas fa-fingerprint text-xs"></i>
                        <span class="text-[11px] font-bold hidden sm:inline">Forensic Reveal</span>
                    </button>
                    <!-- Reveal method (shown while Forensic Reveal is on). The methods work on any paper colour. -->
                    <span id="forensic-tools" class="hidden items-center gap-1.5">
                        <select id="forensic-mode" title="Reveal method" class="bg-black/40 border border-rose-500/40 rounded-lg py-1.5 px-2 text-[11px] font-bold text-slate-200 focus:outline-none">
                            <option value="pca1">PCA 1</option>
                            <option value="pca2">PCA 2</option>
                            <option value="pca3">PCA 3</option>
                            <option value="sweep">Level Sweep</option>
                            <option value="gradient">Luminance Gradient</option>
                        </select>
                        <input id="forensic-level" type="range" class="hidden w-24 accent-rose-500" />
                    </span>
                }
                <button id="print-pdf" type="button" class="hidden px-3 py-2 text-slate-400 hover:text-brand-cyan bg-black/40 hover:bg-white/5 border border-white/5 rounded-xl transition-all items-center gap-1.5" title="Print (your watermark is printed on every page)">
                    <i class="fas fa-print text-xs"></i>
                    <span class="text-[11px] font-bold hidden sm:inline">Print</span>
                </button>
                <button id="rotate-pdf" class="p-2.5 text-slate-400 hover:text-brand-cyan bg-black/40 hover:bg-white/5 border border-white/5 rounded-xl transition-all" title="Rotate 90°">
                    <i class="fas fa-rotate text-xs"></i>
                </button>
                <button id="fullscreen-toggle" class="p-2.5 text-slate-400 hover:text-brand-cyan bg-black/40 hover:bg-white/5 border border-white/5 rounded-xl transition-all" title="Toggle Fullscreen">
                    <i class="fas fa-expand text-xs"></i>
                </button>
                <button id="dark-mode-toggle" class="p-2.5 text-slate-400 hover:text-brand-yellow bg-black/40 hover:bg-white/5 border border-white/5 rounded-xl transition-all" title="Toggle Inversion Mode">
                    <i class="fas fa-moon text-xs"></i>
                </button>
            </div>
        </div>

        <!-- Viewport Workspace Wrapper -->
        <!-- The page is centred with margin:auto (not justify-center), so a zoomed-in page can still scroll to its left/top edge. -->
        <div id="viewport-wrapper" class="relative flex-1 min-h-0 bg-brand-dark/20 p-2 sm:p-6 flex overflow-auto custom-scrollbar">

            <!-- Elegant Micro-Loading State -->
            <div id="pdf-loading" class="absolute inset-0 bg-brand-dark/95 flex flex-col justify-center items-center z-50 transition-opacity duration-300">
                <div class="relative w-10 h-10 mb-4">
                    <div class="absolute inset-0 rounded-full border-2 border-brand-cyan/10"></div>
                    <div class="absolute inset-0 rounded-full border-2 border-t-brand-cyan animate-spin"></div>
                </div>
                <p class="text-slate-400 text-xs font-bold tracking-wide uppercase">Securing Virtual Reader...</p>
            </div>

            <!-- Canvas Container Matrix -->
            <div id="page-frame" class="relative shrink-0 shadow-[0_40px_80px_rgba(0,0,0,0.7)] rounded-lg sm:rounded-2xl overflow-hidden m-auto border border-white/5 bg-white">
                <canvas id="pdf-canvas" class="block transition-transform duration-150 ease-out"></canvas>
                <!-- Live moving overlay: identifies the viewer on any screenshot or screen recording -->
                <div id="live-mark" class="pointer-events-none absolute z-10 select-none whitespace-nowrap font-mono text-[11px] font-bold px-2 py-1 rounded-md"
                     style="color: rgba(20,30,80,0.38); background: rgba(255,255,255,0.18); transition: left 1.2s ease, top 1.2s ease; left: 10%; top: 10%;"></div>
            </div>
        </div>
    </div>

    <!-- Print dialog: the server renders print pages with the watermark burned in; nothing else can be printed -->
    <div id="print-dialog" class="hidden fixed inset-0 z-[100] bg-black/70 backdrop-blur-sm items-center justify-center p-4">
        <div class="w-full max-w-sm bg-brand-dark border border-white/10 rounded-2xl p-5 shadow-2xl text-slate-200">
            <h3 class="text-sm font-extrabold uppercase tracking-wider text-brand-cyan flex items-center gap-2"><i class="fas fa-print"></i> Print pages</h3>
            <p class="mt-2 text-xs text-slate-400 leading-relaxed">Every printed page carries your name, your code and the print time. Printing is logged.</p>
            <div class="mt-4 space-y-2 text-xs font-bold">
                <label class="flex items-center gap-2 cursor-pointer"><input type="radio" name="print-scope" value="current" checked class="accent-cyan-400" /> Current page</label>
                <label class="flex items-center gap-2 cursor-pointer"><input type="radio" name="print-scope" value="range" class="accent-cyan-400" /> Pages
                    <input id="print-from" type="number" min="1" value="1" class="w-14 text-center bg-black/40 border border-white/10 rounded-lg py-1" /> to
                    <input id="print-to" type="number" min="1" value="1" class="w-14 text-center bg-black/40 border border-white/10 rounded-lg py-1" />
                </label>
                <label class="flex items-center gap-2 pt-1">Paper
                    <select id="print-paper" class="bg-black/40 border border-white/10 rounded-lg py-1 px-2 text-slate-200">
                        <option value="A4">A4</option>
                        <option value="Letter">Letter</option>
                        <option value="Legal">Legal</option>
                    </select>
                </label>
                <p class="text-[11px] text-slate-500 font-normal">Each page is scaled to fit the paper. Choose the same paper size in the print window.</p>
                <p id="print-limit" class="text-[11px] text-slate-500 font-normal"></p>
            </div>
            <p id="print-status" class="mt-3 text-xs text-brand-orange min-h-[1rem]"></p>
            <div class="mt-4 flex justify-end gap-2">
                <button id="print-cancel" type="button" class="px-4 py-2 rounded-xl text-xs font-bold bg-white/5 hover:bg-white/10 border border-white/10">Cancel</button>
                <button id="print-go" type="button" class="px-4 py-2 rounded-xl text-xs font-bold bg-brand-cyan text-dark-bg hover:opacity-90">Print</button>
            </div>
        </div>
    </div>
    @Html.AntiForgeryToken()
</div>

@section Styles {
    <style>
        @@media print {
            body * { visibility: hidden !important; }
        }
        /* Precision Custom Scrollbars */
        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }

        .custom-scrollbar::-webkit-scrollbar-track {
            background: transparent;
        }

        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.08);
            border-radius: 10px;
        }

            .custom-scrollbar::-webkit-scrollbar-thumb:hover {
                background: #42EAFF;
            }

        /* Responsive Fullscreen Fix Matrix Override */
        #pdf-container:fullscreen {
            width: 100vw !important;
            height: 100vh !important;
            max-height: 100vh !important;
            border-radius: 0px !important;
            border: none !important;
            background-color: #030712 !important;
        }

            #pdf-container:fullscreen #viewport-wrapper {
                background-color: #030712;
            }    </style>
}

@section Scripts {
    <script>
        // 🔒 Secure viewer: the browser never receives the PDF file. Each page arrives as a JPEG
        //    rendered on the server with this student's forensic watermark burned into the pixels.
        const streamToken = encodeURIComponent('@ViewBag.StreamToken');
        const infoUrl = '@Url.Action("PdfInfo")' + '?token=' + streamToken;
        const pageUrl = n => '@Url.Action("PdfPage")' + '?token=' + streamToken + '&page=' + n;
        const backUrl = '@(adminMode ? Url.Action("Details", "Courses", new { area = "Admin", id = Model.CourseId }) : Url.Action("MyCourseDetails", new { id = Model.CourseId }))';

        // Pages are rendered at 2x PDF points, so natural CSS size = bitmap size / 2.
        const SERVER_SCALE = 2;

        let numPages = 0,
        pageNum = 1,
        scale = 1,
        rotation = 0,
        renderSeq = 0,
        currentBitmap = null,
        // 'page' = whole page visible (default), 'width' = page fills the width, null = manual zoom
        fitMode = 'page';

        const maxScale = 3.0, minScale = 0.25;

        const canvas = document.getElementById('pdf-canvas'),
        ctx = canvas.getContext('2d'),
        loadingEl = document.getElementById('pdf-loading'),
        pageCountEl = document.getElementById('page-count'),
        pageInputEl = document.getElementById('page-idx-input'),
        zoomPercentEl = document.getElementById('zoom-percent'),
        wrapperEl = document.getElementById('viewport-wrapper'),
        containerEl = document.getElementById('pdf-container'),
        liveMarkEl = document.getElementById('live-mark'),
        fitBtn = document.getElementById('zoom-fit'),
        fitLabel = document.getElementById('zoom-fit-label'),
        fitIcon = document.querySelector('#zoom-fit i'),
        fsIcon = document.querySelector('#fullscreen-toggle i');

        // The viewer fills the screen from where it starts down to the bottom (fullscreen CSS takes over there).
        const sizeContainer = () => {
        if (document.fullscreenElement) return;
        const top = containerEl.getBoundingClientRect().top + window.scrollY;
        containerEl.style.height = Math.max(420, Math.round(window.innerHeight - top - 16)) + 'px';
        };
        sizeContainer();

        // Scale at which the current page shows whole ('page') or fills the width ('width').
        const fitScale = mode => {
        if (!currentBitmap) return scale;
        const cs = getComputedStyle(wrapperEl);
        const availW = wrapperEl.clientWidth - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight) - 2;
        const availH = wrapperEl.clientHeight - parseFloat(cs.paddingTop) - parseFloat(cs.paddingBottom) - 2;
        const swap = rotation % 180 !== 0;
        const naturalW = (swap ? currentBitmap.height : currentBitmap.width) / SERVER_SCALE;
        const naturalH = (swap ? currentBitmap.width : currentBitmap.height) / SERVER_SCALE;
        const s = mode === 'width' ? availW / naturalW : Math.min(availW / naturalW, availH / naturalH);
        return Math.min(maxScale, Math.max(0.1, s));
        };

        const updateFitButton = () => {
        const toWidth = fitMode === 'page';
        fitLabel.textContent = toWidth ? 'Fit Width' : 'Fit Page';
        fitBtn.title = toWidth ? 'Fit to Width' : 'Show Whole Page';
        fitBtn.setAttribute('aria-label', fitBtn.title);
        fitIcon.className = (toWidth ? 'fas fa-arrows-left-right' : 'fas fa-file') + ' text-[11px]';
        };

        // Small in-memory cache of decoded pages (kept tiny on purpose).
        const bitmapCache = new Map();
        const MAX_CACHED = 4;

        const showError = msg => {
        loadingEl.style.opacity = '1';
        loadingEl.style.pointerEvents = 'all';
        loadingEl.innerHTML = '<div class="glass-panel p-6 rounded-2xl border border-brand-orange/30 text-brand-orange text-center max-w-xs font-bold text-xs leading-relaxed uppercase tracking-wide"><i class="fas fa-triangle-exclamation text-lg mb-2 block"></i>' + msg + '</div>';
        };

        const fetchPage = async n => {
        if (bitmapCache.has(n)) return bitmapCache.get(n);
        const res = await fetch(pageUrl(n), { credentials: 'same-origin', cache: 'no-store' });
        if (res.status === 401 || res.status === 403) throw new Error('auth');
        if (res.status === 429) throw new Error('rate');
        if (res.status === 404) throw new Error('notfound');
        if (!res.ok) throw new Error('http ' + res.status);
        const bmp = await createImageBitmap(await res.blob());
        bitmapCache.set(n, bmp);
        while (bitmapCache.size > MAX_CACHED) {
        const oldest = bitmapCache.keys().next().value;
        if (oldest === pageNum) break;
        const old = bitmapCache.get(oldest);
        bitmapCache.delete(oldest);
        if (old !== currentBitmap && old.close) old.close();
        }
        return bmp;
        };

        const drawBitmap = bmp => {
        currentBitmap = bmp;
        if (fitMode) scale = fitScale(fitMode);
        zoomPercentEl.textContent = `${Math.round(scale * 100)}%`;
        const swap = rotation % 180 !== 0;
        const naturalW = (swap ? bmp.height : bmp.width) / SERVER_SCALE;
        const naturalH = (swap ? bmp.width : bmp.height) / SERVER_SCALE;

        // Full-resolution backing store; CSS size controls zoom.
        canvas.width = swap ? bmp.height : bmp.width;
        canvas.height = swap ? bmp.width : bmp.height;
        canvas.style.width = Math.floor(naturalW * scale) + 'px';
        canvas.style.height = Math.floor(naturalH * scale) + 'px';

        ctx.save();
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        ctx.translate(canvas.width / 2, canvas.height / 2);
        ctx.rotate(rotation * Math.PI / 180);
        ctx.drawImage(bmp, -bmp.width / 2, -bmp.height / 2);
        ctx.restore();
        if (isForensicMode) revealWatermarks();
        };

        // ---- Forensic Reveal (admin view only) -----------------------------------------------------------------
        // The watermarks are only ~2% darker than the page, and pages are not always white (e.g. cream), so the
        // methods below look for tiny local differences instead of "near white". Same ideas as Forensically:
        //  • PCA 1/2/3: project the colours onto a principal component, then equalise the histogram. Tiny differences
        //    in the dominant colour (the paper) are spread over the full grey range, so the marks stand out.
        //  • Level Sweep: stretch a narrow band of levels around the paper colour; the slider moves the band.
        //  • Luminance Gradient: edges of the brightness (Sobel) as a colour map; the slider sets the strength.
        const forensicModeEl = document.getElementById('forensic-mode');
        const forensicLevelEl = document.getElementById('forensic-level');

        // Eigen-decomposition of a symmetric 3x3 matrix (Jacobi rotations), largest eigenvalue first.
        const eigenSym3 = A => {
        const a = A.map(r => r.slice());
        const V = [[1, 0, 0], [0, 1, 0], [0, 0, 1]];
        for (let sweep = 0; sweep < 50; sweep++) {
        if (Math.abs(a[0][1]) + Math.abs(a[0][2]) + Math.abs(a[1][2]) < 1e-10) break;
        for (const [p, q] of [[0, 1], [0, 2], [1, 2]]) {
        if (Math.abs(a[p][q]) < 1e-14) continue;
        const theta = (a[q][q] - a[p][p]) / (2 * a[p][q]);
        const t = (theta >= 0 ? 1 : -1) / (Math.abs(theta) + Math.sqrt(theta * theta + 1));
        const c = 1 / Math.sqrt(t * t + 1), sn = t * c;
        for (let k = 0; k < 3; k++) { const kp = a[k][p], kq = a[k][q]; a[k][p] = c * kp - sn * kq; a[k][q] = sn * kp + c * kq; }
        for (let k = 0; k < 3; k++) { const pk = a[p][k], qk = a[q][k]; a[p][k] = c * pk - sn * qk; a[q][k] = sn * pk + c * qk; }
        for (let k = 0; k < 3; k++) { const kp = V[k][p], kq = V[k][q]; V[k][p] = c * kp - sn * kq; V[k][q] = sn * kp + c * kq; }
        }
        }
        return [0, 1, 2].map(i => ({ value: a[i][i], vector: [V[0][i], V[1][i], V[2][i]] })).sort((x, y) => y.value - x.value);
        };

        const revealPca = (d, component) => {
        const n = d.length / 4;
        let mr = 0, mg = 0, mb = 0;
        for (let i = 0; i < d.length; i += 4) { mr += d[i]; mg += d[i + 1]; mb += d[i + 2]; }
        mr /= n; mg /= n; mb /= n;
        let rr = 0, rg = 0, rb = 0, gg = 0, gb = 0, bb = 0;
        for (let i = 0; i < d.length; i += 4) {
        const r = d[i] - mr, g = d[i + 1] - mg, b = d[i + 2] - mb;
        rr += r * r; rg += r * g; rb += r * b; gg += g * g; gb += g * b; bb += b * b;
        }
        const v = eigenSym3([[rr, rg, rb], [rg, gg, gb], [rb, gb, bb]])[component].vector;
        const proj = new Float32Array(n);
        let min = Infinity, max = -Infinity;
        for (let i = 0, j = 0; i < d.length; i += 4, j++) {
        const x = (d[i] - mr) * v[0] + (d[i + 1] - mg) * v[1] + (d[i + 2] - mb) * v[2];
        proj[j] = x; if (x < min) min = x; if (x > max) max = x;
        }
        // Histogram equalisation over 4096 bins.
        const BINS = 4096, span = (max - min) || 1, hist = new Uint32Array(BINS);
        const bin = new Uint16Array(n);
        for (let j = 0; j < n; j++) { const k = Math.min(BINS - 1, ((proj[j] - min) / span * (BINS - 1)) | 0); bin[j] = k; hist[k]++; }
        const lut = new Uint8ClampedArray(BINS);
        let acc = 0;
        for (let k = 0; k < BINS; k++) { acc += hist[k]; lut[k] = Math.round(acc / n * 255); }
        for (let i = 0, j = 0; i < d.length; i += 4, j++) { const y = lut[bin[j]]; d[i] = d[i + 1] = d[i + 2] = y; }
        };

        const revealLevelSweep = (d, offset) => {
        // Band centre per channel = the most common level (the paper colour) + slider offset.
        const peaks = [0, 1, 2].map(c => {
        const h = new Uint32Array(256);
        for (let i = c; i < d.length; i += 4) h[d[i]]++;
        let best = 0; for (let k = 1; k < 256; k++) if (h[k] > h[best]) best = k;
        return best;
        });
        const W = 24;
        const luts = peaks.map(pk => {
        const lo = pk - 4 + offset - W / 2, lut = new Uint8ClampedArray(256);
        for (let k = 0; k < 256; k++) lut[k] = (k - lo) * 255 / W;
        return lut;
        });
        for (let i = 0; i < d.length; i += 4) { d[i] = luts[0][d[i]]; d[i + 1] = luts[1][d[i + 1]]; d[i + 2] = luts[2][d[i + 2]]; }
        };

        const revealGradient = (d, w, h, strength) => {
        const L = new Float32Array(w * h);
        for (let i = 0, j = 0; i < d.length; i += 4, j++) L[j] = d[i] * 0.299 + d[i + 1] * 0.587 + d[i + 2] * 0.114;
        for (let y = 0; y < h; y++) {
        for (let x = 0; x < w; x++) {
        const o = (y * w + x) * 4;
        if (x === 0 || y === 0 || x === w - 1 || y === h - 1) { d[o] = 128; d[o + 1] = 128; d[o + 2] = 255; continue; }
        const j = y * w + x;
        const gx = (L[j - w + 1] + 2 * L[j + 1] + L[j + w + 1]) - (L[j - w - 1] + 2 * L[j - 1] + L[j + w - 1]);
        const gy = (L[j + w - 1] + 2 * L[j + w] + L[j + w + 1]) - (L[j - w - 1] + 2 * L[j - w] + L[j - w + 1]);
        d[o] = 128 + gx * strength;
        d[o + 1] = 128 + gy * strength;
        d[o + 2] = 255 - (Math.abs(gx) + Math.abs(gy)) * strength * 0.5;
        }
        }
        };

        const syncForensicSlider = () => {
        if (!forensicModeEl) return;
        const m = forensicModeEl.value;
        forensicLevelEl.classList.toggle('hidden', m.startsWith('pca'));
        if (m === 'sweep' && forensicLevelEl.dataset.mode !== 'sweep') {
        Object.assign(forensicLevelEl, { min: -60, max: 60, step: 1, value: 0, title: 'Level band position' });
        } else if (m === 'gradient' && forensicLevelEl.dataset.mode !== 'gradient') {
        Object.assign(forensicLevelEl, { min: 1, max: 30, step: 1, value: 10, title: 'Gradient strength' });
        }
        forensicLevelEl.dataset.mode = m;
        };

        const revealWatermarks = () => {
        const img = ctx.getImageData(0, 0, canvas.width, canvas.height);
        const mode = forensicModeEl ? forensicModeEl.value : 'pca1';
        if (mode === 'sweep') revealLevelSweep(img.data, parseInt(forensicLevelEl.value, 10) || 0);
        else if (mode === 'gradient') revealGradient(img.data, canvas.width, canvas.height, parseInt(forensicLevelEl.value, 10) || 10);
        else revealPca(img.data, ({ pca1: 0, pca2: 1, pca3: 2 })[mode] ?? 0);
        ctx.putImageData(img, 0, 0);
        };

        if (forensicModeEl) {
        syncForensicSlider();
        forensicModeEl.addEventListener('change', () => { syncForensicSlider(); if (currentBitmap) drawBitmap(currentBitmap); });
        forensicLevelEl.addEventListener('input', () => { if (currentBitmap) drawBitmap(currentBitmap); });
        }

        const updateControls = num => {
        pageInputEl.value = num;
        zoomPercentEl.textContent = `${Math.round(scale * 100)}%`;
        document.getElementById('prev-page').disabled = num <= 1;
        document.getElementById('first-page').disabled = num <= 1;
        document.getElementById('next-page').disabled = num >= numPages;
        document.getElementById('last-page').disabled = num >= numPages;
        };

        const renderPage = async num => {
        const seq = ++renderSeq;
        updateControls(num);
        if (!bitmapCache.has(num)) {
        loadingEl.style.opacity = '1';
        loadingEl.style.pointerEvents = 'all';
        }
        try {
        const bmp = await fetchPage(num);
        if (seq !== renderSeq) return; // a newer request superseded this one
        drawBitmap(bmp);
        loadingEl.style.opacity = '0';
        loadingEl.style.pointerEvents = 'none';
        // Prefetch the next page so turning pages feels instant.
        if (num < numPages) fetchPage(num + 1).catch(() => {});
        } catch (err) {
        if (seq !== renderSeq) return;
        console.error('Secure page error:', err);
        if (err.message === 'auth') showError('Session token expired.<br/>Please reload page.');
        else if (err.message === 'notfound') showError('Page not found.');
        else if (err.message === 'rate') showError('Too many page requests.<br/>Please wait a minute.');
        else showError('Could not load this page.<br/>Please reload page.');
        }
        };

        // Redraw only (zoom/rotate) without refetching.
        const queueRenderPage = num => {
        if (num === pageNum && currentBitmap && bitmapCache.get(num) === currentBitmap) {
        drawBitmap(currentBitmap);
        updateControls(num);
        } else {
        renderPage(num);
        }
        };

        const changePage = modifier => {
        if (!numPages) return;
        if (modifier === 'first') pageNum = 1;
        else if (modifier === 'last') pageNum = numPages;
        else if (modifier === 'next' && pageNum < numPages) pageNum++;
        else if (modifier === 'prev' && pageNum > 1) pageNum--;
        renderPage(pageNum);
        };

        const changeZoom = (zoomType) => {
        if (zoomType === 'in') { fitMode = null; scale = Math.min(maxScale, scale + 0.25); }
        else if (zoomType === 'out') { fitMode = null; scale = Math.max(minScale, scale - 0.25); }
        else if (zoomType === 'fit') { fitMode = fitMode === 'page' ? 'width' : 'page'; }
        updateFitButton();
        queueRenderPage(pageNum);
        if (zoomType === 'fit') wrapperEl.scrollTo(0, 0);
        };

        // Keep the fitted page fitted when the window or phone orientation changes.
        let resizeTimer = 0;
        window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(() => {
        sizeContainer();
        if (currentBitmap) queueRenderPage(pageNum);
        }, 120);
        });

        // Live overlay: viewer code + masked email + clock, jumping to a new spot every few seconds.
        const startLiveMark = (code, who) => {
        const tick = () => {
        const now = new Date();
        liveMarkEl.textContent = `${code} · ${who} · ${now.toISOString().slice(0, 16).replace('T', ' ')} UTC`;
        liveMarkEl.style.left = (5 + Math.random() * 55) + '%';
        liveMarkEl.style.top = (5 + Math.random() * 85) + '%';
        };
        tick();
        setInterval(tick, 4000);
        };

        fetch(infoUrl, { credentials: 'same-origin', cache: 'no-store' })
        .then(res => {
        if (!res.ok) throw new Error(String(res.status));
        return res.json();
        })
        .then(info => {
        numPages = info.pageCount;
        pageCountEl.textContent = numPages;
        pageInputEl.max = numPages;
        startLiveMark(info.code, info.who);
        if (info.canPrint) setupPrint(info.maxPrintPages || 1);
        renderPage(pageNum);
        })
        .catch(err => {
        console.error('Secure PDF Fetch Error: ', err);
        const status = err.message;
        if (status === '404') showError('Document file not found on server.<br/>Please contact support.');
        else if (status === '401' || status === '403') showError('Session token expired.<br/>Please reload page.');
        else showError('Could not open document.<br/>Please reload page.');
        });

        document.getElementById('first-page').addEventListener('click', () => changePage('first'));
        document.getElementById('last-page').addEventListener('click', () => changePage('last'));
        document.getElementById('next-page').addEventListener('click', () => changePage('next'));
        document.getElementById('prev-page').addEventListener('click', () => changePage('prev'));
        document.getElementById('zoom-in').addEventListener('click', () => changeZoom('in'));
        document.getElementById('zoom-out').addEventListener('click', () => changeZoom('out'));
        document.getElementById('zoom-fit').addEventListener('click', () => changeZoom('fit'));

        document.getElementById('rotate-pdf').addEventListener('click', () => {
        rotation = (rotation + 90) % 360;
        queueRenderPage(pageNum);
        });

        pageInputEl.addEventListener('change', (e) => {
        let val = parseInt(e.target.value);
        if (val >= 1 && val <= numPages) {
        pageNum = val;
        renderPage(pageNum);
        } else {
        e.target.value = pageNum;
        }
        });

        document.getElementById('fullscreen-toggle').addEventListener('click', () => {
        if (!document.fullscreenElement) {
        containerEl.requestFullscreen().then(() => {
        fsIcon.classList.replace('fa-expand', 'fa-compress');
        }).catch(err => alert('Fullscreen interface block.'));
        } else {
        document.exitFullscreen();
        }
        });

        document.addEventListener('fullscreenchange', () => {
        if (!document.fullscreenElement) { fsIcon.classList.replace('fa-compress', 'fa-expand'); sizeContainer(); }
        setTimeout(() => { if (currentBitmap) queueRenderPage(pageNum); }, 150);
        });

        // Forensic Reveal exists only for staff (the button is not rendered for students).
        let isForensicMode = false;
        const forensicBtn = document.getElementById('forensic-toggle');
        if (forensicBtn) forensicBtn.addEventListener('click', function() {
            isForensicMode = !isForensicMode;
            const span = this.querySelector('span');
            if (isForensicMode) {
                if (isInversionMode) {
                    document.getElementById('dark-mode-toggle').click();
                }
                canvas.style.filter = 'none';
                liveMarkEl.style.visibility = 'hidden';
                this.classList.remove('text-slate-400', 'bg-black/40', 'border-white/5');
                this.classList.add('bg-rose-500', 'text-dark-bg', 'border-rose-500', 'shadow-[0_0_15px_rgba(244,63,94,0.4)]');
                if (span) span.textContent = 'Forensic Active';
                const tools = document.getElementById('forensic-tools');
                if (tools) { tools.classList.remove('hidden'); tools.classList.add('flex'); }
            } else {
                canvas.style.filter = 'none';
                liveMarkEl.style.visibility = '';
                this.classList.add('text-slate-400', 'bg-black/40', 'border-white/5');
                this.classList.remove('bg-rose-500', 'text-dark-bg', 'border-rose-500', 'shadow-[0_0_15px_rgba(244,63,94,0.4)]');
                if (span) span.textContent = 'Forensic Reveal';
                const tools = document.getElementById('forensic-tools');
                if (tools) { tools.classList.add('hidden'); tools.classList.remove('flex'); }
            }
            if (currentBitmap) drawBitmap(currentBitmap);
        });

        let isInversionMode = false;
        document.getElementById('dark-mode-toggle').addEventListener('click', function() {
            if (isForensicMode && forensicBtn) {
                forensicBtn.click();
            }
            isInversionMode = !isInversionMode;
            const icon = this.querySelector('i');

            if (isInversionMode) {
                canvas.style.filter = 'invert(0.88) hue-rotate(180deg) brightness(1.1) contrast(1.1)';
                icon.classList.replace('fa-moon', 'fa-sun');
                icon.classList.add('text-brand-yellow');
            } else {
                canvas.style.filter = 'none';
                icon.classList.replace('fa-sun', 'fa-moon');
                icon.classList.remove('text-brand-yellow');
            }
        });

        // ---- Print -------------------------------------------------------------------------------------
        // The server starts (and logs) a print job and returns a short-lived ticket for those pages; each page is
        // rendered with a stronger watermark and a "Printed by" footer. The pages go into a hidden frame that is
        // printed and then removed. The viewer page itself prints blank (see @@media print above).
        const printUrlStart = '@Url.Action("PdfPrintStart")';
        const printPageUrl = (ticket, n) => '@Url.Action("PdfPrintPage")' + '?token=' + streamToken + '&ticket=' + encodeURIComponent(ticket) + '&page=' + n;
        const printDialog = document.getElementById('print-dialog');
        const printStatus = document.getElementById('print-status');
        const printGo = document.getElementById('print-go');
        let printBusy = false;

        const showPrintDialog = open => {
        printDialog.classList.toggle('hidden', !open);
        printDialog.classList.toggle('flex', open);
        };

        const setupPrint = maxPages => {
        const btn = document.getElementById('print-pdf');
        btn.classList.remove('hidden');
        btn.classList.add('flex');
        document.getElementById('print-limit').textContent = 'Up to ' + maxPages + ' pages per print.';
        // Default paper: Letter in the US/Canada, A4 elsewhere.
        const lang = (navigator.language || '').toLowerCase();
        document.getElementById('print-paper').value = /-(us|ca)$/.test(lang) ? 'Letter' : 'A4';
        btn.addEventListener('click', () => {
        if (printBusy) return;
        document.getElementById('print-from').value = pageNum;
        document.getElementById('print-to').value = Math.min(numPages, pageNum + maxPages - 1);
        document.getElementById('print-from').max = numPages;
        document.getElementById('print-to').max = numPages;
        printStatus.textContent = '';
        showPrintDialog(true);
        });
        };
        document.getElementById('print-cancel').addEventListener('click', () => { if (!printBusy) showPrintDialog(false); });
        ['print-from', 'print-to'].forEach(id => document.getElementById(id).addEventListener('focus', () => {
        document.querySelector('input[name="print-scope"][value="range"]').checked = true;
        }));

        printGo.addEventListener('click', async () => {
        if (printBusy) return;
        const range = document.querySelector('input[name="print-scope"]:checked').value === 'range';
        const from = range ? parseInt(document.getElementById('print-from').value, 10) : pageNum;
        const to = range ? parseInt(document.getElementById('print-to').value, 10) : pageNum;
        if (!(from >= 1 && to >= from && to <= numPages)) { printStatus.textContent = 'Choose pages between 1 and ' + numPages + '.'; return; }

        printBusy = true;
        printGo.disabled = true;
        const urls = [];
        try {
        printStatus.textContent = 'Preparing...';
        const body = new URLSearchParams({ token: decodeURIComponent(streamToken), from: String(from), to: String(to) });
        const af = document.querySelector('input[name="__RequestVerificationToken"]');
        const res = await fetch(printUrlStart, {
        method: 'POST', credentials: 'same-origin', cache: 'no-store', body,
        headers: af ? { 'RequestVerificationToken': af.value } : {}
        });
        let data = null;
        try { data = await res.json(); } catch (e) { }
        if (!res.ok || !data || !data.ticket) throw new Error((data && data.error) || 'Printing is not available right now.');

        for (let n = from; n <= to; n++) {
        printStatus.textContent = 'Preparing page ' + (n - from + 1) + ' of ' + (to - from + 1) + '...';
        const r = await fetch(printPageUrl(data.ticket, n), { credentials: 'same-origin', cache: 'no-store' });
        if (!r.ok) throw new Error('Could not prepare page ' + n + '.');
        urls.push(URL.createObjectURL(await r.blob()));
        }

        printStatus.textContent = 'Opening the print window...';
        const frame = document.createElement('iframe');
        frame.setAttribute('aria-hidden', 'true');
        frame.style.cssText = 'position:fixed;right:0;bottom:0;width:0;height:0;border:0;visibility:hidden;';
        document.body.appendChild(frame);
        const doc = frame.contentDocument;
        doc.open();
        // Fit every page onto the chosen paper (A4 / Letter / Legal), whatever the PDF's own size (e.g. A5):
        // each page sits in a box the size of the printable area and is scaled to fit, centred. Landscape
        // pages get a landscape sheet (CSS named page).
        const PAPER = { A4: [210, 297], Letter: [215.9, 279.4], Legal: [215.9, 355.6] };
        const paperName = document.getElementById('print-paper').value;
        const [pw, ph] = PAPER[paperName] || PAPER.A4;
        const M = 6; // mm margin: most printers cannot print to the very edge
        const css = '@@page{size:' + pw + 'mm ' + ph + 'mm;margin:' + M + 'mm}'
        + '@@page land{size:' + ph + 'mm ' + pw + 'mm;margin:' + M + 'mm}'
        + 'html,body{margin:0;padding:0;background:#fff}'
        + '.pg{width:' + (pw - 2 * M - 0.5) + 'mm;height:' + (ph - 2 * M - 0.5) + 'mm;display:flex;align-items:center;justify-content:center;overflow:hidden;break-after:page;page-break-after:always}'
        + '.pg.land{page:land;width:' + (ph - 2 * M - 0.5) + 'mm;height:' + (pw - 2 * M - 0.5) + 'mm}'
        + '.pg:last-child{break-after:auto;page-break-after:auto}'
        + '.pg img{display:block;max-width:100%;max-height:100%;width:auto;height:auto}';
        doc.write('<!doctype html><html><head><title>Print</title><style>' + css + '</style></head><body></body></html>');
        doc.close();
        await Promise.all(urls.map(u => new Promise(resolve => {
        const box = doc.createElement('div');
        box.className = 'pg';
        const im = doc.createElement('img');
        im.onload = () => { if (im.naturalWidth > im.naturalHeight) box.classList.add('land'); resolve(); };
        im.onerror = resolve;
        im.src = u;
        box.appendChild(im);
        doc.body.appendChild(box);
        })));
        const cleanup = () => { setTimeout(() => { frame.remove(); urls.forEach(u => URL.revokeObjectURL(u)); }, 1000); };
        frame.contentWindow.addEventListener('afterprint', cleanup);
        showPrintDialog(false);
        frame.contentWindow.focus();
        frame.contentWindow.print();
        setTimeout(cleanup, 120000); // safety net if afterprint never fires
        } catch (err) {
        urls.forEach(u => URL.revokeObjectURL(u));
        printStatus.textContent = err.message || 'Printing failed.';
        } finally {
        printBusy = false;
        printGo.disabled = false;
        }
        });

        // Anti-Exploit Security Engine hooks
        document.addEventListener('keydown', e => {
        if (e.key === 'ArrowRight') changePage('prev');
        if (e.key === 'ArrowLeft') changePage('next');
        if (e.key === '+' || e.key === '=') changeZoom('in');
        if (e.key === '-') changeZoom('out');

        if (e.ctrlKey && ['p', 'P', 's', 'S', 'c', 'C', 'u', 'U'].includes(e.key)) {
        e.preventDefault();
        }
        if (e.key === 'F12' || (e.ctrlKey && e.shiftKey && ['I', 'J', 'C'].includes(e.key.toUpperCase()))) {
        e.preventDefault();
        window.location.replace(backUrl);
        }
        });

        // (A window-size check used to sit here; it also threw out students using browser zoom or a side panel.)
        setInterval(function() {
        const before = new Date().getTime();
        debugger;
        const after = new Date().getTime();
        if (after - before > 100) {
        window.location.replace(backUrl);
        }
        }, 1500);
    </script>
}