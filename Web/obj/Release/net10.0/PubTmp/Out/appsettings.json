    // Explanation: Text displayed on video
    // مثال: "OmanPharmaAcademy" به‌عنوان علامت تشخیص
    // Example: "OmanPharmaAcademy" as identification mark
    // ============================================
    // 4️⃣ حفاظت پیشرفته - Advanced Protection
    // ============================================
    "AdvancedProtection": {
      // --- تفعیل/غیرفعال‌کردن ماژول‌ها ---
