  // 🛡️ مدیریت نشست همزمان و جلوگیری از اشتراک‌گذاری اکانت (SQL Server + EF Core)
  // Concurrent Session Management & Anti-Account-Sharing (SQL Server + EF Core-backed; no external cache)
  // ═══════════════════════════════════════════════════════════════
  "SessionSecurity": {
    // حداکثر تعداد ورود همزمان مجاز برای هر کاربر (جلوگیری از اشتراک‌گذاری اکانت)
    // Maximum concurrent logins allowed per user; the oldest/least-active session is evicted beyond this
    "MaxConcurrentLogins": 2,
    // مدت اعتبار نشست به ساعت (Sliding) از آخرین فعالیت معتبر کاربر
    // Sliding session lifetime in hours, renewed on every validated request
    "SessionExpirationHours": 12,
    // آستانه سرعت (کیلومتر بر ساعت) برای تشخیص «سفر غیرممکن» بین دو ورود متوالی
    // Speed threshold (km/h) for Impossible-Travel detection between two consecutive logins
    "ImpossibleTravelSpeedThresholdKmH": 800,
    // حداقل فاصله (کیلومتر) قبل از در نظر گرفتن سناریوی سفر غیرممکن (کاهش نویز IP های نزدیک به هم)
    // Minimum distance (km) before the impossible-travel heuristic is evaluated (reduces same-metro IP noise)
    "MinimumDistanceKmForEvaluation": 50,
    // مدت نگهداری آخرین موقعیت ورود کاربر در SQL Server برای مقایسه‌های بعدی (روز)
    // Retention period (days) for the user's last known login location, used by future evaluations
    "LastKnownLocationRetentionDays": 30,
    // قفل سخت‌گیرانه IP/Fingerprint؛ در صورت true هر تغییر IP یا اثر انگشت دستگاه بلافاصله نشست را باطل می‌کند
    // Strict IP/Fingerprint binding; when true, any mid-session change immediately invalidates the session
    "EnableStrictIpLocking": false,
    // فاصله زمانی (دقیقه) بین اجرای پاکسازی خودکار نشست‌های منقضی و اسنپ‌شات‌های قدیمی موقعیت مکانی
    // Interval (minutes) between automatic cleanup sweeps of expired sessions and stale location snapshots
    "CleanupIntervalMinutes": 30
  },
