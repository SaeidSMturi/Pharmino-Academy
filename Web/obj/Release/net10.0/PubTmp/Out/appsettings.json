        // Explanation: Maximum suspicion score
        // مثال: نمره 0-100
        // Example: Score ranges from 0-100
        "BlockThreshold": 85,
        // توضیح: نمره‌ای که جریان کاملاً قطع می‌شود (افزایش از 70 به 85)
        // Explanation: Score at which stream is completely blocked (increased from 70 to 85)
        // اگر نمره ≥ 85: قطع فوری
        // If score ≥ 85: Immediate blocking
        // ⚠️ PRODUCTION: این مقدار در کد override می‌شود
        // ⚠️ PRODUCTION: This value is overridden in code
        "ThrottleThreshold": 70,
        // توضیح: نمره‌ای که سرعت کاهش می‌یابد (افزایش از 50 به 70)
        // Explanation: Score at which bandwidth is throttled (increased from 50 to 70)
        // اگر نمره ≥ 70: سرعت به 256 KB/s
        // If score ≥ 70: Bandwidth reduced to 256 KB/s
        // ⚠️ PRODUCTION: این مقدار در کد override می‌شود
