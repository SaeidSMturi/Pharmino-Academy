      // Explanation: Analyze user behavior to identify downloaders
      // عمل‌کرد: تتبع سرعت، الگوهای دسترسی، و رفتار نامعمول
      // Function: Track speed, access patterns, and unusual behavior
      "EnablePlayerHeartbeat": true,
      // توضیح: نظارت بر فعالیت پخش‌کننده
      // Explanation: Monitor player activity
      // عمل‌کرد: اگر heartbeat دریافت نشود، جریان قطع می‌شود
      // Function: If no heartbeat received, stream is terminated
      // هدف: جلوگیری از دانلود‌کنندگان خودکار (IDM، wget)
      // Purpose: Prevent automated downloaders (IDM, wget)
      "EnableBandwidthThrottling": true,
      // توضیح: کاهش سرعت برای رفتارهای مشکوک
