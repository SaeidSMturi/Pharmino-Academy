        "ThrottleOnSuspicion": true,
        // توضیح: کاهش خودکار سرعت در صورت رفتار مشکوک
        // Explanation: Automatically reduce speed if suspicious behavior
        // هدف: تثبیط دانلود‌کنندگان بدون قطع فوری
        // Purpose: Deter downloaders without immediate blocking
        "SuspicionThrottleKBps": 256
        // توضیح: سرعت مسدود‌سازی برای افراد مشکوک
        // Explanation: Throttled speed for suspicious users
        // مثال: 256 KB/s ≈ 0.25 MB/s (بسیار ناامیدکننده)
        // Example: 256 KB/s ≈ 0.25 MB/s (very discouraging)
      },
      // ============================================
      // 7️⃣ شناسایی الگو - Pattern Detection
      // ============================================
      // هدف: تشخیص رفتارهای دانلود‌کننده‌ای خودکار
      // Purpose: Detect automated downloader behavior
      "PatternDetection": {
        "MaxSeekPerMinute": 10,
        // توضیح: حداکثر تعداد جستجوها در دقیقه (معمول برای کاربر)
        // Explanation: Max seeks per minute (normal for user)
        // مثال: کاربر معمولی حدود 5-10 بار در دقیقه می‌جستجو کند
        // Example: Normal user seeks 5-10 times per minute
        // اگر بیشتر بود: علامت دانلود‌کننده خودکار
        // If more: Sign of automated downloader
        "MaxPauseResumePerMinute": 8,
        // توضیح: حداکثر تعداد توقف/ادامه در دقیقه
        // Explanation: Max pause/resume actions per minute
        // هدف: تشخیص رفتار غیرطبیعی
        // Purpose: Detect unnatural behavior
        "MinWatchTimePercentage": 30,
        // توضیح: حداقل درصد زمان تماشا نسبت به کل جلسه
