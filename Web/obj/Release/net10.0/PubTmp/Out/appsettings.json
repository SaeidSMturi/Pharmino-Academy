    // Explanation: Domains allowed to access videos
    // هدف: جلوگیری از درخواست‌های Cross-Origin
    // Purpose: Prevent cross-origin requests
    "MaxConcurrentStreams": 2,
    // توضیح: حداکثر تعداد جریان‌های همزمان در هر کاربر
    // Explanation: Maximum concurrent streams per user
    // مثال: کاربر نمی‌تواند بیش از 2 ویدیو را به‌طور همزمان تماشا کند
