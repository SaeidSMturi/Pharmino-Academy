        // مثال: اگر کاربر 30 دقیقه جلسه داشت باید حداقل 9 دقیقه ببیند
        // Example: If session is 30 min, user must watch at least 9 min
        // اگر کمتر بود: علامت دانلود بدون تماشا
        // If less: Sign of downloading without watching
        "MaxSkipPercentage": 70,
        // توضیح: حداکثر درصد قسمت‌های رد‌شده
        // Explanation: Max percentage of skipped portions
        // مثال: اگر 70% از ویدیو رد شود = مشکوک
        // Example: If 70% of video skipped = suspicious
        "DetectSequentialDownload": true,
        // توضیح: شناسایی دانلود ترتیبی (از اول تا آخر)
