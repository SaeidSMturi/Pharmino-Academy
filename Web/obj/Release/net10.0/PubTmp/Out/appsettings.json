      // 6️⃣ تنظیمات Bandwidth - Bandwidth Settings
      // ============================================
      // هدف: کنترل سرعت دانلود برای محدود‌کردن نامشروعین
      // Purpose: Control download speed to limit unauthorized users
      "BandwidthSettings": {
        "InitialBandwidthKBps": 1500,
