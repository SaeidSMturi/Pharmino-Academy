    // ⚠️ Critical: Must be changed in Production environment
    "TokenExpirationMinutes": 60,
    // توضیح: مدت زمان اعتبار توکن دسترسی (دقیقه)
    // Explanation: Duration of access token validity (minutes)
    // مثال: توکن پس از 60 دقیقه منقضی می‌شود
    // Example: Token expires after 60 minutes
    // ============================================
    // 2️⃣ محدودیت‌های دسترسی - Access Restrictions
    // ============================================
