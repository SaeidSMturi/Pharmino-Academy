        // Example: 1500 KB/s ≈ 1.5 MB/s (for initial buffering)
        "MaxBandwidthKBps": 2500,
        // توضیح: حداکثر سرعت برای کاربران معتبر
        // Explanation: Maximum speed for legitimate users
