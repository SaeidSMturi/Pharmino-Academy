@model Domain.Entities.Course.PaymentTransaction
@{
    ViewData["Title"] = "PayPal Payment Simulator";
}

<div class="min-h-screen flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8 relative overflow-hidden">
    <div class="max-w-xl w-full space-y-8 bg-white/5 backdrop-blur-xl border border-white/10 p-8 md:p-10 rounded-3xl shadow-2xl relative z-10">

        <div class="absolute -top-10 -left-10 w-40 h-40 bg-[#0070ba]/30 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-10 -right-10 w-40 h-40 bg-yellow-500/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="text-center relative z-10">
            <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-[#0070ba]/10 text-[#0070ba] border border-[#0070ba]/30 mb-4 shadow-[0_0_15px_rgba(0,112,186,0.3)] animate-pulse">
                <i class="fab fa-paypal text-4xl"></i>
            </div>
            <h2 class="text-2xl font-extrabold text-white">PayPal Payment Simulator</h2>
            <p class="mt-2 text-sm text-gray-300">Simulating a secure transaction in a demo environment</p>
        </div>

        <div class="mt-8 space-y-6 relative z-10">
            <div class="bg-black/30 border border-white/10 rounded-2xl p-6 space-y-4 text-left" dir="ltr">
                <div class="flex justify-between items-center border-b border-white/10 pb-3">
                    <span class="text-gray-400 text-sm">Course Title:</span>
                    <span class="text-white font-bold text-base">@Model.Course.Title</span>
                </div>
                <div class="flex justify-between items-center border-b border-white/10 pb-3">
                    <span class="text-gray-400 text-sm">Transaction Amount:</span>
                    <span class="text-yellow-400 font-extrabold text-lg">@Model.Amount.ToString("N0") @Model.Currency</span>
                </div>
                <div class="flex justify-between items-center border-b border-white/10 pb-3">
                    <span class="text-gray-400 text-sm">Payment Token:</span>
                    <span class="text-gray-300 font-mono text-xs">@Model.OrderToken</span>
                </div>
                <div class="flex justify-between items-center">
                    <span class="text-gray-400 text-sm">Current Status:</span>
                    <span class="px-3 py-1 rounded-full text-xs font-semibold bg-yellow-500/10 text-yellow-400 border border-yellow-500/30">@Model.Status</span>
                </div>
            </div>

            <div class="flex flex-col gap-4">
                <a href="/Payment/PayPalCallback?token=@Model.OrderToken&courseId=@Model.CourseId"
                   class="flex items-center justify-center w-full px-6 py-4 rounded-2xl bg-gradient-to-r from-[#2ecc71] to-[#27ae60] hover:from-[#27ae60] hover:to-[#219653] text-white font-bold text-base transition-all duration-300 transform hover:-translate-y-1 shadow-[0_4px_15px_rgba(46,204,113,0.4)] text-center">
                    <i class="fas fa-check-circle mr-2"></i>
                    Complete and Simulate Successful Payment
                </a>

                <a href="/Payment/PayPalCancel?token=@Model.OrderToken&courseId=@Model.CourseId"
                   class="flex items-center justify-center w-full px-6 py-4 rounded-2xl bg-transparent border border-red-500/50 hover:bg-red-500/10 text-red-400 font-medium text-base transition-all duration-300 transform hover:-translate-y-1 text-center">
                    <i class="fas fa-times-circle mr-2"></i>
                    Cancel Payment and Return
                </a>
            </div>
        </div>
    </div>
</div>