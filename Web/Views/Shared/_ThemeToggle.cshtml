<button type="button" 
        class="theme-toggle-btn" 
        onclick="toggleTheme()" 
        aria-label="Toggle theme" 
        title="Toggle Light / Dark Mode">
    <i class="fas fa-sun theme-icon-sun" aria-hidden="true"></i>
    <i class="fas fa-moon theme-icon-moon" aria-hidden="true"></i>
</button>
