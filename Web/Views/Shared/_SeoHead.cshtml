@using Application.Interfaces
@using Web.Seo
@inject ISeoService SeoService
@inject Microsoft.Extensions.Configuration.IConfiguration Config

@{
    var rawPath = Context.Request.Path.Value ?? "/";
    var path = SeoSite.CanonicalPath(rawPath);
    var lang = SeoSite.CurrentLang;
    var isArabic = lang == "ar";
    var isFarsi = lang == "fa";
    var baseUrl = SeoSite.BaseUrl(Context);
    var brand = SeoSite.BrandName(lang);

    // 1. Defaults (pages override these through ViewData)
    var defaultTitle = isFarsi
        ? "آمادگی آزمون لایسنس داروسازی عمان و کشورهای خلیج فارس"
        : (isArabic ? "التحضير لامتحان ترخيص الصيادلة في عُمان والخليج" : "Pharmacist Licensing Exam Preparation for Oman & the Gulf");
    var defaultMetaDescription = isFarsi
        ? "آمادگی آنلاین آزمون لایسنس داروسازی عمان (OMSB / Pearson VUE) و خلیج فارس: ویدیو، جزوه و آزمون تمرینی از داروسازی که خودش قبول شده است."
        : (isArabic
            ? "تحضير أونلاين لامتحان ترخيص الصيادلة في عُمان (OMSB / Pearson VUE) والخليج: فيديوهات وملفات PDF واختبارات تدريبية من صيدلي اجتاز الامتحان."
            : "Online prep for the Oman pharmacist exam (OMSB / Pearson VUE) and Gulf licensing: video lessons, PDFs and practice exams from a pharmacist who passed.");
    var defaultMetaKeywords = isFarsi
        ? "آزمون داروسازی عمان, آزمون OMSB, Pearson VUE داروسازی, لایسنس داروسازی خلیج فارس, آمادگی آزمون داروسازی, داروسازی بالینی"
        : (isArabic
            ? "امتحان الصيدلة عمان, امتحان OMSB للصيادلة, بيرسون فيو صيدلة, ترخيص الصيادلة الخليج, التحضير لامتحان الصيدلة, صيادلة مصر"
            : "Oman pharmacist exam, OMSB pharmacy exam, Pearson VUE pharmacy exam, Gulf pharmacist licensing, pharmacy exam preparation, pharmacist jobs Oman, pharmacists from India, pharmacists from Pakistan, Egyptian pharmacists");

    var title = ViewData["SeoTitle"]?.ToString() ?? ViewData["Title"]?.ToString() ?? defaultTitle;
    var metaDescription = ViewData["MetaDescription"]?.ToString() ?? defaultMetaDescription;
    var metaKeywords = ViewData["MetaKeywords"]?.ToString() ?? defaultMetaKeywords;
    var noIndexPath = SeoSite.IsNoIndexPath(path);
    var metaRobots = ViewData["MetaRobots"]?.ToString()
        ?? (noIndexPath ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1");
    var defaultCanonical = SeoSite.LocalizedUrl(baseUrl, path, lang);
    var canonicalUrl = SeoSite.ResolveCanonical(baseUrl, ViewData["CanonicalUrl"]?.ToString(), defaultCanonical);
    var ogImage = ViewData["OgImage"]?.ToString() ?? $"{baseUrl}/images/og-default.png";
    var ogType = ViewData["OgType"]?.ToString() ?? "website";
    var jsonLd = ViewData["JsonLd"]?.ToString();
    string? ogTitle = null;
    string? ogDescription = null;

    // 2. Admin overrides for this path (Admin > SEO > Page SEO)
    var customPageSeo = await SeoService.GetPageSeoByPathAsync(rawPath);
    if (customPageSeo != null && customPageSeo.IsActive)
    {
        if (!string.IsNullOrWhiteSpace(customPageSeo.Title)) title = customPageSeo.Title;
        if (!string.IsNullOrWhiteSpace(customPageSeo.MetaDescription)) metaDescription = customPageSeo.MetaDescription;
        if (!string.IsNullOrWhiteSpace(customPageSeo.MetaKeywords)) metaKeywords = customPageSeo.MetaKeywords;
        if (!string.IsNullOrWhiteSpace(customPageSeo.MetaRobots)) metaRobots = customPageSeo.MetaRobots;
        if (!string.IsNullOrWhiteSpace(customPageSeo.CanonicalUrl)) canonicalUrl = SeoSite.ResolveCanonical(baseUrl, customPageSeo.CanonicalUrl, canonicalUrl);
        if (!string.IsNullOrWhiteSpace(customPageSeo.OgTitle)) ogTitle = customPageSeo.OgTitle;
        if (!string.IsNullOrWhiteSpace(customPageSeo.OgDescription)) ogDescription = customPageSeo.OgDescription;
        if (!string.IsNullOrWhiteSpace(customPageSeo.OgImage)) ogImage = customPageSeo.OgImage;
        if (!string.IsNullOrWhiteSpace(customPageSeo.OgType)) ogType = customPageSeo.OgType;
        if (!string.IsNullOrWhiteSpace(customPageSeo.JsonLd)) jsonLd = customPageSeo.JsonLd;
    }

    // Search engines show at most ~160 characters; trim longer text at a word boundary.
    metaDescription = SeoSite.FitDescription(metaDescription);

    var fullTitle = title.Contains(brand, StringComparison.OrdinalIgnoreCase) || title.Contains("Pharmino", StringComparison.OrdinalIgnoreCase)
        ? title
        : $"{title} | {brand}";
    ogTitle ??= fullTitle;
    ogDescription ??= metaDescription;
    var indexable = !metaRobots.Contains("noindex", StringComparison.OrdinalIgnoreCase);

    var googleVerification = Config["Seo:GoogleSiteVerification"];
    var bingVerification = Config["Seo:BingSiteVerification"];
    var yandexVerification = Config["Seo:YandexVerification"];
    var sameAs = Config.GetSection("Seo:SameAs").Get<string[]>() ?? Array.Empty<string>();

    // Site-wide entity graph: who the academy is, where it serves, and the site search target.
    var orgJson = System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, object>
    {
        ["@context"] = "https://schema.org",
        ["@graph"] = new object[]
        {
            new Dictionary<string, object>
            {
                ["@type"] = "EducationalOrganization",
                ["@id"] = $"{baseUrl}/#organization",
                ["name"] = "Pharmino Academy",
                ["alternateName"] = new[] { "أكاديمية فارمينو", "آکادمی فارمینو", "PharminoAcademy" },
                ["url"] = baseUrl + "/",
                ["logo"] = $"{baseUrl}/images/logo.png",
                ["image"] = $"{baseUrl}/images/og-default.png",
                ["description"] = defaultMetaDescription,
                ["areaServed"] = SeoSite.AreaServed.Select(c => new Dictionary<string, object> { ["@type"] = "Country", ["name"] = c }).ToArray(),
                ["knowsAbout"] = new[] { "Pharmacy licensing exams", "OMSB pharmacist exam", "Pearson VUE pharmacy exam", "Clinical pharmacy", "Pharmacology", "Pharmaceutical calculations" },
                ["sameAs"] = sameAs
            },
            new Dictionary<string, object>
            {
                ["@type"] = "WebSite",
                ["@id"] = $"{baseUrl}/#website",
                ["url"] = baseUrl + "/",
                ["name"] = "Pharmino Academy",
                ["inLanguage"] = new[] { "en", "ar", "fa" },
                ["publisher"] = new Dictionary<string, object> { ["@id"] = $"{baseUrl}/#organization" }
            }
        }
    });
}

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>@fullTitle</title>
<meta name="description" content="@metaDescription">
<meta name="keywords" content="@metaKeywords">
<meta name="robots" content="@metaRobots">
<meta name="author" content="Pharmino Academy">
<meta name="application-name" content="@brand">
<meta name="theme-color" content="#0a0f1c">
<link rel="canonical" href="@canonicalUrl" />
<partial name="_Favicons" />
@if (!string.IsNullOrWhiteSpace(googleVerification))
{
    <meta name="google-site-verification" content="@googleVerification" />
}
@if (!string.IsNullOrWhiteSpace(bingVerification))
{
    <meta name="msvalidate.01" content="@bingVerification" />
}
@if (!string.IsNullOrWhiteSpace(yandexVerification))
{
    <meta name="yandex-verification" content="@yandexVerification" />
}

@if (indexable && ViewData["NoHreflang"] == null)
{
    @* Language versions of this page: tells Google which URL to show to Arabic, Farsi and English searchers in each region. *@
    foreach (var l in SeoSite.Cultures)
    {
        <link rel="alternate" hreflang="@l" href="@SeoSite.LocalizedUrl(baseUrl, path, l)" />
    }
    foreach (var code in SeoSite.RegionalEnglish)
    {
        <link rel="alternate" hreflang="@code" href="@SeoSite.LocalizedUrl(baseUrl, path, "en")" />
    }
    foreach (var code in SeoSite.RegionalArabic)
    {
        <link rel="alternate" hreflang="@code" href="@SeoSite.LocalizedUrl(baseUrl, path, "ar")" />
    }
    <link rel="alternate" hreflang="x-default" href="@SeoSite.LocalizedUrl(baseUrl, path, "en")" />
}

<!-- Open Graph / Facebook / LinkedIn / WhatsApp / Telegram -->
<meta property="og:type" content="@ogType">
<meta property="og:url" content="@canonicalUrl">
<meta property="og:title" content="@ogTitle">
<meta property="og:description" content="@ogDescription">
<meta property="og:image" content="@ogImage">
<meta property="og:image:alt" content="@brand">
<meta property="og:site_name" content="@brand">
<meta property="og:locale" content="@SeoSite.OgLocale(lang)">
@foreach (var l in SeoSite.Cultures.Where(c => c != lang))
{
    <meta property="og:locale:alternate" content="@SeoSite.OgLocale(l)">
}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:url" content="@canonicalUrl">
<meta name="twitter:title" content="@ogTitle">
<meta name="twitter:description" content="@ogDescription">
<meta name="twitter:image" content="@ogImage">

@if (indexable)
{
    <script type="application/ld+json">@Html.Raw(orgJson)</script>
}
@if (!string.IsNullOrWhiteSpace(jsonLd))
{
    <script type="application/ld+json">
        @Html.Raw(jsonLd)
    </script>
}
