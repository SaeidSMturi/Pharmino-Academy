@*
    Animated site background (wwwroot/js/theme-shader-bg.js): 21st.dev "Gradient Wave" (matte, blurred) in light
    mode, 21st.dev "Beams Background" in dark mode. Include once per page, inside <head>.
*@
<style>
    #pa-shader-bg,
    #pa-beams-bg {
        position: fixed;
        inset: 0;
        width: 100vw;
        height: 100vh;
        z-index: -1;
        pointer-events: none;
        display: block;
    }
    /* Light: a layer of blur over the matte wave. Slightly enlarged so the blurred edges never show. */
    html.pa-bg-light #pa-shader-bg {
        filter: blur(22px);
        transform: scale(1.08);
    }
    /* Dark: the beams canvas carries the component's own 15px blur and near-black background. */
    #pa-beams-bg {
        background: #0a0a0a;
        filter: blur(15px);
        transform: scale(1.06);
    }
    /* Behind the canvases (only ever visible at a blurred edge): match each scene. */
    html.pa-has-shader-bg.pa-bg-dark { background-color: #0a0a0a !important; }
    html.pa-has-shader-bg.pa-bg-light { background-color: #e6f6fd !important; }
    /* Let the shader show through the page's own flat background colours. */
    html.pa-has-shader-bg,
    html.pa-has-shader-bg body {
        background: transparent !important;
        background-image: none !important;
    }
    /* Dark background has bright blue areas: keep text that sits directly on it readable. */
    html.pa-bg-dark .text-glow-cool {
        background: linear-gradient(90deg, #7ff0ff, #d6ecff) !important;
        -webkit-background-clip: text !important;
        background-clip: text !important;
        -webkit-text-fill-color: transparent !important;
    }
    html.pa-bg-dark .text-custom-snow\/70,
    html.pa-bg-dark .text-custom-snow\/60,
    html.pa-bg-dark .text-custom-snow\/50,
    html.pa-bg-dark .pa-onbg {
        color: #e8eefa !important;
        text-shadow: 0 1px 10px rgba(0, 0, 0, .65);
    }
</style>
<script src="~/js/theme-shader-bg.js" asp-append-version="true" defer></script>
