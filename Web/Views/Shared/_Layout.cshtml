@using System.Security.Claims
@using Application.Interfaces
@using Microsoft.AspNetCore.Mvc.Localization
@inject IPermissionService _permissionService
@inject IViewLocalizer Localizer

@{
    var userIdClaim = User.FindFirst(ClaimTypes.NameIdentifier);
    var currentUserId = userIdClaim != null ? int.Parse(userIdClaim.Value) : 0;
    var canViewDashboard = await _permissionService.UserHasPermissionAsync(currentUserId, "Dashboard.View");
    
    var currentCulture = System.Globalization.CultureInfo.CurrentCulture.Name;
    var isRtl = System.Globalization.CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
}

<!DOCTYPE html>
<html lang="@currentCulture" dir="@(isRtl ? "rtl" : "ltr")">
<head>
    <script>
        (function () {
            try {
                var theme = localStorage.getItem('pharmino_theme') || 'dark';
                document.documentElement.setAttribute('data-theme', theme);
                if (theme === 'light') {
                    document.documentElement.classList.add('light', 'light-theme');
                } else {
                    document.documentElement.classList.add('dark', 'dark-theme');
                }
            } catch (e) { }
        })();
    </script>
    <partial name="_SeoHead" />


    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <script src="~/css/tailwind.min.css"></script>
    <script src="~/js/marked.min.js"></script>
    <link rel="stylesheet" href="~/css/Style.css" />
    <link rel="stylesheet" href="~/css/theme.css" />
    @if (isRtl)
    {
        <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
        <style>
            body, h1, h2, h3, h4, h5, h6, p, a, span, button, input, select, textarea, div {
                font-family: 'Cairo', sans-serif !important;
            }
        </style>
    }
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="antialiased font-sans overflow-x-hidden">

    <div id="preloader">
        <div class="loader-ring"></div>
    </div>

    <div class="fixed inset-0 pointer-events-none z-[-1] overflow-hidden">
        <div class="absolute top-1/4 left-5 w-80 h-80 bg-custom-gold/10 rounded-full mix-blend-screen filter blur-[120px] animate-blob-1"></div>
        <div class="absolute bottom-1/3 right-5 w-96 h-96 bg-custom-navy/20 rounded-full mix-blend-screen filter blur-[140px] animate-blob-2"></div>
    </div>

    <header id="header-wrapper" class="fixed top-6 left-0 right-0 z-50 flex justify-center px-4 transition-all duration-500 ease-in-out">
        <div id="header-container" class="w-full max-w-6xl px-5 py-3 rounded-full bg-custom-dark/60 backdrop-blur-xl shadow-[0_8px_32px_rgba(18,60,118,0.3)] flex justify-between items-center transition-all duration-500 ease-in-out border border-custom-gold/20 relative">

            <div class="text-xl font-extrabold tracking-tight z-10">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="flex items-center gap-3 group">
                    <div class="relative w-10 h-10 flex items-center justify-center">
                        <div class="absolute inset-0 rounded-full bg-custom-navy blur-md opacity-50 group-hover:opacity-80 transition-opacity duration-300"></div>
                        <div class="relative w-full h-full rounded-full bg-gradient-to-br from-custom-navy to-[#1a5099] border border-custom-gold/30 flex items-center justify-center text-custom-gold group-hover:scale-105 transition-transform duration-300 shadow-inner">
                            <i class="fas fa-prescription-bottle-medical text-sm"></i>
                        </div>
                    </div>
                    <span class="text-custom-snow text-lg font-black tracking-wide group-hover:text-custom-gold transition-colors duration-300"><setting key="Site Name"></setting></span>
                </a>
            </div>

            <nav class="hidden lg:flex items-center space-x-2 text-sm font-medium z-10">
                <a asp-area="" asp-controller="Courses" asp-action="Index" class="relative group px-5 py-2 text-custom-snow/80 hover:text-custom-gold transition-colors duration-300 rounded-full">
                    <span class="relative z-10">@Localizer["Courses"]</span>
                    <div class="absolute inset-0 h-full w-full bg-custom-navy/40 rounded-full scale-75 opacity-0 group-hover:scale-100 group-hover:opacity-100 transition-all duration-300"></div>
                </a>
                <a href="/Home/Index#about" class="relative group px-5 py-2 text-custom-snow/80 hover:text-custom-gold transition-colors duration-300 rounded-full">
                    <span class="relative z-10">@Localizer["About"]</span>
                    <div class="absolute inset-0 h-full w-full bg-custom-navy/40 rounded-full scale-75 opacity-0 group-hover:scale-100 group-hover:opacity-100 transition-all duration-300"></div>
                </a>
                <a href="/Home/Index#features" class="relative group px-5 py-2 text-custom-snow/80 hover:text-custom-gold transition-colors duration-300 rounded-full">
                    <span class="relative z-10">@Localizer["Features"]</span>
                    <div class="absolute inset-0 h-full w-full bg-custom-navy/40 rounded-full scale-75 opacity-0 group-hover:scale-100 group-hover:opacity-100 transition-all duration-300"></div>
                </a>
                <a href="/Home/Index#contact" class="relative group px-5 py-2 text-custom-snow/80 hover:text-custom-gold transition-colors duration-300 rounded-full">
                    <span class="relative z-10">@Localizer["Contact"]</span>
                    <div class="absolute inset-0 h-full w-full bg-custom-navy/40 rounded-full scale-75 opacity-0 group-hover:scale-100 group-hover:opacity-100 transition-all duration-300"></div>
                </a>
            </nav>

            <div class="hidden lg:flex items-center gap-3 z-10">
                <partial name="_ThemeToggle" />
                <partial name="_LanguageSwitcher" />

                @if (User.Identity.IsAuthenticated)
                {
                    <div class="relative">
                        <button id="user-menu-button" class="flex items-center gap-3 font-semibold bg-custom-navy/20 hover:bg-custom-navy/40 px-4 py-2 rounded-full transition-all duration-300 border border-custom-gold/20 hover:border-custom-gold/50">
                            <div class="w-8 h-8 rounded-full bg-custom-gold text-custom-navy flex items-center justify-center font-bold text-sm shadow-[0_0_10px_rgba(225,215,136,0.3)]">
                                @(User.FindFirst("FirstName")?.Value?.FirstOrDefault() ?? 'U')
                            </div>
                            <span class="text-custom-snow text-sm">@User.FindFirst("FirstName")?.Value</span>
                            <i class="fas fa-chevron-down text-custom-gold/70 text-[10px] transition-transform duration-300" id="user-arrow"></i>
                        </button>

                        <div id="user-menu" class="absolute right-0 mt-4 w-64 rounded-2xl bg-black/20 backdrop-blur-2xl shadow-[0_20px_50px_rgba(0,0,0,0.8)] border border-custom-gold/20 hidden z-50 overflow-hidden transform opacity-0 scale-95 transition-all duration-300 origin-top-right">
                            <div class="absolute inset-0 bg-custom-dark/60 backdrop-blur-2xl rounded-2xl shadow-[0_20px_50px_rgba(0,0,0,0.8)] border border-custom-gold/20"></div>

                            <div class="relative z-10 rounded-2xl overflow-hidden flex flex-col">
                                <div class="p-5 border-b border-white/5 bg-gradient-to-br from-custom-navy/30 to-transparent relative z-10">
                                    <p class="text-base text-custom-snow font-bold">@User.FindFirst("FirstName")?.Value</p>
                                    <p class="text-xs text-custom-gold mt-1 truncate tracking-wider uppercase">@Localizer["StudentAccount"]</p>
                                </div>

                                <div class="py-2">
                                    <a asp-area="User" asp-controller="Dashboard" asp-action="Index" class="flex items-center gap-3 px-5 py-3 text-sm text-custom-snow hover:bg-custom-navy/30 hover:text-custom-gold transition-colors duration-200">
                                        <i class="fas fa-chart-pie w-4"></i> @Localizer["Dashboard"]
                                    </a>
                                    <a asp-area="User" asp-controller="Courses" asp-action="Index" class="flex items-center gap-3 px-5 py-3 text-sm text-custom-snow hover:bg-custom-navy/30 hover:text-custom-gold transition-colors duration-200">
                                        <i class="fas fa-book-open w-4"></i> @Localizer["MyCourses"]
                                    </a>

                                    @if (canViewDashboard)
                                    {
                                        <div class="h-px bg-white/5 my-1 mx-4"></div>
                                        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="flex items-center gap-3 px-5 py-3 text-sm text-custom-snow hover:bg-custom-navy/30 hover:text-custom-gold transition-colors duration-200">
                                            <i class="fas fa-shield-halved w-4"></i> @Localizer["AdminPanel"]
                                        </a>
                                    }

                                    <div class="h-px bg-white/5 my-1 mx-4"></div>

                                    <a asp-area="User" asp-controller="Profile" asp-action="EditProfile" class="flex items-center gap-3 px-5 py-3 text-sm text-custom-snow hover:bg-custom-navy/30 hover:text-custom-gold transition-colors duration-200">
                                        <i class="fas fa-user-pen w-4"></i> @Localizer["ProfileSettings"]
                                    </a>
                                    <a asp-area="User" asp-controller="Settings" asp-action="Index" class="flex items-center gap-3 px-5 py-3 text-sm text-custom-snow hover:bg-custom-navy/30 hover:text-custom-gold transition-colors duration-200">
                                        <i class="fas fa-cog w-4"></i> @Localizer["AccountSettings"]
                                    </a>

                                    <div class="h-px bg-white/5 my-1 mx-4"></div>

                                    <a asp-area="" asp-controller="Account" asp-action="Logout" class="flex items-center gap-3 px-5 py-3 text-sm text-[#ff6b6b] hover:bg-[#ff6b6b]/10 transition-colors duration-200 group">
                                        <i class="fas fa-right-from-bracket w-4 group-hover:-translate-x-1 transition-transform"></i> @Localizer["Logout"]
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <a asp-area="" asp-controller="Account" asp-action="Login" class="font-semibold text-sm text-custom-snow hover:text-custom-gold transition-all duration-300 px-2">
                        @Localizer["Login"]
                    </a>
                    <a asp-area="" asp-controller="Account" asp-action="Register" class="relative group px-6 py-2.5 rounded-full overflow-hidden font-bold text-sm text-custom-navy bg-custom-gold transition-all duration-300 shadow-[0_0_15px_rgba(225,215,136,0.2)] hover:shadow-[0_0_25px_rgba(225,215,136,0.4)] transform hover:-translate-y-0.5 border border-custom-gold">
                        <span class="relative z-10">@Localizer["SignUp"]</span>
                        <div class="absolute inset-0 w-full h-full bg-white/20 transform scale-x-0 group-hover:scale-x-100 transition-transform origin-left duration-300"></div>
                    </a>
                }
            </div>

            <div class="lg:hidden z-10">
                <button id="mobile-menu-button" class="w-10 h-10 rounded-full bg-custom-navy/20 border border-custom-gold/20 text-custom-gold hover:bg-custom-navy hover:text-white transition-all duration-300 flex items-center justify-center">
                    <i class="fas fa-bars"></i>
                </button>
            </div>
        </div>
    </header>

    <div id="offcanvas-backdrop" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-40 hidden opacity-0 transition-opacity duration-500"></div>
    <div id="offcanvas-menu" class="fixed top-0 right-0 h-full w-[85vw] max-w-sm z-50 transform translate-x-full transition-transform duration-500 ease-out bg-custom-dark/90 backdrop-blur-2xl border-l border-white/10 shadow-[-20px_0_50px_rgba(0,0,0,0.8)] flex flex-col overflow-hidden">

        <div class="absolute top-0 right-0 w-64 h-64 bg-custom-gold/10 rounded-full blur-[80px] pointer-events-none"></div>
        <div class="absolute bottom-20 left-0 w-64 h-64 bg-custom-navy/20 rounded-full blur-[80px] pointer-events-none"></div>

        <div class="flex justify-between items-center p-6 border-b border-white/5 relative z-10">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="text-xl font-bold text-custom-snow flex items-center gap-2 group">
                <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-custom-navy to-custom-gold flex items-center justify-center text-white shadow-[0_0_15px_rgba(225,215,136,0.4)] group-hover:scale-110 transition-transform duration-300">
                    <i class="fas fa-prescription-bottle-medical text-sm"></i>
                </div>
                <setting key="Site Name"></setting>
            </a>
            <div class="flex items-center gap-3">
                <partial name="_ThemeToggle" />
                <partial name="_LanguageSwitcher" />
                <button id="offcanvas-close-button" class="w-8 h-8 rounded-full flex items-center justify-center bg-white/5 border border-white/10 text-custom-snow hover:bg-custom-gold/20 hover:text-custom-gold hover:border-custom-gold/50 transition-all duration-300 group">
                    <i class="fas fa-times group-hover:rotate-90 transition-transform duration-300"></i>
                </button>
            </div>
        </div>

        <div class="flex-grow overflow-y-auto px-4 py-6 relative z-10 scrollbar-hide">
            @if (User.Identity.IsAuthenticated)
            {
                <div class="offcanvas-item mb-8">
                    <div class="p-4 rounded-2xl bg-gradient-to-br from-white/5 to-transparent border border-white/10 flex items-center gap-4">
                        <div class="w-12 h-12 rounded-full bg-gradient-to-r from-custom-gold to-[#c2b869] text-custom-dark flex items-center justify-center font-bold text-xl shadow-[0_0_15px_rgba(225,215,136,0.3)]">
                            @(User.FindFirst("FirstName")?.Value?.FirstOrDefault() ?? 'U')
                        </div>
                        <div>
                            <p class="text-xs text-custom-gold font-semibold tracking-wider uppercase mb-0.5">@Localizer["Welcome"]</p>
                            <a asp-area="User" asp-controller="Dashboard" asp-action="Index" class="text-base font-bold text-custom-snow hover:text-custom-gold transition-colors">@User.FindFirst("FirstName")?.Value</a>
                        </div>
                    </div>
                </div>
            }

            <nav class="flex flex-col space-y-2">
                <a asp-area="" asp-controller="Courses" asp-action="Index" class="offcanvas-item group flex items-center gap-4 p-3 rounded-2xl hover:bg-white/5 transition-all duration-300">
                    <div class="w-10 h-10 rounded-xl bg-custom-gold/10 text-custom-gold flex items-center justify-center group-hover:bg-custom-gold group-hover:text-custom-dark group-hover:shadow-[0_0_15px_rgba(225,215,136,0.4)] transition-all duration-300">
                        <i class="fas fa-book"></i>
                    </div>
                    <div>
                        <h4 class="text-sm font-bold text-custom-snow group-hover:text-custom-gold transition-colors">@Localizer["Courses"]</h4>
                        <p class="text-xs text-custom-snow/40 mt-0.5">Explore our materials</p>
                    </div>
                </a>

                <a href="/Home/Index#about" class="offcanvas-item group flex items-center gap-4 p-3 rounded-2xl hover:bg-white/5 transition-all duration-300">
                    <div class="w-10 h-10 rounded-xl bg-custom-navy/20 text-custom-snow flex items-center justify-center group-hover:bg-custom-navy group-hover:text-white group-hover:shadow-[0_0_15px_rgba(18,60,118,0.4)] transition-all duration-300">
                        <i class="fas fa-info-circle"></i>
                    </div>
                    <div>
                        <h4 class="text-sm font-bold text-custom-snow group-hover:text-custom-snow transition-colors">@Localizer["About"]</h4>
                        <p class="text-xs text-custom-snow/40 mt-0.5">Who we are</p>
                    </div>
                </a>

                <a href="/Home/Index#features" class="offcanvas-item group flex items-center gap-4 p-3 rounded-2xl hover:bg-white/5 transition-all duration-300">
                    <div class="w-10 h-10 rounded-xl bg-custom-navy/20 text-custom-snow flex items-center justify-center group-hover:bg-custom-navy group-hover:text-white group-hover:shadow-[0_0_15px_rgba(18,60,118,0.4)] transition-all duration-300">
                        <i class="fas fa-star"></i>
                    </div>
                    <div>
                        <h4 class="text-sm font-bold text-custom-snow group-hover:text-custom-snow transition-colors">@Localizer["Features"]</h4>
                        <p class="text-xs text-custom-snow/40 mt-0.5">Platform benefits</p>
                    </div>
                </a>

                <a href="/Home/Index#contact" class="offcanvas-item group flex items-center gap-4 p-3 rounded-2xl hover:bg-white/5 transition-all duration-300">
                    <div class="w-10 h-10 rounded-xl bg-custom-gold/10 text-custom-gold flex items-center justify-center group-hover:bg-custom-gold group-hover:text-custom-dark group-hover:shadow-[0_0_15px_rgba(225,215,136,0.4)] transition-all duration-300">
                        <i class="fas fa-envelope"></i>
                    </div>
                    <div>
                        <h4 class="text-sm font-bold text-custom-snow group-hover:text-custom-gold transition-colors">@Localizer["Contact"]</h4>
                        <p class="text-xs text-custom-snow/40 mt-0.5">Get in touch</p>
                    </div>
                </a>
            </nav>
        </div>

        <div class="p-6 border-t border-white/5 bg-custom-dark/50 relative z-10 backdrop-blur-md">
            @if (User.Identity.IsAuthenticated)
            {
                <div class="flex flex-col gap-3">
                    <a asp-area="User" asp-controller="Dashboard" asp-action="Index" class="offcanvas-item w-full flex justify-center items-center gap-2 bg-white/5 hover:bg-white/10 border border-white/10 text-custom-snow font-bold py-3.5 px-6 rounded-xl transition-colors duration-300">
                        <i class="fas fa-chart-pie text-custom-gold"></i> @Localizer["Dashboard"]
                    </a>
                    @if (canViewDashboard)
                    {
                        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="offcanvas-item w-full flex justify-center items-center gap-2 bg-white/5 hover:bg-white/10 border border-white/10 text-custom-snow font-bold py-3.5 px-6 rounded-xl transition-colors duration-300">
                            <i class="fas fa-shield-halved text-custom-navy"></i> @Localizer["AdminPanel"]
                        </a>
                    }
                    <a asp-area="" asp-controller="Account" asp-action="Logout" class="offcanvas-item w-full flex justify-center items-center gap-2 bg-red-500/10 hover:bg-red-500/20 border border-red-500/30 text-red-400 font-bold py-3.5 px-6 rounded-xl transition-colors duration-300">
                        <i class="fas fa-right-from-bracket"></i> @Localizer["Logout"]
                    </a>
                </div>
            }
            else
            {
                <div class="flex flex-col gap-3">
                    <a asp-area="" asp-controller="Account" asp-action="Login" class="offcanvas-item w-full flex justify-center items-center gap-2 bg-white/5 hover:bg-white/10 border border-white/10 text-custom-snow font-bold py-3.5 px-6 rounded-xl transition-colors duration-300">
                        <i class="fas fa-user text-custom-gold"></i> @Localizer["Login"]
                    </a>
                    <a asp-area="" asp-controller="Account" asp-action="Register" class="offcanvas-item w-full flex justify-center items-center gap-2 bg-gradient-to-r from-custom-navy to-[#1a5099] border border-custom-gold/30 text-custom-gold font-bold py-3.5 px-6 rounded-xl transition-all duration-300 transform hover:scale-[1.02] shadow-[0_0_20px_rgba(18,60,118,0.3)]">
                        <i class="fas fa-user-plus"></i> @Localizer["CreateAccount"]
                    </a>
                </div>
            }
        </div>
    </div>

    <main class="pt-28 pb-12 min-h-screen relative z-10">
        <div class="container mx-auto px-4">

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="mb-6 p-4 rounded-xl bg-green-500/10 border border-green-500/30 text-green-400 glass-panel animate-float" style="animation-duration: 4s;">
                    <i class="fas fa-check-circle mr-2"></i> @TempData["SuccessMessage"]
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="mb-6 p-4 rounded-xl bg-red-500/10 border border-red-500/30 text-red-400 glass-panel animate-float" style="animation-duration: 4s;">
                    <i class="fas fa-exclamation-circle mr-2"></i> @TempData["ErrorMessage"]
                </div>
            }

            @if (TempData["InfoMessage"] != null)
            {
                <div class="mb-6 p-4 rounded-xl bg-custom-navy/30 border border-custom-navy/50 text-custom-snow glass-panel animate-float" style="animation-duration: 4s;">
                    <i class="fas fa-info-circle mr-2 text-custom-gold"></i> @TempData["InfoMessage"]
                </div>
            }

            @RenderBody()

        </div>
    </main>

    <footer class="py-12 border-t border-custom-gold/10 bg-custom-dark/80 backdrop-blur-lg relative z-10">
        <div class="container mx-auto px-4">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
                <div>
                    <h3 class="text-xl font-bold mb-4 flex items-center gap-2 text-custom-gold">
                        <i class="fas fa-prescription-bottle-medical drop-shadow-[0_0_8px_rgba(225,215,136,0.5)]"></i> @Localizer["SiteName"]
                    </h3>
                    <p class="text-slate-400 text-sm leading-relaxed">
                        @Localizer["FooterDescription"]
                    </p>
                </div>

                <div>
                    <h4 class="text-lg font-semibold mb-4 text-custom-snow">@Localizer["QuickLinks"]</h4>
                    <ul class="space-y-2 text-slate-400 text-sm">
                        <li><a asp-area="" asp-controller="Home" asp-action="Index" class="hover:text-custom-gold transition-colors">@Localizer["Home"]</a></li>
                        <li><a asp-area="" asp-controller="Courses" asp-action="Index" class="hover:text-custom-gold transition-colors">@Localizer["Courses"]</a></li>
                        <li><a asp-area="" asp-controller="Home" asp-action="Privacy" class="hover:text-custom-gold transition-colors">@Localizer["PrivacyPolicy"]</a></li>
                    </ul>
                </div>

                <div>
                    <h4 class="text-lg font-semibold mb-4 text-custom-snow">@Localizer["Support"]</h4>
                    <ul class="space-y-2 text-slate-400 text-sm">
                        <li><a href="#" class="hover:text-custom-gold transition-colors">@Localizer["HelpCenter"]</a></li>
                        <li><a href="/Home/Index#contact" class="hover:text-custom-gold transition-colors">@Localizer["Contact"]</a></li>
                        <li><a href="#" class="hover:text-custom-gold transition-colors">@Localizer["FAQ"]</a></li>
                    </ul>
                </div>

                <div>
                    <h4 class="text-lg font-semibold mb-4 text-custom-snow">@Localizer["FollowUs"]</h4>
                    <div class="flex gap-4">
                        <a href="#" class="w-10 h-10 rounded-full border border-white/10 hover:border-custom-gold bg-custom-navy/20 hover:bg-custom-navy text-custom-snow hover:text-custom-gold flex items-center justify-center transition-all duration-300">
                            <i class="fab fa-facebook-f"></i>
                        </a>
                        <a href="#" class="w-10 h-10 rounded-full border border-white/10 hover:border-custom-gold bg-custom-navy/20 hover:bg-custom-navy text-custom-snow hover:text-custom-gold flex items-center justify-center transition-all duration-300">
                            <i class="fab fa-twitter"></i>
                        </a>
                        <a href="#" class="w-10 h-10 rounded-full border border-white/10 hover:border-custom-gold bg-custom-navy/20 hover:bg-custom-navy text-custom-snow hover:text-custom-gold flex items-center justify-center transition-all duration-300">
                            <i class="fab fa-instagram"></i>
                        </a>
                    </div>
                </div>
            </div>

            <div class="text-center pt-8 border-t border-white/5">
                <p class="text-slate-500 text-sm">
                    &copy; @DateTime.Now.Year @Localizer["SiteName"]. All rights reserved.
                </p>
            </div>
        </div>
    </footer>

<script src="~/js/site.js"></script>
<script src="~/js/theme.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>