@using System.Globalization
@{
    var currentCulture = CultureInfo.CurrentUICulture.Name;
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    var isFarsi = currentCulture.StartsWith("fa", StringComparison.OrdinalIgnoreCase);
    var isArabic = currentCulture.StartsWith("ar", StringComparison.OrdinalIgnoreCase);

    ViewData["Title"] = isFarsi ? "صفحه پیدا نشد" : (isArabic ? "الصفحة غير موجودة" : "404 - Page Not Found");
    Layout = null;
}

<!DOCTYPE html>
<html lang="@currentCulture" dir="@(isRtl ? "rtl" : "ltr")">
<head>
    <script>
        (function () {
            try {
                var theme = localStorage.getItem('pharmino_theme') || 'dark';
                document.documentElement.setAttribute('data-theme', theme);
                if (theme === 'light') {
                    document.documentElement.classList.add('light', 'light-theme');
                } else {
                    document.documentElement.classList.add('dark', 'dark-theme');
                }
            } catch (e) { }
        })();
    </script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    @if (isFarsi)
    {
        <style>
            @@font-face {
                font-family: 'B Nazanin';
                src: url('/fonts/BNazanin.ttf') format('truetype');
                font-weight: normal;
                font-style: normal;
                font-display: swap;
            }
            html {
                font-size: 19px !important;
            }
            * {
                font-family: 'B Nazanin', Tahoma, sans-serif !important;
            }
        </style>
    }
    else if (isArabic)
    {
        <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">
        <style>
            * {
                font-family: 'Cairo', sans-serif !important;
            }
        </style>
    }
    else
    {
        <style>
            * {
                font-family: 'Inter', sans-serif;
            }
        </style>
    }
    <style>
        .error-animation {
            animation: float 3s ease-in-out infinite;
        }
        @@keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-20px); }
        }
    </style>
</head>
<body class="bg-gradient-to-br from-slate-900 via-purple-900/10 to-slate-900 min-h-screen flex items-center justify-center p-4 relative">
    <div class="absolute top-6 @(isRtl ? "left-6" : "right-6") flex items-center gap-3 z-50">
        <partial name="_ThemeToggle" />
        <partial name="_LanguageSwitcher" />
    </div>

    <div class="text-center max-w-lg">
        <div class="error-animation mb-8">
            <i class="fas fa-exclamation-triangle text-amber-400 text-9xl opacity-80"></i>
        </div>
        
        <h1 class="text-white text-8xl font-black mb-4 tracking-wider">404</h1>
        <h2 class="text-white text-3xl font-bold mb-4">
            @(isFarsi ? "صفحه مورد نظر یافت نشد" : (isArabic ? "الصفحة المطلوبة غير موجودة" : "Page Not Found"))
        </h2>
        <p class="text-white/80 text-lg mb-8 max-w-md mx-auto">
            @(isFarsi ? "صفحه‌ای که به دنبال آن هستید وجود ندارد یا به آدرس دیگری منتقل شده است." : (isArabic ? "الصفحة التي تبحث عنها غير موجودة أو تم نقلها." : "The page you are looking for doesn't exist or you don't have permission to access it."))
        </p>
        
        <div class="flex items-center justify-center gap-4">
            <a href="/" class="inline-flex items-center px-8 py-3 bg-brand-cyan/20 border border-brand-cyan/40 text-brand-cyan hover:bg-brand-cyan hover:text-black rounded-xl font-bold transition-all transform hover:scale-105 shadow-lg">
                <i class="fas fa-home @(isRtl ? "ml-2" : "mr-2")"></i>
                @(isFarsi ? "بازگشت به خانه" : (isArabic ? "الرئيسية" : "Go Home"))
            </a>
            <button onclick="history.back()" class="inline-flex items-center px-8 py-3 bg-white/5 border border-white/20 text-white rounded-xl font-bold hover:bg-white/10 transition-all transform hover:scale-105">
                <i class="fas @(isRtl ? "fa-arrow-right ml-2" : "fa-arrow-left mr-2")"></i>
                @(isFarsi ? "صفحه قبل" : (isArabic ? "رجوع" : "Go Back"))
            </button>
        </div>
    </div>
    <script src="~/js/theme.js"></script>
</body>
</html>
