@model Domain.Entities.Course.Course

@{
    ViewData["Title"] = Model.Title;
    var isRtl = System.Globalization.CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    var isEnrolled = (bool)ViewBag.IsEnrolled;
    var videos = ViewBag.Videos as List<Domain.Entities.Course.CourseVideo>;
    var pdfs = ViewBag.Pdfs as List<Domain.Entities.Course.CoursePdf>;
    var bundleCourses = ViewBag.BundleCourses as List<Domain.Entities.Course.Course>;
    var isAuthenticated = (bool)ViewBag.IsAuthenticated;
}

<style>
    /* انیمیشن لرزش برای حالت عدم دسترسی */
    @@keyframes deniedShake {
        0%, 100% {
            transform: scale(1.1) translateX(0);
        }

        25% {
            transform: scale(1.1) translateX(-4px);
        }

        50% {
            transform: scale(1.1) translateX(4px);
        }

        75% {
            transform: scale(1.1) translateX(-4px);
        }
    }

    /* کلاسی که با جاوا اسکریپت اضافه می‌شود */
    .premium-locked-active {
        background-color: #123C76 !important; /* custom-navy */
        border-color: #E1D788 !important; /* custom-gold */
        box-shadow: 0 0 20px rgba(225, 215, 136, 0.4) !important;
        animation: deniedShake 0.4s ease-in-out !important;
    }

        /* چرخاندن و محو کردن دلار */
        .premium-locked-active .vid-dollar {
            transform: scale(0) rotate(180deg) !important;
            opacity: 0 !important;
        }

        /* نمایش و صاف کردن قفل */
        .premium-locked-active .vid-lock {
            transform: scale(1) rotate(0deg) !important;
            opacity: 1 !important;
        }
</style>

<div class="max-w-7xl mx-auto space-y-8 pb-12 mt-4 px-4 sm:px-6 lg:px-8">
    <a asp-area="" asp-controller="Courses" asp-action="Index" class="group inline-flex items-center px-4 py-2 rounded-full bg-custom-navy/20 text-custom-snow/80 hover:text-custom-gold hover:bg-custom-navy/40 border border-custom-gold/20 hover:border-custom-gold/50 transition-all duration-300 backdrop-blur-md gap-2">
        <i class="fas @(isRtl ? "fa-arrow-right" : "fa-arrow-left") transform group-hover:-translate-x-1 transition-transform"></i>
        <span class="font-medium">@(isRtl ? "العودة إلى الدورات" : "Back to Courses")</span>
    </a>

    <div class="relative rounded-3xl overflow-hidden bg-custom-dark/60 border border-custom-gold/20 backdrop-blur-xl shadow-[0_8px_32px_rgba(18,60,118,0.3)]">
        <div class="absolute -top-24 -right-24 w-96 h-96 bg-custom-gold/10 rounded-full blur-[120px] pointer-events-none animate-blob-1"></div>

        <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-custom-navy/20 rounded-full blur-[140px] pointer-events-none animate-blob-2"></div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 p-8 relative z-10">
            <div class="lg:col-span-5">
                <div class="relative w-full aspect-video lg:aspect-square xl:aspect-[4/5] rounded-2xl overflow-hidden shadow-[0_0_15px_rgba(225,215,136,0.1)] group border border-custom-gold/10">
                    @if (!string.IsNullOrEmpty(Model.ImageName))
                    {
                        <img src="~/uploads/courses/@Model.ImageName"
                             alt="@Model.Title"
                             class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700" />

                        <div class="absolute inset-0 bg-gradient-to-t from-custom-dark/90 via-custom-dark/20 to-transparent"></div>
                    }
                    else
                    {
                        <div class="w-full h-full bg-gradient-to-br from-custom-navy/40 to-[#1a5099]/40 flex items-center justify-center">
                            <i class="fas fa-graduation-cap text-custom-gold/50 text-7xl drop-shadow-lg"></i>
                        </div>
                    }
                    <div class="absolute top-4 right-4 flex flex-col gap-1.5 items-end z-20">
                        @if (Model.IsBundle)
                        {
                            <span class="px-3.5 py-1 text-xs font-black uppercase tracking-wider rounded-full bg-gradient-to-r from-purple-600 to-indigo-600 text-white shadow-lg flex items-center gap-1.5">
                                <i class="fas fa-layer-group"></i> Course Bundle
                            </span>
                        }
                        @if (Model.HasActiveDiscount)
                        {
                            <span class="px-3 py-1 text-xs font-black uppercase tracking-wider rounded-full bg-gradient-to-r from-rose-500 to-amber-500 text-white shadow-lg animate-pulse">
                                -@Model.DiscountPercent% OFF
                            </span>
                        }
                    </div>
                </div>
            </div>

            <div class="lg:col-span-7 flex flex-col justify-center">
                <div class="flex flex-wrap items-center gap-2 mb-3">
                    @if (Model.IsBundle)
                    {
                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-purple-500/20 text-purple-300 border border-purple-500/30">
                            <i class="fas fa-layer-group"></i> Complete Package (@(bundleCourses?.Count ?? 0) Courses)
                        </span>
                    }
                    @if (Model.HasActiveDiscount)
                    {
                        <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-bold bg-rose-500/20 text-rose-300 border border-rose-500/30">
                            <i class="fas fa-bolt"></i> Limited Discount
                        </span>
                    }
                </div>

                <h1 class="text-3xl md:text-5xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-custom-snow to-custom-gold mb-4 leading-tight">
                    @Model.Title
                </h1>
                <p class="text-custom-snow/70 text-base md:text-lg mb-8 leading-relaxed">
                    @Model.Description
                </p>

                <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
                    @if (Model.IsBundle)
                    {
                        <div class="p-4 rounded-2xl bg-purple-500/10 border border-purple-500/20 hover:bg-purple-500/20 hover:border-purple-500/40 transition-all flex flex-col items-center justify-center text-center group">
                            <div class="w-10 h-10 rounded-full bg-purple-500/20 flex items-center justify-center mb-2 group-hover:scale-110 group-hover:shadow-[0_0_15px_rgba(168,85,247,0.4)] transition-all">
                                <i class="fas fa-layer-group text-purple-400 text-lg"></i>
                            </div>
                            <div class="text-custom-snow font-bold text-lg">@(bundleCourses?.Count ?? 0)</div>
                            <div class="text-custom-snow/50 text-xs uppercase tracking-wider">Sub-Courses</div>
                        </div>
                    }

                    @if (Model.DurationHours.HasValue && Model.DurationHours.Value > 0)
                    {
                        <div class="p-4 rounded-2xl bg-custom-navy/20 border border-custom-gold/10 hover:bg-custom-navy/40 hover:border-custom-gold/30 transition-all flex flex-col items-center justify-center text-center group">
                            <div class="w-10 h-10 rounded-full bg-custom-gold/10 flex items-center justify-center mb-2 group-hover:scale-110 group-hover:shadow-[0_0_15px_rgba(225,215,136,0.3)] transition-all">
                                <i class="far fa-clock text-custom-gold text-lg"></i>
                            </div>
                            <div class="text-custom-snow font-bold text-lg">@Model.DurationHours</div>
                            <div class="text-custom-snow/50 text-xs uppercase tracking-wider">@Localizer["Hours"]</div>
                        </div>
                    }

                    <div class="p-4 rounded-2xl bg-custom-navy/20 border border-custom-gold/10 hover:bg-custom-navy/40 hover:border-custom-gold/30 transition-all flex flex-col items-center justify-center text-center group">
                        <div class="w-10 h-10 rounded-full bg-custom-navy/40 flex items-center justify-center mb-2 group-hover:scale-110 group-hover:shadow-[0_0_15px_rgba(18,60,118,0.5)] transition-all">
                            <i class="fas fa-video text-custom-snow text-lg"></i>
                        </div>
                        <div class="text-custom-snow font-bold text-lg">@(videos?.Count ?? 0)</div>
                        <div class="text-custom-snow/50 text-xs uppercase tracking-wider">@Localizer["Videos"]</div>
                    </div>

                    @if (!Model.IsBundle)
                    {
                        <div class="p-4 rounded-2xl bg-custom-navy/20 border border-custom-gold/10 hover:bg-custom-navy/40 hover:border-custom-gold/30 transition-all flex flex-col items-center justify-center text-center group">
                            <div class="w-10 h-10 rounded-full bg-[#ff6b6b]/10 flex items-center justify-center mb-2 group-hover:scale-110 group-hover:shadow-[0_0_15px_rgba(255,107,107,0.3)] transition-all">
                                <i class="fas fa-file-pdf text-[#ff6b6b] text-lg"></i>
                            </div>
                            <div class="text-custom-snow font-bold text-lg">@(pdfs?.Count ?? 0)</div>
                            <div class="text-custom-snow/50 text-xs uppercase tracking-wider">@Localizer["PDFs"]</div>
                        </div>
                    }

                    <div class="p-4 rounded-2xl bg-custom-navy/20 border border-custom-gold/10 hover:bg-custom-navy/40 hover:border-custom-gold/30 transition-all flex flex-col items-center justify-center text-center group">
                        <div class="w-10 h-10 rounded-full bg-[#4ade80]/10 flex items-center justify-center mb-2 group-hover:scale-110 group-hover:shadow-[0_0_15px_rgba(74,222,128,0.3)] transition-all">
                            <i class="fas fa-tag text-[#4ade80] text-lg"></i>
                        </div>
                        <div class="text-custom-snow font-bold text-lg">
                            @if (!Model.IsListedForSale)
                            {
                                <span class="text-purple-300 text-sm font-bold flex items-center justify-center gap-1">
                                    <i class="fas fa-cubes text-xs"></i>Bundle Only
                                </span>
                            }
                            else if (Model.HasActiveDiscount)
                            {
                                <div>
                                    <span class="text-emerald-400 font-black">$@Model.EffectivePrice.ToString("N0")</span>
                                    <span class="text-xs text-custom-snow/40 line-through block">$@Model.Price.ToString("N0")</span>
                                </div>
                            }
                            else if (Model.Price == 0)
                            {
                                <span>@Localizer["Free"]</span>
                            }
                            else
                            {
                                <span>$@Model.Price.ToString("N0")</span>
                            }
                        </div>
                        <div class="text-custom-snow/50 text-xs uppercase tracking-wider">@Localizer["Price"]</div>
                    </div>
                </div>

                <div class="mt-auto">
                    @if (isEnrolled)
                    {
                        <div class="w-full px-6 py-3 rounded-2xl bg-[#4ade80]/10 border border-[#4ade80]/30 text-[#4ade80] font-medium text-center mb-4 flex items-center justify-center shadow-inner">
                            <i class="fas fa-check-circle mr-2"></i>
                            @Localizer["EnrolledStatus"]
                        </div>
                        <a asp-area="User" asp-controller="Courses" asp-action="MyCourseDetails" asp-route-id="@Model.CourseId"
                           class="flex items-center justify-center w-full px-8 py-4 rounded-2xl bg-gradient-to-r from-custom-navy to-[#1a5099] border border-custom-gold/30 hover:border-custom-gold text-custom-gold font-bold text-lg transition-all duration-300 transform hover:-translate-y-1 shadow-[0_0_15px_rgba(18,60,118,0.5)] group">
                            <i class="fas fa-book-reader mr-3 group-hover:scale-110 transition-transform"></i>
                            @Localizer["GoToCourseDashboard"]
                        </a>
                    }
                    else if (!Model.IsListedForSale)
                    {
                        @if (Model.IncludedInBundles != null && Model.IncludedInBundles.Any(b => b.Bundle != null && b.Bundle.IsActive))
                        {
                            <div class="p-6 rounded-2xl bg-gradient-to-br from-purple-900/30 via-custom-navy/40 to-purple-950/40 border border-purple-500/30 text-start space-y-4 shadow-xl">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-xl bg-purple-500/20 text-purple-300 flex items-center justify-center text-lg shadow-inner">
                                        <i class="fas fa-layer-group"></i>
                                    </div>
                                    <div>
                                        <h4 class="text-white font-bold text-base">Package Exclusive</h4>
                                        <p class="text-xs text-purple-200/70">This course is part of bundled packages and is not sold separately.</p>
                                    </div>
                                </div>
                                <div class="space-y-2 pt-2 border-t border-purple-500/20">
                                    <span class="text-[11px] font-bold uppercase tracking-wider text-purple-300 block">Available in these bundles:</span>
                                    <div class="grid grid-cols-1 gap-2">
                                        @foreach (var bundleItem in Model.IncludedInBundles.Where(b => b.Bundle != null && b.Bundle.IsActive))
                                        {
                                            <a href="/Course/@bundleItem.BundleId" class="flex items-center justify-between p-3.5 rounded-xl bg-purple-500/20 hover:bg-purple-500/30 border border-purple-500/30 text-white transition-all group">
                                                <span class="font-bold text-sm text-purple-100 group-hover:text-white flex items-center gap-2">
                                                    <i class="fas fa-cubes text-purple-400"></i>
                                                    @bundleItem.Bundle.Title
                                                </span>
                                                <span class="text-xs font-mono font-bold text-emerald-400 flex items-center gap-1.5">
                                                    $@bundleItem.Bundle.EffectivePrice.ToString("N0")
                                                    <i class="fas fa-arrow-right text-[10px] opacity-70 group-hover:translate-x-1 transition-transform"></i>
                                                </span>
                                            </a>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="p-5 rounded-2xl bg-amber-500/10 border border-amber-500/30 text-start flex items-center gap-3 shadow-lg">
                                <i class="fas fa-lock text-amber-400 text-2xl"></i>
                                <div>
                                    <h4 class="text-white font-bold text-sm">Not Listed for Individual Sale</h4>
                                    <p class="text-xs text-amber-200/70">This course is currently private or restricted to package bundles.</p>
                                </div>
                            </div>
                        }
                    }
                    else if (!isAuthenticated)
                    {
                        <a href="/Account/Login?returnUrl=@Uri.EscapeDataString(Context.Request.Path)"
                           class="flex items-center justify-center w-full px-8 py-4 rounded-2xl bg-gradient-to-r from-custom-navy to-[#1a5099] border border-custom-gold/30 hover:border-custom-gold text-custom-gold font-bold text-lg transition-all duration-300 transform hover:-translate-y-1 shadow-[0_0_15px_rgba(18,60,118,0.5)] hover:shadow-[0_0_25px_rgba(225,215,136,0.3)] group">
                            <i class="fas fa-sign-in-alt mr-3 group-hover:scale-110 transition-transform"></i>
                            @Localizer["LoginToEnroll"]
                        </a>
                    }
                    else
                    {
                        <div class="space-y-3 w-full">
                            @if (User.IsInRole("Admin"))
                            {
                                <a href="/Admin/Courses/Details/@Model.CourseId"
                                   class="flex items-center justify-center w-full px-6 py-3.5 rounded-2xl bg-gradient-to-r from-brand-cyan to-brand-blue hover:from-cyan-400 hover:to-blue-500 text-dark-bg font-extrabold text-base transition-all duration-300 transform hover:-translate-y-0.5 shadow-[0_0_20px_rgba(66,234,255,0.4)] gap-2.5">
                                    <i class="fas fa-sliders text-sm"></i>
                                    <span>@(isRtl ? "مدیریت این دوره در پنل ادمین" : "Manage in Admin Panel")</span>
                                </a>
                            }
                            <form asp-area="" asp-controller="Courses" asp-action="Enroll" method="post" class="w-full">
                                <input type="hidden" name="courseId" value="@Model.CourseId" />
                                @Html.AntiForgeryToken()
                                <button type="submit" class="flex items-center justify-center w-full px-8 py-4 rounded-2xl bg-custom-gold hover:bg-[#c2b869] text-custom-navy font-bold text-lg transition-all duration-300 transform hover:-translate-y-1 shadow-[0_0_20px_rgba(225,215,136,0.4)] group border border-custom-gold gap-3">
                                    <i class="fas fa-user-plus group-hover:scale-110 transition-transform text-lg"></i>
                                    @if (Model.EffectivePrice == 0)
                                    {
                                        <span>@(isRtl ? "سجل الآن مجاناً" : "Enroll Now for Free")</span>
                                    }
                                    else if (Model.HasActiveDiscount)
                                    {
                                        <span class="flex items-center gap-2.5 flex-wrap justify-center">
                                            <span>@(isRtl ? "سجل الآن مقابل" : "Enroll Now for")</span>
                                            <span class="px-2.5 py-0.5 rounded-xl bg-custom-navy text-custom-gold font-extrabold text-base shadow-sm">$@Model.EffectivePrice.ToString("N0")</span>
                                            <span class="text-sm line-through opacity-70">($@Model.Price.ToString("N0"))</span>
                                            <span class="text-xs bg-emerald-600 text-white px-2 py-0.5 rounded-full font-black">-@Model.DiscountPercent%</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="flex items-center gap-2.5 flex-wrap justify-center">
                                            <span>@(isRtl ? "سجل الآن" : "Enroll Now")</span>
                                            <span class="px-3 py-1 rounded-xl bg-custom-navy text-custom-gold font-extrabold text-base shadow-sm">$@Model.Price.ToString("N0")</span>
                                        </span>
                                    }
                                </button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (Model.IsBundle && bundleCourses != null && bundleCourses.Any())
    {
        <div class="rounded-3xl bg-custom-dark/60 border border-purple-500/30 p-8 backdrop-blur-xl shadow-[0_8px_32px_rgba(88,28,135,0.2)]">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8 pb-6 border-b border-purple-500/20">
                <div class="flex items-center">
                    <div class="w-12 h-12 rounded-2xl bg-purple-500/20 flex items-center justify-center mr-4 border border-purple-500/40 shadow-[0_0_20px_rgba(168,85,247,0.3)]">
                        <i class="fas fa-cubes text-purple-400 text-xl"></i>
                    </div>
                    <div>
                        <h2 class="text-2xl font-bold text-custom-snow flex items-center gap-2">
                            Included Sub-Courses
                            <span class="text-xs px-2.5 py-0.5 rounded-full bg-purple-500/20 text-purple-300 border border-purple-500/30 font-semibold">
                                @bundleCourses.Count Courses in this Bundle
                            </span>
                        </h2>
                        <p class="text-sm text-custom-snow/60 mt-0.5">Enrolling in this bundle unlocks complete lifetime access to every sub-course below.</p>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                @foreach (var subCourse in bundleCourses)
                {
                    <div class="rounded-2xl bg-custom-navy/20 border border-purple-500/20 hover:border-purple-500/50 p-5 transition-all duration-300 hover:bg-custom-navy/40 flex flex-col justify-between group">
                        <div>
                            <div class="h-40 rounded-xl overflow-hidden mb-4 bg-custom-dark relative">
                                @if (!string.IsNullOrEmpty(subCourse.ImageName) && subCourse.ImageName != "default.jpg")
                                {
                                    <img src="~/uploads/courses/@subCourse.ImageName" alt="@subCourse.Title" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                                }
                                else
                                {
                                    <div class="w-full h-full flex items-center justify-center bg-purple-950/30">
                                        <i class="fas fa-graduation-cap text-purple-400/40 text-5xl"></i>
                                    </div>
                                }
                                <div class="absolute top-2.5 right-2.5 px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-purple-600 text-white shadow">
                                    Included
                                </div>
                            </div>

                            <h3 class="text-lg font-bold text-custom-snow group-hover:text-purple-300 transition-colors line-clamp-1 mb-2">
                                @subCourse.Title
                            </h3>
                            <p class="text-xs text-custom-snow/60 line-clamp-2 mb-4 leading-relaxed">
                                @subCourse.Description
                            </p>
                        </div>

                        <div class="pt-4 border-t border-purple-500/20 flex items-center justify-between">
                            <div class="flex items-center gap-3 text-xs text-custom-snow/60 font-medium">
                                <span class="flex items-center gap-1"><i class="far fa-clock text-custom-gold/80"></i> @subCourse.DurationHours hr</span>
                                <span class="flex items-center gap-1"><i class="fas fa-video text-custom-cyan/80"></i> @subCourse.Videos.Count vids</span>
                            </div>

                            @if (isEnrolled)
                            {
                                <a asp-area="User" asp-controller="Courses" asp-action="MyCourseDetails" asp-route-id="@subCourse.CourseId"
                                   class="px-3.5 py-1.5 rounded-xl bg-purple-600 hover:bg-purple-500 text-white text-xs font-bold transition-all shadow-[0_0_15px_rgba(168,85,247,0.4)] flex items-center gap-1.5">
                                    <i class="fas fa-play text-[10px]"></i> Open
                                </a>
                            }
                            else
                            {
                                <a asp-area="" asp-controller="Courses" asp-action="Details" asp-route-id="@subCourse.CourseId"
                                   class="px-3 py-1.5 rounded-xl bg-custom-navy/40 hover:bg-custom-navy text-custom-snow/80 hover:text-white text-xs font-semibold border border-custom-gold/20 transition-all flex items-center gap-1">
                                    <i class="fas fa-external-link-alt text-[10px]"></i> View
                                </a>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div>
            <div class="flex items-center mb-6">
                <div class="w-10 h-10 rounded-xl bg-custom-gold/10 flex items-center justify-center mr-3 border border-custom-gold/30 shadow-[0_0_10px_rgba(225,215,136,0.2)]">
                    <i class="fas fa-play text-custom-gold text-lg"></i>
                </div>
                <h2 class="text-2xl font-bold text-custom-snow">@Localizer["CourseVideos"]</h2>
            </div>

            @if (videos == null || !videos.Any())
            {
                <div class="p-10 rounded-3xl border border-dashed border-custom-navy/50 bg-custom-navy/10 text-center">
                    <div class="w-16 h-16 mx-auto bg-custom-dark border border-custom-gold/20 rounded-full flex items-center justify-center mb-4 shadow-inner">
                        <i class="fas fa-video-slash text-custom-snow/50 text-2xl"></i>
                    </div>
                    <p class="text-custom-snow/60 font-medium">
                        @(!isAuthenticated || !isEnrolled ? Localizer["LoginAndEnrollToViewVideos"] : Localizer["NoVideosAvailable"])
                    </p>
                </div>
            }
            else
            {
                <div class="space-y-3">
                    @{
                        int videoIndex = 1;
                    }
                    @foreach (var video in videos)
                    {
                        bool canWatch = isEnrolled || video.IsFree;

                        <div class="group rounded-2xl bg-custom-navy/20 border border-custom-gold/10 p-4 transition-all duration-300 hover:bg-custom-navy/40 @(canWatch ? "hover:border-custom-gold/50" : "hover:border-[#ff6b6b]/50")">
                            <div class="flex items-center gap-4">

                                @if (canWatch)
                                {
                                    <a asp-area="User" asp-controller="Courses" asp-action="Watch" asp-route-videoId="@video.VideoId"
                                       class="relative flex-shrink-0 w-12 h-12 bg-custom-dark border border-custom-gold/30 flex items-center justify-center transition-all duration-300 ease-out rounded-xl group-hover:rounded-[50%] group-hover:bg-custom-gold group-hover:border-custom-gold group-hover:scale-110 group-hover:shadow-[0_0_20px_rgba(225,215,136,0.5)] cursor-pointer z-10">

                                        <div class="absolute inset-0 rounded-[50%] border-2 border-custom-navy/50 opacity-0 group-hover:animate-ping pointer-events-none"></div>

                                        <span class="absolute text-custom-snow/70 font-bold text-sm transition-all duration-300 ease-out transform scale-100 opacity-100 group-hover:scale-0 group-hover:opacity-0">
                                            @videoIndex.ToString("D2")
                                        </span>

                                        <i class="fas fa-play absolute text-custom-navy text-lg pl-0.5 transition-all duration-300 ease-out transform scale-0 opacity-0 group-hover:scale-100 group-hover:opacity-100 drop-shadow-md"></i>
                                    </a>
                                }
                                else
                                {
                                    <div onclick="showLockAnimation(this)" class="relative flex-shrink-0 w-12 h-12 bg-custom-dark border border-custom-navy/50 flex items-center justify-center transition-all duration-300 ease-out rounded-xl group-hover:rounded-[50%] group-hover:bg-[#ff6b6b] group-hover:border-[#ff6b6b] group-hover:scale-110 group-hover:shadow-[0_0_20px_rgba(255,107,107,0.4)] z-10 cursor-pointer">

                                        <span class="vid-number absolute text-custom-snow/70 font-bold text-sm transition-all duration-300 ease-out transform scale-100 opacity-100 group-hover:scale-0 group-hover:opacity-0">
                                            @videoIndex.ToString("D2")
                                        </span>

                                        <i class="vid-dollar fas fa-dollar-sign absolute text-custom-snow text-xl transition-all duration-300 ease-out transform scale-0 opacity-0 group-hover:scale-100 group-hover:opacity-100 drop-shadow-md"></i>

                                        <i class="vid-lock fas fa-lock absolute text-custom-snow text-xl transition-all duration-300 ease-out transform scale-0 opacity-0 -rotate-180 drop-shadow-md"></i>
                                    </div>
                                }

                                <div class="flex-1 min-w-0">
                                    <div class="flex items-center justify-between mb-1">
                                        <h3 class="text-base font-bold text-custom-snow group-hover:text-custom-gold transition-colors truncate pr-4">@video.Title</h3>

                                        @if (canWatch)
                                        {
                                            @if (video.IsFree && !isEnrolled)
                                            {
                                                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#4ade80]/20 text-[#4ade80] uppercase border border-[#4ade80]/20 flex-shrink-0">@Localizer["BadgeFreePreview"]</span>
                                            }
                                            else
                                            {
                                                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-custom-gold/20 text-custom-gold uppercase border border-custom-gold/20 flex-shrink-0">@Localizer["BadgeUnlocked"]</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#ff6b6b]/10 text-[#ff6b6b] uppercase border border-[#ff6b6b]/20 flex-shrink-0">@Localizer["BadgePremium"]</span>
                                        }
                                    </div>

                                    @if (video.DurationSeconds.HasValue)
                                    {
                                        <span class="flex items-center text-xs text-custom-snow/50 font-medium">
                                            <i class="far fa-clock mr-1.5 text-custom-gold/70"></i>
                                            @TimeSpan.FromSeconds(video.DurationSeconds.Value).ToString(@"hh\:mm\:ss")
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                        videoIndex++;
                    }
                </div>
            }
        </div>

        <div>
            <div class="flex items-center mb-6">
                <div class="w-10 h-10 rounded-xl bg-[#ff6b6b]/10 flex items-center justify-center mr-3 border border-[#ff6b6b]/20 shadow-[0_0_10px_rgba(255,107,107,0.2)]">
                    <i class="fas fa-file-pdf text-[#ff6b6b] text-lg"></i>
                </div>
                <h2 class="text-2xl font-bold text-custom-snow">@Localizer["CourseMaterials"]</h2>
            </div>

            @if (pdfs == null || !pdfs.Any())
            {
                <div class="p-10 rounded-3xl border border-dashed border-custom-navy/50 bg-custom-navy/10 text-center">
                    <div class="w-16 h-16 mx-auto bg-custom-dark border border-custom-gold/20 rounded-full flex items-center justify-center mb-4 shadow-inner">
                        <i class="fas fa-file-excel text-custom-snow/50 text-2xl"></i>
                    </div>
                    <p class="text-custom-snow/60 font-medium">
                        @(!isAuthenticated || !isEnrolled ? Localizer["LoginAndEnrollToViewMaterials"] : Localizer["NoMaterialsAvailable"])
                    </p>
                </div>
            }
            else
            {
                <div class="space-y-3">
                    @foreach (var pdf in pdfs)
                    {
                        <div class="group rounded-2xl bg-custom-navy/20 border border-custom-gold/10 p-4 transition-all duration-300 hover:bg-custom-navy/40 hover:border-[#ff6b6b]/50">
                            <div class="flex items-center gap-4">
                                <div class="flex-shrink-0 w-12 h-12 rounded-xl @(pdf.Price == 0 ? "bg-[#ff6b6b]/10 border-[#ff6b6b]/20" : "bg-custom-dark border-custom-navy/50") border flex items-center justify-center transition-colors">
                                    @if (pdf.Price == 0)
                                    {
                                        <i class="fas fa-file-pdf text-[#ff6b6b]"></i>
                                    }
                                    else
                                    {
                                        <i class="fas fa-lock text-custom-snow/50 group-hover:text-custom-snow/80"></i>
                                    }
                                </div>

                                <div class="flex-1 min-w-0">
                                    <div class="flex items-center justify-between mb-1">
                                        <h3 class="text-base font-bold text-custom-snow group-hover:text-[#ff6b6b] transition-colors truncate pr-4">@(pdf.Title ?? pdf.OriginalFileName)</h3>
                                        @if (pdf.Price == 0)
                                        {
                                            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#4ade80]/20 text-[#4ade80] uppercase border border-[#4ade80]/20 flex-shrink-0">@Localizer["BadgeFree"]</span>
                                        }
                                        else
                                        {
                                            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-custom-navy/50 text-custom-snow/70 uppercase border border-custom-navy flex-shrink-0">@Localizer["BadgeLocked"]</span>
                                        }
                                    </div>
                                    <span class="flex items-center text-xs text-custom-snow/50 font-medium truncate">
                                        <i class="far fa-file-alt mr-1.5 text-[#ff6b6b]/70"></i>
                                        @Localizer["PdfDocument"]
                                    </span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@section Scripts
{
    <script>
        function showLockAnimation(element) {
            if (element.classList.contains('premium-locked-active')) return;
            element.classList.add('premium-locked-active');
            if (navigator.vibrate) navigator.vibrate(50);
            setTimeout(() => {
                element.classList.remove('premium-locked-active');
            }, 1500);
        }
    </script>
}