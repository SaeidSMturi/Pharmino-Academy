@using System.Globalization
@using Microsoft.Extensions.Options
@inject IOptions<Domain.Configuration.PasswordPolicyOptions> PasswordPolicy
@*
    One-page sign-up (approved sketches 1–6). Six steps; each slides away when done and the next slides in.
    Nothing is saved until the email code is verified (step 6): the page then posts everything once to
    SignupController.Create. Styles: css/signup.css · behaviour: js/signup.js · step 6 is the React OTP
    component, built from ClientApp into dist/signup/signup.js.
*@
@{
    var currentCulture = CultureInfo.CurrentCulture.Name;
    var isRtl = CultureInfo.CurrentCulture.TextInfo.IsRightToLeft;
    var isFarsi = currentCulture.StartsWith("fa", StringComparison.OrdinalIgnoreCase);
    var isArabic = currentCulture.StartsWith("ar", StringComparison.OrdinalIgnoreCase);
    var policy = PasswordPolicy.Value;
    Layout = null;
}
<!DOCTYPE html>
<html lang="@currentCulture" dir="@(isRtl ? "rtl" : "ltr")">
<head>
    <script>
        (function () {
            try {
                var theme = localStorage.getItem('pharmino_theme') || 'dark';
                document.documentElement.setAttribute('data-theme', theme);
                document.documentElement.classList.add(theme === 'light' ? 'light' : 'dark', theme === 'light' ? 'light-theme' : 'dark-theme');
            } catch (e) { document.documentElement.classList.add('dark', 'dark-theme'); }
        })();
    </script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, follow">
    <title>@Localizer["RegisterTitle"] - @Localizer["SiteName"]</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/dist/signup/flag-icons/css/flag-icons.min.css" />
    <link rel="stylesheet" href="~/dist/signup/signup.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/signup.css" asp-append-version="true" />
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #0b0f19; color: #f1f5f9; }
        html.light body { background-color: #f4f6fb; color: #0f172a; }
    </style>
    @if (isFarsi)
    {
        <style>
            @@font-face { font-family: 'B Nazanin'; src: url('/fonts/BNazanin.ttf') format('truetype'); font-display: swap; }
            body, h1, h2, h3, p, span, a, label, button { font-family: 'B Nazanin', Tahoma, sans-serif !important; }
        </style>
    }
    else if (isArabic)
    {
        <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">
        <style> body, h1, h2, h3, p, span, a, label, button { font-family: 'Cairo', sans-serif !important; } </style>
    }
</head>
<body class="antialiased">

    <div class="absolute top-4 @(isRtl ? "left-4" : "right-4") z-50 flex items-center gap-2">
        <div class="glass-panel p-1.5 rounded-full bg-slate-900/40 border border-white/10 shadow-lg flex items-center gap-2">
            <partial name="_ThemeToggle" />
            <partial name="_LanguageSwitcher" />
        </div>
    </div>

    <div class="min-h-screen flex flex-col items-center justify-center relative px-4 py-20 overflow-hidden">

        <main class="su relative z-10" id="su"
              data-country="@ViewBag.DetectedCountry"
              data-terms-version="@Application.DTOs.Account.SignupTerms.Version"
              data-min-age="@Application.DTOs.Account.SignupTerms.MinimumAge"
              data-pw-len="@policy.RequiredLength" data-pw-upper="@policy.RequireUppercase.ToString().ToLowerInvariant()"
              data-pw-lower="@policy.RequireLowercase.ToString().ToLowerInvariant()" data-pw-digit="@policy.RequireDigit.ToString().ToLowerInvariant()"
              data-pw-special="@policy.RequireSpecialCharacter.ToString().ToLowerInvariant()" data-pw-chars="@policy.SpecialCharacters"
              data-pw-unique="@policy.MinimumUniqueCharacters"
              data-url-check-email="@Url.Action("CheckEmail", "Signup")" data-url-check-phone="@Url.Action("CheckPhone", "Signup")"
              data-url-send-code="@Url.Action("SendCode", "Signup")" data-url-verify-code="@Url.Action("VerifyCode", "Signup")"
              data-url-create="@Url.Action("Create", "Signup")">
            <div class="su-card">
                @* Stepper: look of 21st.dev "Segmented Progress Pill Stepper" (shadcnspace stepper-04). *@
                <div class="su-stepper">
                    <div class="su-stepper-head"><h3 id="su-stepname">Your email</h3><p id="su-steplabel">Step 1 of 6</p></div>
                    <div class="su-track" aria-hidden="true"><i class="fill" id="su-track-fill"></i><i class="pill" id="su-track-pill"></i></div>
                    <ol class="su-steps" id="su-steps" aria-label="Sign-up steps">
                        <li><button type="button" data-goto="1" aria-current="step"><svg class="ck" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg><span>Email</span></button></li>
                        <li><button type="button" data-goto="2" disabled><svg class="ck" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg><span>About you</span></button></li>
                        <li><button type="button" data-goto="3" disabled><svg class="ck" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg><span>Password</span></button></li>
                        <li><button type="button" data-goto="4" disabled><svg class="ck" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg><span>Phone</span></button></li>
                        <li><button type="button" data-goto="5" disabled><svg class="ck" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg><span>Terms</span></button></li>
                        <li><button type="button" data-goto="6" disabled><svg class="ck" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg><span>Verify</span></button></li>
                    </ol>
                </div>
                <div class="su-sr" aria-live="polite" id="su-live"></div>

                <form id="su-form" novalidate autocomplete="on" onsubmit="return false">
                    @Html.AntiForgeryToken()

                    @* ---------- Step 1: email ---------- *@
                    <section class="su-step is-active" data-step="1" data-name="Your email" aria-labelledby="su-h1">
                        <svg class="su-env su-f" id="su-env" viewBox="0 0 104 78" aria-hidden="true">
                            <g class="letter"><rect x="18" y="18" width="68" height="42" rx="3" fill="#f8fafc" stroke="#94a3b8" /><line x1="26" y1="30" x2="70" y2="30" stroke="#94a3b8" /><line x1="26" y1="38" x2="60" y2="38" stroke="#94a3b8" /></g>
                            <rect x="6" y="15" width="92" height="57" rx="7" fill="#1D9E75" />
                            <path d="M6 72 L52 41 L98 72" fill="none" stroke="#0F6E56" stroke-width="1.5" />
                            <path class="flap" d="M6 22 Q6 15 13 15 H91 Q98 15 98 22 L52 50 Z" fill="#5DCAA5" stroke="#0F6E56" stroke-width="1.5" />
                            <g class="seal"><circle cx="52" cy="50" r="12" fill="#0F6E56" /><path d="M46 50 l4.5 4.5 l8 -9" fill="none" stroke="#E1F5EE" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" /></g>
                        </svg>
                        <h1 class="su-title su-f" id="su-h1">Create your account</h1>
                        <p class="su-sub su-f">Start with your email. We'll send a code to it at the end.</p>
                        <div class="su-f">
                            <label class="su-label" for="su-email">Email</label>
                            <input class="su-input" id="su-email" type="email" name="email" autocomplete="email" inputmode="email" placeholder="name@example.com" maxlength="200" dir="ltr">
                            <div class="su-msg" id="su-email-msg"></div>
                        </div>
                        <div class="su-nav su-f"><button type="button" class="su-btn su-btn-primary" data-next>Next</button></div>
                    </section>

                    @* ---------- Step 2: name + three-ring date dial ---------- *@
                    <section class="su-step" data-step="2" data-name="About you" aria-labelledby="su-h2">
                        <h2 class="su-title su-f" id="su-h2">About you</h2>
                        <div class="su-row su-stack su-f">
                            <div><label class="su-label" for="su-first">First name</label><input class="su-input" id="su-first" autocomplete="given-name" placeholder="John" maxlength="200"></div>
                            <div><label class="su-label" for="su-last">Last name</label><input class="su-input" id="su-last" autocomplete="family-name" placeholder="Doe" maxlength="200"></div>
                        </div>
                        <div class="su-f">
                            <span class="su-label" id="su-dob-label">Date of birth</span>
                            <svg class="su-dial" id="su-dial" viewBox="0 0 240 240" role="group" aria-labelledby="su-dob-label">
                                <circle class="face" cx="120" cy="120" r="117" />
                                <g class="ring" data-ring="y" tabindex="0" role="slider" aria-label="Year"><circle class="band" cx="120" cy="120" r="104" stroke-width="24" /></g>
                                <g class="ring" data-ring="m" tabindex="0" role="slider" aria-label="Month"><circle class="band" cx="120" cy="120" r="78" stroke-width="24" /></g>
                                <g class="ring" data-ring="d" tabindex="0" role="slider" aria-label="Day"><circle class="band" cx="120" cy="120" r="53" stroke-width="22" /></g>
                                <circle class="hub" cx="120" cy="120" r="40" pointer-events="none" />
                                <text class="cdate" x="120" y="117" text-anchor="middle" pointer-events="none" id="su-cdate"></text>
                                <text class="cyear" x="120" y="135" text-anchor="middle" pointer-events="none" id="su-cyear"></text>
                                <rect x="111" y="1" width="18" height="118" rx="9" fill="none" stroke="#1D9E75" stroke-width="1.5" opacity=".7" pointer-events="none" />
                                <path d="M120 0 l-5 0 l5 7 l5 -7z" fill="#1D9E75" pointer-events="none" />
                            </svg>
                            <div class="su-age" id="su-age"></div>
                            <div class="su-hint">Outer: years · middle: months · inner: days. Drag, scroll, use arrows or tap a value.</div>
                        </div>
                        <div class="su-msg bad su-f" id="su-about-msg"></div>
                        <div class="su-nav su-f"><button type="button" class="su-btn su-btn-ghost" data-back>Back</button><button type="button" class="su-btn su-btn-primary" data-next>Next</button></div>
                    </section>

                    @* ---------- Step 3: password ---------- *@
                    <section class="su-step" data-step="3" data-name="Password" aria-labelledby="su-h3">
                        <svg class="su-lock su-f" id="su-lock" viewBox="0 0 64 72" aria-hidden="true">
                            <path class="shackle" id="su-shackle" d="M18 34 V22 a14 14 0 0 1 28 0 V34" fill="none" stroke-width="6" stroke-linecap="round" style="transform:translateY(-12px)" />
                            <rect class="body" x="8" y="32" width="48" height="36" rx="8" />
                            <circle cx="32" cy="48" r="4" fill="#0b0f19" /><rect x="30.5" y="49" width="3" height="9" rx="1.5" fill="#0b0f19" />
                        </svg>
                        <h2 class="su-title su-f" id="su-h3">Create a password</h2>
                        <div class="su-f">
                            <label class="su-label" for="su-pw">Password</label>
                            <div class="su-pw"><input class="su-input" id="su-pw" type="password" autocomplete="new-password" placeholder="Create a password" maxlength="200" dir="ltr"><button type="button" class="su-eye" id="su-eye" aria-label="Show password"><i class="fas fa-eye"></i></button></div>
                            <div class="su-meter" aria-hidden="true"><i id="su-meter"></i></div>
                            <div class="su-level" id="su-level"></div>
                            <ul class="su-rules" id="su-rules"></ul>
                        </div>
                        <div class="su-f">
                            <label class="su-label" for="su-pw2">Confirm password</label>
                            <div class="su-pw" id="su-pw2-wrap"><input class="su-input" id="su-pw2" type="password" autocomplete="new-password" placeholder="Type it again" maxlength="200" dir="ltr"></div>
                            <div class="su-msg" id="su-pw-msg"></div>
                        </div>
                        <div class="su-nav su-f"><button type="button" class="su-btn su-btn-ghost" data-back>Back</button><button type="button" class="su-btn su-btn-primary" data-next>Next</button></div>
                    </section>

                    @* ---------- Step 4: phone ---------- *@
                    <section class="su-step" data-step="4" data-name="Phone" aria-labelledby="su-h4">
                        <svg class="su-phone su-f" id="su-phone" viewBox="0 0 92 150" aria-hidden="true">
                            <rect class="frame" x="6" y="2" width="80" height="146" rx="14" stroke-width="2" />
                            <rect class="screen" x="13" y="16" width="66" height="104" rx="4" />
                            <rect x="36" y="7" width="20" height="3" rx="1.5" fill="#64748b" />
                            <text class="cc" x="46" y="44" text-anchor="middle" id="su-phone-cc"></text>
                            <text class="num" x="46" y="62" text-anchor="middle" id="su-phone-num"></text>
                            <g class="tick"><circle cx="46" cy="92" r="11" fill="#1D9E75" /><path d="M41 92 l4 4 l7 -8" fill="none" stroke="#E1F5EE" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></g>
                            <rect x="38" y="130" width="16" height="8" rx="4" fill="none" stroke="#64748b" />
                        </svg>
                        <h2 class="su-title su-f" id="su-h4">Your mobile number</h2>
                        <div class="su-f">
                            <label class="su-label" for="su-tel">Mobile number</label>
                            <div class="su-tel" id="su-tel-row" dir="ltr">
                                <button type="button" class="su-cc" id="su-cc" aria-haspopup="listbox" aria-expanded="false" aria-label="Country code"><span class="fi" id="su-flag"></span><span id="su-cc-label">+</span><i class="fas fa-chevron-down" style="font-size:.7em"></i></button>
                                <input class="su-input" id="su-tel" type="tel" inputmode="tel" autocomplete="tel-national" placeholder="Your number">
                                <div class="su-pop" id="su-pop" hidden>
                                    <input class="su-input" id="su-cq" placeholder="Search country or code" aria-label="Search countries" autocomplete="off">
                                    <div class="su-list" id="su-list" role="listbox" aria-label="Countries"></div>
                                </div>
                            </div>
                            <div class="su-msg" id="su-detect"></div>
                            <div class="su-msg" id="su-tel-msg"></div>
                            <p class="su-note">Used for account recovery and course updates. We never share it.</p>
                        </div>
                        <div class="su-nav su-f"><button type="button" class="su-btn su-btn-ghost" data-back>Back</button><button type="button" class="su-btn su-btn-primary" data-next>Next</button></div>
                    </section>

                    @* ---------- Step 5: terms ---------- *@
                    <section class="su-step" data-step="5" data-name="Terms" aria-labelledby="su-h5">
                        <h2 class="su-title" id="su-h5">Terms and conditions</h2>
                        <div class="su-tbar"><span class="su-chip">Agreed compensation of 50–1,000 OMR applies</span><button type="button" class="su-link su-jump" id="su-jump">Jump to section 6 ↓</button></div>
                        <div class="su-read" aria-hidden="true"><i id="su-read"></i></div>
                        <div class="su-doc" id="su-doc" tabindex="0" role="document" aria-label="Terms and conditions">
                            <partial name="_SignupTerms" />
                        </div>
                        <label class="su-chk lock" data-lock><input type="checkbox" id="su-c1" disabled><span>I have read and agree to the Terms of use and student agreement.</span></label>
                        <label class="su-chk lock" data-lock><input type="checkbox" id="su-c3" disabled><span>I consent to Pharmino processing my personal data as described in section 9 and the Privacy Policy.</span></label>
                        <div class="su-msg" id="su-terms-msg">Scroll to the end of the terms to continue.</div>
                        <div class="su-nav"><button type="button" class="su-btn su-btn-ghost" data-back>Back</button><button type="button" class="su-btn su-btn-primary" id="su-agree">Agree and send my code <span class="su-plane"><i class="fas fa-paper-plane"></i></span></button></div>
                    </section>

                    @* ---------- Step 6: email code (React OTP component) ---------- *@
                    <section class="su-step" data-step="6" data-name="Verify email" aria-label="Verify your email">
                        <div class="su-otp" id="su-otp"></div>
                        <div class="su-creating" id="su-creating" aria-live="polite"></div>
                    </section>
                </form>
            </div>
            <p class="su-foot">Already have an account? <a asp-controller="Account" asp-action="Login">Sign in</a></p>
        </main>
    </div>

    <script src="~/js/gradient-bg.js" asp-append-version="true" data-preset="site"></script>
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <script src="~/dist/signup/signup.js" asp-append-version="true"></script>
    <script src="~/js/signup.js" asp-append-version="true"></script>
</body>
</html>
