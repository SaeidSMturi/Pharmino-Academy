        const countryCodeButton = document.getElementById('country-code-button');
        const countryCodeDropdown = document.getElementById('country-code-dropdown');
        const countryList = document.getElementById('country-list');
        const countrySearch = document.getElementById('country-search');
        const selectedCountryFlag = document.getElementById('selected-country-flag');
        const selectedCountryCode = document.getElementById('selected-country-code');
        const countryCodeInput = document.getElementById('country-code-input');

        function populateCountryList(filter = '') {
        countryList.innerHTML = '';
        const filteredCountries = countries.filter(c =>
        c.name.toLowerCase().includes(filter.toLowerCase()) ||
        c.code.includes(filter)
        );

        filteredCountries.forEach(country => {
        const li = document.createElement('li');
        li.classList.add('px-3', 'py-2.5', 'mb-1', 'cursor-pointer', 'hover:bg-brand-blue/20', 'rounded-lg', 'flex', 'items-center', 'text-sm', 'transition-colors');
        li.dataset.code = country.code;
        li.dataset.flag = country.flag;

        li.innerHTML = `
        <span class="text-xl">${country.flag}</span>
        <span class="ml-3 font-medium text-slate-300 group-hover:text-white">${country.name}</span>
        <span class="ml-auto text-slate-500 text-xs">${country.code}</span>
        `;

        li.addEventListener('click', () => {
        selectedCountryFlag.textContent = country.flag;
        selectedCountryCode.textContent = country.code;
        countryCodeInput.value = country.code;
        countryCodeDropdown.classList.add('hidden');
        });
        countryList.appendChild(li);
        });
        }

        populateCountryList();

        countryCodeButton.addEventListener('click', (e) => {
        e.stopPropagation();
        countryCodeDropdown.classList.toggle('hidden');
        });

        countrySearch.addEventListener('keyup', () => {
        populateCountryList(countrySearch.value);
        });

        document.addEventListener('click', (e) => {
        if (!document.getElementById('country-code-container').contains(e.target)) {
        countryCodeDropdown.classList.add('hidden');
        }
        });
        });
