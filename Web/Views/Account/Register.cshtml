@model Application.DTOs.Account.RegisterDto
@using System.Globalization
@{
    var currentCulture = CultureInfo.CurrentCulture.Name;
    var isRtl = CultureInfo.CurrentCulture.TextInfo.IsRightToLeft;
    Layout = null;
}

<!DOCTYPE html>
<html lang="@currentCulture" dir="@(isRtl ? "rtl" : "ltr")">
<head>
    <script>
        (function () {
            try {
                var theme = localStorage.getItem('pharmino_theme') || 'dark';
                document.documentElement.setAttribute('data-theme', theme);
                if (theme === 'light') {
                    document.documentElement.classList.add('light', 'light-theme');
                } else {
                    document.documentElement.classList.add('dark', 'dark-theme');
                }
            } catch (e) { }
        })();
    </script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@Localizer["RegisterTitle"] - @Localizer["SiteName"]</title>
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
        theme: {
        extend: {
        colors: {
        'brand-yellow': '#FFB343',
        'brand-cyan': '#42EAFF',
        'brand-blue': '#4272FF',
        'brand-orange': '#FF7E42',
        'dark-bg': '#0B0F19'
        },
        animation: {
        'blob': 'blob 7s infinite',
        },
        keyframes: {
        blob: {
        '0%': { transform: 'translate(0px, 0px) scale(1)' },
        '33%': { transform: 'translate(30px, -50px) scale(1.1)' },
        '66%': { transform: 'translate(-20px, 20px) scale(0.9)' },
        '100%': { transform: 'translate(0px, 0px) scale(1)' },
        }
        }
        }
        }
        }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
        font-family: 'Inter', sans-serif;
        background-color: #0B0F19;
        color: #e2e8f0;
        overflow-x: hidden;
        }

        .glass-panel {
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);
        }

        .animation-delay-2000 {
        animation-delay: 2s;
        }

        /* Custom scrollbar for dropdown هماهنگ با رنگ‌های جدید */
        .country-dropdown-list::-webkit-scrollbar {
        width: 6px;
        }

        .country-dropdown-list::-webkit-scrollbar-track {
        background: rgba(15, 23, 42, 0.5); /* slate-900/50 */
        border-radius: 10px;
        }

        .country-dropdown-list::-webkit-scrollbar-thumb {
        background: #4272FF; /* brand-blue */
        border-radius: 10px;
        }

        .country-dropdown-list::-webkit-scrollbar-thumb:hover {
        background: #42EAFF; /* brand-cyan */
        }

        .validation-summary-valid {
            display: none;
        }
        .field-validation-valid {
            display: none;
        }
        .validation-summary-errors {
            background-color: rgba(239, 68, 68, 0.1);
            border: 1px solid rgba(239, 68, 68, 0.2);
            border-radius: 0.75rem;
            padding: 0.75rem 1rem;
            margin-bottom: 1rem;
            color: #f87171;
            font-size: 0.875rem;
            font-weight: 500;
        }
        .validation-summary-errors ul {
            list-style-type: disc;
            padding-inline-start: 1.25rem;
        }
        .field-validation-error {
            color: #f87171;
            font-size: 0.75rem;
            margin-top: 0.25rem;
            display: block;
        }
        .input-validation-error {
            border-color: #ef4444 !important;
        }
    </style>
    @{
        var isFarsi = currentCulture.StartsWith("fa", StringComparison.OrdinalIgnoreCase);
        var isArabic = currentCulture.StartsWith("ar", StringComparison.OrdinalIgnoreCase);
    }
    @if (isFarsi)
    {
        <style>
            @@font-face {
                font-family: 'B Nazanin';
                src: url('/fonts/BNazanin.ttf') format('truetype');
                font-weight: normal;
                font-style: normal;
                font-display: swap;
            }
            html {
                font-size: 19px !important;
            }
            body, h1, h2, h3, h4, h5, h6, p, span, a, input, button, label, select, option {
                font-family: 'B Nazanin', Tahoma, sans-serif !important;
            }
        </style>
    }
    else if (isArabic)
    {
        <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
        <style>
            body, h1, h2, h3, h4, h5, h6, p, span, a, input, button, label, select, option {
                font-family: 'Cairo', sans-serif !important;
            }
        </style>
    }
</head>
<body class="antialiased relative min-h-screen">

    <!-- Floating Theme & Language Switcher -->
    <div class="absolute top-4 right-4 z-50 flex items-center gap-2">
        <div class="glass-panel p-1.5 rounded-full bg-slate-900/40 border border-white/10 shadow-lg flex items-center gap-2">
            <partial name="_ThemeToggle" />
            <partial name="_LanguageSwitcher" />
        </div>
    </div>

    <div class="fixed inset-0 z-0 overflow-hidden pointer-events-none">
        <div class="absolute top-[-5%] left-[-10%] w-[500px] h-[500px] bg-brand-blue rounded-full mix-blend-screen filter blur-[120px] opacity-30 animate-blob"></div>
        <div class="absolute bottom-[-10%] right-[-10%] w-[400px] h-[400px] bg-brand-cyan rounded-full mix-blend-screen filter blur-[120px] opacity-20 animate-blob animation-delay-2000"></div>
    </div>

    <div class="relative z-10 min-h-screen flex flex-col items-center justify-center p-4 py-10">

        <main class="w-full max-w-lg">
            <div class="glass-panel rounded-3xl p-8 md:p-10 transition-all duration-300 hover:border-brand-blue/30 shadow-2xl">
                <div class="text-center mb-8">
                    <h1 class="text-3xl font-extrabold text-white tracking-tight">@Localizer["RegisterTitle"]</h1>
                    <p class="text-slate-400 mt-2 text-sm">@Localizer["RegisterSub"]</p>
                </div>

                <form asp-action="Register" asp-controller="Account" method="POST" class="space-y-5">
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="p-4 rounded-xl bg-red-500/10 border border-red-500/30 text-red-400 flex items-center space-x-3 text-sm">
                            <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                            <span>@TempData["ErrorMessage"]</span>
                        </div>
                    }
                    <div asp-validation-summary="ModelOnly" class="text-red-400 text-sm font-medium bg-red-500/10 border border-red-500/20 rounded-xl p-3 empty:hidden"></div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label asp-for="FirstName" class="block text-sm font-medium text-slate-300 mb-1.5">@Localizer["FirstName"]</label>
                            <div class="relative">
                                <input asp-for="FirstName" type="text" autocomplete="given-name" required
                                       class="w-full bg-slate-900/50 border border-slate-700/50 rounded-xl p-3.5 text-white placeholder-slate-500 focus:ring-2 focus:ring-brand-cyan/50 focus:border-brand-cyan focus:outline-none transition-all duration-200">
                            </div>
                            <span asp-validation-for="FirstName" class="text-red-400 text-xs mt-1 block"></span>
                        </div>
                        <div>
                            <label asp-for="LastName" class="block text-sm font-medium text-slate-300 mb-1.5">@Localizer["LastName"]</label>
                            <div class="relative">
                                <input asp-for="LastName" type="text" autocomplete="family-name" required
                                       class="w-full bg-slate-900/50 border border-slate-700/50 rounded-xl p-3.5 text-white placeholder-slate-500 focus:ring-2 focus:ring-brand-cyan/50 focus:border-brand-cyan focus:outline-none transition-all duration-200">
                            </div>
                            <span asp-validation-for="LastName" class="text-red-400 text-xs mt-1 block"></span>
                        </div>
                    </div>

                    <div>
                        <label asp-for="PhoneNumber" class="block text-sm font-medium text-slate-300 mb-1.5">@Localizer["PhoneNumber"]</label>
                        <div class="mt-1 flex rounded-xl shadow-sm">
                            <div id="country-code-container" class="relative w-1/3">
                                <button type="button" id="country-code-button" class="flex items-center justify-center w-full h-full rounded-l-xl border border-r-0 border-slate-700/50 bg-slate-900/50 p-3.5 focus:ring-2 focus:ring-brand-cyan/50 focus:border-brand-cyan focus:outline-none transition-all duration-200 text-white">
                                    <span id="selected-country-flag" class="text-lg">🇴🇲</span>
                                    <span id="selected-country-code" class="mx-2 text-sm font-medium">+968</span>
                                </button>
                                <div id="country-code-dropdown" class="absolute z-20 hidden mt-2 w-72 max-h-60 overflow-y-auto rounded-xl bg-slate-800 border border-slate-700/50 shadow-xl ring-1 ring-black ring-opacity-5 focus:outline-none country-dropdown-list backdrop-blur-xl">
                                    <div class="p-3 sticky top-0 bg-slate-800 z-10 border-b border-slate-700/50">
                                        <input type="text" id="country-search" class="w-full bg-slate-900/50 border border-slate-600/50 rounded-lg p-2.5 text-sm text-white placeholder-slate-400 focus:ring-2 focus:ring-brand-cyan/50 focus:border-brand-cyan focus:outline-none transition-all" placeholder="@Localizer["SearchCountry"]">
                                    </div>
                                    <ul id="country-list" class="p-2">
                                    </ul>
                                </div>
                                <input type="hidden" name="country-code" id="country-code-input" value="+968">
                            </div>
                            <input type="tel" asp-for="PhoneNumber" required
                                   class="block w-2/3 rounded-r-xl bg-slate-900/50 border border-slate-700/50 p-3.5 focus:ring-2 focus:ring-brand-cyan/50 focus:border-brand-cyan focus:outline-none transition-all duration-200 text-white placeholder-slate-500" placeholder="123 456 789">
                        </div>
                        <span asp-validation-for="PhoneNumber" class="text-red-400 text-xs mt-1 block"></span>
                    </div>

                    <div>
                        <label asp-for="Email" class="block text-sm font-medium text-slate-300 mb-1.5">@Localizer["EmailAddress"]</label>
                        <div class="relative">
                            <input asp-for="Email" type="email" autocomplete="email" required
                                   class="w-full bg-slate-900/50 border border-slate-700/50 rounded-xl p-3.5 text-white placeholder-slate-500 focus:ring-2 focus:ring-brand-cyan/50 focus:border-brand-cyan focus:outline-none transition-all duration-200">
                        </div>
                        <span asp-validation-for="Email" class="text-red-400 text-xs mt-1 block"></span>
                    </div>

                    <div>
                        <label asp-for="Password" class="block text-sm font-medium text-slate-300 mb-1.5">@Localizer["Password"]</label>
                        <div class="relative">
                            <input asp-for="Password" type="password" autocomplete="new-password" required id="password-input"
                                   class="w-full bg-slate-900/50 border border-slate-700/50 rounded-xl p-3.5 text-white placeholder-slate-500 focus:ring-2 focus:ring-brand-cyan/50 focus:border-brand-cyan focus:outline-none transition-all duration-200">
                        </div>
                        <span asp-validation-for="Password" class="text-red-400 text-xs mt-1 block"></span>

                        <div class="mt-3 p-4 bg-slate-900/40 border border-slate-700/50 rounded-xl transition-all duration-300">
                            <p class="text-xs font-semibold text-slate-300 mb-3">@Localizer["PasswordMustContain"]</p>
                            <ul class="grid grid-cols-1 md:grid-cols-2 gap-2 text-xs text-slate-400">
                                <li id="req-length" class="flex items-center transition-colors">
                                    <span class="@(isRtl ? "ml-2" : "mr-2") text-[10px] w-3 h-3 flex items-center justify-center rounded-full bg-slate-800">✗</span>
                                    <span>@Localizer["AtLeast8Chars"]</span>
                                </li>
                                <li id="req-uppercase" class="flex items-center transition-colors">
                                    <span class="@(isRtl ? "ml-2" : "mr-2") text-[10px] w-3 h-3 flex items-center justify-center rounded-full bg-slate-800">✗</span>
                                    <span>@Localizer["OneUppercase"]</span>
                                </li>
                                <li id="req-lowercase" class="flex items-center transition-colors">
                                    <span class="@(isRtl ? "ml-2" : "mr-2") text-[10px] w-3 h-3 flex items-center justify-center rounded-full bg-slate-800">✗</span>
                                    <span>@Localizer["OneLowercase"]</span>
                                </li>
                                <li id="req-digit" class="flex items-center transition-colors">
                                    <span class="@(isRtl ? "ml-2" : "mr-2") text-[10px] w-3 h-3 flex items-center justify-center rounded-full bg-slate-800">✗</span>
                                    <span>@Localizer["OneDigit"]</span>
                                </li>
                                <li id="req-special" class="flex items-center transition-colors">
                                    <span class="@(isRtl ? "ml-2" : "mr-2") text-[10px] w-3 h-3 flex items-center justify-center rounded-full bg-slate-800">✗</span>
                                    <span>@Localizer["OneSpecialChar"]</span>
                                </li>
                                <li id="req-unique" class="flex items-center transition-colors">
                                    <span class="@(isRtl ? "ml-2" : "mr-2") text-[10px] w-3 h-3 flex items-center justify-center rounded-full bg-slate-800">✗</span>
                                    <span>@Localizer["FourUniqueChars"]</span>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <div>
                        <label asp-for="ConfirmPassword" class="block text-sm font-medium text-slate-300 mb-1.5">@Localizer["ConfirmPassword"]</label>
                        <div class="relative">
                            <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" required
                                   class="w-full bg-slate-900/50 border border-slate-700/50 rounded-xl p-3.5 text-white placeholder-slate-500 focus:ring-2 focus:ring-brand-cyan/50 focus:border-brand-cyan focus:outline-none transition-all duration-200">
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-red-400 text-xs mt-1 block"></span>
                    </div>

                    <div class="pt-3">
                        <button type="submit"
                                class="w-full flex justify-center py-3.5 px-4 rounded-xl shadow-lg shadow-brand-orange/20 text-base font-bold text-slate-900 bg-gradient-to-r from-brand-yellow to-brand-orange hover:from-brand-orange hover:to-brand-yellow focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-dark-bg focus:ring-brand-yellow transition-all duration-300 transform hover:-translate-y-0.5">
                            @Localizer["RegisterTitle"]
                        </button>
                    </div>

                </form>
            </div>

            <p class="mt-8 text-center text-sm text-slate-400">
                @Localizer["AlreadyHaveAccount"]
                <a asp-area="" asp-controller="Account" asp-action="Login" class="font-semibold text-brand-cyan hover:text-brand-blue transition-colors">
                    @Localizer["SignIn"]
                </a>
            </p>
        </main>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
        // Password strength validation
        const passwordInput = document.getElementById('password-input');
        if (passwordInput) {
        passwordInput.addEventListener('input', function() {
        validatePassword(this.value);
        });
        }

        function validatePassword(password) {
        const requirements = {
        length: password.length >= 8,
        uppercase: /[A-Z]/.test(password),
        lowercase: /[a-z]/.test(password),
        digit: /\d/.test(password),
        special: /[!@@#$%^&*()_+\-=\[\]{}|;:,.<>?]/.test(password),
        unique: new Set(password).size >= 4
        };

        updateRequirement('req-length', requirements.length);
        updateRequirement('req-uppercase', requirements.uppercase);
        updateRequirement('req-lowercase', requirements.lowercase);
        updateRequirement('req-digit', requirements.digit);
        updateRequirement('req-special', requirements.special);
        updateRequirement('req-unique', requirements.unique);
        }

        function updateRequirement(id, isValid) {
        const element = document.getElementById(id);
        if (element) {
        const icon = element.querySelector('span:first-child');
        if (isValid) {
        icon.textContent = '✓';
        // Style for valid requirement
        icon.classList.add('bg-green-500/20', 'text-green-400');
        icon.classList.remove('bg-slate-800', 'text-slate-400');
        element.classList.add('text-green-400');
        element.classList.remove('text-slate-400');
        } else {
        icon.textContent = '✗';
        // Style for invalid requirement
        icon.classList.add('bg-slate-800', 'text-slate-400');
        icon.classList.remove('bg-green-500/20', 'text-green-400');
