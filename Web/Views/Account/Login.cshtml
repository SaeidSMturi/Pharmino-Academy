@model Application.DTOs.Account.LoginDto
@using System.Globalization
@{
    var currentCulture = CultureInfo.CurrentCulture.Name;
    var isRtl = CultureInfo.CurrentCulture.TextInfo.IsRightToLeft;
    ViewData["Title"] = Localizer["WelcomeBack"].Value;
    Layout = null;
}
<!DOCTYPE html>
<html lang="@currentCulture" dir="@(isRtl ? "rtl" : "ltr")">
<head>
    <script>
        (function () {
            try {
                var theme = localStorage.getItem('pharmino_theme') || 'dark';
                document.documentElement.setAttribute('data-theme', theme);
                if (theme === 'light') {
                    document.documentElement.classList.add('light', 'light-theme');
                } else {
                    document.documentElement.classList.add('dark', 'dark-theme');
                }
            } catch (e) { }
        })();
    </script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - @Localizer["SiteName"]</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #0b0f19;
            color: #f1f5f9;
        }
        @@keyframes liquid-background {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }
        .liquid-glass {
            background-color: rgba(15, 23, 42, 0.45);
            background-image: linear-gradient(110deg, rgba(66, 114, 255, 0.1) 0%, rgba(255, 126, 66, 0.05) 50%, rgba(66, 114, 255, 0.1) 100%);
            background-size: 200% 200%;
            animation: liquid-background 12s ease infinite;
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        }
        .custom-gradient-btn {
            background: linear-gradient(135deg, #4272FF 0%, #FF7E42 100%);
            background-size: 200% auto;
            transition: 0.4s ease;
        }
        .custom-gradient-btn:hover {
            background-position: right center;
            box-shadow: 0 10px 25px -5px rgba(66, 114, 255, 0.4);
        }
    </style>
    @{
        var isFarsi = currentCulture.StartsWith("fa", StringComparison.OrdinalIgnoreCase);
        var isArabic = currentCulture.StartsWith("ar", StringComparison.OrdinalIgnoreCase);
    }
    @if (isFarsi)
    {
        <style>
            @@font-face {
                font-family: 'B Nazanin';
                src: url('/fonts/BNazanin.ttf') format('truetype');
                font-weight: normal;
                font-style: normal;
                font-display: swap;
            }
            html {
                font-size: 19px !important;
            }
            body, h1, h2, h3, h4, h5, h6, p, span, a, input, button, label, select, option {
                font-family: 'B Nazanin', Tahoma, sans-serif !important;
            }
        </style>
    }
    else if (isArabic)
    {
        <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
        <style>
            body, h1, h2, h3, h4, h5, h6, p, span, a, input, button, label, select, option {
                font-family: 'Cairo', sans-serif !important;
            }
        </style>
    }
</head>
<body class="antialiased selection:bg-cyan-500 selection:text-white">

    <!-- Floating Theme & Language Switcher -->
    <div class="absolute top-4 right-4 z-50 flex items-center gap-2">
        <div class="glass-panel p-1.5 rounded-full bg-slate-900/40 border border-white/10 shadow-lg flex items-center gap-2">
            <partial name="_ThemeToggle" />
            <partial name="_LanguageSwitcher" />
        </div>
    </div>

    <div class="min-h-screen flex flex-col items-center justify-center relative p-4 overflow-hidden">
        <div class="absolute top-[-10%] left-[-10%] w-[50vw] h-[50vw] rounded-full bg-[#4272FF]/15 blur-[120px] pointer-events-none"></div>
        <div class="absolute bottom-[-10%] right-[-10%] w-[50vw] h-[50vw] rounded-full bg-[#FF7E42]/15 blur-[120px] pointer-events-none"></div>
        <div class="absolute top-[30%] right-[20%] w-[30vw] h-[30vw] rounded-full bg-[#42EAFF]/10 blur-[100px] pointer-events-none"></div>

        <main class="w-full max-w-md z-10">
            <div class="liquid-glass rounded-3xl p-8 md:p-10 transform transition-all duration-300">
                <div class="text-center mb-8">
                    <h1 class="text-3xl font-extrabold tracking-tight bg-gradient-to-r from-white via-slate-200 to-slate-400 bg-clip-text text-transparent">@Localizer["WelcomeBack"]</h1>
                    <p class="text-slate-400 mt-2 text-sm font-medium">@Localizer["LoginSub"]</p>
                </div>

                <form asp-action="Login" asp-controller="Account" method="post" class="space-y-5">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 flex items-center space-x-3 text-sm">
                            <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                            <span>@TempData["SuccessMessage"]</span>
                        </div>
                    }
                    <div asp-validation-summary="ModelOnly" class="text-red-400 text-sm font-medium bg-red-500/10 border border-red-500/20 rounded-xl p-3 empty:hidden"></div>

                    <div>
                        <label asp-for="UsernameOrEmail" class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1.5">@Localizer["EmailAddress"]</label>
                        <div class="relative group">
                            <input asp-for="UsernameOrEmail" type="email" autocomplete="email" required placeholder="name@example.com"
                                   class="w-full bg-slate-900/60 border border-slate-800 rounded-xl p-3.5 focus:border-[#4272FF] focus:ring-2 focus:ring-[#4272FF]/20 focus:outline-none transition-all text-white placeholder-slate-600 text-sm">
                        </div>
                        <span asp-validation-for="UsernameOrEmail" class="text-red-400 text-xs mt-1 block"></span>
                    </div>

                    <div>
                        <div class="flex items-center justify-between mb-1.5">
                            <label asp-for="Password" class="block text-xs font-semibold uppercase tracking-wider text-slate-400">@Localizer["Password"]</label>
                            <a asp-action="ForgotPassword" asp-controller="Account" class="text-xs font-semibold text-[#42EAFF] hover:text-[#4272FF] transition-colors">@Localizer["ForgotPasswordLink"]</a>
                        </div>
                        <div class="relative group">
                            <input asp-for="Password" type="password" autocomplete="current-password" required placeholder="••••••••"
                                   class="w-full bg-slate-900/60 border border-slate-800 rounded-xl p-3.5 focus:border-[#4272FF] focus:ring-2 focus:ring-[#4272FF]/20 focus:outline-none transition-all text-white placeholder-slate-600 text-sm">
                        </div>
                        <span asp-validation-for="Password" class="text-red-400 text-xs mt-1 block"></span>
                    </div>

                    <div class="pt-2">
                        <button type="submit"
                                class="w-full custom-gradient-btn py-3.5 px-4 rounded-xl shadow-lg text-sm font-bold text-white focus:outline-none transition-all transform active:scale-[0.98]">
                            @Localizer["SignIn"]
                        </button>
                    </div>

                </form>
            </div>

            <p class="mt-6 text-center text-sm text-slate-500 font-medium">
                @Localizer["NoAccount"]
                <a asp-area="" asp-controller="Account" asp-action="Register" class="font-bold text-[#FF7E42] hover:text-[#FFB343] transition-colors ml-1">
                    @Localizer["SignUpLink"]
                </a>
            </p>
        </main>
    </div>
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/theme.js" asp-append-version="true"></script>
</body>
</html>