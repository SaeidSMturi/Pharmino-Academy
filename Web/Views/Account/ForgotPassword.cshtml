@model Application.DTOs.Account.ForgotPasswordDto
@using System.Globalization
@{
    var currentCulture = CultureInfo.CurrentCulture.Name;
    var isRtl = CultureInfo.CurrentCulture.TextInfo.IsRightToLeft;
    ViewData["Title"] = Localizer["ForgotPasswordTitle"].Value;
    Layout = null;
}
<!DOCTYPE html>
<html lang="@currentCulture" dir="@(isRtl ? "rtl" : "ltr")">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - @Localizer["SiteName"]</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'brand-yellow': '#FFB343',
                        'brand-cyan': '#42EAFF',
                        'brand-blue': '#4272FF',
                        'brand-orange': '#FF7E42',
                        'dark-bg': '#0B0F19'
                    },
                    animation: {
                        'blob': 'blob 7s infinite',
                    },
                    keyframes: {
                        blob: {
                            '0%': { transform: 'translate(0px, 0px) scale(1)' },
                            '33%': { transform: 'translate(30px, -50px) scale(1.1)' },
                            '66%': { transform: 'translate(-20px, 20px) scale(0.9)' },
                            '100%': { transform: 'translate(0px, 0px) scale(1)' },
                        }
                    }
                }
            }
        }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #0B0F19;
            color: #e2e8f0;
            overflow-x: hidden;
        }
        .glass-panel {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);
        }
        .animation-delay-2000 {
            animation-delay: 2s;
        }
    </style>
    @if (isRtl)
    {
        <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
        <style>
            body, h1, h2, h3, h4, h5, h6, p, span, a, input, button, label, select, option {
                font-family: 'Cairo', sans-serif !important;
            }
        </style>
    }
</head>
<body class="antialiased relative min-h-screen">

    <!-- Floating Language Switcher -->
    <div class="absolute top-4 right-4 z-50">
        <div class="glass-panel p-1 rounded-full bg-slate-900/40 border border-white/10 shadow-lg">
            <partial name="_LanguageSwitcher" />
        </div>
    </div>

    <div class="fixed inset-0 z-0 overflow-hidden pointer-events-none">
        <div class="absolute top-[-10%] right-[-10%] w-96 h-96 bg-brand-blue rounded-full mix-blend-screen filter blur-[120px] opacity-30 animate-blob"></div>
        <div class="absolute bottom-[-10%] left-[-10%] w-96 h-96 bg-brand-cyan rounded-full mix-blend-screen filter blur-[120px] opacity-20 animate-blob animation-delay-2000"></div>
    </div>

    <div class="relative z-10 min-h-screen flex flex-col items-center justify-center p-4">
        <main class="w-full max-w-md">
            <div class="glass-panel rounded-3xl p-8 md:p-10 shadow-2xl transition-all duration-300 hover:border-brand-blue/20">
                <div class="text-center mb-8">
                    <div class="mb-4 inline-flex w-16 h-16 bg-brand-blue/10 rounded-2xl items-center justify-center border border-brand-blue/20">
                        <i class="fas fa-key text-brand-cyan text-2xl"></i>
                    </div>
                    <h1 class="text-3xl font-extrabold text-white tracking-tight">@Localizer["ForgotPasswordTitle"]</h1>
                    <p class="text-slate-400 mt-2 text-sm leading-relaxed">
                        @Localizer["ForgotPasswordSub"]
                    </p>
                </div>

                <form asp-action="ForgotPassword" asp-controller="Account" method="post" class="space-y-6">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="p-4 rounded-xl bg-brand-cyan/10 border border-brand-cyan/30 text-brand-cyan flex items-center space-x-3 text-sm animate-fade-in">
                            <i class="fas fa-check-circle text-lg"></i>
                            <span>@TempData["SuccessMessage"]</span>
                        </div>
                    }
                    <div asp-validation-summary="ModelOnly" class="text-red-400 text-sm mb-3"></div>

                    <div>
                        <label asp-for="Email" class="block text-sm font-medium text-slate-300 mb-1.5">@Localizer["EmailAddress"]</label>
                        <div class="relative">
                            <input asp-for="Email" type="email" required
                                   class="w-full bg-slate-900/50 border border-slate-700/50 rounded-xl p-3.5 text-white placeholder-slate-500 focus:ring-2 focus:ring-brand-cyan/50 focus:border-brand-cyan focus:outline-none transition-all duration-200"
                                   placeholder="name@example.com">
                        </div>
                        <span asp-validation-for="Email" class="text-red-400 text-xs mt-1 block"></span>
                    </div>

                    <div>
                        <button type="submit"
                                class="w-full flex justify-center py-3.5 px-4 rounded-xl shadow-lg shadow-brand-orange/20 text-base font-bold text-slate-900 bg-gradient-to-r from-brand-yellow to-brand-orange hover:from-brand-orange hover:to-brand-yellow focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-dark-bg focus:ring-brand-yellow transition-all duration-300 transform hover:-translate-y-0.5">
                            @Localizer["SendResetLink"]
                        </button>
                    </div>

                    <div class="text-center pt-2">
                        <a asp-action="Login" class="inline-flex items-center text-sm font-semibold text-brand-cyan hover:text-brand-blue transition-colors group">
                            <i class="fas @(isRtl ? "fa-arrow-right" : "fa-arrow-left") mx-2 text-xs group-hover:-translate-x-1 transition-transform"></i>
                            @Localizer["BackToLogin"]
                        </a>
                    </div>
                </form>
            </div>
        </main>
    </div>

    <partial name="_ValidationScriptsPartial" />
</body>
</html>