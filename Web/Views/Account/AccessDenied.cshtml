@using System.Globalization
@{
    var currentCulture = CultureInfo.CurrentCulture.Name;
    var isRtl = CultureInfo.CurrentCulture.TextInfo.IsRightToLeft;
    ViewData["Title"] = Localizer["AccessDenied"].Value;
    Layout = null;
}
<!DOCTYPE html>
<html lang="@currentCulture" dir="@(isRtl ? "rtl" : "ltr")">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - @Localizer["SiteName"]</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'brand-yellow': '#FFB343',
                        'brand-cyan': '#42EAFF',
                        'brand-blue': '#4272FF',
                        'brand-orange': '#FF7E42',
                        'dark-bg': '#0B0F19'
                    },
                    animation: {
                        'blob': 'blob 7s infinite',
                        'pulse-slow': 'pulse 3s cubic-bezier(0.4, 0, 0.6, 1) infinite',
                    },
                    keyframes: {
                        blob: {
                            '0%': { transform: 'translate(0px, 0px) scale(1)' },
                            '33%': { transform: 'translate(30px, -50px) scale(1.1)' },
                            '66%': { transform: 'translate(-20px, 20px) scale(0.9)' },
                            '100%': { transform: 'translate(0px, 0px) scale(1)' },
                        }
                    }
                }
            }
        }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #0B0F19;
            color: #e2e8f0;
            overflow-x: hidden;
        }
        .glass-panel {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);
        }
        .animation-delay-2000 {
            animation-delay: 2s;
        }
    </style>
    @if (isRtl)
    {
        <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
        <style>
            body, h1, h2, h3, h4, h5, h6, p, span, a, input, button, label, select, option {
                font-family: 'Cairo', sans-serif !important;
            }
        </style>
    }
</head>
<body class="antialiased relative min-h-screen">

    <!-- Floating Language Switcher -->
    <div class="absolute top-4 right-4 z-50">
        <div class="glass-panel p-1 rounded-full bg-slate-900/40 border border-white/10 shadow-lg">
            <partial name="_LanguageSwitcher" />
        </div>
    </div>

    <div class="fixed inset-0 z-0 overflow-hidden pointer-events-none">
        <div class="absolute top-[10%] left-[20%] w-[400px] h-[400px] bg-brand-orange rounded-full mix-blend-screen filter blur-[120px] opacity-20 animate-blob"></div>
        <div class="absolute bottom-[10%] right-[20%] w-[400px] h-[400px] bg-brand-blue rounded-full mix-blend-screen filter blur-[120px] opacity-20 animate-blob animation-delay-2000"></div>
    </div>

    <div class="relative z-10 min-h-screen flex flex-col items-center justify-center p-4">
        <main class="w-full max-w-md text-center">
            <div class="glass-panel rounded-3xl p-8 md:p-12 transition-all duration-300 hover:border-brand-orange/30 shadow-2xl">
                <div class="mb-6 flex justify-center">
                    <div class="w-24 h-24 bg-brand-orange/10 rounded-full flex items-center justify-center border border-brand-orange/20 animate-pulse-slow">
                        <svg class="w-10 h-10 text-brand-orange" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                        </svg>
                    </div>
                </div>

                <h1 class="text-7xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-brand-yellow to-brand-orange mb-2 tracking-tighter">
                    403
                </h1>

                <h2 class="text-2xl font-bold text-white mb-4">@Localizer["AccessDenied"]</h2>

                <p class="text-slate-400 text-sm mb-8 leading-relaxed">
                    @Localizer["AccessDeniedSub"]
                </p>

                <div class="flex flex-col space-y-3">
                    <a asp-controller="Home" asp-action="Index"
                       class="w-full flex justify-center py-3.5 px-4 rounded-xl shadow-lg shadow-brand-blue/20 text-base font-bold text-white bg-gradient-to-r from-brand-blue to-brand-cyan hover:from-brand-cyan hover:to-brand-blue focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-dark-bg focus:ring-brand-cyan transition-all duration-300 transform hover:-translate-y-0.5">
                        @Localizer["BackToHome"]
                    </a>

                    <a asp-controller="Account" asp-action="Login"
                       class="w-full flex justify-center py-3.5 px-4 border border-slate-700/50 rounded-xl text-sm font-semibold text-slate-300 bg-slate-800/50 hover:bg-slate-700/50 hover:text-white focus:outline-none transition-all duration-300">
                        @Localizer["LoginDifferentAccount"]
                    </a>
                </div>
            </div>
        </main>
    </div>
</body>
</html>